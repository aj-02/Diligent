BEGIN_METHOD ZLOG_UPDATE CHANGING CONTAINER.
DATA:
      INITIATOROFWORKFLOWI TYPE WFSYST-INITIATOR OCCURS 0,
      banfn type banfn,
      status type SYPRI40.

  SWC_GET_TABLE CONTAINER 'InitiatorOfWorkflowI' INITIATOROFWORKFLOWI.
  swc_get_element container 'PR' banfn.
  swc_get_element container 'STATUS' status.

  data: it_ZMM_PURCH_LOG type TABLE OF ZMM_PURCH_LOG,
        wa_ZMM_PURCH_LOG type ZMM_PURCH_LOG,
        wa_agent type WFSYST-INITIATOR.

wa_ZMM_PURCH_LOG-slno = 0.


  select * into table it_ZMM_PURCH_LOG
    from ZMM_PURCH_LOG
    where
    banfn = banfn.
if sy-subrc = 0.
  sort it_ZMM_PURCH_LOG by slno DESCENDING.
  read table it_ZMM_PURCH_LOG into wa_ZMM_PURCH_LOG index 1.
  endif.


CASE STATUS.
  WHEN 'A'.
    wa_ZMM_PURCH_LOG-STATUS = 'APPROVED'.
    WHEN 'R'.
      wa_ZMM_PURCH_LOG-STATUS = 'REJECTED'.
      WHEN 'F'.
        wa_ZMM_PURCH_LOG-STATUS = 'FORWARDED'.
        when 'E'.
          wa_ZMM_PURCH_LOG-STATUS = 'REVERT'.
        ENDCASE.

wa_ZMM_PURCH_LOG-slno = wa_ZMM_PURCH_LOG-slno + 1.
loop at INITIATOROFWORKFLOWI into wa_agent.
wa_ZMM_PURCH_LOG-banfn = banfn.
wa_ZMM_PURCH_LOG-cdate = sy-datum.
wa_ZMM_PURCH_LOG-ctime = sy-uzeit.
wa_ZMM_PURCH_LOG-objid = wa_agent+2(12).
modify ZMM_PURCH_LOG from wa_ZMM_PURCH_LOG.

endloop.
commit WORK AND WAIT.
END_METHOD.

