BEGIN_METHOD ENTER_TEXT CHANGING CONTAINER.
DATA BANFN TYPE THEAD-TDNAME.

DATA IT_LINE TYPE TABLE OF TLINE.
DATA IT_LINE1 TYPE TABLE OF TLINE.
DATA WA_LINE TYPE TLINE.

DATA SYTITLE TYPE SYTITLE.
DATA IT_TAB TYPE CATSXT_LONGTEXT_ITAB.
DATA WA_TAB TYPE TXLINE.
BANFN = OBJECT-KEY-NUMBER.

CONCATENATE 'Comments for PR No' BANFN INTO SYTITLE SEPARATED BY SPACE.

CALL FUNCTION 'CATSXT_SIMPLE_TEXT_EDITOR'
  EXPORTING
    IM_TITLE        = SYTITLE
*   IM_DISPLAY_MODE = ' '
*   IM_START_COLUMN = 10
*   IM_START_ROW    = 10
  CHANGING
    CH_TEXT         = IT_TAB.


CLEAR WA_LINE.
APPEND WA_LINE TO IT_LINE.

DATA : L_DATE TYPE CHAR10,
      L_TIME TYPE CHAR8.

CONCATENATE SY-DATUM+6(2) '.' SY-DATUM+4(2) '.' SY-DATUM(4) INTO L_DATE.
CONCATENATE SY-UZEIT(2) '.' SY-UZEIT+2(2) '.' SY-UZEIT+4(2) INTO L_TIME.

CONCATENATE 'Reply' SY-UNAME  L_DATE L_TIME INTO WA_LINE-TDLINE SEPARATED BY SPACE.
APPEND WA_LINE TO IT_LINE.



CALL FUNCTION 'READ_TEXT'
  EXPORTING
*   CLIENT                        = SY-MANDT
    ID                            = 'ST'
    LANGUAGE                      = SY-LANGU
    NAME                          = BANFN
    OBJECT                        = 'TEXT'
*   ARCHIVE_HANDLE                = 0
*   LOCAL_CAT                     = ' '
* IMPORTING
*   HEADER                        =
*   OLD_LINE_COUNTER              =
  TABLES
    LINES                         = IT_LINE1
 EXCEPTIONS
   ID                            = 1
   LANGUAGE                      = 2
   NAME                          = 3
   NOT_FOUND                     = 4
   OBJECT                        = 5
   REFERENCE_CHECK               = 6
   WRONG_ACCESS_TO_ARCHIVE       = 7
   OTHERS                        = 8
          .
IF SY-SUBRC <> 0.
* Implement suitable error handling here
ENDIF.


CLEAR WA_LINE.
LOOP AT IT_TAB INTO WA_TAB.
  WA_LINE-TDLINE = WA_TAB.
  APPEND WA_LINE TO IT_LINE.
ENDLOOP.

APPEND LINES OF IT_LINE TO IT_LINE1.

DATA HEADER TYPE THEAD.

HEADER-TDOBJECT = 'TEXT'.
HEADER-TDNAME = BANFN.
HEADER-TDID = 'ST'.
HEADER-TDSPRAS = SY-LANGU.

CALL FUNCTION 'SAVE_TEXT'
  EXPORTING
*   CLIENT                = SY-MANDT
    HEADER                = HEADER
   INSERT                = 'X'
   SAVEMODE_DIRECT       = 'X'
*   OWNER_SPECIFIED       = ' '
*   LOCAL_CAT             = ' '
* IMPORTING
*   FUNCTION              =
*   NEWHEADER             =
  TABLES
    LINES                 = IT_LINE1
 EXCEPTIONS
   ID                    = 1
   LANGUAGE              = 2
   NAME                  = 3
   OBJECT                = 4
   OTHERS                = 5
          .
IF SY-SUBRC <> 0.
* Implement suitable error handling here
ELSE.
  COMMIT WORK.
ENDIF.


END_METHOD.




