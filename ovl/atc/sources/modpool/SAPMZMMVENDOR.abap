7904   FORM user_ok_tc USING    p_tc_name TYPE dynfnam
7905                            p_table_name
7906                            p_mark_name
7907                   CHANGING p_ok      LIKE sy-ucomm.
7908
7909   *&SPWIZARD: BEGIN OF LOCAL DATA----------------------------------------*
7910     DATA: l_ok     TYPE sy-ucomm,
7911           l_offset TYPE i.
7912   *&SPWIZARD: END OF LOCAL DATA------------------------------------------*
7913
7914   *&SPWIZARD: Table control specific operations                          *
7915   *&SPWIZARD: evaluate TC name and operations                            *
7916     SEARCH p_ok FOR p_tc_name.
7917     IF sy-subrc <> 0.
7918       EXIT.
7919     ENDIF.
7920     l_offset = strlen( p_tc_name ) + 1.
7921     l_ok = p_ok+l_offset.
7922   *&SPWIZARD: execute general and TC specific operations                 *
7923     CASE l_ok.
7924       WHEN 'INSR'.                      "insert row
7925
7926         READ TABLE  g_tc319_itab INTO zfivmsbank INDEX 1.  "#EC CI_NOORDER
7927         DATA : l_line TYPE i.
7928
7929         DESCRIBE TABLE  g_tc319_itab LINES l_line.
7930
7931         l_line = l_line + 1.
7932         tc319-lines = l_line.
7933         CLEAR : g_create .
7934         CLEAR : g_tc319_wa,    g_exist .
7935         INSERT INITIAL LINE INTO g_tc319_itab INDEX l_line.
7936         g_tc319_wa-srno = l_line.
7937         MODIFY g_tc319_itab FROM g_tc319_wa INDEX l_line.  "#EC CI_NOORDER
7938   *       PERFORM FCODE_INSERT_ROW USING    P_TC_NAME
7939   *                                         P_TABLE_NAME.
7940   *       CLEAR P_OK.
7941
7942       WHEN 'DELE'.                      "delete row
7943         IF g_okcode931 = 'CHANGE' OR g_okcode531 = 'CHANGE'.  "08092010
7944           g_tc319_itab_temp[] = g_tc319_itab[].
7945           g_tc531_itab_temp[] = g_tc531_itab[].
7946           g_zvms_reqno   = zfivmsbank-reqno.
7947         ENDIF.
7948
7949         PERFORM fcode_delete_row USING    p_tc_name
7950                                           p_table_name
7951                                           p_mark_name.
7952         CLEAR p_ok.
7953
7954       WHEN 'P--' OR                     "top of list
7955            'P-'  OR                     "previous page
7956            'P+'  OR                     "next page
7957            'P++'.                       "bottom of list
7958         PERFORM compute_scrolling_in_tc USING p_tc_name
7959                                               l_ok.
7960         CLEAR p_ok.
7961   *     WHEN 'L--'.                       "total left
7962   *       PERFORM FCODE_TOTAL_LEFT USING P_TC_NAME.
7963   *
7964   *     WHEN 'L-'.                        "column left
7965   *       PERFORM FCODE_COLUMN_LEFT USING P_TC_NAME.
7966   *
7967   *     WHEN 'R+'.                        "column right
7968   *       PERFORM FCODE_COLUMN_RIGHT USING P_TC_NAME.
7969   *
7970   *     WHEN 'R++'.                       "total right
7971   *       PERFORM FCODE_TOTAL_RIGHT USING P_TC_NAME.
7972   *
7973       WHEN 'MARK'.                      "mark all filled lines
7974         PERFORM fcode_tc_mark_lines USING p_tc_name
7975                                           p_table_name
7976                                           p_mark_name   .
7977         CLEAR p_ok.
7978
7979       WHEN 'DMRK'.                      "demark all filled lines
7980         PERFORM fcode_tc_demark_lines USING p_tc_name
7981                                             p_table_name
7982                                             p_mark_name .
7983         CLEAR p_ok.
7984
7985       WHEN 'POSI'.
7986         PERFORM search_request.
7987         CLEAR p_ok.
7988
7989
7990     ENDCASE.
7991
7992   ENDFORM.                              " USER_OK_TC
