643        SELECT lifnr j_1ipanno
644              INTO CORRESPONDING FIELDS OF TABLE it_pan
645              FROM lfa1
646              FOR ALL ENTRIES IN ist_lfa1
647              WHERE lifnr = ist_lfa1-lifnr.  "#EC CI_NOORDER
