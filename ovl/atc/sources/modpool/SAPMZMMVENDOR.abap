7997   FORM fcode_insert_row
7998                 USING    p_tc_name           TYPE dynfnam
7999                          p_table_name             .
8000
8001   *&SPWIZARD: BEGIN OF LOCAL DATA----------------------------------------*
8002     DATA l_lines_name       LIKE feld-name.
8003     DATA l_selline          LIKE sy-stepl.
8004     DATA l_lastline         TYPE i.
8005     DATA l_line             TYPE i.
8006     DATA l_table_name       LIKE feld-name.
8007     FIELD-SYMBOLS <tc>                 TYPE cxtab_control.
8008     FIELD-SYMBOLS <table>              TYPE STANDARD TABLE.
8009     FIELD-SYMBOLS <lines>              TYPE i.
8010   *&SPWIZARD: END OF LOCAL DATA------------------------------------------*
8011
8012     ASSIGN (p_tc_name) TO <tc>.
8013
8014   *&SPWIZARD: get the table, which belongs to the tc                     *
8015     CONCATENATE p_table_name '[]' INTO l_table_name. "table body
8016     ASSIGN (l_table_name) TO <table>.                "not headerline
8017
8018   *&SPWIZARD: get looplines of TableControl                              *
8019     CONCATENATE 'G_' p_tc_name '_LINES' INTO l_lines_name.
8020     ASSIGN (l_lines_name) TO <lines>.
8021
8022   *&SPWIZARD: get current line                                           *
8023     GET CURSOR LINE l_selline.
8024     IF sy-subrc <> 0.                   " append line to table
8025       l_selline = <tc>-lines + 1.
8026   *&SPWIZARD: set top line                                               *
8027       IF l_selline > <lines>.
8028         <tc>-top_line = l_selline - <lines> + 1 .
8029       ELSE.
8030         <tc>-top_line = 1.
8031       ENDIF.
8032     ELSE.                               " insert line into table
8033       l_selline = <tc>-top_line + l_selline - 1.
8034       l_lastline = <tc>-top_line + <lines> - 1.
8035     ENDIF.
8036   *&SPWIZARD: set new cursor line                                        *
8037     l_line = l_selline - <tc>-top_line + 1.
8038
8039   *&SPWIZARD: insert initial line                                        *
8040     INSERT INITIAL LINE INTO <table> INDEX l_selline.
8041     <tc>-lines = <tc>-lines + 1.
8042   *&SPWIZARD: set cursor                                                 *
8043     SET CURSOR LINE l_line.
8044
8045   ENDFORM.                              " FCODE_INSERT_ROW
