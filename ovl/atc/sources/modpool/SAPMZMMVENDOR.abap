8125           last_page_full = 'X'
8126           loops          = <lines>
8127           ok_code        = p_ok
8128           overlapping    = 'X'
8129         IMPORTING
8130           entry_new      = l_tc_new_top_line
8131         EXCEPTIONS
8132   *       NO_ENTRY_OR_PAGE_ACT  = 01
8133   *       NO_ENTRY_TO    = 02
8134   *       NO_OK_CODE_OR_PAGE_GO = 03
8135           OTHERS         = 0.
8136     ENDIF.
8137
8138   *&SPWIZARD: get actual tc and column                                   *
8139     GET CURSOR FIELD l_tc_field_name
8140                AREA  l_tc_name.
8141
8142     IF syst-subrc = 0.
8143       IF l_tc_name = p_tc_name.
8144   *&SPWIZARD: et actual column                                           *
8145         SET CURSOR FIELD l_tc_field_name LINE 1.
8146       ENDIF.
8147     ENDIF.
8148
8149   *&SPWIZARD: set the new top line                                       *
8150     <tc>-top_line = l_tc_new_top_line.
