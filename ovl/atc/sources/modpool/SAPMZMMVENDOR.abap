3673   FORM update_zmm_hvenext.
3674     zmm_hvenext-mandt = sy-mandt.
3675     CASE g_trans_mode.
3676       WHEN 'N'.
3677         zmm_hvenext-erfdt = sy-datum.
3678         zmm_hvenext-ernam = sy-uname.
3679       WHEN 'M'.
3680         zmm_hvenext-aedtm = sy-datum.
3681         zmm_hvenext-aeusn = sy-uname.
3682         CLEAR zmm_hvenext-rel_flag.
3683       WHEN 'R'.
3684         zmm_hvenext-released_by = sy-uname.
3685         zmm_hvenext-release_date = sy-datum.
3686         zmm_hvenext-rel_flag = 'X'.
3687       WHEN 'A'.
3688         zmm_hvenext-assigned_by = sy-uname.
3689         zmm_hvenext-assign_date = sy-datum.
3690         zmm_hvenext-ass_flag = 'X'.
3691       WHEN 'X'.
3692         DELETE FROM zmm_hvenext WHERE reqno = zmm_hvenext-reqno.
3693         IF NOT sy-subrc IS INITIAL.
3694           g_crt1 = 'X'.
3695         ENDIF.
3696         EXIT.
3697     ENDCASE.
3698
3699     IF NOT zmm_hvenext-reqno IS INITIAL. "AND
3700   *     NOT ZMM_HVENEXT-EKGRP IS INITIAL.
3701       MODIFY zmm_hvenext.
3702       IF NOT sy-subrc IS INITIAL.
3703         g_crt1 = 'X'.
3704       ENDIF.
3705     ENDIF.
3706
