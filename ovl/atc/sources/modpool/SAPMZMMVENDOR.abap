8721                                 AND ( zfivmsbank-status = 'APPROVED BY HOF'
8722                                 OR  zfivmsbank-status = 'REGISTRATION SUCCESSFUL').  " added by ss on 11.10.2021
8723           g_asy_reqno = zfivmsbank-reqno.
