827            ENDIF.
828
829          WHEN 'R'.
830
831            IF zmm_hvencrt-rel_flag <> ' ' .
832              MESSAGE e736(zmm) WITH zmm_hvencrt-reqno.
833            ENDIF.
834
835            IF zmm_hvencrt-rel_flag <> ' '  AND zmm_hvencrt-ass_flag = 'F'.
836              MESSAGE e742(zmm) WITH zmm_hvencrt-reqno.
837            ENDIF.
838
839            SELECT * FROM zmm_dvencrt INTO TABLE ist_zmm_dvencrt WHERE
840                               reqno = zmm_hvencrt-reqno AND
841                               del_flag = ' ' AND ass_flag = ' '.
842
843          WHEN 'A'.
844
845            IF zmm_hvencrt-rel_flag <> ' '  AND zmm_hvencrt-ass_flag = 'F'.
846              MESSAGE e742(zmm) WITH zmm_hvencrt-reqno.
847            ENDIF.
