2527   * Begin of <> on 10022012
2528   *  SELECT reqno bukrs erfdt ass_flag lifnr ernam FROM zmm_vend_unblock
2529   *                     INTO TABLE ist_req WHERE del_flag <> 'X'.
2530   *
2531   *  CASE g_trans_mode.
2532   *    WHEN 'A' OR 'M'.
2533   *      DELETE ist_req WHERE ass_flag = 'X'.
2534   *      DELETE ist_req WHERE reqno = ' '.
2535   *  ENDCASE.
2536   *
2537   *  SORT ist_req.
2538   *  DELETE ADJACENT DUPLICATES FROM ist_req COMPARING reqno.
2539   *
2540   *  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
2541   *    EXPORTING
2542   *      retfield        = 'REQNO'
2543   *      dynpprog        = sy-cprog
2544   *      dynpnr          = sy-dynnr
2545   *      value_org       = 'S'
2546   *    TABLES
2547   *      value_tab       = ist_req
2548   *      return_tab      = ist_return_tab
2549   *    EXCEPTIONS
2550   *      parameter_error = 1
2551   *      no_values_found = 2
2552   *      OTHERS          = 3.
2553   *  IF sy-subrc <> 0.
2554   *    MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
2555   *            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
2556   *  ENDIF.
2557
2558     CASE g_trans_mode.
2559       WHEN 'M'.
2560         SELECT reqno bukrs lifnr ernam erfdt zrelease releasedby zapprove approvedby
2561         ass_flag assigned_by assign_date FROM zmm_vend_unblock INTO TABLE ist_requnbl
2562         WHERE ass_flag <> 'X'.  "#EC CI_NOORDER
2563
2564       WHEN 'RL'.
2565         SELECT reqno bukrs lifnr ernam erfdt zrelease releasedby zapprove approvedby
2566         ass_flag assigned_by assign_date FROM zmm_vend_unblock INTO TABLE ist_requnbl
2567         WHERE zrelease <> 'X'.  "#EC CI_NOORDER
2568
2569       WHEN 'AP'.
2570         SELECT reqno bukrs lifnr ernam erfdt zrelease releasedby zapprove approvedby
2571         ass_flag assigned_by assign_date FROM zmm_vend_unblock INTO TABLE ist_requnbl
2572         WHERE zrelease = 'X' AND zapprove <> 'X'.  "#EC CI_NOORDER
2573
