1209                                                       WHERE ass_flag = ' '
1210                                                         AND rel_flag = ' '.  "#EC CI_NOORDER
1211       WHEN 'A'.
1212         SELECT reqno rel_flag ass_flag FROM zmm_hvencrt INTO CORRESPONDING FIELDS OF TABLE ist_req
1213                                                      WHERE rel_flag <> ' '
1214                                                  AND  ( ass_flag = 'P'  OR
