8727         ENDIF.
8728   * End of <> on 17052013
8729       ELSE.
8730   * End of <> on 24022011
8731         SELECT SINGLE * FROM t100 INTO wa_t100 WHERE sprsl = messtab-msgspra
8732                                   AND   arbgb = messtab-msgid
8733                                   AND   msgnr = messtab-msgnr.
8734         IF sy-subrc = 0.
8735           l_mstring = wa_t100-text.
