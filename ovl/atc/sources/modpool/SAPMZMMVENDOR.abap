8738             REPLACE '&2' WITH messtab-msgv2 INTO l_mstring.
8739             REPLACE '&3' WITH messtab-msgv3 INTO l_mstring.
8740             REPLACE '&4' WITH messtab-msgv4 INTO l_mstring.
8741           ELSE.
8742             REPLACE '&' WITH messtab-msgv1 INTO l_mstring.
8743             REPLACE '&' WITH messtab-msgv2 INTO l_mstring.
8744             REPLACE '&' WITH messtab-msgv3 INTO l_mstring.
8745             REPLACE '&' WITH messtab-msgv4 INTO l_mstring.
8746           ENDIF.
8747           CONDENSE l_mstring.
8748           WRITE: / messtab-msgtyp, l_mstring(250).
8749         ELSE.
8750           WRITE: / messtab.
8751         ENDIF.
8752       ENDIF.
8753     ENDLOOP.
8754     SKIP.
8755     REFRESH bdcdata.
