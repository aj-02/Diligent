3733             APPEND ist_dvenext.
3734           ENDLOOP.
3735
3736           DELETE zmm_dvenext FROM TABLE ist_dvenext[].
3737           IF NOT sy-subrc IS INITIAL.
3738             g_crt2 = 'X'.
3739           ENDIF.
3740           EXIT.
3741
3742       ENDCASE.
3743
3744       MODIFY zmm_dvenext FROM TABLE ist_dvenext[].
3745       IF NOT sy-subrc IS INITIAL.
3746         g_crt2 = 'X'.
3747       ENDIF.
3748
3749     ENDIF.
