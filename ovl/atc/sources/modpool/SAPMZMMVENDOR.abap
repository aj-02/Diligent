7529     DATA : l_no  TYPE sy-tabix,
7530            l_cnt TYPE sy-tabix.
7531
7532     IF p_tr_mode = 'DELE'.
7533
7534       DESCRIBE TABLE ist_unbl LINES l_no.
7535
7536       LOOP AT ist_unbl.
7537         IF ist_unbl-del_flag = 'X'.
7538           l_cnt = l_cnt + 1.
7539         ENDIF.
7540       ENDLOOP.
7541
7542       IF l_cnt = l_no.
7543
7544         MESSAGE w858(zmm).
7545
7546         LOOP AT ist_unbl.
7547           CLEAR ist_unbl-del_flag.
7548           MODIFY ist_unbl INDEX sy-tabix.
