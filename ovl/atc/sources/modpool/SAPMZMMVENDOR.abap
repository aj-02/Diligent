864
865
866                """"""""""""""
867              ENDIF.
868              """"""""""""""""""""
869            ENDIF.
870
871            IF zmm_hvencrt-rel_flag <> ' ' OR
872               zmm_hvencrt-ass_flag <> ' '.
873              MESSAGE e735(zmm) WITH text-023.
874            ELSE.
875              SELECT * FROM zmm_dvencrt INTO TABLE ist_zmm_dvencrt WHERE
876                                               reqno = zmm_hvencrt-reqno.  "#EC CI_NOORDER
877            ENDIF.
878
879        ENDCASE.
880
881      ENDIF.
