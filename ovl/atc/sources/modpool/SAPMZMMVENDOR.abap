8110     CONCATENATE 'G_' p_tc_name '_LINES' INTO l_tc_lines_name.
8111     ASSIGN (l_tc_lines_name) TO <lines>.
8112
8113
8114   *&SPWIZARD: is no line filled?                                         *
8115     IF <tc>-lines = 0.
8116   *&SPWIZARD: yes, ...                                                   *
8117       l_tc_new_top_line = 1.
