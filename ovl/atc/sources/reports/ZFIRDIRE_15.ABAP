4613           LOOP AT lt_nits_lfa1_total WHERE name1 = t_stcd1-name1.
4614   *        LOOP AT lt_nits_all WHERE name1 = t_stcd1-name1.
4615             MOVE-CORRESPONDING lt_nits_lfa1_total TO lt_nits_all.
4616             lc_stcd1 = lt_nits_all-stcd1.
4617             SHIFT lc_stcd1 RIGHT DELETING TRAILING space.
4618             SHIFT lc_stcd1 RIGHT.
4619             SHIFT lc_stcd1 LEFT DELETING LEADING space.
4620             IF lc_stcd1 = t_stcd1-stcd1.
4621               PERFORM check_digit USING lt_nits_all-stkzn
4622                                         lt_nits_all-stcd1
4623                                         lt_nits_all-land1
4624                            CHANGING lt_nits_all-digit lt_nits_all-stcd1.
4625               IF NOT lt_nits_all-digit IS INITIAL.
4626                 MOVE-CORRESPONDING lt_nits_all TO t_nits_all.
4627                 INSERT TABLE t_nits_all.
4628               ENDIF.
4629             ENDIF.
4630           ENDLOOP.
4631         ENDIF.
4632       ENDLOOP.
4633       FREE: lt_nits_all, t_stcd1.
4634     ENDIF.
4635     gt_nits_kna1_total[] = lt_nits_kna1_total[].
4636     SORT gt_nits_kna1_total[].
