2630   *  <--  p2        text
2631   *----------------------------------------------------------------------*
2632   FORM i01_convert_local_to_alternat.
2633
2634   *------- Convert local company code currencies into alternative  -------
2635   *------ -currency ALTCURR     with exchange rate at CONVDATE -------
2636     CHECK NOT wa_idwtglob-wt_sc_altcurr  IS INITIAL AND
2637            wa_idwtglob-wt_sc_convdate <> '00000000'.
2638
2639
2640   *    loop at wa_qstrmain.
2641
2642     CHECK wa_idwtglob-wt_sc_altcurr <> wa_qstrmain-hwaer.
2643
2644     IF wa_qstrmain-dmbtr <> 0.
2645       lv_dmbtr = wa_qstrmain-dmbtr.
2646     ELSE.
2647       IF wa_qstrmain-wt_qsshh <> 0.
2648         lv_dmbtr = wa_qstrmain-wt_qsshh.
2649       ELSE.
2650         wa_qstrmain-hwaer = wa_idwtglob-wt_sc_altcurr.
2651       ENDIF.
2652     ENDIF.
2653
2654     CALL FUNCTION 'CONVERT_TO_FOREIGN_CURRENCY'
2655       EXPORTING
2656         date             = wa_idwtglob-wt_sc_convdate      "#EC DOM_EQUAL
2657         foreign_currency = wa_idwtglob-wt_sc_altcurr
2658         local_amount     = lv_dmbtr
2659         local_currency   = wa_qstrmain-hwaer
2660         type_of_rate     = 'M'
2661       IMPORTING
2662         foreign_amount   = lv_dmbtr_alt
2663       EXCEPTIONS
2664         no_rate_found    = 1
2665         overflow         = 2
2666         no_factors_found = 3
2667         no_spread_found  = 4
2668         derived_2_times  = 5
2669         OTHERS           = 6.
2670
2671     IF sy-subrc = 0.
2672       lv_altrate = lv_dmbtr_alt / lv_dmbtr.
2673       wa_qstrmain-hwaer    = wa_idwtglob-wt_sc_altcurr.
2674       wa_qstrmain-dmbtr    = wa_qstrmain-dmbtr    * lv_altrate.
2675       wa_qstrmain-wt_qsshh = wa_qstrmain-wt_qsshh * lv_altrate.
2676       wa_qstrmain-wt_qbshh = wa_qstrmain-wt_qbshh * lv_altrate.
2677       wa_qstrmain-wt_qsfhh = wa_qstrmain-wt_qsfhh * lv_altrate.
2678       wa_qstrmain-wt_nethh = wa_qstrmain-wt_nethh * lv_altrate.
2679       wa_qstrmain-wt_taxhh = wa_qstrmain-wt_taxhh * lv_altrate.
2680       wa_qstrmain-sknto    = wa_qstrmain-sknto    * lv_altrate.
2681     ELSE.
2682       IF wa_idwtglob-wt_sc_list_act4 IS INITIAL.
2683         MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
2684              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
2685       ELSE.
2686         CLEAR wa_error.
2687         wa_error-wt_msgid       = sy-msgid.
2688         wa_error-wt_msgty       = sy-msgty.
2689         wa_error-wt_msgnr       = sy-msgno.
2690         MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
2691              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
2692              INTO wa_error-wt_natxt.
2693         PERFORM f01_fill_idwterror TABLES i_idwterror[]
2694                                  USING wa_error.
2695       ENDIF.
2696     ENDIF.
2697
2698   ENDFORM.                               " I01_CONVERT_LOCAL_TO_ALTERNAT.
