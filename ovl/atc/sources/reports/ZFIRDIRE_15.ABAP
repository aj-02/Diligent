432    FORM get_accounts_k.
433
434      DATA: lc_buzei_k LIKE bseg-buzei,
435            lc_belnr_k LIKE bseg-belnr,
436            lv_lifnr   TYPE bseg-lifnr.
437      DATA: lc_from LIKE sy-index,
438            lc_to   LIKE sy-index.
439
440    * Documents Detail
441      DESCRIBE TABLE t_bkpf LINES gi_lin.
442      IF gi_lin GT zdi00_max_de.
443        lc_from = 1.
444        lc_to = zdi00_max_de.
445        DO.
446          LOOP AT t_bkpf INTO *bkpf FROM lc_from TO lc_to.
447            MOVE: *bkpf-belnr TO bkpf-belnr,
448                  *bkpf-gjahr TO bkpf-gjahr,
449                  *bkpf-blart TO bkpf-blart,
450                  *bkpf-budat TO bkpf-budat,
451                  *bkpf-xblnr TO bkpf-xblnr,
452                  *bkpf-stblg TO bkpf-stblg,
453                  *bkpf-stjah TO bkpf-stjah,
454                  *bkpf-awkey TO bkpf-awkey.
455
456    *-- Validar si el documento es del tercero seleccionado
457            IF s_terce IS NOT INITIAL.
458              CLEAR lv_lifnr.
459              " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
460    *          SELECT SINGLE lifnr INTO lv_lifnr FROM bseg
461    *               WHERE  bukrs =  p_bukrs
462    *                 AND  belnr =  bkpf-belnr
463    *                 AND  gjahr =  p_gjahr
464    *                 AND  lifnr IN s_terce.
465              SELECT SINGLE  supplier AS lifnr FROM i_operationalacctgdocitem
466    *    WHERE COMPANYCODE in @P_BUKRS
467                 WHERE accountingdocument = @bkpf-belnr
468                AND companycode IN @p_bukrs
469                 AND fiscalyear IN @p_gjahr AND supplier IN @s_terce INTO @lv_lifnr .
470              " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC
471            ENDIF.
472
473            " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
474    *        SELECT  buzei koart shkzg dmbtr zuonr
475    *                sgtxt hkont lifnr ebeln ebelp xref1 xref3
476    *          INTO (bseg-buzei, bseg-koart, bseg-shkzg, bseg-dmbtr,
477    *                bseg-zuonr, bseg-sgtxt, bseg-hkont, bseg-lifnr,
478    *                bseg-ebeln, bseg-ebelp, bseg-xref1, bseg-xref3)
479    *          FROM  bseg
480    *         WHERE  bukrs =  p_bukrs
481    *           AND  belnr =  bkpf-belnr
482    *           AND  gjahr =  p_gjahr
483    *           AND  ( hkont IN s_hkont OR koart = 'K' ).
484            SELECT  accountingdocumentitem AS buzei , financialaccounttype AS
485           koart , unadjusteddebitcreditcode AS shkzg , absoluteamountincocodecrcy
486           AS dmbtr , assignmentreference AS zuonr , documentitemtext AS sgtxt ,
487           glaccount AS hkont , supplier AS lifnr , purchasingdocument AS ebeln ,
488           purchasingdocumentitem AS ebelp , reference1idbybusinesspartner AS
489           xref1 , reference3idbybusinesspartner AS xref3 FROM
490           i_operationalacctgdocitem WHERE companycode IN @p_bukrs AND
491           accountingdocument = @bkpf-belnr AND fiscalyear IN @p_gjahr AND (
492           glaccount IN @s_hkont OR financialaccounttype = 'K' ) INTO (
493           @bseg-buzei , @bseg-koart , @bseg-shkzg , @bseg-dmbtr , @bseg-zuonr ,
494           @bseg-sgtxt , @bseg-hkont , @bseg-lifnr , @bseg-ebeln , @bseg-ebelp ,
495           @bseg-xref1 , @bseg-xref3  ).
496              " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC
497
498              IF s_terce IS NOT INITIAL.
499                CHECK lv_lifnr IN s_terce.
500                bseg-lifnr = lv_lifnr.
501              ENDIF.
502
503    * Vendors
504              IF bseg-koart = 'K'.
505                MOVE bkpf-belnr TO lc_belnr_k.
506                MOVE bseg-buzei TO lc_buzei_k.
507    **            EXTRACT detail.
508                CONTINUE.
509              ENDIF.
510
511              IF bkpf-belnr = lc_belnr_k.
512                bseg-buzei = lc_buzei_k.
513              ENDIF.
514
515              IF bseg-lifnr NE space.
516                MOVE bseg-lifnr TO r_vendor-low.
517                COLLECT r_vendor.
518              ENDIF.
519
520    * Material Documents
521              IF bseg-ebeln NE space.
522                MOVE bseg-ebeln TO t_order-ebeln.
523                MOVE bseg-ebelp TO t_order-ebelp.
524                COLLECT t_order.
525              ENDIF.
526
527              IF p_cncpt IS INITIAL.
528                READ TABLE t_ctacpt WITH TABLE KEY hkont = bseg-hkont.
529                IF sy-subrc EQ 0.
530                  cncpt = t_ctacpt-cncpt.
531                ENDIF.
532              ELSE.
533                cncpt = p_cncpt.
534              ENDIF.
535
536              EXTRACT detail.
537            ENDSELECT.
538          ENDLOOP.
539          lc_from = lc_to + 1.
540          lc_to   = lc_from + zdi00_max_de.
541          IF lc_from GT gi_lin.
542            EXIT.
543          ENDIF.
544          COMMIT WORK.
545        ENDDO.
546      ELSE.
547        LOOP AT t_bkpf INTO *bkpf.
548          MOVE: *bkpf-belnr TO bkpf-belnr,
549                *bkpf-gjahr TO bkpf-gjahr,
550                *bkpf-blart TO bkpf-blart,
551                *bkpf-budat TO bkpf-budat,
552                *bkpf-xblnr TO bkpf-xblnr,
553                *bkpf-stblg TO bkpf-stblg,
554                *bkpf-stjah TO bkpf-stjah,
555                *bkpf-awkey TO bkpf-awkey.
556
557    *-- Validar si el documento es del tercero seleccionado
558          IF s_terce IS NOT INITIAL.
559            CLEAR lv_lifnr.
560            " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
561    *        SELECT SINGLE lifnr INTO lv_lifnr FROM bseg
562    *             WHERE  bukrs =  p_bukrs
563    *               AND  belnr =  bkpf-belnr
564    *               AND  gjahr =  p_gjahr
565    *               AND  lifnr IN s_terce.
566            SELECT SINGLE  supplier AS lifnr FROM i_operationalacctgdocitem WHERE
567           companycode IN @p_bukrs AND accountingdocument = @bkpf-belnr AND
568           fiscalyear IN @p_gjahr AND supplier IN @s_terce INTO @lv_lifnr .
569            " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC
570          ENDIF.
571
572          " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
573    *      SELECT  buzei koart shkzg dmbtr zuonr
574    *              sgtxt hkont lifnr ebeln ebelp xref1 xref3
575    *        INTO (bseg-buzei, bseg-koart, bseg-shkzg, bseg-dmbtr,
576    *              bseg-zuonr, bseg-sgtxt, bseg-hkont, bseg-lifnr,
577    *              bseg-ebeln, bseg-ebelp, bseg-xref1, bseg-xref3)
578    *        FROM  bseg
579    *       WHERE  bukrs =  p_bukrs
580    *         AND  belnr =  bkpf-belnr
581    *         AND  gjahr =  p_gjahr
582    *         AND  ( hkont IN s_hkont OR koart = 'K' ).
583          SELECT  accountingdocumentitem AS buzei , financialaccounttype AS
584         koart , unadjusteddebitcreditcode AS shkzg , absoluteamountincocodecrcy
585         AS dmbtr , assignmentreference AS zuonr , documentitemtext AS sgtxt ,
586         glaccount AS hkont , supplier AS lifnr , purchasingdocument AS ebeln ,
587         purchasingdocumentitem AS ebelp , reference1idbybusinesspartner AS
588         xref1 , reference3idbybusinesspartner AS xref3 FROM
589         i_operationalacctgdocitem WHERE companycode IN @p_bukrs AND
590         accountingdocument = @bkpf-belnr AND fiscalyear IN @p_gjahr AND (
591         glaccount IN @s_hkont OR financialaccounttype = 'K' ) INTO (
592         @bseg-buzei , @bseg-koart , @bseg-shkzg , @bseg-dmbtr , @bseg-zuonr ,
593         @bseg-sgtxt , @bseg-hkont , @bseg-lifnr , @bseg-ebeln , @bseg-ebelp ,
594         @bseg-xref1 , @bseg-xref3  ).
595            " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC
596
597            IF s_terce IS NOT INITIAL.
598              CHECK lv_lifnr IN s_terce.
599              bseg-lifnr = lv_lifnr.
600            ENDIF.
601
602    * Vendors
603            IF bseg-koart = 'K'.
604              MOVE bkpf-belnr TO lc_belnr_k.
605              MOVE bseg-buzei TO lc_buzei_k.
606    **          EXTRACT detail.
607              CONTINUE.
608            ENDIF.
609
610            IF bkpf-belnr = lc_belnr_k.
611              bseg-buzei = lc_buzei_k.
612            ENDIF.
613
614            IF bseg-lifnr NE space.
615              MOVE bseg-lifnr TO r_vendor-low.
616              COLLECT r_vendor.
617            ENDIF.
618
619    * Material Documents
620            IF bseg-ebeln NE space.
621              MOVE bseg-ebeln TO t_order-ebeln.
622              MOVE bseg-ebelp TO t_order-ebelp.
623              COLLECT t_order.
624            ENDIF.
625
626            IF p_cncpt IS INITIAL.
627              READ TABLE t_ctacpt WITH TABLE KEY hkont = bseg-hkont.
628              IF sy-subrc EQ 0.
629                cncpt = t_ctacpt-cncpt.
630              ENDIF.
631            ELSE.
632              cncpt = p_cncpt.
633            ENDIF.
634
635            EXTRACT detail.
636          ENDSELECT.
637        ENDLOOP.
638      ENDIF.
639
640    ENDFORM.                    " GET_ACCOUNTS_K
