3900               lt_fieldcat-fix_column = zdi00_check.
3901             WHEN 'I'.
3902               lt_fieldcat-no_out = zdi00_check.
3903             WHEN 'P'.
3904               lt_fieldcat-no_out = zdi00_check.
3905             WHEN 'R'.
3906               lt_fieldcat-just = 'R'.
3907             WHEN 'S'.
3908               lt_fieldcat-do_sum = zdi00_check.
3909           ENDCASE.
3910         WHEN 'C'.
3911           lt_fieldcat-currency = p_value.
3912         WHEN 'L'.
3913           lt_fieldcat-outputlen = p_value.
3914         WHEN 'I'.
3915           lt_fieldcat-icon = p_value.
3916         WHEN 'H'.
3917           lt_fieldcat-hotspot = 'X'.
3918         WHEN 'P'.
3919           lt_fieldcat-col_pos = p_value.
3920       ENDCASE.
3921       MODIFY pt_fieldcat FROM lt_fieldcat INDEX sy-tabix.
3922     ELSE.
3923       CASE p_type.
3924         WHEN 'A'.
3925           lt_fieldcat-tabname   = p_tabn.
3926           lt_fieldcat-fieldname = p_field.
3927           lt_fieldcat-reptext_ddic = p_value.
3928           lt_fieldcat-seltext_l    = p_value.
3929           lt_fieldcat-seltext_m    = p_value.
3930           lt_fieldcat-seltext_s    = p_value.
3931           INSERT lt_fieldcat INTO pt_fieldcat.
3932       ENDCASE.
3933     ENDIF.
