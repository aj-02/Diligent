2807   *&      Form  I01_CHECK_SPECIAL_GL
2808   *&---------------------------------------------------------------------*
2809   *       text
2810   *----------------------------------------------------------------------*
2811   *  -->  p1        text
2812   *  <--  p2        text
2813   *----------------------------------------------------------------------*
2814   *Note 545125 begin
2815   FORM i01_check_special_gl.
2816     DATA: t074u,
2817           wa_t074u       TYPE t074u,
2818           acct-type      TYPE t074u-koart,
2819           int            TYPE i,
2820           text_umskz(20) TYPE c.
2821
2822     DATA: BEGIN OF tab OCCURS 0,
2823             text(1) TYPE c,
2824           END OF tab.
2825   *Note 605880 begin
2826     CONDENSE p_aumskz NO-GAPS.
2827   *Eliminate the duplicated special G/L indicators
2828     WHILE  p_aumskz(1) NE space.
2829       tab-text = p_aumskz(1).
2830       COLLECT tab.
2831       SHIFT p_aumskz LEFT.
2832     ENDWHILE.
2833
2834     CASE p_frmat.
2835       WHEN zdi00_1002 OR zdi00_1001.                          "<-nix.2011
2836         wa_idwtglob-wt_data_source = 'DS1'.
2837       WHEN zdi00_1003.
2838         wa_idwtglob-wt_data_source = 'DS3'.
2839       WHEN OTHERS.
2840     ENDCASE.
2841
2842   *Note 605880 end
2843   * Determine specific account type according to the output group.
2844     IF wa_idwtglob-wt_data_source = 'DS1' OR
2845        wa_idwtglob-wt_data_source = 'DS2' OR
2846        wa_idwtglob-wt_data_source = 'DS5' OR
2847        wa_idwtglob-wt_data_source = 'DS7'.  "Note 787062
2848       acct-type = 'K'.
2849     ELSE.
2850       IF wa_idwtglob-wt_data_source = 'DS3' OR
2851          wa_idwtglob-wt_data_source = 'DS4' OR
2852          wa_idwtglob-wt_data_source = 'DS6'.
2853         acct-type = 'D'.
2854       ENDIF.
2855     ENDIF.
2856
2857   * Check if the special G/L indicator is exsiting in specific account
2858   * type.
2859     LOOP AT tab.
2860       SELECT * FROM t074u INTO wa_t074u
2861         WHERE
2862           koart  = acct-type        AND
2863           umskz  = tab-text.
2864       ENDSELECT.
2865       IF sy-subrc = 0.
2866   * Check if the special G/L indicator has downpayment or BOE G/L trans.
2867   * type
2868         IF ( wa_t074u-umsks = 'A' ) OR
2869            ( wa_t074u-umsks = 'W' ).
2870           text_umskz(1) = tab-text.
2871           SHIFT text_umskz RIGHT.
2872           int = int + 1.
2873         ELSE.
2874   *Note 605880 begin
2875           p_aumskz(1) = tab-text.
2876           SHIFT p_aumskz RIGHT.
2877   *Note 605880 end
2878         ENDIF.
2879       ELSE.
2880         text_umskz(1) = tab-text.
2881         SHIFT text_umskz RIGHT.
2882         int = int + 1.
2883       ENDIF.
2884       AT LAST.
2885   *Note 605880 begin
2886         SHIFT p_aumskz LEFT.
2887   *Note 605880 end
2888       ENDAT.
2889
2890     ENDLOOP.
2891     IF int > 0.
2892   *Note 605880 begin
2893       SET CURSOR FIELD 'P_AUMSKZ'.
2894   *Note 605880 end
2895       MESSAGE w043(id_wt) WITH text_umskz.
2896     ENDIF.
2897   ENDFORM.                               " I01_CHECK_SPECIAL_GL
2898   *Note 545125 end
