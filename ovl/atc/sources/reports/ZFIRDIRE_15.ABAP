734    FORM i01_check_output_group.
735
736      IF p_outg NE wa_idwtglob-wt_output_grp OR
737         p_cust NE wa_idwtglob-wt_output_cust.
738
739        IF NOT wa_idwtglob-wt_output_grp IS INITIAL. " real change of keys
740          wa_point = 'check_output_gp'.
741          PERFORM i01_initialization.
742        ENDIF.
743
744        SELECT SINGLE * FROM  idwtnavig
745            WHERE  pgmname         = sy-repid
746            AND    wt_output_grp  = p_outg.
747
748        IF sy-subrc NE 0.
749          MESSAGE e367(fr) WITH 'IDWTNAVIG'.
750        ENDIF.
751
752        SELECT SINGLE * FROM  t059id01
753            WHERE  wt_output_grp   = p_outg
754            AND    wt_output_cust  = p_cust.
755
756        IF sy-subrc NE 0.
757          MESSAGE e020(id_wt).
758        ENDIF.
759
760        SELECT SINGLE * FROM t059id01t
761            WHERE  spras = sy-langu
762            AND    wt_output_grp   = p_outg
763            AND    wt_output_cust  = p_cust.
