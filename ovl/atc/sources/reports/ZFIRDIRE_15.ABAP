3873   FORM update_fieldcat  USING    VALUE(p_type)
3874                                  VALUE(p_tabn)
3875                                  VALUE(p_field)
3876                                  VALUE(p_value)
3877                         CHANGING pt_fieldcat TYPE slis_t_fieldcat_alv.
