977    FORM i01_complete_fidoc.
978    *  DATA: l_qbshb TYPE qbshb,
979    *        l_qsshb TYPE qsshb,
980    *        l_qbshh TYPE qbshh.
981      DATA: l_qbshb TYPE summ9,
982            l_qsshb TYPE summ9,
983            l_qbshh TYPE summ9.
984
985    * for Withholding tax posted at invoice time: the invoice amount picked
986    * up on the vendor item is net of Withholding tax ( the WT is already
987    * posted, so there is an item for it ) . In order to display always the
988    * invoice amount as the gross amount including WT, we reintegrate the
989    * WT inside the invoice amount.
990    * The base amounts of ALL withholding tax types have to be taken
991
992      IF wa_idwtfidoc-item_source = space.                  " FI item
993        wa_idwtfidoc-item_ref(10)   = wa_idwtfidoc-belnr.
994        wa_idwtfidoc-item_ref+11(3) = wa_idwtfidoc-buzei.
995        wa_idwtfidoc-item_ref+15(4) = wa_idwtfidoc-gjahr.
996        IF wa_idwtfidoc-wt_postm = '1'.
997          CALL FUNCTION 'ZFI_WT_CALCULATE_DEDUCTION'           " NOTE 498660
998            EXPORTING
999              i_bukrs    = wa_idwtfidoc-bukrs
1000             i_belnr    = wa_idwtfidoc-belnr
1001             i_gjahr    = wa_idwtfidoc-gjahr
1002             i_buzei    = wa_idwtfidoc-buzei
1003             i_wt_postm = '1'
1004           CHANGING
1005             c_qbshb    = l_qbshb
1006             c_qsshb    = l_qsshb
1007             c_qbshh    = l_qbshh.
1008
1009   *      check: invoice or credit memo
1010
1011         IF wa_idwtfidoc-wrbtr > 0.
1012           wa_idwtfidoc-dmbtr  = wa_idwtfidoc-dmbtr + abs( l_qbshh ).
1013           wa_idwtfidoc-wrbtr  = wa_idwtfidoc-wrbtr + abs( l_qbshb ).
1014         ELSE.
1015           wa_idwtfidoc-dmbtr  = wa_idwtfidoc-dmbtr - abs( l_qbshh ).
1016           wa_idwtfidoc-wrbtr  = wa_idwtfidoc-wrbtr - abs( l_qbshb ).
1017         ENDIF.
1018       ENDIF.
1019     ENDIF.
1020
1021   * amounts sums :
1022
1023     wa_idwtfidoc-wt_amexclvat1  = wa_idwtfidoc-wrbtr
1024                                 - wa_idwtfidoc-wt_taxhb.
1025
1026     wa_idwtfidoc-wt_amexclvat   = wa_idwtfidoc-dmbtr
1027                                 - wa_idwtfidoc-wt_taxhh.
1028
1029   * Note 0434242 begin
1030   *  IF wa_idwtfidoc-wt_qsfhh GE wa_idwtfidoc-wt_taxhh.
1031     "10/09/2001
1032   *  wa_idwtfidoc-wt_amrexmp     = wa_idwtfidoc-wt_qsfhh
1033   *                              - wa_idwtfidoc-wt_taxhh.
1034   *  ELSE.                                                     "10/09/2001
1035   *    wa_idwtfidoc-wt_amrexmp     = wa_idwtfidoc-wt_qsfhh.
1036     "10/09/2001
1037   *  ENDIF.                                                    "10/09/2001
1038   * Note 0434242 end
1039
1040   *  IF wa_idwtfidoc-wt_qsfhb GE wa_idwtfidoc-wt_taxhb.
1041   *    wa_idwtfidoc-wt_amrexmp1    = wa_idwtfidoc-wt_qsfhb
1042   *                                - wa_idwtfidoc-wt_taxhb.
1043   *  ELSE.
1044   *    wa_idwtfidoc-wt_amrexmp1    = wa_idwtfidoc-wt_qsfhb.
