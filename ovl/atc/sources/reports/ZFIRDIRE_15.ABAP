780    DEFINE check_ucomm.
781      case sscrfields-ucomm.
782        when 'UCOMM01'.
783          if p_bas eq ' '.
784            p_bas = 'X'.
785            p_opc = 'X'.
786            p_cta = space.
787          else.
788            p_bas = space.
789            p_opc = space.
790            p_cta = 'X'.
791          endif.
792        when 'UCOMM02'.
793          p_ope = space.
794          p_clo = 'X'.
795        when 'UCOMM03'.
796          p_ope = 'X'.
797          p_clo = space.
798        when 'UCOMM04'.
799          if p_bar eq ' '.
800            p_bar = 'X'.
801            p_ctr = space.
802          else.
803            p_bar = space.
804            p_ctr = 'X'.
805          endif.
806        when others.
807      endcase.
808    END-OF-DEFINITION.
