3102   *&---------------------------------------------------------------------*
3103   *       text
3104   *----------------------------------------------------------------------*
3105   *      -->P_MAN_QSTRMAIN  text
3106   *      <--P_SY_SUBRC  text
3107   *----------------------------------------------------------------------*
3108   *&---------------------------------------------------------------------*
3109   *&      Form  filter_boe
3110   *&---------------------------------------------------------------------*
3111   *       text
3112   *----------------------------------------------------------------------*
3113   *      -->P_MAN_QSTRMAIN  text
3114   *      <--P_SY_SUBRC  text
3115   *----------------------------------------------------------------------*
3116   FORM filter_boe TABLES   p_man_qstrmain STRUCTURE man_qstrmain
3117                   CHANGING subrc.
3118
3119   * Data - Local
3120   *  DATA: t_bseg TYPE bseg OCCURS 10 WITH HEADER LINE  .
3121   *Filter BOE items based on due dates.
3122   *  LOOP at p_man_qstrmain where umsks = 'W'.
3123   *    if not  p_man_qstrmain-zfbdt in p_budat.
3124   *     delete table p_man_qstrmain.
3125   *    endif.
3126   *  ENDLOOP.
3127
3128
3129   * P_man_Qstermain already holds all BOE documents.
3130     LOOP AT p_man_qstrmain.
3131   * Search BOE table for relevant record...
3132       " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
3133   *    SELECT SINGLE  belnr buzei FROM bsed INTO (bsed-belnr,bsed-buzei)
3134   *        WHERE bukrs = p_man_qstrmain-bukrs
3135   *          AND belnr = p_man_qstrmain-belnr
3136   ** Note 745528
3137   **          AND buzei = p_man_qstrmain-buzei        " note # 670694
3138   *          AND gjahr = p_man_qstrmain-gjahr
3139   *          AND regio IN p_regio.
3140       SELECT belnr buzei FROM bsed   UP TO 1 ROWS INTO (bsed-belnr ,
3141      bsed-buzei) WHERE bukrs = p_man_qstrmain-bukrs AND belnr =
3142      p_man_qstrmain-belnr AND gjahr = p_man_qstrmain-gjahr AND regio IN
3143      p_regio  ORDER BY  bukrs belnr gjahr buzei .   ENDSELECT.
3144       " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC
3145   * A bill of exchange document is found.
3146       IF sy-subrc = 0.
3147         " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
3148   *      SELECT SINGLE zfbdt INTO bseg-zfbdt FROM bseg
3149   *      WHERE bukrs = p_man_qstrmain-bukrs
3150   *      AND   belnr = bsed-belnr
3151   *      AND   gjahr = p_man_qstrmain-gjahr
3152   *      AND   buzei = bsed-buzei
3153   *** Note no. 912749 Begin
3154         SELECT SINGLE  duecalculationbasedate AS zfbdt FROM
3155        i_operationalacctgdocitem WHERE companycode = @p_man_qstrmain-bukrs AND
3156        accountingdocument = @bsed-belnr AND fiscalyear = @p_man_qstrmain-gjahr
3157        AND accountingdocumentitem = @bsed-buzei AND specialgltransactiontype =
3158        'W' AND duecalculationbasedate IN @p_budat INTO @bseg-zfbdt .
3159         " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC
3160   * if the document is not within the due dates entered, delete it.
3161         IF sy-subrc NE 0.
3162           DELETE TABLE p_man_qstrmain.
3163         ELSE.
3164   *Move the due date to the internal table.
3165           p_man_qstrmain-zfbdt = bseg-zfbdt.
3166           MODIFY p_man_qstrmain.
3167         ENDIF.
3168       ENDIF.
3169     ENDLOOP.
3170   *      ELSE.
3171   ** Move the due date to internal table.
3172   *        p_man_qstrmain-zfbdt = bseg-zfbdt.
3173   *        MODIFY p_man_qstrmain TRANSPORTING zfbdt.
3174   *      ENDIF.
3175   *    ENDIF.
3176   *  ENDLOOP.
3177   * To select BOE's whose due date fall within the selection dates that
3178   * not there in p_qstrmain internal table.
3179   *  SELECT * FROM bseg INTO TABLE t_bseg
3180   *          WHERE bukrs IN p_bukrs
3181   *            AND koart = 'K'
3182   *            AND umsks = 'W'
3183   *            AND shkzg = 'H'
3184   *            AND zfbdt IN p_budat.
3185   *  IF sy-subrc = 0.
3186   ** Do not proceed if entry is already present in man_qstrmain table.
3187   ** itab read  does not include Buzei as the line item number of
3188   ** internal table is different from bseg line item number.
3189   *    LOOP AT t_bseg .
3190   *      READ TABLE p_man_qstrmain WITH KEY bukrs = t_bseg-bukrs
3191   *                                         belnr = t_bseg-belnr
3192   *                                         gjahr = t_bseg-gjahr.
3193   ** If record is already there in internal table, do not proceed.
3194   *      CHECK sy-subrc NE 0.
3195   ** Add new records to the internal table based on due dates.
3196   *      SELECT SINGLE * FROM bkpf
3197   *          WHERE bukrs = t_bseg-bukrs
3198   *            AND belnr = t_bseg-belnr
3199   *            AND gjahr = t_bseg-gjahr
3200   *            AND stgrd = ' ' .          " BOE document was reversed
3201   *      IF sy-subrc NE 0 .
3202   *        CONTINUE.                      " Skip these records.
3203   *      ENDIF.
3204   **Get base amounts from Normal Vendor line of BSEG document
3205   *      SELECT SINGLE dmbtr wrbtr INTO (bseg-dmbtr,bseg-wrbtr)
3206   *       FROM    bseg  WHERE
3207   *               bukrs = t_bseg-bukrs
3208   *           AND belnr = t_bseg-belnr
3209   *           AND gjahr = t_bseg-gjahr
3210   *           AND augbl = t_bseg-belnr
3211   *           AND umsks = ' '
3212   *           AND koart = 'K'
3213   *           AND lifnr = t_bseg-lifnr .
3214   *      t_bseg-dmbtr = bseg-dmbtr.
3215   *      t_bseg-wrbtr = bseg-wrbtr.
3216   *      MODIFY t_bseg TRANSPORTING dmbtr wrbtr.
3217   *
3218   ** Get withholding data for BOE payment lines
3219   *      SELECT * FROM with_item
3220   *                WHERE     bukrs = t_bseg-bukrs
3221   *                  AND     belnr = t_bseg-belnr
3222   *                  AND     gjahr = t_bseg-gjahr
3223   *                  AND wt_withcd NE ' '
3224   *                  AND     koart = 'K'
3225   *                  AND   wt_acco = t_bseg-lifnr .
3226   *        IF sy-subrc = 0.
3227   *          CLEAR p_man_qstrmain.
3228   *          MOVE-CORRESPONDING with_item TO p_man_qstrmain.
3229   *          MOVE-CORRESPONDING t_bseg    TO p_man_qstrmain.
3230   *          MOVE-CORRESPONDING bkpf      TO p_man_qstrmain.
3231   *          p_man_qstrmain-zfbdt  = t_bseg-zfbdt .
3232   *          p_man_qstrmain-partnerno = with_item-wt_acco.
3233   *
3234   *
3235   *
3236   ** If invoice is posted with no withholding tax codes,amounts are zero
3237   ** in with_item table, so pick BSEG base values for exemption
3238   *        IF p_man_qstrmain-wt_qsshh = 0 AND p_man_qstrmain-wt_qsshb = 0.
3239   *            p_man_qstrmain-wt_qsfhh = t_bseg-dmbtr.
3240   *            p_man_qstrmain-wt_qsfhb = t_bseg-wrbtr.
3241   *          ELSE.
3242   *            p_man_qstrmain-wt_qsfhh = t_bseg-dmbtr -
3243   *                                      p_man_qstrmain-wt_qsshh.
3244   *            p_man_qstrmain-wt_qsfhb = t_bseg-wrbtr -
3245   *                                      p_man_qstrmain-wt_qsshb.
3246   *          ENDIF.
3247   *          APPEND p_man_qstrmain.
3248   *        ENDIF.
3249   *      ENDSELECT.                       " With_item
3250   *    ENDLOOP.                           " Loop at t_bseg
3251   *  ENDIF.
3252   *
3253     DESCRIBE TABLE p_man_qstrmain LINES sy-tfill.
3254     IF sy-tfill = 0.
3255       subrc = 4 .
3256     ENDIF.
3257   *
3258   *
3259
3260   ENDFORM.                               " filter_boe
