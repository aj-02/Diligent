247    *&      Form  I01_CHECK_COMPANY_CODE                                   *
248    *&---------------------------------------------------------------------*
249    *       Checks company codes
250    *----------------------------------------------------------------------*
251    FORM i01_check_company_codes.
252
253    *------- Check if there are selected values ----------------------------
254      DESCRIBE TABLE p_bukrs LINES sy-tfill.
255      CHECK sy-tfill NE 0.                 " only if selected comp.codes
256
257    *------- Check if comp. code low and high values exist -----------------
258      LOOP AT p_bukrs.
259
260        IF NOT p_bukrs-low IS INITIAL.
261          SELECT SINGLE * FROM t001 WHERE bukrs = p_bukrs-low.
262          IF sy-subrc <> 0.
263            SET CURSOR FIELD 'P_BUKRS-LOW'.
264            MESSAGE e165(f5) WITH p_bukrs-low.
265          ENDIF.
266    * 17092001 - BoD Allow same company in different country selection
267    *     IF t001-land1 NE p_land1.
268    *       SET CURSOR FIELD 'P_BUKRS-LOW'.
269    *       MESSAGE e025(id_wt) WITH p_bukrs-low p_land1.
270    *     ENDIF.
271    * 17092001 - EoD Allow same company in different country selection
272        ENDIF.
273        IF NOT p_bukrs-high IS INITIAL.
274          SELECT SINGLE * FROM t001 WHERE bukrs = p_bukrs-high.
275          IF sy-subrc <> 0.
276            SET CURSOR FIELD 'P_BUKRS-HIGH'.
277            MESSAGE e165(f5) WITH p_bukrs-high.
278          ENDIF.
279    * 17092001 - BoD Allow same company in different country selection
280    *     IF t001-land1 NE p_land1.
281    *       SET CURSOR FIELD 'P_BUKRS-HIGH'.
282    *       MESSAGE e025(id_wt) WITH p_bukrs-high p_land1.
283    *     ENDIF.
284    * 17092001 - EoD Allow same company in different country selection
285        ENDIF.
286
287    * It's necessary to work in a common currency : either all companies
288    * have the same or an alternative currency must be chosen.
289
290        IF wa_hwaer IS INITIAL.
291          MOVE space TO wa_alcur_needed.
292          MOVE t001-waers  TO wa_hwaer.
293        ELSE.
294          IF wa_hwaer <> t001-waers AND
295             p_alcur IS INITIAL.
296            wa_alcur_needed = 'X'.
297          ENDIF.
298        ENDIF.
299
300      ENDLOOP.
301
302    ENDFORM.                               " I01_CHECK_COMPANY_CODES
