3965
3966     DATA: lc_tcode  LIKE sy-tcode,
3967           lc_belnr  LIKE bkpf-belnr,
3968           v_lineas5 LIKE sy-tabix.
3969     v_lineas5 = 0.
3970     v_text_det = ''.
3971     CASE iv_ucomm.
3972       WHEN '&IC1'.
3973         CASE rs_selfield-tabname.
3974           WHEN c_itab1.
3975             CASE p_frmat.
3976               WHEN zdi00_1001.
3977                 READ TABLE t_totnit_alv INDEX rs_selfield-tabindex.
3978                 IF sy-subrc EQ 0.
3979                   IF v_tabla = 'X'.
3980
3981                     CASE rs_selfield-fieldname.
3982                       WHEN  'LIFNR'.
3983                         IF t_totnit_alv-lifnr <> ''.
3984                           READ TABLE t_totnit_alv
3985                             INDEX rs_selfield-tabindex.
3986                           IF sy-subrc EQ 0.
3987                             "Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
3988   *                          SET PARAMETER: ID 'LIF'
3989   *                                         FIELD t_totnit_alv-lifnr,
3990   *                                         ID 'BUK' FIELD p_bukrs.
3991   *                          CALL TRANSACTION 'FK03'
3992   *                               AND SKIP FIRST SCREEN.
3993                             SELECT partner FROM v_cvi_vend_link
