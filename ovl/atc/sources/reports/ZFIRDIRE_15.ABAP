3887         WHEN 'T'.
3888           lt_fieldcat-reptext_ddic = p_value.
3889           lt_fieldcat-seltext_l    = p_value.
3890           lt_fieldcat-seltext_m    = p_value.
3891           lt_fieldcat-seltext_s    = p_value.
3892         WHEN 'O'.
3893           CASE p_value.
3894             WHEN 'X'.
3895               lt_fieldcat-key = zdi00_check.
3896               lt_fieldcat-key_sel = zdi00_check.
3897             WHEN 'F'.
3898               lt_fieldcat-key = zdi00_check.
