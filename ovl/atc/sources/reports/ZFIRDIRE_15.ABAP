963    DEFINE assign_range.
964      loop at &1 where option eq 'BT'.
965        gc_nitl = &1-low.
966        gc_nith = &1-high.
967        clear &1-high.
968        while gc_nitl le gc_nith.
969          &1-option = 'EQ'.
970          &1-low = gc_nitl.
971          append &1.
972          add 1 to gc_nitl.
973          condense gc_nitl.
974        endwhile.
975      endloop.
976      delete &1 where option eq 'BT'.
977    END-OF-DEFINITION.
