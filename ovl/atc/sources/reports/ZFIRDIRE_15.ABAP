5204   *      -->V_NIT      text
5205   *      -->V_DIG      text
5206   *----------------------------------------------------------------------*
5207   FORM calculo_digito_v USING nit
5208          CHANGING v_dig.
5209     DATA: BEGIN OF arreglo,
5210             pa1(2)  TYPE n,                                      "  = 71
5211             pa2(2)  TYPE n,                                      "  = 67
5212             pa3(2)  TYPE n,                                      "  = 59
5213             pa4(2)  TYPE n,                                      "  = 53
5214             pa5(2)  TYPE n,                                      "  = 47
5215             pa6(2)  TYPE n,                                      "  = 43
5216             pa7(2)  TYPE n,                                      "  = 41
5217             pa8(2)  TYPE n,                                      "  = 37
5218             pa9(2)  TYPE n,                                      "  = 29
5219             pa10(2) TYPE n,                                     " = 23
5220             pa11(2) TYPE n,                                     " = 19
5221             pa12(2) TYPE n,                                     " = 17
5222             pa13(2) TYPE n,                                     " = 13
5223             pa14(2) TYPE n,                                     " = 7
5224             pa15(2) TYPE n,                                     " = 3
5225           END OF arreglo.
5226     arreglo-pa1 = 71.
5227     arreglo-pa2 = 67.
5228     arreglo-pa3 = 59.
5229     arreglo-pa4 = 53.
5230     arreglo-pa5 = 47.
5231     arreglo-pa6 = 43.
5232     arreglo-pa7 = 41.
5233     arreglo-pa8 = 37.
5234     arreglo-pa9 = 29.
5235     arreglo-pa10  = 23.
5236     arreglo-pa11  = 19.
5237     arreglo-pa12  = 17.
5238     arreglo-pa13  = 13.
5239     arreglo-pa14  = 7.
5240     arreglo-pa15  = 3.
5241     DATA: wsuma TYPE i,
5242           valor TYPE i.
5243     DATA:  v_mod(4) TYPE n.
5244     valor = nit(1).
5245     wsuma = wsuma + ( valor * arreglo-pa1 ).
5246     valor = nit+1(1).
5247     wsuma = wsuma + ( valor * arreglo-pa2 ).
5248     valor = nit+2(1).
5249     wsuma = wsuma + ( valor * arreglo-pa3 ).
5250     valor = nit+3(1).
5251     wsuma = wsuma + ( valor * arreglo-pa4 ).
5252     valor = nit+4(1).
5253     wsuma = wsuma + ( valor * arreglo-pa5 ).
5254     valor = nit+5(1).
5255     wsuma = wsuma + ( valor * arreglo-pa6 ).
5256     valor = nit+6(1).
5257     wsuma = wsuma + ( valor * arreglo-pa7 ).
5258     valor = nit+7(1).
5259     wsuma = wsuma + ( valor * arreglo-pa8 ).
5260     valor = nit+8(1).
5261     wsuma = wsuma + ( valor * arreglo-pa9 ).
5262     valor = nit+9(1).
5263     wsuma = wsuma + ( valor * arreglo-pa10 ).
5264     valor = nit+10(1).
5265     wsuma = wsuma + ( valor * arreglo-pa11 ).
5266     valor = nit+11(1).
5267     wsuma = wsuma + ( valor * arreglo-pa12 ).
5268     valor = nit+12(1).
5269     wsuma = wsuma + ( valor * arreglo-pa13 ).
5270     valor = nit+13(1).
5271     wsuma = wsuma + ( valor * arreglo-pa14 ).
5272     valor = nit+14(1).
5273     wsuma = wsuma + ( valor * arreglo-pa15 ).
5274     v_mod = wsuma MOD 11.
5275     IF v_mod = 0.
5276       v_dig = 0.
5277     ELSEIF v_mod = 1.
5278       v_dig = 0.
5279     ELSE.
5280       v_dig = 11 - v_mod.
5281     ENDIF.
5282   ENDFORM.                    "digito
