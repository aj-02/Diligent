7490   FORM get_sakan USING p_bu.
7491     CLEAR ska1.
7492     IF p_bu NE t001-bukrs.
7493       LOOP AT ht001
7494         WHERE bukrs = p_bu.
7495         MOVE-CORRESPONDING ht001 TO t001.
7496         EXIT.
7497       ENDLOOP.
7498       IF sy-subrc NE 0.
7499         SELECT SINGLE * FROM t001
7500           WHERE bukrs = p_bu.
7501         IF sy-subrc = 0.
7502           MOVE-CORRESPONDING t001 TO ht001.
7503           APPEND ht001.
7504         ELSE.
7505
7506   *    Schreiben Protokollsatz
7507           CLEAR fimsg.
7508           fimsg-msort = '0001'.
7509           fimsg-msgid = 'FR'.
7510           fimsg-msgty = 'I'.
7511           fimsg-msgno = '321'.
7512           fimsg-msgv1 = p_bu.
7513
7514           CALL FUNCTION 'FI_MESSAGE_COLLECT'
7515             EXPORTING
7516               i_fimsg       = fimsg
7517               i_xappn       = ' '
7518             EXCEPTIONS
7519               msgid_missing = 01
7520               msgno_missing = 02
7521               msgty_missing = 03.
7522           IF sy-subrc NE 0.
7523             MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
7524                     WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
7525           ENDIF.
7526         ENDIF.
7527       ENDIF.
7528     ENDIF.
7529     LOOP AT sakantab
7530       WHERE ktopl = t001-ktopl
7531       AND   saknr = abstkont.
7532       ska1-sakan = sakantab-sakan.
7533       EXIT.
7534     ENDLOOP.
7535     IF sy-subrc NE 0.
7536       " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
7537       SELECT SINGLE * FROM ska1          "#EC CI_DB_OPERATION_OK[2389136]
7538         WHERE ktopl = t001-ktopl         "#EC CI_DB_OPERATION_OK[2431747]
7539         AND   saknr = abstkont.
7540       " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC
7541       IF sy-subrc = 0.
7542         MOVE: ska1-ktopl TO sakantab-ktopl,
7543               ska1-saknr TO sakantab-saknr,
7544               ska1-sakan TO sakantab-sakan.
7545         APPEND sakantab.
7546       ELSE.
7547         CLEAR fimsg.
7548         fimsg-msort = '0005'.
7549         fimsg-msgid = 'FR'.
7550         fimsg-msgty = 'I'.
7551         fimsg-msgno = '322'.
7552         fimsg-msgv1 = abstkont.
7553         fimsg-msgv2 = bsik-bukrs.
7554
7555         CALL FUNCTION 'FI_MESSAGE_COLLECT'
7556           EXPORTING
7557             i_fimsg       = fimsg
7558             i_xappn       = ' '
7559           EXCEPTIONS
7560             msgid_missing = 01
7561             msgno_missing = 02
7562             msgty_missing = 03.
7563         IF sy-subrc NE 0.
7564           MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
7565                   WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
7566         ENDIF.
7567       ENDIF.
7568     ENDIF.
7569
7570   ENDFORM.                    " GET_SAKAN
