7335   FORM initial_cta.
7336
7337     MOVE: 'I'  TO r_docmm-sign,
7338           'EQ' TO r_docmm-option,
7339           'I'  TO r_docfi-sign,
7340           'EQ' TO r_docfi-option,
7341           'I'  TO r_docvf-sign,
7342           'EQ' TO r_docvf-option,
7343           'I'  TO r_vendor-sign,
7344           'EQ' TO r_vendor-option.
7345
7346     IF p_cncpt IS INITIAL AND p_bas EQ zdi00_check.
7347       SELECT  * INTO TABLE t_zdicta
7348         FROM  zdicta
7349        WHERE  gjahr  = p_gjahr
7350          AND  frmat  = p_frmat
7351          AND  cncpt IN s_cncpt
7352          AND  bukrs  = p_bukrs
7353          AND  activ  = zdi00_check.
7354       IF sy-subrc NE 0.
7355         SELECT  * INTO TABLE t_zdicta
7356           FROM  zdicta
7357          WHERE  gjahr  = p_gjahr
7358            AND  frmat  = p_frmat
7359            AND  cncpt IN s_cncpt
7360            AND  bukrs  = space
7361            AND  activ  = zdi00_check.
7362       ENDIF.
7363       IF sy-subrc EQ 0.
7364         MOVE 'I'  TO s_hkont-sign.
7365         MOVE 'EQ' TO s_hkont-option.
7366         LOOP AT t_zdicta.
7367           MOVE t_zdicta-cncpt TO t_ctacpt-cncpt.
7368           IF t_zdicta-hkoto IS INITIAL.
7369             MOVE t_zdicta-hkofr TO s_hkont-low.
7370             COLLECT s_hkont.
7371             MOVE s_hkont-low TO t_ctacpt-hkont.
7372             INSERT TABLE t_ctacpt.
7373           ELSE.
7374             " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
7375   *          SELECT saknr INTO s_hkont-low                   "#EC PORTABLE
7376   *            FROM ska1           "#EC CI_SGLSELECT           "#EC CI_XYZ
7377   *           WHERE ktopl = t001-ktopl
7378   *             AND saknr BETWEEN t_zdicta-hkofr AND t_zdicta-hkoto.
7379             SELECT  glaccount AS saknr FROM i_glaccountinchartofaccounts WHERE
7380            chartofaccounts = @t001-ktopl AND glaccount BETWEEN @t_zdicta-hkofr AND
7381            @t_zdicta-hkoto INTO @s_hkont-low .
7382               " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC
7383               COLLECT s_hkont.
7384               MOVE s_hkont-low TO t_ctacpt-hkont.
7385               INSERT TABLE t_ctacpt.
7386             ENDSELECT.
7387           ENDIF.
7388         ENDLOOP.
7389         SORT s_hkont.
7390       ELSE.
7391         IF p_frmat EQ zdi00_1001.
7392           v_no_cta = 'X'.
7393         ELSE.
7394           MESSAGE i021(zdimsg).
7395           LEAVE LIST-PROCESSING.
7396         ENDIF.
7397       ENDIF.
7398       r_cncpt[] = s_cncpt[].
7399     ELSE.
7400       IF p_cncpt IS INITIAL.
7401         MESSAGE i021(zdimsg).
7402         LEAVE LIST-PROCESSING.
7403       ENDIF.
7404       MOVE p_cncpt TO r_cncpt-low.
7405       APPEND r_cncpt.
7406   ***** si se selecciona un concepto y unas cuentas por parametros de
7407   ***** adicionales
7408       IF p_frmat = zdi00_1001.
7409         LOOP AT s_hkont.
7410           CLEAR t_zdicta.
7411           t_zdicta-hkofr = s_hkont-low.
7412           t_zdicta-hkoto = s_hkont-high.
7413           t_zdicta-cncpt = p_frmat.
7414           APPEND t_zdicta.
7415         ENDLOOP.
7416         REFRESH s_hkont.
7417         MOVE 'I'  TO s_hkont-sign.
7418         MOVE 'EQ' TO s_hkont-option.
7419         LOOP AT t_zdicta.
7420           MOVE t_zdicta-cncpt TO t_ctacpt-cncpt.
7421           IF t_zdicta-hkoto IS INITIAL.
7422             MOVE t_zdicta-hkofr TO s_hkont-low.
7423             COLLECT s_hkont.
7424             MOVE s_hkont-low TO t_ctacpt-hkont.
7425             INSERT TABLE t_ctacpt.
7426           ELSE.
7427             " " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 05.06.2026  FOR ATC
7428   *          SELECT saknr INTO s_hkont-low                   "#EC PORTABLE
7429   *            FROM ska1                "#EC CI_SGLSELECT      "#EC CI_XYZ
7430   *           WHERE ktopl = t001-ktopl
7431   *             AND saknr BETWEEN t_zdicta-hkofr AND t_zdicta-hkoto.
7432             SELECT  glaccount AS saknr FROM i_glaccountinchartofaccounts WHERE
7433            chartofaccounts = @t001-ktopl AND glaccount BETWEEN @t_zdicta-hkofr AND
7434            @t_zdicta-hkoto INTO @s_hkont-low .
7435               " " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 05.06.2026 FOR ATC
7436               COLLECT s_hkont.
7437               MOVE s_hkont-low TO t_ctacpt-hkont.
7438               INSERT TABLE t_ctacpt.
7439             ENDSELECT.
7440           ENDIF.
7441         ENDLOOP.
7442         SORT s_hkont.
7443       ENDIF.
7444
7445   *****
7446     ENDIF.
7447
7448     IF p_frmat NE zdi00_1007.
7449       r_frmat-low = p_frmat.
7450     ENDIF.
7451     APPEND r_frmat.
7452
7453     WRITE s_budat-low DD/MM/YYYY TO gc_begda.
7454     WRITE s_budat-high DD/MM/YYYY TO gc_endda.
7455
7456   ENDFORM.                    " initial_cta
