371    *&      Form  I01_CHECK_BUS_PLACE                                      *
372    *&---------------------------------------------------------------------*
373    *&      Checks if the business place component is active for the given
374    *&      country and if the business places exist for the company code
375    *&---------------------------------------------------------------------*
376    FORM i01_check_bus_place.
377
378      IF NOT p_bupla-low IS INITIAL OR
379         NOT p_bupla-high IS INITIAL.
380
381        SELECT * FROM t001 WHERE bukrs IN p_bukrs.
382
383          CALL FUNCTION 'J_1BSA_COMPONENT_ACTIVE'
384            EXPORTING
385              bukrs                = t001-bukrs
386              component            = '**'
387            EXCEPTIONS
388              component_not_active = 1.
389          IF sy-subrc = 1.
390            SET CURSOR FIELD 'P_BUPLA-LOW'.
391            MESSAGE e001(id_wt).
392          ELSE.
393
394            IF NOT p_bupla-low IS INITIAL.
395              SELECT SINGLE * FROM j_1bbranch INTO @DATA(ls_bbranch) WHERE bukrs  = @t001-bukrs "#EC CI_USAGE_OK[3404390]
396                                              AND branch = @p_bupla-low.
397              IF sy-subrc <> 0.
398                SET CURSOR FIELD 'P_BUPLA-LOW'.
399                MESSAGE e562(icc-kr) WITH p_bupla-low t001-bukrs.
400              ENDIF.
401            ENDIF.
402            IF NOT p_bupla-high IS INITIAL.
403              SELECT SINGLE * FROM j_1bbranch INTO ls_bbranch WHERE bukrs  = t001-bukrs "#EC CI_USAGE_OK[3404390]
404                                            AND branch = p_bupla-high.
405              IF sy-subrc <> 0.
406                SET CURSOR FIELD 'P_BUPLA-HIGH'.
407                MESSAGE e562(icc-kr) WITH p_bupla-high t001-bukrs.
408              ENDIF.
409            ENDIF.
410          ENDIF.
411        ENDSELECT.
412      ENDIF.
