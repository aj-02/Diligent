2596   FORM i01_express_with_factor.
2597
2598
2599     IF wa_idwtglob-wt_sc_unit IS INITIAL OR
2600        wa_idwtglob-wt_sc_unit EQ 0       OR
2601        wa_idwtglob-wt_sc_unit EQ 1.
2602       EXIT.
2603     ELSE.
2604
2605       DIVIDE wa_qstrmain-dmbtr    BY wa_idwtglob-wt_sc_unit.
2606       DIVIDE wa_qstrmain-wrbtr    BY wa_idwtglob-wt_sc_unit.
2607       DIVIDE wa_qstrmain-wt_qsfhh BY wa_idwtglob-wt_sc_unit.
2608       DIVIDE wa_qstrmain-wt_qsfhb BY wa_idwtglob-wt_sc_unit.
2609       DIVIDE wa_qstrmain-wt_qbshh BY wa_idwtglob-wt_sc_unit.
2610       DIVIDE wa_qstrmain-wt_qbshb BY wa_idwtglob-wt_sc_unit.
2611       DIVIDE wa_qstrmain-wt_qsshh BY wa_idwtglob-wt_sc_unit.
2612       DIVIDE wa_qstrmain-wt_qsshb BY wa_idwtglob-wt_sc_unit.
2613       DIVIDE wa_qstrmain-wt_nethh BY wa_idwtglob-wt_sc_unit.
2614       DIVIDE wa_qstrmain-wt_nethb BY wa_idwtglob-wt_sc_unit.
2615       DIVIDE wa_qstrmain-wt_taxhh BY wa_idwtglob-wt_sc_unit.
2616       DIVIDE wa_qstrmain-wt_taxhb BY wa_idwtglob-wt_sc_unit.
2617       DIVIDE wa_qstrmain-sknto    BY wa_idwtglob-wt_sc_unit.
2618       DIVIDE wa_qstrmain-wskto    BY wa_idwtglob-wt_sc_unit.
2619
2620     ENDIF.
