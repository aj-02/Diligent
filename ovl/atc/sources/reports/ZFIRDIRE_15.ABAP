212    AT SELECTION-SCREEN.
213      perform check_autorizacion using p_bukrs-low.
214    * Validation LIFNR
215      IF p_opc3 = 'X'.
216    **    IF s_terce IS NOT INITIAL.
217    **      p_opc3 = ''.
218    **    ENDIF.
219    * Validacion de Fechas:
220    * Solo se permite generar meses completos, y año completo. Cualquier
221    * otra selección: No actualizará las tablas.
222        IF p_budat-low+6(2) <> '01'.
223          p_opc3 = ''.
224        ENDIF.
225        DATA: v_fecha LIKE sy-datum.
226        CALL FUNCTION 'RP_LAST_DAY_OF_MONTHS'
227          EXPORTING
228            day_in            = p_budat-high
229          IMPORTING
230            last_day_of_month = v_fecha
231          EXCEPTIONS
232            day_in_no_date    = 1
233            OTHERS            = 2.
234
235        IF p_budat-low+4(2) <> p_budat-high+4(2).
236          IF p_budat-low+4(2) <> '01'
237             OR p_budat-high+4(2) <> '12' .
238            p_opc3 = ''.
239          ENDIF.
240        ENDIF.
241        IF p_budat-high+6(2) <> v_fecha+6(2).
242          p_opc3 = ''.
243        ENDIF.
244        IF p_opc3 = ''.
245          message s080(zdimsg) with text-097
246                                    "'Rango fechas no permitido,'
247                                    text-098.
248                                    "'para actualización de Tablas.'.
249        ENDIF.
