2273   *---------------------------------------------------------------------*
2274   *       FORM KALENDERWOCHE_ERMITTELN                                  *
2275   *---------------------------------------------------------------------*
2276   *       Hier wird ermittelt, ob auf die 52.Kalenderwoche noch eine    *
2277   *       53.Woche folgt oder nicht. Dabei wird wie folgt vorgegangen:  *
2278   *       Solange die 52.Woche nicht erreicht ist, kann zur Woche immer *
2279   *       eine Woche addiert werden, ohne daß es Probleme mit dem       *
2280   *       Jahreswechsel gibt. Ist die 52.Woche erreicht, wird geprüft,  *
2281   *       ob es eine 53.Woche gibt. Wenn ja, wird sie noch gesetzt.     *
2282   *       Wenn nein, folgt auf die 52.Woche die 1.Woche des neuen       *
2283   *       Jahres.
2284   *---------------------------------------------------------------------*
2285   FORM kalenderwoche_ermitteln.
2286     DATA: ke_week LIKE s031-spwoc,
2287           ke_datum LIKE sy-datlo.
2288
2289     IF flg_periotab = true.
2290       ke_week = periotab-low.
2291     ELSE.
2292       ke_week = zeitr-low.
2293     ENDIF.
2294
2295     CALL FUNCTION 'WEEK_GET_FIRST_DAY'
2296       EXPORTING
2297         week = ke_week
2298       IMPORTING
2299         date = ke_datum.
2300
2301     ke_datum = ke_datum + 7.
2302     CLEAR ke_week.
2303
2304     CALL FUNCTION 'DATE_GET_WEEK'
2305       EXPORTING
2306         date = ke_datum
2307       IMPORTING
2308         week = ke_week.
2309
2310     IF ke_week+4(2) = '53'.
2311       IF flg_periotab = true.
2312         periotab-low = ke_week.
2313       ELSE.
2314         zeitr-low = ke_week.
2315       ENDIF.
2316     ELSE.
2317       IF flg_periotab = true.
2318         periotab-low+4(2) = '01'.
2319         periotab-low(4) = periotab-low(4) + 1.
2320       ELSE.
2321         zeitr-low+4(2) = '01'.
2322         zeitr-low(4) = zeitr-low(4) + 1.
2323       ENDIF.
2324     ENDIF.
2325   ENDFORM.                               "kalenderwoche_ermitteln
