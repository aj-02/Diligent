492    *---------------------------------------------------------------------*
493    *       FORM analyse_wechseln_mit_belegnr                            *
494    *---------------------------------------------------------------------*
495    *       IS-Wechsel mit Belegnummern.                                  *
496    *
497    *  Bem: Das Flag flg_gsa wird nicht mit übergeben, weil es nicht
498    *       notwendig ist. Hier wird mit der eindeutigen Belegnr.
499    *       gesprungen!
500    *---------------------------------------------------------------------*
501    FORM ANALYSE_WECHSELN_MIT_BELEGNR.
502
503      DATA: AW_FIELD         LIKE SELTAB_SEL-FIELD,
504            AW_HLP_MCINF     LIKE TMC4-MCINF,
505            AW_FLG_SELSCREEN TYPE BOOLEAN,
506            AW_HLP_TEXT      LIKE RSEU1-MENU_SHORT,
507            AW_FELDNAME(20).
508
509    * Selektionstabellen füllen, unabh. von Cursor und Drilldown.
510    * Bem: der aktuelle Drilldown ist nicht notwendig, da später die
511    * Belegnr. aus der aus_s000 gelesen werden und diese als Selektions-
512    * kriterium (zumindest für ein Werk eindeutig ist).
513      PERFORM SELEKTIONSTABELLEN_FUELLEN
514                  USING FALSE.
515    * Löschen der Exception aus seltab_sel (falls gefüllt)
516      READ TABLE SELTAB_SEL WITH KEY FIELD = 'EXC_NO'.
517      CLEAR SELTAB_SEL-SIGN.
518      CLEAR SELTAB_SEL-OPTION.
519      CLEAR SELTAB_SEL-LOW.
520      CLEAR SELTAB_SEL-HIGH.
521      MODIFY SELTAB_SEL INDEX SY-TABIX.
522    * Vorsicht!! Da nicht garantiert ist, ob die Belegnr. werksübergreifend
523    * eindeutig ist, werden alle Selektionen, außer zu Werk, gelöscht,
524    * weil sonst beim Sprung in eine positionsgenaue Struktur nur
525    * Positionen selektiert werden. Es soll aber mit den gesamten Belegen
526    * gesprungen werden.
527      READ TABLE DRILLDOWN_FCODES WITH KEY DDICFELD = 'WERKS'.
528      IF SY-SUBRC <> 0.
529        CLEAR DRILLDOWN_FCODES.
530      ENDIF.
531      LOOP AT SELTAB_SEL.
532        IF SELTAB_SEL-FIELD(3) = 'DD_'.
533          IF SELTAB_SEL-FIELD+3 NE DRILLDOWN_FCODES-RANGES_SUF.
534    *          Alle, nur nicht das Werk
535            CLEAR SELTAB_SEL-SIGN.
536            CLEAR SELTAB_SEL-OPTION.
537            CLEAR SELTAB_SEL-LOW.
538            CLEAR SELTAB_SEL-HIGH.
539            MODIFY SELTAB_SEL.
540          ENDIF.
541        ENDIF.
542      ENDLOOP.
543    * Feldname von VIC-Merkmal bestimmen (tmc1k-stfna)
544      SELECT SINGLE * FROM TMC1K WHERE GSTRU = TMC4-GSTRU
545                                   AND LFNR2 = '01'.
546
547    * Ranges_suf bestimmen
548      READ TABLE DRILLDOWN_FCODES WITH KEY DDICFELD = TMC1K-STFNA.
549      CONCATENATE 'DD_' DRILLDOWN_FCODES-RANGES_SUF INTO AW_FIELD.
550    * Lesen aller Belegnummern aus aus_s000 und schreiben in
551    * seltab_sel
552      CLEAR SELTAB_SEL.
553      SELTAB_SEL-FIELD  = AW_FIELD.
554      SELTAB_SEL-SIGN   = 'I'.
555      SELTAB_SEL-OPTION = 'EQ'.
556      LOOP AT AUS_S000.
557        SELTAB_SEL-LOW = AUS_S000-OBJEKT.
558        SELTAB_SEL-HIGH = SPACE.
559        APPEND SELTAB_SEL.
560      ENDLOOP.
561
562    * Muß seltab_sel sortiert sein.
563    * SORT seltab_sel BY field.
564
565
566
567
568    * Aufruf der Analyse.
569
570    * hier noch eigener Text, damit Benutzer weiß, daß spezieller Wechsel
571    * durchgeführt wird.
572      PERFORM TEXT_ERMITTELN USING    309
573    *                                 'Manuelle Selektion'
574                             CHANGING AW_HLP_TEXT.
575      PERFORM TEXT_ERMITTELN USING    311
576    *                              'Info-Struktur für Wechsel mit Belegnr.'
577                             CHANGING HLP_TEXT1.
578
579    * IF aw_flg_mehrfacher_aufruf = false.
580    *   Es handelt sich um den 1. Aufruf der Routine => Parameter für Popup
581    *   auf den Namen der Info-Struktur setzen
582    *    SET PARAMETER ID 'MCB' FIELD hlp_mcinf.
583    *    aw_flg_mehrfacher_aufruf = true.
584    *  ENDIF.
585
586      CALL FUNCTION 'MCS_MCINF_GET'
587           EXPORTING
588                I_FLG_ONLY_WITH_TABLE = TRUE
589                I_FUNCTION_TEXT       = AW_HLP_TEXT
590                I_TITLEBAR_TEXT       = HLP_TEXT1
591           IMPORTING
592                E_MCINF               = AW_HLP_MCINF
593                E_FLG_FREE_FCODE      = AW_FLG_SELSCREEN
594           EXCEPTIONS
595                NO_FIELD_SELECTED     = 1
596                OTHERS                = 2.
597
598      CHECK SY-SUBRC = 0.
599
600      CALL FUNCTION 'MCS_ANALYSE_CALL'
601           EXPORTING
602                I_MCINF                       = AW_HLP_MCINF
603                I_SPERI                       = SAV_SPERI
604                I_FLG_VIA_SELSCREEN           = AW_FLG_SELSCREEN
605                I_PERIV                       = SAV_PERIV
606                I_FLG_ANL_DEFAULT             = TRUE
607                I_CALL_PLANNING               = FALSE
608           TABLES
609                T_SEL                         = SELTAB_SEL
610                T_FIELDS                      = SELTAB_FIELDS
611           EXCEPTIONS
612                EVALUATIVE_INFO_STRUCTURE     = 1
613                INFO_STRUCTURE_NOT_GENERATED  = 2
614                NO_ANALYSIS_SELECTED          = 3
615                INFO_STRUCTURE_DOES_NOT_EXIST = 4
616                ANALYSE_DOES_NOT_EXIST        = 5
617                OTHERS                        = 6.
618      IF SY-SUBRC <> 0.
619    * MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
620    *         WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
621      ENDIF.
