7283   FORM ergaenzen_bestand.
7284
7285     TABLES: mara, marc.
7286
7287     DATA: eb_gsber LIKE t134h-gsber.
7288
7289     DATA: BEGIN OF eb_mara.
7290             INCLUDE STRUCTURE mara.
7291     DATA: END OF eb_mara.
7292
7293     DATA: BEGIN OF eb_marc.
7294             INCLUDE STRUCTURE marc.
7295     DATA: END OF eb_marc.
7296
7297     DATA: BEGIN OF eb_mbew.
7298             INCLUDE STRUCTURE mbew.
7299     DATA: END OF eb_mbew.
7300
7301     DATA: eb_tabix LIKE sy-tabix.
7302
7303     SORT int_s032 BY werks lgort matnr.
7304
7305     LOOP AT int_s031.
7306
7307       READ TABLE int_s032 WITH KEY mandt = int_s031-mandt
7308                                    ssour = int_s031-ssour
7309                                    vrsio = int_s031-vrsio
7310                                    werks = int_s031-werks
7311                                    lgort = int_s031-lgort
7312                                    matnr = int_s031-matnr
7313                                    BINARY SEARCH.
7314
7315       IF sy-subrc NE 0.
7316         eb_tabix = sy-tabix.
7317         CLEAR int_s032.
7318         MOVE-CORRESPONDING int_s031 TO int_s032.
7319         IF NOT int_s032-matnr IS INITIAL.
7320           IF int_s032-matnr <> eb_mara-matnr.
7321             SELECT SINGLE * FROM mara WHERE matnr = int_s032-matnr.
7322             IF sy-subrc = 0.
7323               MOVE-CORRESPONDING mara TO eb_mara.
7324               MOVE-CORRESPONDING eb_mara TO int_s032.
7325             ENDIF.
7326           ELSE.
7327             MOVE-CORRESPONDING eb_mara TO int_s032.
7328           ENDIF.
7329           IF ( eb_marc-matnr <> int_s032-matnr ) OR
7330                ( eb_marc-werks <> int_s032-werks ).
7331             SELECT SINGLE * FROM marc WHERE matnr = int_s032-matnr
7332                                         AND werks = int_s032-werks.
7333             IF sy-subrc = 0.
7334               MOVE-CORRESPONDING marc TO eb_marc.
7335               MOVE-CORRESPONDING eb_marc TO int_s032.
7336             ENDIF.
7337           ELSE.
7338             MOVE-CORRESPONDING eb_marc TO int_s032.
7339           ENDIF.
7340           IF NOT int_s031-lgort IS INITIAL.
7341             CLEAR int_s032-eisbe.
7342           ENDIF.
7343           IF ( eb_mbew-matnr <> int_s032-matnr ) OR
7344              ( t001w-werks <> int_s032-werks ).
7345             SELECT SINGLE * FROM t001w WHERE werks = int_s032-werks.
7346             IF t001w-bwkey <> eb_mbew-bwkey.
7347               SELECT SINGLE * FROM mbew WHERE matnr = int_s032-matnr
7348                                           AND bwkey = t001w-bwkey
7349                                           AND bwtar = space.
7350               IF sy-subrc = 0.
7351                 MOVE-CORRESPONDING mbew TO eb_mbew.
7352                 MOVE eb_mbew-bklas TO int_s032-bklas.
7353               ENDIF.
7354             ELSE.
7355               MOVE eb_mbew-bklas TO int_s032-bklas.
7356             ENDIF.
7357           ELSE.
7358             MOVE eb_mbew-bklas TO int_s032-bklas.
7359           ENDIF.
7360   * Geschäftsbereich ermitteln
7361           CALL FUNCTION 'CO_TA_T134H_READ'
7362             EXPORTING
7363               werks_imp       = int_s032-werks
7364               spart_imp       = int_s032-spart
7365             IMPORTING
7366               gsber_exp       = eb_gsber
7367             EXCEPTIONS
7368               entry_not_found = 01.
7369           IF sy-subrc = 0.
7370             int_s032-gsber = eb_gsber.
7371           ENDIF.
7372           IF int_s032-mtart IN sl_mtart AND
7373              int_s032-matkl IN sl_matkl AND
7374              int_s032-spart IN sl_spart AND
7375              int_s032-dispo IN sl_dispo AND
7376              int_s032-dismm IN sl_dismm AND
7377              int_s032-bklas IN gr_bklas AND
7378              int_s032-gsber IN sl_gsber.
7379             INSERT int_s032 INDEX eb_tabix.
7380           ENDIF.
7381         ENDIF.
7382       ENDIF.
7383     ENDLOOP.
7384
7385     IF NOT sl_mtart IS INITIAL OR
7386        NOT sl_matkl IS INITIAL OR
7387        NOT sl_spart IS INITIAL OR
7388        NOT sl_dispo IS INITIAL OR
7389        NOT sl_dismm IS INITIAL OR
7390        NOT gr_bklas IS INITIAL OR
7391        NOT sl_gsber IS INITIAL.
7392       DELETE int_s032
7393         WHERE NOT mtart IN sl_mtart
7394            OR NOT matkl IN sl_matkl
7395            OR NOT spart IN sl_spart
7396            OR NOT dispo IN sl_dispo
7397            OR NOT dismm IN sl_dismm
7398            OR NOT bklas IN gr_bklas
7399            OR NOT gsber IN sl_gsber.
7400     ENDIF.
7401
7402   ENDFORM.                               "ergaenzen_bestand
