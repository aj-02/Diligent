380          AA_END_ROW = AA_START_ROW + AA_POPUP_LENGTH.
381
382          PERFORM TEXT_ERMITTELN USING    099
383    *                                     'Alle Kennzahlen'
384                                 CHANGING HLP_TEXT1.
