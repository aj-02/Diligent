4924   *---------------------------------------------------------------------*
4925   *       FORM ZUSATZKENNZAHLEN_REICHWEITE                              *
4926   *---------------------------------------------------------------------*
4927   *       Es werden Zusatzkennzahlen zur Reichweite berechnet           *
4928   *       Hinweise zur Reichweitenberechnung:                           *
4929   *       Reichweite = Lagerbestand / mittl.Tagesverbrauch.             *
4930   *       Mittl.Tagesverbrauch =                                        *
4931   *       Summe Verbrauch / (Anzahl Perioden * Periodenlänge )          *
4932   *       Die Angabe der Kennzahl erfolgt also immer in Tagen           *
4933   *
4934   *---------------------------------------------------------------------*
4935   *  -->  KZ_EINTRAG                                                    *
4936   *---------------------------------------------------------------------*
4937   FORM zusatzkennzahlen_reichweite CHANGING kz_eintrag STRUCTURE aus_s000.
4938     DATA:  zr_verbrauch TYPE f,
4939            zr_reichweit TYPE f,
4940            zr_verbrwert TYPE f,
4941            zr_periodenlaenge TYPE i,
4942            zr_monat     TYPE d.
4943
4944     CLEAR: zr_verbrauch, zr_reichweit, zr_verbrwert.
4945     IF kz_eintrag-mgvbr GT 0 OR kz_eintrag-wgvbr GT 0.
4946       IF ( flg_dd = true OR akt_drilldown-fcode = con_fcode_aper )
4947         AND sum_kz = false.
4948   *     Aufrißcode = Periode, d.h. Periodenanzahl = 1.
4949         IF flg_monat IS INITIAL.
4950           zr_verbrauch = kz_eintrag-mgvbr / periodenlaenge.
4951           zr_verbrwert = kz_eintrag-wgvbr / periodenlaenge.
4952         ELSE.
4953           IF akt_drilldown-fcode NE con_fcode_aper.
4954             PERFORM akt_drilldown_lesen.
4955             zr_monat = hlp_akt_drilldown-objekt.
4956           ELSE.
4957             zr_monat = kz_eintrag-objekt(8).
4958           ENDIF.
4959           PERFORM anzahl_tage USING    zr_monat
4960                               CHANGING zr_periodenlaenge.
4961           zr_verbrauch = kz_eintrag-mgvbr / zr_periodenlaenge.
4962           zr_verbrwert = kz_eintrag-wgvbr / zr_periodenlaenge.
4963         ENDIF.
4964       ELSE.
4965   *     Aufrißcode = periodenübergreifend, z.B. Werk
4966         IF flg_monat IS INITIAL.
4967           zr_verbrauch =
4968             kz_eintrag-mgvbr / ( anzahl_perio * periodenlaenge ).
4969           zr_verbrwert =
4970             kz_eintrag-wgvbr / ( anzahl_perio * periodenlaenge ).
4971         ELSE.
4972           zr_verbrauch = kz_eintrag-mgvbr / anz_tage.
4973           zr_verbrwert = kz_eintrag-wgvbr / anz_tage.
4974         ENDIF.
4975       ENDIF.
4976   *   Reichweite bewerteter Bestand
4977       PERFORM berechne_zahl USING kz_eintrag-mbwbest
4978                                   zr_verbrauch
4979                          CHANGING kz_eintrag-rwbewbest.
4980   *   Reichweite Wert bewerteter Bestand
4981       PERFORM berechne_zahl USING kz_eintrag-wbwbest
4982                                   zr_verbrwert
4983                          CHANGING kz_eintrag-rwwbwbest.
4984   *   Reichweite Konsi-Bestand
4985       PERFORM berechne_zahl USING kz_eintrag-mkobest
4986                                   zr_verbrauch
4987                          CHANGING kz_eintrag-rwkobest.
4988   *   Reichweite Gesamtbestand
4989       PERFORM berechne_zahl USING kz_eintrag-gsbest
4990                                   zr_verbrauch
4991                          CHANGING kz_eintrag-rwgsbest.
4992       kz_eintrag-rwwgsbest = kz_eintrag-rwwbwbest.
4993   *   Reichweite mittlerer bewerteter Bestand
4994       PERFORM berechne_zahl USING kz_eintrag-dbwbest
4995                                   zr_verbrauch
4996                          CHANGING kz_eintrag-drwbwbest.
4997       PERFORM berechne_zahl USING kz_eintrag-dwbwbest
4998                                   zr_verbrwert
4999                          CHANGING kz_eintrag-drwwbwbest.
5000   *   Reichweite mittlerer Konsi-Bestand
5001       PERFORM berechne_zahl USING kz_eintrag-dkobest
5002                                   zr_verbrauch
5003                          CHANGING kz_eintrag-drwkobest.
5004   *   Reichweite mittlerer Gesamtbestand
5005       PERFORM berechne_zahl USING kz_eintrag-dgsbest
5006                                   zr_verbrauch
5007                          CHANGING kz_eintrag-drwgsbest.
5008       kz_eintrag-drwwgsbest = kz_eintrag-drwwbwbest.
5009     ENDIF.
5010   * Prüfen, ob Verbrauch vorhanden.
5011     IF kz_eintrag-mgvbr LE 0.
5012   * Verbrauch ist Null oder negativ.
5013       IF kz_eintrag-mbwbest LE 0.
5014         kz_eintrag-rwbewbest = 0.
5015       ELSE.
5016         kz_eintrag-rwbewbest = c_maxrwuh.
5017       ENDIF.
5018       IF kz_eintrag-mkobest LE 0.
5019         kz_eintrag-rwkobest  = 0.
5020       ELSE.
5021         kz_eintrag-rwkobest  = c_maxrwuh.
5022       ENDIF.
5023       IF kz_eintrag-gsbest LE 0.
5024         kz_eintrag-rwgsbest  = 0.
5025       ELSE.
5026         kz_eintrag-rwgsbest  = c_maxrwuh.
5027       ENDIF.
5028       IF kz_eintrag-dbwbest LE 0.
5029         kz_eintrag-drwbwbest  = 0.
5030       ELSE.
5031         kz_eintrag-drwbwbest  = c_maxrwuh.
5032       ENDIF.
5033       IF kz_eintrag-dkobest LE 0.
5034         kz_eintrag-drwkobest  = 0.
5035       ELSE.
5036         kz_eintrag-drwkobest  = c_maxrwuh.
5037       ENDIF.
5038       IF kz_eintrag-dgsbest LE 0.
5039         kz_eintrag-drwgsbest  = 0.
5040       ELSE.
5041         kz_eintrag-drwgsbest  = c_maxrwuh.
5042       ENDIF.
5043     ENDIF.
5044     IF kz_eintrag-wgvbr LE 0.
5045       IF kz_eintrag-wbwbest LE 0.
5046         kz_eintrag-rwwbwbest = 0.
5047         kz_eintrag-rwwgsbest = 0.
5048       ELSE.
5049         kz_eintrag-rwwbwbest = c_maxrwuh.
5050         kz_eintrag-rwwgsbest = c_maxrwuh.
5051       ENDIF.
5052       IF kz_eintrag-dwbwbest LE 0.
5053         kz_eintrag-drwwbwbest = 0.
5054         kz_eintrag-drwwgsbest = 0.
5055       ELSE.
5056         kz_eintrag-drwwbwbest = c_maxrwuh.
5057         kz_eintrag-drwwgsbest = c_maxrwuh.
5058       ENDIF.
5059     ENDIF.
5060   ENDFORM.                               "zusatzkennzahlen_reichweite
5061
5062
5063   *---------------------------------------------------------------------*
5064   *       FORM ZUSATZKENNZAHLEN_UMSCHLAG                                *
5065   *---------------------------------------------------------------------*
5066   *       Es werden Zusatzkennzahlen zur Umschlagshäufigkeit berechnet  *
5067   *       Hinweise zur Berechnung:                                      *
5068   *       Mittlere Umschlagshäufigkeit =                                *
5069   *       mittlerer Verbrauch pro Tag / mittlerer Lagerbestand          *
5070   *       Gesamt-Umschlagshäufigkeit =                                  *
5071   *       kumulierter Verbrauch / mittlerer Lagerbestand                *
5072   *---------------------------------------------------------------------*
5073   *  -->  KZ_EINTRAG                                                    *
5074   *---------------------------------------------------------------------*
5075   FORM zusatzkennzahlen_umschlag CHANGING kz_eintrag STRUCTURE aus_s000.
5076   * Prüfen, ob Verbrauch vorliegt.
5077     IF kz_eintrag-mgvbr LE 0 AND kz_eintrag-wgvbr LE 0.
5078   *   Verbrauch Null bzw. negativ, somit ziehen die Initialwerte
5079       EXIT.
5080   * Prüfen, ob ein mittlerer Bestand vorhanden ist.
5081     ENDIF.
5082     IF kz_eintrag-dbwbest LE 0.
5083   * Bewerteter Bestand = 0 oder negativ
5084       kz_eintrag-uhbwbest    =  c_maxrwuh.
5085       kz_eintrag-duhbwbest   =  c_maxrwuh.
5086       kz_eintrag-juhbwbest   =  c_maxrwuh.
5087       kz_eintrag-uhwbwbest   =  c_maxrwuh.
5088       kz_eintrag-duhwbwbest  =  c_maxrwuh.
5089       kz_eintrag-juhwbwbest  =  c_maxrwuh.
