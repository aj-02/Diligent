1227         CASE XXL_KENNZAHLEN-INTTYPE.
1228           WHEN 'D'.
1229             XXL_SEMANTIK-COL_TYP = 'DAT'.
1230           WHEN 'P'.
1231             XXL_SEMANTIK-COL_TYP = 'NUM'.
1232           WHEN 'F'.
1233             XXL_SEMANTIK-COL_TYP = 'NUM'.
1234           WHEN 'I'.
1235             XXL_SEMANTIK-COL_TYP = 'NUM'.
1236           WHEN 'N'.
1237             XXL_SEMANTIK-COL_TYP = 'NUM'.
1238           WHEN OTHERS.
1239             XXL_SEMANTIK-COL_TYP = 'STR'.
1240         ENDCASE.
1241       ENDIF.
1242       IF XXL_KENNZAHLEN-GESAMTKZ = TRUE.
