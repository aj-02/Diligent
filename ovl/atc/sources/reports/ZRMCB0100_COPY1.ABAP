1471   *---------------------------------------------------------------------*
1472   *       FORM LISTE_SORTIEREN                                          *
1473   *---------------------------------------------------------------------*
1474   *       Sortiert die akt. Liste nach der Spalte auf der Cursor steht  *
1475   *---------------------------------------------------------------------*
1476   *  -->  LS_FLG_SORT_ABST: Flag für Sortiertyp                         *
1477   *                         = TRUE,  bei absteigender Reihenfolge       *
1478   *                         = FALSE, bei aufsteigender Reihenfolge      *
1479   *---------------------------------------------------------------------*
1480   FORM LISTE_SORTIEREN USING LS_FLG_SORT_ABST type c.
1481   * Sortiertyp neu setzen
1482     FLG_SORT_ABST = LS_FLG_SORT_ABST.
1483     IF DARSTELLUNGSART <> CON_DARST_EINZEL    AND
1484        DARSTELLUNGSART <> CON_DARST_SUMME     AND
1485        DARSTELLUNGSART <> CON_DARST_RESTSUMME AND
1486        DARSTELLUNGSART <> CON_DARST_UEBERSCHRIFT.
1487       PERFORM LISTE_SORTIEREN_KOMPLEX.
1488       EXIT.
1489     ENDIF.
1490
1491   * Parameter zur Liststufe aktualisieren
1492     PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
1493     PERFORM AUSTAB_AKTUALISIEREN.
1494   * Sortierkriterium bestimmen
1495     PERFORM KENNZAHLSPALTE_BESTIMMEN USING TRUE.
1496     IF KENNZAHL_SPALTE-FIELDNAME IS INITIAL.
1497   *   Sortierung nach Merkmalsspalte
1498       READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
1499       IF AKT_DRILLDOWN-FCODE = CON_FCODE_APER.
1500   *     Periodenaufriß => Sortierung nach interner Darstellung der Periode
1501         SORT_KRITERIUM = CON_FELD_AUSTABOBJEKT.
1502       ELSE.
1503   *     Merkmalsaufriß
1504         IF FLG_OBJEKTTEXT eq CON_OBJEKTTEXT_TEXT.
1505   *     Darstellung mit Bezeichnung => nach externer Darstellung sortieren
1506           SORT_KRITERIUM = CON_FELD_AUSTABTEXT.
1507         ELSE.
1508   *     Darstellung mit Schlüssel, Schlüssel und Bezeichunung u.a.
1509   *     => nach interner Darstellung sortieren
1510   ENHANCEMENT-POINT RMCS0LIS_03 SPOTS ES_RMCS0LIS STATIC INCLUDE BOUND.
1511
1512   ENHANCEMENT-SECTION     RMCS0LIS_04 SPOTS ES_RMCS0LIS INCLUDE BOUND.
1513           SORT_KRITERIUM = CON_FELD_AUSTABOBJEKT.
1514   END-ENHANCEMENT-SECTION.
1515         ENDIF.
1516       ENDIF.
1517       IF gf_acc_init IS INITIAL.
1518         CALL FUNCTION 'GET_ACCESSIBILITY_MODE'
1519           IMPORTING
1520             ACCESSIBILITY           = gf_acc_on
1521           EXCEPTIONS
1522             ITS_NOT_AVAILABLE       = 1
1523             OTHERS                  = 2.
1524         IF SY-SUBRC <> 0.
1525   * MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
1526   *         WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
1527         ENDIF.
1528         gf_acc_init = true.
1529       ENDIF.
1530       IF NOT gf_acc_on IS INITIAL.
1531   * we could fix that problem in non-ACC, as well...
1532         REFRESH SORT_KENNZAHLEN.
1533       ENDIF.
1534
1535       SORT_KENNZAHLEN-TABNAME   = GSTRU.
1536       SORT_KENNZAHLEN-FIELDNAME = SORT_KRITERIUM+9.
1537       MOVE-CORRESPONDING AKT_DRILLDOWN TO SORT_KENNZAHLEN.
1538     ELSE.
1539
1540   *   Sortierung nach Kennzahl
1541       SORT_KRITERIUM = KENNZAHL_SPALTE-AUSTABFELD.
1542       MOVE-CORRESPONDING KENNZAHL_SPALTE TO SORT_KENNZAHLEN.
1543     ENDIF.
1544
1545   * Sortierkriterium anhängen
1546     DELETE SORT_KENNZAHLEN WHERE FLG_GRUPPE = FALSE AND
1547                                  FIELDNAME  = SORT_KENNZAHLEN-FIELDNAME.
1548     IF NOT SY-SUBRC IS INITIAL.
1549       ANZ_SORTKRIT = ANZ_SORTKRIT + 1.
1550     ENDIF.
1551     SORT_KENNZAHLEN-AUSTABFELD = SORT_KRITERIUM.
1552     SORT_KENNZAHLEN-FLG_GRUPPE = FALSE.
1553     SORT_KENNZAHLEN-FLG_ABST   = LS_FLG_SORT_ABST.
1554     INSERT SORT_KENNZAHLEN INDEX 1.
1555     MOVE-CORRESPONDING SORT_KENNZAHLEN TO KENNZAHLEN_SSTAB_S.
1556     KENNZAHLEN_SSTAB_S-SORT_DOWN = SORT_KENNZAHLEN-FLG_ABST.
1557
1558   * Sortierkriterium in Funktionsgruppe übertragen
1559     CALL FUNCTION 'CNSG_SET_SORT_FIELDS'
1560          EXPORTING
1561               I_FLG_DISPLAY     = FALSE
1562               I_FLG_SORT_DOWN   = LS_FLG_SORT_ABST
1563               I_ACTION_FIELD    = KENNZAHLEN_SSTAB_S
1564               I_ACTION          = 'N'
1565          CHANGING
1566               C_HANDLE          = SORT_HANDLE
1567          EXCEPTIONS
1568               CANCEL            = 1
1569               NO_ALLOWED_FIELDS = 2
1570               OTHERS            = 3.
1571
1572     PERFORM AUSTAB_SORTIEREN USING FLG_SORT_ABST.
1573
1574   * Sortierte Liste neu ausgeben
1575     PERFORM LISTE_ERSETZEN USING FALSE TRUE.
1576   ENDFORM.                               "LISTE_SORTIEREN
