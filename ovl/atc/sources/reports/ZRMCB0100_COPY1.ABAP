429              ac_austab-wbeszug = ac_austab-wbeszug + ac_inttab-wbeszug.
430    *         if eisbe_werks <> ac_inttab-werks
431    *            or eisbe_matnr <> ac_inttab-matnr.
432              ac_austab-eisbe   = ac_austab-eisbe   + ac_inttab-eisbe.
433    *           eisbe_werks = ac_inttab-werks.
434    *           eisbe_matnr = ac_inttab-matnr.
435    *         endif.
436            ENDIF.
437          WHEN con_speri_spmon.
438            IF ac_inttab-spmon EQ akt_mon OR ac_inttab-spmon IS INITIAL.
439              ac_austab-mbwbest = ac_austab-mbwbest + ac_inttab-mbwbest.
440              ac_austab-mkobest = ac_austab-mkobest + ac_inttab-mkobest.
441              ac_austab-wbwbest = ac_austab-wbwbest + ac_inttab-wbwbest.
442              ac_austab-beszug  = ac_austab-beszug  + ac_inttab-beszug.
443              ac_austab-wbeszug = ac_austab-wbeszug + ac_inttab-wbeszug.
444    *         if eisbe_werks <> ac_inttab-werks
445    *            or eisbe_matnr <> ac_inttab-matnr.
446              ac_austab-eisbe   = ac_austab-eisbe   + ac_inttab-eisbe.
447    *           eisbe_werks = ac_inttab-werks.
448    *           eisbe_matnr = ac_inttab-matnr.
449    *         endif.
450            ENDIF.
451          WHEN con_speri_spbup.
452            IF ac_inttab-spbup EQ akt_bup OR ac_inttab-spbup IS INITIAL.
453              ac_austab-mbwbest = ac_austab-mbwbest + ac_inttab-mbwbest.
454              ac_austab-mkobest = ac_austab-mkobest + ac_inttab-mkobest.
455              ac_austab-wbwbest = ac_austab-wbwbest + ac_inttab-wbwbest.
456              ac_austab-beszug  = ac_austab-beszug  + ac_inttab-beszug.
457              ac_austab-wbeszug = ac_austab-wbeszug + ac_inttab-wbeszug.
458    *         if eisbe_werks <> ac_inttab-werks
459    *            or eisbe_matnr <> ac_inttab-matnr.
460              ac_austab-eisbe   = ac_austab-eisbe   + ac_inttab-eisbe.
