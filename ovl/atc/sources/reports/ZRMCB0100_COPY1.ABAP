1309       LOOP AT hl_dd04t_tab_a.
1310         rsttyp_info-reptext   = hl_dd04t_tab_a-reptext.
1311         rsttyp_info-scrtext_s = hl_dd04t_tab_a-scrtext_s.
1312         rsttyp_info-scrtext_m = hl_dd04t_tab_a-scrtext_m.
1313         rsttyp_info-scrtext_l = hl_dd04t_tab_a-scrtext_l.
1314         MOVE-CORRESPONDING hl_dd04t_tab_a TO hierarchie_fcodes.
