1934   *---------------------------------------------------------------------*
1935   *       FORM PARAMETER_SETZEN                                         *
1936   *---------------------------------------------------------------------*
1937   *       Sollen Bewegungsdaten (Kundenauftrag, Bestellung etc. oder    *
1938   *       Stammdaten angezeigt werden, so werden vorher alle SPA/GPA    *
1939   *       Parameter aus dem aktuellen Drilldown ermittelt und gesetzt.  *
1940   *       Da für das aktuelle Merkmal auf der Liste die Tabelle         *
1941   *       AKT_DRILLDOWN erst bei der Funktion 'Aufriß' gefüllt wird,    *
1942   *       muß das ausgewählte Merkmal aus der Cursorposition ermittelt  *
1943   *       werden.                                                       *
1944   *---------------------------------------------------------------------*
1945   FORM PARAMETER_SETZEN.
1946     DATA: PS_SAV_TABIX LIKE SY-TABIX,
1947           PS_HLP_MATNR LIKE MARA-MATNR.
1948
1949   * Kennung für Beleg-/Stammdaten aus Standardanalysen setzen (Vertrieb)
1950     SET PARAMETER ID 'MC1' FIELD TRUE.
1951
1952     PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
1953
1954     LOOP AT DRILLDOWN_FCODES.
1955       PS_SAV_TABIX = SY-TABIX.
1956       READ TABLE AKT_DRILLDOWN WITH KEY FCODE = DRILLDOWN_FCODES-FCODE.
1957       IF SY-SUBRC = 0.
1958         IF SY-TABIX < DRILLDOWN_EINTRAEGE.
1959   *       Nach diesem Merkmal wurde bereits aufgerissen
1960           IF AKT_DRILLDOWN-MEMORYID <> SPACE.
1961             IF AKT_DRILLDOWN-MEMORYID = CON_MEMORYID_MAT.
1962   *           Hilffeld notwendig, da Konvertierungsexit-FB für MATNR
1963   *           Bezugsstruktur hat und Lg(MATNR) <> Lg(AKT_DRILLDOWN-OBJEKT)
1964               PS_HLP_MATNR = AKT_DRILLDOWN-OBJEKT.
1965               SET PARAMETER ID    AKT_DRILLDOWN-MEMORYID
1966                             FIELD PS_HLP_MATNR.
1967             ELSEIF AKT_DRILLDOWN-MEMORYID = 'ASN'.
1968               SET PARAMETER ID 'ASN' FIELD AKT_DRILLDOWN-OBJEKT.
1969             ELSEIF AKT_DRILLDOWN-MEMORYID = 'AGR' AND
1970                    AKT_DRILLDOWN-KETT_AKT = TRUE.
1971   * Merkmalskettung für Arbeitsplatz aktiv
1972               SET PARAMETER ID 'WRK' FIELD AKT_DRILLDOWN-OBJEKT+0(4).
1973               SET PARAMETER ID 'AGR' FIELD AKT_DRILLDOWN-OBJEKT+4(8).
1974             ELSEIF AKT_DRILLDOWN-MEMORYID = 'LAG' AND
1975                    AKT_DRILLDOWN-KETT_AKT = TRUE.
1976   * Merkmalskettung für Lagerort aktiv
1977               SET PARAMETER ID 'WRK' FIELD AKT_DRILLDOWN-OBJEKT+0(4).
1978               SET PARAMETER ID 'LAG' FIELD AKT_DRILLDOWN-OBJEKT+4(8).
1979             ELSE.
1980               SET PARAMETER ID    AKT_DRILLDOWN-MEMORYID
1981                             FIELD AKT_DRILLDOWN-OBJEKT.
1982             ENDIF.
1983   *         im SD werden z.T. in den Datenelementen, die kundenähnlich
1984   *         sind spezielle SPA/GPA-Parameter verwendet- für diesen Fall
1985   *         muß zusätzlich die 'normale' Parameter-ID KUN gesetzt werden,
1986   *         da viele Anzeigetransaktionen nur diese nutzen.
1987             IF AKT_DRILLDOWN-DOMNAME = 'KUNNR'.
1988               SET PARAMETER ID 'KUN' FIELD AKT_DRILLDOWN-OBJEKT.
1989             ENDIF.
1990           ENDIF.
1991         ELSE.
1992   *       Neuestes Aufrißkriterium
1993           IF DARSTELLUNGSART = CON_DARST_EINZEL.
1994             IF AKT_DRILLDOWN-MEMORYID <> SPACE.
1995               IF AKT_DRILLDOWN-MEMORYID = CON_MEMORYID_MAT.
1996   *             Hilffeld notwendig, da Konvertierungsexit-FB für MATNR Be-
1997   *             zugsstruktur hat und Lg(MATNR) <> Lg(AKT_DRILLDOWN-OBJEKT)
1998                 PS_HLP_MATNR = AKT_OBJEKT.
1999                 SET PARAMETER ID    AKT_DRILLDOWN-MEMORYID
2000                               FIELD PS_HLP_MATNR.
2001               ELSEIF AKT_DRILLDOWN-MEMORYID = 'ASN'.
2002                 SET PARAMETER ID 'ASN' FIELD AKT_OBJEKT.
2003               ELSEIF AKT_DRILLDOWN-MEMORYID = 'AGR' AND
2004                      AKT_DRILLDOWN-KETT_AKT = TRUE.
2005   * Merkmalskettung für Arbeitsplatz aktiv
2006                 SET PARAMETER ID 'WRK' FIELD AKT_OBJEKT+0(4).
2007                 SET PARAMETER ID 'AGR' FIELD AKT_OBJEKT+4(8).
2008               ELSEIF AKT_DRILLDOWN-MEMORYID = 'LAG' AND
2009                      AKT_DRILLDOWN-KETT_AKT = TRUE.
2010   * Merkmalskettung für Lagerort aktiv
2011                 SET PARAMETER ID 'WRK' FIELD AKT_OBJEKT+0(4).
2012                 SET PARAMETER ID 'LAG' FIELD AKT_OBJEKT+4(8).
2013               ELSE.
2014                 SET PARAMETER ID    AKT_DRILLDOWN-MEMORYID
2015                               FIELD AKT_OBJEKT.
2016               ENDIF.
2017             ENDIF.
2018             IF AKT_DRILLDOWN-DOMNAME = 'KUNNR'.
2019               SET PARAMETER ID 'KUN' FIELD AKT_OBJEKT.
2020             ENDIF.
2021           ELSE.
2022   *         Parameter aus SL...-Tabellen setzen
2023             PERFORM PARAMETER_SETZEN_SL.
2024           ENDIF.
2025         ENDIF.
2026       ELSE.
2027   *     Parameter aus  SL...-Tabellen setzen
2028         PERFORM PARAMETER_SETZEN_SL.
2029       ENDIF.
2030     ENDLOOP.
2031   ENDFORM.                               "PARAMETER_SETZEN
