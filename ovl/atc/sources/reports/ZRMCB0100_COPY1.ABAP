4319   *---------------------------------------------------------------------*
4320   *       FORM TEXT_UEBERGEBEN                                          *
4321   *---------------------------------------------------------------------*
4322   *       An den Funktionsbaustein MCB_GRAPHIC_DAILY wird der Text      *
4323   *       des aktuellen Drilldown-Objektes übergeben. Gibt es mehrere   *
4324   *       Liststufen, so wird das aktuelle Objekt mit Führungspunkten   *
4325   *       übergeben.                                                    *
4326   *---------------------------------------------------------------------*
4327   FORM text_uebergeben.
4328
4329     DATA: te_lsind LIKE sy-lsind,
4330           te_hlp_text(60),
4331           te_hlp_strlen TYPE i,
4332           te_hlp_objekttext(60).
4333
4334   *Das aktuelle Objekt hängt von der Cursorposition ab.
4335     IF darstellungsart = con_darst_einzel.
4336   *Letzte Zeile der Drilldown-Tabelle lesen
4337       READ TABLE akt_drilldown INDEX sy-lsind.
4338       PERFORM drilldowntext_ermitteln USING    akt_drilldown
4339                                       CHANGING te_hlp_text.
4340       IF sy-lsind > 1.
4341   *     Mehr als 2 Drilldown-Stufen durchgeführt => Führungspunkte setzen
4342         SHIFT te_hlp_text RIGHT BY 4 PLACES.
4343         te_hlp_text(3) = '...'.
4344       ENDIF.
4345       te_hlp_strlen = strlen( te_hlp_text ) + 1.
4346       READ TABLE aus_s000 INDEX austab_tabix.
4347       IF sy-subrc = 0.
4348         WRITE aus_s000-text TO te_hlp_text+te_hlp_strlen.
4349       ENDIF.
4350     ELSE.
4351       IF sy-lsind <= 1.
4352   *Anwender ist auf Summenzeile und es gibt keinen Aufriß
4353         te_hlp_text = analyse_text.
4354       ELSE.
4355   *Anwender ist auf Summenzeile, aber es gibt einen Aufriß
4356   *Ermitteln des übergeordneten Objektes
4357         te_lsind = sy-lsind - 1.
4358         READ TABLE akt_drilldown INDEX te_lsind.
4359         PERFORM drilldowntext_ermitteln USING    akt_drilldown
4360                                         CHANGING te_hlp_text.
4361         IF te_lsind > 1.
4362   *     Mehr als 2 Drilldown-Stufen durchgeführt => Führungspunkte setzen
4363           SHIFT te_hlp_text RIGHT BY 4 PLACES.
4364           te_hlp_text(3) = '...'.
4365         ENDIF.
4366         te_hlp_strlen = strlen( te_hlp_text ) + 1.
4367         PERFORM objekttext_ermitteln USING    akt_drilldown-domname
4368                                               akt_drilldown-rollname
4369                                               akt_drilldown-convexit
4370                                               akt_drilldown-outputlen
4371                                               akt_drilldown-objekt
4372                                      CHANGING te_hlp_objekttext.
4373
4374         WRITE te_hlp_objekttext TO te_hlp_text+te_hlp_strlen.
4375
4376       ENDIF.
4377     ENDIF.
4378     text = te_hlp_text.
4379   ENDFORM.                               "text_uebergeben
