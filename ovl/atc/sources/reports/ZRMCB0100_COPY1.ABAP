532                         int_s000
533                         exception
534                         from database mcsi(is) id mcsi_key
535                         ACCEPTING PADDING ACCEPTING TRUNCATION.
536              ENDTRY.
537              loop at sel_tab_dir.
538                move-corresponding sel_tab_dir to sel_tab.
539                append sel_tab.
540              endloop.
541            endif.
542          else.
