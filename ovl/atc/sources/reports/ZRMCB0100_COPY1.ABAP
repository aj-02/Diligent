54       IF SAV_SPZIS = 'C'.
55     *   Bestandsliste ohne Periodenbezug.
56         EXCL_FCODES = 'PLIS'.
57         APPEND EXCL_FCODES.
58         EXCL_FCODES = 'VJVG'.
59         APPEND EXCL_FCODES.
60         EXCL_FCODES = 'TIME'.
61         APPEND EXCL_FCODES.
62       ENDIF.
63
64       IF SAV_SPZIS = 'D' OR SAV_SPZIS = 'E'.
65     *   Kennzahlmatrix nicht für Typ D und Typ E
66         EXCL_FCODES-FCODE = 'KZMAT'.
67         APPEND EXCL_FCODES.
68       ENDIF.
69
70       IF FLG_ZEITREIHE = TRUE.
71     *   Zeitreihendarstellung gewählt
72         IF SY-SCOLS > ZEITREIHEN_POPUP_WIDTH.
73     *     Scroll-Tasten nach links und rechts ausblenden, wenn unnötig
74           EXCL_FCODES = 'C-'.
75           APPEND EXCL_FCODES.
76           EXCL_FCODES = 'C+'.
77           APPEND EXCL_FCODES.
78           EXCL_FCODES = 'S-'.              "ganz links
79           APPEND EXCL_FCODES.
80           EXCL_FCODES = 'S+'.              "ganz rechts
81           APPEND EXCL_FCODES.
82         ENDIF.
83       ELSE.
84         IF FLG_SELVS_OHNE_PERI = TRUE.
85     *     Zeitreihe nicht bei SelVs, die keine Periode als Merkmal hat
86           EXCL_FCODES = 'TIME'.
87           APPEND EXCL_FCODES.
88         ELSEIF ( ANZ_HIERARCHIE_AUFRISSE <> 0 OR
89                  AKT_DRILLDOWN-FCODE(1) = 'H' ).
90     *     Zeitreihe nicht bei Hierarchieaufriß
91           EXCL_FCODES = 'TIME'.
92           APPEND EXCL_FCODES.
93         ELSE.
94           READ TABLE AKT_DRILLDOWN WITH KEY FCODE = CON_FCODE_APER
95                      TRANSPORTING NO FIELDS.
96           IF SY-SUBRC = 0.
97     *       Zeitreihe nicht bei Periodenaufriß
98             EXCL_FCODES = 'TIME'.
99             APPEND EXCL_FCODES.
100          ELSE.
101            READ TABLE AKT_DRILLDOWN WITH KEY KEYFLAG = FALSE
102                       TRANSPORTING NO FIELDS.
103            IF SY-SUBRC = 0.
104    *         Zeitreihe nicht bei Character-Kennzahl
105              EXCL_FCODES = 'TIME'.
106              APPEND EXCL_FCODES.
107            ENDIF.
108          ENDIF.
109        ENDIF.
110      ENDIF.
111      IF FLG_VERGLEICH <> CON_VERGLEICH_PLANIST OR
112    *   Kein Plan/Ist-Vergleich => Funktion 'Andere Version...' deaktivieren
113        MAINLIST_LSIND <> SY-LSIND.
114    *   Versionswechsel nur auf Vgl. mit Grundaufriß möglich
115        EXCL_FCODES = 'AVER'.
116        APPEND EXCL_FCODES.
117      ENDIF.
118      IF NOT FLG_VERGLEICH IS INITIAL.
119    *   Vergleichpopup
120        IF SY-SCOLS >= VGL_POPUP_WIDTH.
121    *     Scroll-Tasten nach links und rechts ausblenden, wenn unnötig
122          EXCL_FCODES = 'C-'.
123          APPEND EXCL_FCODES.
124          EXCL_FCODES = 'C+'.
125          APPEND EXCL_FCODES.
126        ENDIF.
127        IF SY-LSIND = MAINLIST_LSIND.
128    *     1. Liststufe im Vergleichspopup => 'Aufriß zurück' ausblenden
129          EXCL_FCODES = 'BCKV'.
130          APPEND EXCL_FCODES.
131        ENDIF.
132        IF FLG_VERGLEICH = CON_VERGLEICH_KENNZAHL AND
133           AKT_DRILLDOWN-FCODE(1) = 'H'.
134    *     Kennzahlenvergleich und Hierarchieaufriß => Kein Aufriß möglich
135          EXCL_FCODES = 'AUSW'.
136          APPEND EXCL_FCODES.
137          EXCL_FCODES = 'AUFR'.
138          APPEND EXCL_FCODES.
139        ENDIF.
140      ENDIF.
141      IF SAV_FCODE = 'KGES'.
142    *   Popup 'Alle Kennzahlen': Blättertasten ausblenden
143    *                            (bei Summenzeile gar keine Blättertasten)
144        IF AUSTAB_TABIX = 1 OR DARSTELLUNGSART = CON_DARST_SUMME.
145          EXCL_FCODES = 'LN-'.
146          APPEND EXCL_FCODES.
147        ENDIF.
148        IF AUSTAB_TABIX = AUSTAB_EINTRAEGE OR
149           DARSTELLUNGSART = CON_DARST_SUMME.
150          EXCL_FCODES = 'LN+'.
151          APPEND EXCL_FCODES.
152        ENDIF.
153      ENDIF.
154      IF FLG_LIB_AUFRUF = TRUE.
155    *   Kennzahlzugriff bei Aufruf unter LIB unterdrücken
156        EXCL_FCODES-FCODE = 'KZAW'.
157        APPEND EXCL_FCODES.
158        EXCL_FCODES-FCODE = 'KGES'.
159        APPEND EXCL_FCODES.
160      ENDIF.
161      IF FLG_WERTKENNZAHLEN = FALSE.
162    *   Funktion "Währung-Analysewährung" deaktivieren
163        EXCL_FCODES-FCODE = 'AWAE'.
164        APPEND EXCL_FCODES.
165      ENDIF.
166      IF gf_acc_init IS INITIAL.
167        CALL FUNCTION 'GET_ACCESSIBILITY_MODE'
168          IMPORTING
169            ACCESSIBILITY           = gf_acc_on
170          EXCEPTIONS
171            ITS_NOT_AVAILABLE       = 1
172            OTHERS                  = 2.
173        IF SY-SUBRC <> 0.
174    * MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
175    *         WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
176        ENDIF.
177        gf_acc_init = true.
178      ENDIF.
179      IF EXCEPTION IS INITIAL.
180    *   Funktion "Exception anzeigen" deaktivieren
181        EXCL_FCODES-FCODE = 'EXPA'.
182        APPEND EXCL_FCODES.
183        EXCL_FCODES-FCODE = 'EXCS'.
184        APPEND EXCL_FCODES.
185      ELSEIF gf_acc_on IS INITIAL.
186        EXCL_FCODES-FCODE = 'EXCS'.
187        APPEND EXCL_FCODES.
188      ENDIF.
189
190    * Fkt.: "Sicht-Grundliste" auf Grundliste ausschließen, wenn
191    * Grundliste keine Rangliste ist
192      IF SY-LSIND = 0 AND HITL_KRITERIUM IS INITIAL.
193        EXCL_FCODES-FCODE = 'GRDL'.
194        APPEND EXCL_FCODES.
195      ENDIF.
196    * Fkt. "Sortierung aufheben" deaktivieren
197      IF ( ANZ_SORTKRIT = 0 AND FLG_VERGLEICH = FALSE ) OR
198         ( vgl_sort_spalte = false and flg_vergleich <> false ).
199        EXCL_FCODES-FCODE = 'USRT'.
200        APPEND EXCL_FCODES.
201      ENDIF.
202
203    * Fkt: "Rangliste aufheben" deaktivieren
204      IF HITL_KRITERIUM IS INITIAL.
205        EXCL_FCODES-FCODE = 'RLAH'.
206        APPEND EXCL_FCODES.
207      ENDIF.
208
209      READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
210      IF AKT_DRILLDOWN-FCODE(1) <> 'H'.
211        IF AKT_DRILLDOWN-KEYFLAG = FALSE.
212    *     Aufriß nach Char-Kennzahl => Plan-/Ist-Vergleich deaktivieren
213          EXCL_FCODES-FCODE = 'PLIS'.
214          APPEND EXCL_FCODES.
215        ENDIF.
216        IF SAV_FCODE = 'HANZ'.
217    *     Hierarchie anzeigen und kein aktueller Hierarchieaufriß =>
218    *     Hierarchieknoten aufreißen deaktivieren
219          EXCL_FCODES-FCODE = 'TRDD'.
220          APPEND EXCL_FCODES.
221        ENDIF.
222      else.
223        if sav_fcode eq 'HANZ' and anz_hierarchie_aufrisse > 1.
224    *   Aufriß aus Hierarchieanzeige nur möglich, wenn maximal eine Stufe
225    *   der Hierachie bereits aufgerissen ist
226          excl_fcodes-fcode = 'TRDD'.
227          append excl_fcodes.
228        endif.
229      ENDIF.
230
231    * Schon durchgeführte Drilldown-Fcodes deaktivieren
232      IF ANZ_HIERARCHIE_AUFRISSE = 0 AND AKT_DRILLDOWN-FCODE(1) <> 'H'.
233    *   Noch kein Hierachieaufriß erfolgt => zusätzlich abhängige
234    *   Hierarchie-Fcodes ausblenden
235        LOOP AT AKT_DRILLDOWN.
236          IF AKT_DRILLDOWN-FCODE(1) <> 'H'.
237    *       Normaler Aufriß => Fcode deaktivieren
238            EXCL_FCODES-FCODE = AKT_DRILLDOWN-FCODE.
239            APPEND EXCL_FCODES.
240    *       Vom Aufriß-FCode abhängige Hierarchieaufrisse deaktivieren
241            LOOP AT HIERARCHIE_FCODES WHERE
242                                     MERKMALS_FCODE = AKT_DRILLDOWN-FCODE.
243              EXCL_FCODES-FCODE = HIERARCHIE_FCODES-FCODE.
244              APPEND EXCL_FCODES.
245            ENDLOOP.
246          ENDIF.
247        ENDLOOP.
248    *   Funktion 'Hierarchie anzeigen' deaktivieren
249        EXCL_FCODES-FCODE = 'HANZ'.
250        APPEND EXCL_FCODES.
251      ELSE.
252    *   Mindenstens eine Hierarchieaufriß ist erfolgt (inkl. akt. Aufriß)
253
254    *   Vorerst Vorjahres- und Plan-/Istvergleich ausblenden.
255        EXCL_FCODES-FCODE = 'VJVG'.
256        APPEND EXCL_FCODES.
257        EXCL_FCODES-FCODE = 'PLIS'.
258        APPEND EXCL_FCODES.
259    *   Kennzahlenmatrix nicht möglich
260        EXCL_FCODES-FCODE = 'KZMAT'.
261        APPEND EXCL_FCODES.
262
263        LOOP AT AKT_DRILLDOWN WHERE FCODE(1) <> 'H'.
264    *     Normaler Aufriß => Fcode ausblenden
265          EXCL_FCODES-FCODE = AKT_DRILLDOWN-FCODE.
266          APPEND EXCL_FCODES.
267        ENDLOOP.
268      ENDIF.
269
270      READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
271      IF AKT_DRILLDOWN-FCODE(1) = 'H'.
272    *   Aktueller Aufriß ist Hierarchieaufriß => Nur aktuelle Hierarchie-
273    *   Fcode ist erlaubt (alle anderen müssen ausgeblendet werden)
274        LOOP AT HIERARCHIE_FCODES WHERE FCODE <> AKT_DRILLDOWN-FCODE.
275          EXCL_FCODES-FCODE = HIERARCHIE_FCODES-FCODE.
276          APPEND EXCL_FCODES.
277        ENDLOOP.
278    *   'Hierarchieaufriß...' wird immer ausgeblendet
279        EXCL_FCODES-FCODE = 'HALL'.
280        APPEND EXCL_FCODES.
281      ELSEIF ANZ_HIERARCHIE_AUFRISSE > 0.
282    *   Aktueller Aufriß ist kein Hierarchieaufriß, aber es wurde schon
283    *   nach Hierarchie aufgerissen => kein weiterer Aufriß nach
284    *   Hierarchie ist erlaubt (alle Hierarchie-Fcodes ausblenden)
285        LOOP AT HIERARCHIE_FCODES.
286          EXCL_FCODES-FCODE = HIERARCHIE_FCODES-FCODE.
287          APPEND EXCL_FCODES.
288        ENDLOOP.
289        EXCL_FCODES-FCODE = 'HALL'.
290        APPEND EXCL_FCODES.
291      ENDIF.
292      IF AKT_DRILLDOWN-FCODE <> CON_FCODE_APER.
293    *   Aktueller Aufriß ist kein Periodenaufriß  => Fkt. "Zeitreihengrafik"
294    *   deaktivieren
295        EXCL_FCODES-FCODE = 'SGRA'.
296        APPEND EXCL_FCODES.
297      ENDIF.
298
299      IF AUSTAB_EINTRAEGE = 1.
300    *   Es gibt nur einen Merkmalswert => Fkt. "Zeitreihengrafik" und
301    *                                      "Korrelation" deaktivieren
302        EXCL_FCODES-FCODE = 'SGRA'.
303        APPEND EXCL_FCODES.
304        EXCL_FCODES-FCODE = 'KORR'.
305        APPEND EXCL_FCODES.
306      ENDIF.
307
308    * Layoutschalter gemäß Einstellung deaktivieren
309
310    * Schalter für Drilldown-Pfad
311      IF FLG_HEADER_PATH = TRUE.
312        EXCL_FCODES-FCODE = 'PFAM'.
313      ELSE.
314        EXCL_FCODES-FCODE = 'PFAO'.
315      ENDIF.
316      APPEND EXCL_FCODES.
317    * Schalter für Merkmalstexte
318      CASE FLG_OBJEKTTEXT.
319        WHEN CON_OBJEKTTEXT_TEXT.
320          EXCL_FCODES-FCODE = 'MTEX'.
321        WHEN CON_OBJEKTTEXT_NR.
322          EXCL_FCODES-FCODE = 'MNUM'.
323        WHEN CON_OBJEKTTEXT_NR_TEXT.
324          EXCL_FCODES-FCODE = 'MNTX'.
325      ENDCASE.
326      APPEND EXCL_FCODES.
327    * Schalter für Wertdarstellung
328      IF FLG_PROZENTWERT = TRUE.
329        EXCL_FCODES-FCODE = 'PROZ'.
330      ELSE.
331        EXCL_FCODES-FCODE = 'ABSO'.
332      ENDIF.
333      APPEND EXCL_FCODES.
334    * Schalter für Währungseinstellung-Originalwährung
335      IF ANALYSE_WAEHRUNG IS INITIAL.
336        EXCL_FCODES-FCODE = 'OWAE'.
337        APPEND EXCL_FCODES.
338      ENDIF.
339      IF FLG_SELEKTION = TRUE AND SLV_NO IS INITIAL.
340    *   Selektionsversion löschen ausblenden
341        EXCL_FCODES-FCODE = 'SDEL'.
342        APPEND EXCL_FCODES.
343    *   Selektionsversion anzeigen ausblenden
344        EXCL_FCODES-FCODE = 'SLVA'.
345        APPEND EXCL_FCODES.
346      ENDIF.
347    * §§§ Erweitertes Selektionsbild ja/nein
348      IF FLG_ERWEIT_SELBILD = TRUE.
349        DELETE EXCL_FCODES WHERE FCODE = 'HNEX'.
350        EXCL_FCODES-FCODE = 'HEXT'.
351        APPEND EXCL_FCODES.
352      ELSE.
353        DELETE EXCL_FCODES WHERE FCODE = 'HEXT'.
354        EXCL_FCODES-FCODE = 'HNEX'.
355        APPEND EXCL_FCODES.
356      ENDIF.
357    * eventuell weitere FCodes deaktivieren
358      PERFORM SPEZIAL_EXCL_FCODES_FUELLEN IN PROGRAM (LIS_PROGNAME)
359                                          IF FOUND.
360    ENDFORM.                               "EXCL_FCODES_FUELLEN
361
