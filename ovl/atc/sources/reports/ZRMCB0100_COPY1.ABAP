454    *---------------------------------------------------------------------*
455    *       FORM HANZ_USER_COMMAND                                        *
456    *---------------------------------------------------------------------*
457    *       Für Befehlserweiterung direkt aus Hierarchieanzeige-Popup     *
458    *---------------------------------------------------------------------*
459    *  -->  NODE                                                          *
460    *  -->  COMMAND                                                       *
461    *  -->  VALUE(EXIT)                                                   *
462    *  -->  VALUE(LIST_REFRESH)                                           *
463    *---------------------------------------------------------------------*
464    FORM hanz_user_command  TABLES node           STRUCTURE  seucomm
465                            USING  command        TYPE       CSEQUENCE
466                            CHANGING value(exit)          TYPE BOOLEAN
467                                     value(list_refresh)  TYPE C.
468
469      DATA: huc_mcr_color LIKE mcr_color OCCURS 0 WITH HEADER LINE,
470            huc_text LIKE tmcrt-ntext,
471            huc_anz  TYPE i.
472
473      CASE command.
474        WHEN 'PF1H'.
475          IF NOT node-id IS INITIAL AND
476            node-name NE con_nodename_non_hier AND
477            node-name NE con_nodetype_root.
478            hierarchy_node_id = node-id.
479            darstellungsart   = con_darst_hier.
480            PERFORM hilfetext_anzeigen.
481            CLEAR hierarchy_node_id.
482          ENDIF.
483        WHEN 'TRDD' OR 'TRSL' OR 'TRPI'.
484          IF node-id IS INITIAL OR node-id = '000001'
485                                OR node-child is initial.
486    *       Bitte positionieren Sie den Cursor auf einen Knoten
487            MESSAGE e190(m5).
488          ELSE.
489            READ TABLE akt_drilldown INDEX drilldown_eintraege.
490            IF akt_drilldown-fcode(1) = 'H'.
491    *         Aufriß nur wenn aktueller Knoten Hierarchieknoten ist
492              hierarchy_node_id = node-id.
493              exit = true.
494            ENDIF.
495          ENDIF.
496        WHEN 'TRLG'.
497          LOOP AT rsttyp_info WHERE color NE ' '.
498            huc_mcr_color-name  = rsttyp_info-scrtext_m.
499            huc_mcr_color-color = rsttyp_info-color.
500            APPEND huc_mcr_color.
501          ENDLOOP.
502    *     LOOP AT rsttyp_info.
503    *       huc_mcr_color-name  = rsttyp_info-scrtext_m.
504    *       if rsttyp_info-color is initial.
505    *         huc_mcr_color-color = '1'.
506    *       ELSE.
507    *         huc_mcr_color-color = rsttyp_info-color.
508    *       ENDIF.
509    *       APPEND huc_mcr_color.
510    *     ENDLOOP.
511    *     Das Datenelement hat keine Farbe
512    *     DESCRIBE TABLE huc_mcr_color LINES huc_anz.
513    *     IF huc_anz > 0.
514    *       DELETE huc_mcr_color INDEX huc_anz.
515    *     ENDIF.
516
517          PERFORM text_ermitteln USING    227
518    *                                     'Farblegende'
