1323                   name          = hl_rsttyp_tab-tdomnm
1324              IMPORTING
1325                   gotstate      = hl_gotstate
1326                   dd01v_wa      = hl_dd01v_wa
1327              EXCEPTIONS
1328                   illegal_input = 1
1329                   OTHERS        = 2.
1330         IF sy-subrc = 0.
1331           MOVE-CORRESPONDING hl_dd01v_wa TO rsttyp_info.
1332           MOVE-CORRESPONDING hl_dd01v_wa TO hierarchie_fcodes.
1333         ENDIF.
1334       ENDIF.
1335       APPEND rsttyp_info.
1336     ENDLOOP.
1337
1338   * Farbinformationsermittlung
1339     CLEAR   hl_rsttyp_hlp.
1340     REFRESH hl_rsttyp_hlp.
1341     CLEAR hl_typ_zaehler.
1342     DESCRIBE TABLE rsttyp_info LINES hl_typ_anzahl.
1343     LOOP AT rsthie_tab.
1344       READ TABLE hl_rsttyp_hlp WITH KEY type = rsthie_tab-type.
1345       IF sy-subrc NE 0.
1346         ADD 1 TO hl_typ_zaehler.
1347         READ TABLE rsttyp_info WITH KEY type = rsthie_tab-type.
1348         IF sy-subrc EQ 0.                " Sollte stets stimmen
1349           CASE hl_typ_zaehler.
1350             WHEN 1.
1351               rsttyp_info-color = '1'.
1352             WHEN 2.
1353               rsttyp_info-color = '4'.
1354             WHEN 3.
1355               rsttyp_info-color = '3'.
1356             WHEN 4.
1357               rsttyp_info-color = '7'.
1358           ENDCASE.
1359           IF NOT rsthie_tab-leaf IS INITIAL.
1360             rsttyp_info-color = '0'.
1361           ENDIF.
1362           MODIFY rsttyp_info INDEX sy-tabix. " Farbinformation schreiben
1363           IF hl_typ_zaehler = hl_typ_anzahl.
1364             EXIT.
1365           ENDIF.
1366           hl_rsttyp_hlp-type = rsthie_tab-type.
1367           APPEND hl_rsttyp_hlp.
1368         ENDIF.
1369       ENDIF.
1370     ENDLOOP.                             " rsthie_tab
1371   ENDFORM.                               "HIERARCHIE_LESEN
