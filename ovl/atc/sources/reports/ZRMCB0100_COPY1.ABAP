185    *---------------------------------------------------------------------*
186    FORM SELPROT_OPTION_AUSGEBEN USING SA_OPTION LIKE RSPARAMS-OPTION
187                                       SA_SIGN   LIKE RSPARAMS-SIGN.
188
189    DATA: SA_QUICK_INFO(1024) TYPE C. "Quickinfo for accessibility modus
190
191      IF GF_ACC_INIT = FALSE.
192          CALL FUNCTION 'GET_ACCESSIBILITY_MODE'
193       IMPORTING
194         ACCESSIBILITY           = gf_acc_on
195       EXCEPTIONS
196         ITS_NOT_AVAILABLE       = 1
197         OTHERS                  = 2
198               .
199        gf_acc_init = true.
200      ENDIF.
201
202      IF GF_ACC_ON = FALSE.
203        CLEAR SA_QUICK_INFO.
204      ELSE.
205        IF SA_SIGN = 'I'.
206          CASE SA_OPTION.
207            WHEN 'EQ'.
208           SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
209                         LANGU = SY-LANGU AND ID = ICON_EQUAL_GREEN.
210            WHEN 'NE'.
211           SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
212                         LANGU = SY-LANGU AND ID = ICON_NOT_EQUAL_GREEN.
213            WHEN 'GT'.
214           SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
215                         LANGU = SY-LANGU AND ID = ICON_GREATER_GREEN.
216            WHEN 'LT'.
217           SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
218                         LANGU = SY-LANGU AND ID = ICON_LESS_GREEN.
219            WHEN 'GE'.
220            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
221                         LANGU = SY-LANGU AND ID = ICON_GREATER_EQUAL_GREEN.
222            WHEN 'LE'.
223            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
224                         LANGU = SY-LANGU AND ID = ICON_LESS_EQUAL_GREEN.
225            WHEN 'BT'.
226            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
227                      LANGU = SY-LANGU AND ID = ICON_INTERVAL_INCLUDE_GREEN.
228            WHEN 'NB'.
229            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
230                      LANGU = SY-LANGU AND ID = ICON_INTERVAL_EXCLUDE_GREEN.
231            WHEN 'CP'.
232            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
233                      LANGU = SY-LANGU AND ID = ICON_PATTERN_INCLUDE_GREEN.
234            WHEN 'NP'.
235            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
236                      LANGU = SY-LANGU AND ID = ICON_PATTERN_EXCLUDE_GREEN.
237            WHEN OTHERS.
238              CLEAR SA_QUICK_INFO.
239          ENDCASE.
240        ELSE.
241          CASE SA_OPTION.
242            WHEN 'EQ'.
243            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
244                         LANGU = SY-LANGU AND ID = ICON_EQUAL_RED.
245            WHEN 'NE'.
246            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
247                         LANGU = SY-LANGU AND ID = ICON_NOT_EQUAL_RED.
248            WHEN 'GT'.
249            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
250                         LANGU = SY-LANGU AND ID = ICON_GREATER_RED.
251            WHEN 'LT'.
252            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
253                         LANGU = SY-LANGU AND ID = ICON_LESS_RED.
254            WHEN 'GE'.
255            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
256                         LANGU = SY-LANGU AND ID = ICON_GREATER_EQUAL_RED.
257            WHEN 'LE'.
258            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
259                         LANGU = SY-LANGU AND ID = ICON_LESS_EQUAL_RED.
260            WHEN 'BT'.
261            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
262                        LANGU = SY-LANGU AND ID = ICON_INTERVAL_INCLUDE_RED.
263            WHEN 'NB'.
264            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
265                        LANGU = SY-LANGU AND ID = ICON_INTERVAL_EXCLUDE_RED.
266            WHEN 'CP'.
