159    *---------------------------------------------------------------------*
160    *       FORM CURSORFELD_ERMITTELN                                     *
161    *---------------------------------------------------------------------*
162    *       Bestimmt Feld an Cursor-Position (nötig wegen der Feldsymbole)*
163    *---------------------------------------------------------------------*
164    FORM CURSORFELD_ERMITTELN CHANGING CE_TABNAME   LIKE DFIES-TABNAME
165                                       CE_FIELDNAME LIKE DFIES-FIELDNAME.
166
167      DATA: CE_FELD(30),
168            CE_LINE         LIKE SY-CUROW,
169            CE_CURSOROFFSET LIKE SY-CUCOL,
170            CE_TABIX        LIKE SY-TABIX,
171            CE_LINKS        LIKE TLINE OCCURS 0 WITH HEADER LINE,
172            CE_DFIES        LIKE DFIES,
173            CE_SUBRC        LIKE SY-SUBRC,
174            CE_TITLE        LIKE DSYST-DOKTITLE,
175            CE_HLP_LINKS    LIKE TLINE OCCURS 0,
176            CE_VGL_SPALTE   LIKE SY-TABIX.
177
178      CASE DARSTELLUNGSART.
179        WHEN CON_DARST_EINZEL      OR
180             CON_DARST_VERDICHTUNG OR
181             CON_DARST_SUMME       OR
182             CON_DARST_RESTSUMME   OR
183             CON_DARST_UEBERSCHRIFT.
184          IF FLG_VERGLEICH = FALSE AND FLG_ZEITREIHE = FALSE.
185    *       Hilfetext für Feld aus Tabellenspalte für Grund-/Aufrißliste
186            PERFORM KENNZAHLSPALTE_BESTIMMEN USING TRUE.
187          ELSEIF FLG_ZEITREIHE = FALSE.
188    *       Hilfetext für Vergleiche aber nicht für Zeitreihe
189            PERFORM VGL_KENNZAHLENSPALTE_BESTIMMEN
190                    IN PROGRAM (LIS_PROGNAME) IF FOUND
191                    CHANGING CE_VGL_SPALTE.
192          ENDIF.
193
194          IF KENNZAHL_SPALTE    IS INITIAL AND
195             FLG_SUMTAB_TABELLE =  TRUE    AND
196             ( DARSTELLUNGSART = CON_DARST_VERDICHTUNG OR
197               DARSTELLUNGSART = CON_DARST_SUMME       OR
198               DARSTELLUNGSART = CON_DARST_RESTSUMME ).
199            READ TABLE SUM_S000 INDEX SUMTAB_TABIX.
200            SY-TABIX = <SUMTAB_GLOBAL>-HIERSTUFE + ANZ_GRUPPENKRIT.
201            READ TABLE SORT_KENNZAHLEN INDEX SY-TABIX.
202            CE_TABNAME   = SORT_KENNZAHLEN-TABNAME.
203            CE_FIELDNAME = SORT_KENNZAHLEN-FIELDNAME.
204
205          ELSEIF ( FLG_VERGLEICH <> FALSE AND CE_VGL_SPALTE = 1 ) OR
206    *       F1 auf Merkmalsspalte im Vergleich
207            ( KENNZAHL_SPALTE IS INITIAL AND FLG_LIS_REPORTING = TRUE ) OR
208    *       F1 auf Merkmalsspalte bei Grund- und Aufrißliste
209            FLG_ZEITREIHE = TRUE AND SY-CUCOL <= STRICH_ANFANG.
210    *       F1 auf Merkmalsspalte in der Zeitreihe
211    *       F1 auf Merkmalsspalte => Letzten Aufriß ermitteln
212            PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
213            READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
214            CE_TABNAME = GSTRU.
215            IF AKT_DRILLDOWN-FCODE = CON_FCODE_APER.
216    *         Merkmal ist Periode => Feld gemäß Periodizität setzen
217              CASE SAV_SPERI.
218                WHEN CON_SPERI_SPTAG.
219                  CE_FIELDNAME = CON_FELD_SPTAG.
220                WHEN CON_SPERI_SPWOC.
221                  CE_FIELDNAME = CON_FELD_SPWOC.
222                WHEN CON_SPERI_SPMON.
223                  CE_FIELDNAME = CON_FELD_SPMON.
224                WHEN CON_SPERI_SPBUP.
225                  CE_FIELDNAME = CON_FELD_SPBUP.
226              ENDCASE.
227            ELSE.
228    *         Sonstiges Merkmal
229              CE_FIELDNAME = AKT_DRILLDOWN-DDICFELD.
230            ENDIF.
231          ELSE.
232            GET CURSOR FIELD CE_FELD.
233            IF ( NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL AND
234                 CE_FELD CS KENNZAHL_SPALTE-REFFIELD ) OR
235               CE_FELD = 'CON_EINHEIT_UNGUELTIG'.
236    *         Cursor steht auf Einheitenfeld
237              CE_TABNAME   = KENNZAHL_SPALTE-REFTABLE.
238              CE_FIELDNAME = KENNZAHL_SPALTE-REFFIELD.
239            ELSE.
240    *         Cursor steht auf Kennzahl bzw. Überschrift
241              IF FLG_VERGLEICH <> CON_VERGLEICH_KENNZAHL.
242    *           kein Kennzahlenvergleich
243                CE_TABNAME   = KENNZAHL_SPALTE-TABNAME.
244                CE_FIELDNAME = KENNZAHL_SPALTE-FIELDNAME.
245              ELSEIF CE_VGL_SPALTE = 2.
246    *           Kennzahlenvergleich: 1. Kennzahl
247                CE_TABNAME   = KENNZAHL_SPALTE-TABNAME.
248                CE_FIELDNAME = KENNZAHL_SPALTE-FIELDNAME.
249              ELSEIF CE_VGL_SPALTE = 3.
250    *           Kennzahlenvergleich: 2. Kennzahl
251                CE_TABNAME   = MARK_KENNZAHLEN-TABNAME.
252                CE_FIELDNAME = MARK_KENNZAHLEN-FIELDNAME.
253              ENDIF.
254            ENDIF.
255          ENDIF.
256
257        WHEN CON_DARST_AUFRISS.
258    *     Hilfetext für Feld aus Aufrißprotokoll im Seitenkopf
259          PERFORM CURSORPOS_AUFRISSPROTOKOLL IN PROGRAM (LIS_PROGNAME)
260                                             IF FOUND
261                                             CHANGING CE_TABIX.
262          IF CE_TABIX <> 0.
263    *       Cursor steht auf gültigem Feld
264            READ TABLE AKT_DRILLDOWN INDEX CE_TABIX.
265            CE_TABNAME   = AKT_DRILLDOWN-TABFELD.
266            SEARCH CE_TABNAME FOR '-'.
267            WRITE SPACE TO CE_TABNAME+SY-FDPOS.
268            CE_FIELDNAME = AKT_DRILLDOWN-DDICFELD.
269          ENDIF.
270
271        WHEN CON_DARST_KENNZAHL.
272    *     Hilfetext für Kennzahl aus Kennzahlliste (Fkt. 'Alle Kennzahlen')
273          READ TABLE KENNZAHLEN_TAB INDEX TABINDEX.
274          GET CURSOR FIELD CE_FELD.
275          IF ( NOT KENNZAHLEN_TAB-REFFIELD IS INITIAL AND
276               CE_FELD CS KENNZAHLEN_TAB-REFFIELD ) OR
277             CE_FELD = 'CON_EINHEIT_UNGUELTIG'.
278    *       Cursor steht auf Einheitenfeld
279            CE_TABNAME   = KENNZAHLEN_TAB-REFTABLE.
280            CE_FIELDNAME = KENNZAHLEN_TAB-REFFIELD.
281          ELSE.
282    *       Cursor steht auf Kennzahl bzw. Überschrift
283            CE_TABNAME   = KENNZAHLEN_TAB-TABNAME.
284            CE_FIELDNAME = KENNZAHLEN_TAB-FIELDNAME.
285          ENDIF.
286
287        WHEN CON_DARST_STATUS.
288    *     Hilfetext für Sortierkriterien
289          GET CURSOR FIELD CE_FELD.
290          IF CE_FELD(16) = 'SORT_STATUS-FELD'.
291            READ TABLE SORT_KENNZAHLEN INDEX CE_FELD+16.
292            IF SY-SUBRC IS INITIAL.
293              CE_TABNAME   = SORT_KENNZAHLEN-TABNAME.
294              CE_FIELDNAME = SORT_KENNZAHLEN-FIELDNAME.
295            ENDIF.
296          ENDIF.
297
298        WHEN CON_DARST_GRUPPE.
299    *     Hilfetext für Gruppierungskriterium
300          READ TABLE SORT_KENNZAHLEN INDEX TABINDEX.
301          CE_TABNAME   = SORT_KENNZAHLEN-TABNAME.
302          CE_FIELDNAME = SORT_KENNZAHLEN-FIELDNAME.
303
304        WHEN CON_DARST_HIER.
305    *     Anzeige der Hierarchie
306          READ TABLE RSTHIE_TAB WITH KEY
307                                     ID = HIERARCHY_NODE_ID BINARY SEARCH.
308          CHECK SY-SUBRC = 0.
309          READ TABLE RSTTYP_INFO WITH KEY TYPE = RSTHIE_TAB-TYPE.
310          CHECK SY-SUBRC = 0 AND NOT RSTTYP_INFO-ROLNM IS INITIAL.
311    *     AKT_DRILLDOWN-Felder für F1 über Datenelement temporär setzen
312          AKT_DRILLDOWN-SCRTEXT_L = RSTTYP_INFO-SCRTEXT_L.
313          AKT_DRILLDOWN-ROLLNAME  = RSTTYP_INFO-ROLNM.
314      ENDCASE.
315
316      PERFORM SPEZIAL_CURSORFELD_ERMITTELN IN PROGRAM (LIS_PROGNAME)
317                                           CHANGING CE_TABNAME CE_FIELDNAME
318                                           IF FOUND.
319
320    ENDFORM.                               "CURSORFELD_ERMITTELN
