4544             ori_detail-flg_gsber = true.
4545           WHEN con_fcode_aspa.
4546             ori_detail-spart = akt_drilldown-objekt.
4547             ori_detail-flg_spart = true.
4548           WHEN con_fcode_amta.
4549             ori_detail-mtart = akt_drilldown-objekt.
4550             ori_detail-flg_mtart = true.
4551           WHEN con_fcode_admm.
4552             ori_detail-dismm = akt_drilldown-objekt.
4553             ori_detail-flg_dismm = true.
4554           WHEN con_fcode_abkl.
4555             ori_detail-bklas = akt_drilldown-objekt.
4556             ori_detail-flg_bklas = true.
4557           WHEN con_fcode_aper.
