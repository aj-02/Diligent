845             EXPORTING
846                  control_pattern      = 'PH'  " stree_ctl_autow_w_header
847                  initial_header_width = 40
848             EXCEPTIONS
849                  not_available        = 1
850                  OTHERS               = 2.
851      ELSE.
852        CALL FUNCTION 'RS_TREE_CONTROL_PREPARE'
853             EXPORTING
854                  control_pattern = 'P'    " stree_ctl_propfont_autowidth
855             EXCEPTIONS
856                  not_available   = 1
857                  OTHERS          = 2.
858      ENDIF.
859      IF sy-subrc <> 0.
