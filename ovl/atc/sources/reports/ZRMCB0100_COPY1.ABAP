1013   *       FORM ZEITREIHE_KENNZ_WECHSELN                                 *
1014   *---------------------------------------------------------------------*
1015   *       Icon im ZeitreihenPopUp zum Wechseln der Kennzahl             *
1016   *---------------------------------------------------------------------*
1017   FORM ZEITREIHE_KENNZ_WECHSELN.
1018
1019     DATA: ZK_FIELDS        LIKE MCS01 OCCURS 0 WITH HEADER LINE,
1020           ZK_MARKED_FIELDS LIKE MCS01 OCCURS 0 WITH HEADER LINE,
1021           ZK_FLG_MARKED TYPE BOOLEAN,
1022           ZK_NAME(30).
1023     DATA: ZK_SAV_LSIND LIKE SY-LSIND,
1024           ZK_SAV_CPAGE LIKE SY-CPAGE,
1025           ZK_SAV_STARO LIKE SY-STARO,
1026           ZK_SAV_STACO LIKE SY-STACO,
1027           ZK_SAV_CUROW LIKE SY-CUROW,
1028           ZK_SAV_CUCOL LIKE SY-CUCOL.
1029
1030   * Füller der Felder zu Auswahl
1031     LOOP AT AKT_KENNZAHLEN.
1032       IF AKT_KENNZAHLEN-FIELDNAME <> KENNZAHL_SPALTE-FIELDNAME.
1033         MOVE-CORRESPONDING AKT_KENNZAHLEN TO ZK_FIELDS.
1034         APPEND ZK_FIELDS.
1035       ELSE.
1036         MOVE-CORRESPONDING AKT_KENNZAHLEN TO ZK_MARKED_FIELDS.
1037         APPEND ZK_MARKED_FIELDS.
1038         ZK_FIELDS = ZK_MARKED_FIELDS.
1039         APPEND ZK_FIELDS.
1040       ENDIF.
1041     ENDLOOP.
1042
1043     PERFORM TEXT_ERMITTELN USING    6
1044   *                                 'Kennzahlen'
1045                            CHANGING HLP_TEXT1.
1046     PERFORM TEXT_ERMITTELN USING    5
1047   *                                 'Kennzahl'
1048                            CHANGING HLP_TEXT2.
1049     PERFORM TEXT_ERMITTELN USING    66
1050   *                                 'Zeitreihe: Andere Kennzahl'
1051                            CHANGING HLP_TEXT3.
1052
1053     CALL FUNCTION 'MC_POPUP_TO_MARK_FIELDS'
1054          EXPORTING
1055               I_FIELD_NUMBER_MAX     = 1
1056               I_FIELD_NUMBER_MIN     = 1
1057               I_MARK_BY_TABLE        = TRUE
1058               I_OBJECT_NAME_PLURAL   = HLP_TEXT1
1059               I_OBJECT_NAME_SINGULAR = HLP_TEXT2
1060               I_POPUP_TITLE          = HLP_TEXT3
1061          IMPORTING
1062               E_MARKED               = ZK_FLG_MARKED
1063          TABLES
1064               T_FIELDS               = ZK_FIELDS
1065               T_MARKED_FIELDS        = ZK_MARKED_FIELDS
1066          EXCEPTIONS
1067               UNVALID_TEXT_LENGTH    = 1
1068               OTHERS                 = 2.
1069
1070     IF ZK_FLG_MARKED = TRUE.
1071       READ TABLE ZK_MARKED_FIELDS INDEX 1.
1072       READ TABLE AKT_KENNZAHLEN
1073                  WITH KEY FIELDNAME = ZK_MARKED_FIELDS-FIELDNAME.
1074       IF KENNZAHL_SPALTE-FIELDNAME <> ZK_MARKED_FIELDS-FIELDNAME.
1075   *     andere Kennzahl gewählt
1076         MOVE-CORRESPONDING AKT_KENNZAHLEN TO KENNZAHL_SPALTE.
1077   *     Breite zurücksetzen (evtl. hier intelligentere Lösung notwendig)
1078   *     zeitreihen_kennzahl_breite = kennzahl_spalte-outputlen.
1079   *     Feldsymbole neu zuweisen
1080         PERFORM ZEITREIHE_FELDSYMBOLE_ZUWEISEN.
1081   *     alte Listen- und Cursorposition merken
1082         ZK_SAV_LSIND = SY-LSIND.
1083         ZK_SAV_CPAGE = SY-CPAGE.
1084         ZK_SAV_STARO = SY-STARO.
1085         ZK_SAV_STACO = SY-STACO.
1086         ZK_SAV_CUROW = SY-CUROW.
1087         ZK_SAV_CUCOL = SY-CUCOL.
1088   *     Zeitreihe neu ausgeben
1089         PERFORM ZEITREIHE_AUSGEBEN_VORBEREITEN USING TRUE.
1090         PERFORM ZEITREIHE_AUSGEBEN USING ZEITREIHEN_ERSTE_SPALTE
1091                                          ZEITREIHEN_ANZ_SPALTEN.
1092   *     Listen- und Cursorposition wiederherstellen
1093         SCROLL LIST INDEX ZK_SAV_LSIND TO PAGE   ZK_SAV_CPAGE
1094                                        LINE      ZK_SAV_STARO.
1095         SCROLL LIST INDEX ZK_SAV_LSIND TO COLUMN ZK_SAV_STACO.
1096         SET CURSOR ZK_SAV_CUCOL ZK_SAV_CUROW.
1097       ENDIF.
1098     ENDIF.
1099
1100   ENDFORM.                               "ZEITREIHE_KENNZ_WECHSELN
