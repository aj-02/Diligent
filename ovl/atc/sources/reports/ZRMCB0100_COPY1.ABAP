6911             APPEND int_ex_kennz_plan_sub.
6912             PERFORM uebernahme_merkmale_farbe.
6913           ENDLOOP.
6914         ENDIF.
6915       ELSE.
6916         IF int_mcyc-anzper > 0.
6917   *--------- Prognosefall
6918           CLEAR int_ex_kennz_forc_sub.
6919           REFRESH int_ex_kennz_forc_sub.
6920           CLEAR int_ex_kennz_plan_sub.
6921           REFRESH int_ex_kennz_plan_sub.
6922           LOOP AT hlp_kennz_plan_sub2.
6923   *--------- Prognose
6924             int_ex_kennz_forc_sub = hlp_kennz_plan_sub2.
6925             APPEND int_ex_kennz_forc_sub.
6926           ENDLOOP.
6927   *--------- Planzahl
6928           LOOP AT hlp_kennz_plan_sub.
6929             int_ex_kennz_plan_sub = hlp_kennz_plan_sub.
6930             APPEND int_ex_kennz_plan_sub.
6931           ENDLOOP.
6932           PERFORM uebernahme_merkmale_farbe.
6933         ELSE.
6934   *--------- Ist-Daten-Fall
6935           CLEAR int_ex_kennz_sub.
6936           REFRESH int_ex_kennz_sub.
6937           CLEAR int_ex_kennz_plan_sub.
6938           REFRESH int_ex_kennz_plan_sub.
6939           LOOP AT hlp_kennz_sub.
6940   *--------- Ist-Daten
6941             int_ex_kennz_sub = hlp_kennz_sub.
6942             APPEND int_ex_kennz_sub.
6943           ENDLOOP.
6944   *--------- Planzahl
6945           LOOP AT hlp_kennz_plan_sub.
6946             int_ex_kennz_plan_sub = hlp_kennz_plan_sub.
6947             APPEND int_ex_kennz_plan_sub.
6948           ENDLOOP.
6949           PERFORM uebernahme_merkmale_farbe.
6950         ENDIF.
6951       ENDIF.
6952     ENDIF.
6953
6954   *--------- Trendanalyse
6955     IF int_mcyc-trend <> space.
6956       PERFORM uebernahme_merkmale_farbe.
6957     ENDIF.
6958
6959   *--------- Nicht numerische Kennzahl
6960     IF int_mcyc-kzwert = true.
6961       PERFORM uebernahme_merkmale_farbe.
6962     ENDIF.
