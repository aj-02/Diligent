4570                 ori_detail-flg_spbup = true.
4571             ENDCASE.
4572         ENDCASE.
4573       ELSE.
4574         EXIT.
4575       ENDIF.
4576     ENDLOOP.
4577     IF darstellungsart = con_darst_einzel.
4578   *Auf welcher Zeile steht der Cursor ?
4579       READ TABLE akt_drilldown INDEX lines.
4580       IF sy-subrc = 0.
4581         CASE akt_drilldown-fcode.
4582           WHEN con_fcode_awrk.
4583             ori_detail-werks = akt_objekt.
4584             ori_detail-flg_werks = true.
4585           WHEN con_fcode_algo.
4586             ori_detail-lgort = akt_objekt+4(4).
4587             ori_detail-flg_lgort = true.
4588           WHEN con_fcode_amat.
4589             ori_detail-matnr = akt_objekt.
4590             ori_detail-flg_matnr = true.
4591           WHEN con_fcode_adis.
4592             ori_detail-dispo = akt_objekt.
4593             ori_detail-flg_dispo = true.
4594           WHEN con_fcode_agsb.
4595             ori_detail-gsber = akt_objekt.
4596             ori_detail-flg_gsber = true.
4597           WHEN con_fcode_awgp.
4598             ori_detail-matkl = akt_objekt.
4599             ori_detail-flg_matkl = true.
4600           WHEN con_fcode_aspa.
4601             ori_detail-spart = akt_objekt.
4602             ori_detail-flg_spart = true.
4603           WHEN con_fcode_amta.
4604             ori_detail-mtart = akt_objekt.
4605             ori_detail-flg_mtart = true.
4606           WHEN con_fcode_admm.
4607             ori_detail-dismm = akt_objekt.
4608             ori_detail-flg_dismm = true.
4609           WHEN con_fcode_abkl.
4610             ori_detail-bklas = akt_objekt.
4611             ori_detail-flg_bklas = true.
