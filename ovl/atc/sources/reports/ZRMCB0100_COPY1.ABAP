1157   *       FORM KENNZAHL_AUSGEBEN_ACC                                    *
1158   *---------------------------------------------------------------------*
1159   *       Kennzahl ausgeben fuer Accessibility                          *
1160   *---------------------------------------------------------------------*
1161   *  -->  KA_INDEX      : Index der Kennzahl: > 0 in AKT_KENNZAHLEN     *
1162   *                                           < 0 in KENNZAHLEN_TAB     *
1163   *  -->  KA_KENNZAHL   : Kennzahl                                      *
1164   *  -->  KA_SUMME      : Kennzahlsumme                                 *
1165   *  -->  KA_EINHEIT    : Einheit der Kennzahl                          *
1166   *  <--  KA_RETURNCODE : Returncode                                    *
1167   *---------------------------------------------------------------------*
1168   FORM KENNZAHL_AUSGEBEN_ACC USING VALUE(KA_INDEX) LIKE SY-TABIX
1169                                VALUE(KA_KENNZAHL) TYPE SIMPLE
1170                                KA_SUMME           TYPE SIMPLE
1171                                KA_EINHEIT       TYPE C
1172                          CHANGING KA_RETURNCODE LIKE SY-SUBRC.
1173
1174     LOCAL: SPALTEN_BREITE,
1175            SPALTEN_BREITE_P.
1176
1177     STATICS: KA_FLG_FIRST             TYPE BOOLEAN VALUE TRUE,
1178              KA_FLG_KENNZAHL_AUSGEBEN TYPE BOOLEAN VALUE TRUE,
1179              KA_FLG_EXIST             TYPE BOOLEAN VALUE TRUE,
1180              KA_DUMMYZEIT             TYPE T VALUE '111111',
1181              KA_ZEITMASKE(8).
1182
1183     DATA: KA_BREITE          LIKE SPALTEN_BREITE,
1184           KA_PROZENTZAHL     TYPE P DECIMALS 2,
1185           KA_QUICKINFO(255),
1186           KA_CONVEXIT(7)     VALUE '==     ',
1187           KA_SPALTEN_HAELFTE LIKE SPALTEN_BREITE,
1188           KA_FACTOR          TYPE N,
1189           KA_FLTP_GUELTIG    TYPE BOOLEAN VALUE TRUE,
1190           KA_TEXT_AUSGABE(30) type C,
1191           KA_HELP_BREITE LIKE SPALTEN_BREITE,
1192           KA_NUR TYPE I,
1193           KA_NUR_HELP TYPE I.
1194           .
1195
1196     FIELD-SYMBOLS: <KA_FACTOR>    LIKE FACTORS-F1,
1197                    <KA_LENGTH>.
1198
1199     IF DARSTELLUNGSART = 'E'.
1200
1201       KA_NUR = COLOR_TAB-COL_MERKMAL.
1202       IF KA_NUR = 5.
1203          KA_NUR_HELP = 501.
1204       ELSEIF KA_NUR = 3.
1205          KA_NUR_HELP = 502.
1206       ELSEIF KA_NUR = 6.
1207          KA_NUR_HELP = 503.
1208       ELSE.
1209          CLEAR KA_NUR_HELP.
1210       ENDIF.
1211
1212       IF KA_NUR_HELP <> 0.
1213        SELECT SINGLE NTEXT FROM TMCRT INTO KA_QUICKINFO
1214               WHERE SPRAS = SY-LANGU AND TXTNR = KA_NUR_HELP.
1215       ELSE.
1216         CLEAR KA_QUICKINFO.
1217       ENDIF.
1218     ELSE.
1219         CLEAR KA_QUICKINFO.
1220     ENDIF.
1221
1222     IF KA_FLG_FIRST = TRUE.
1223   *   Maske für Ausgabe der Uhrzeit ermitteln.
1224       KA_FLG_FIRST = FALSE.
1225       WRITE KA_DUMMYZEIT TO KA_ZEITMASKE.
1226       TRANSLATE KA_ZEITMASKE USING '1_'.
1227     ENDIF.
1228
1229     IF KENNZAHL_ANZAHL < KA_INDEX.
1230   *   Kennzahlausgabe beendet => HIDE-Information ausgeben.
1231       HIDE: <AUSTAB_GLOBAL>-OBJEKT, <AUSTAB_GLOBAL>-ID,
1232             DARSTELLUNGSART, AUSTAB_TABIX, SUMTAB_TABIX.
1233       KA_RETURNCODE = 1.
1234       EXIT.
1235     ENDIF.
1236
1237   * Kennzahleigenschaften ermitteln
1238     IF KA_INDEX > 0.
1239   *   Ausgabe einer aktuellen Kennzahl
1240       READ TABLE AKT_KENNZAHLEN INDEX KA_INDEX.
1241     ELSEIF KA_INDEX < 0.
1242   *   Ausgabe einer Kennzahlen aus der KENNZAHLEN_TAB
1243       KA_INDEX = - KA_INDEX.
1244       READ TABLE KENNZAHLEN_TAB INDEX KA_INDEX.
1245       CLEAR AKT_KENNZAHLEN.
1246       MOVE-CORRESPONDING KENNZAHLEN_TAB TO AKT_KENNZAHLEN.
1247     ELSE.
1248   *   Einzelausgabe der Kennzahl (z.B. wie bei Fkt. 'Alle Kennzahlen')
1249       MOVE-CORRESPONDING KENNZAHLEN_TAB TO AKT_KENNZAHLEN.
1250     ENDIF.
1251
1252     SPALTEN_BREITE = AKT_KENNZAHLEN-OUTPUTLEN.
1253     IF AKT_KENNZAHLEN-REFLEN IS INITIAL OR
1254        FLG_EINHEITENZEILE    <> FALSE.
1255   *   Feld hat keine Einheit
1256       SPALTEN_BREITE_P = AKT_KENNZAHLEN-OUTPUTLEN.
1257     ELSE.
1258   *   Feld hat Einheit
1259       SPALTEN_BREITE_P = AKT_KENNZAHLEN-OUTPUTLEN +
1260                          AKT_KENNZAHLEN-REFLEN + 1.
1261     ENDIF.
1262
1263   * Feldsymbol setzen für Prüfung, ob Quickinfo nötig ist
1264   * (entfällt vorerst aus Performance-Gründen, außer bei TYP D, T, C
1265   * ASSIGN KA_QUICKINFO(SPALTEN_BREITE) TO <KA_QUICKINFO>.
1266
1267   * prüfen, ob Kennzahl angezeigt werden soll
1268     IF FLG_LIS_REPORTING       =  FALSE              AND
1269        DARSTELLUNGSART         <> CON_DARST_EINZEL   AND
1270        DARSTELLUNGSART         <> CON_DARST_KENNZAHL AND
1271        AKT_KENNZAHLEN-GESAMTKZ =  FALSE.
1272       KA_FLG_KENNZAHL_AUSGEBEN = FALSE.
1273     ELSE.
1274       KA_FLG_KENNZAHL_AUSGEBEN = TRUE.
