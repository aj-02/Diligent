420    *---------------------------------------------------------------------*
421    *       FORM RANGES_FUELLEN                                           *
422    *---------------------------------------------------------------------*
423    *       Füllen der SL- bzw. EX-Ranges aus der Tabelle RF_TAB, die     *
424    *       die erlaubten Einträge in der Struktur MCYB enthält           *
425    *---------------------------------------------------------------------*
426    *  <->  RF_TAB           : Tabelle mit erlaubten Einträgen            *
427    *  -->  RF_RANGES_PRAEFIX: 'SL_' oder 'EX_'                           *
428    *---------------------------------------------------------------------*
429    FORM ranges_fuellen TABLES rf_tab STRUCTURE mcyb
430                        USING  rf_ranges_praefix TYPE CSEQUENCE.
431
432      DATA : rf_feldname(30),
433             rf_sav_fname LIKE mcyb-fname.
434      DATA:  l_change_tplnr_to_strno LIKE SY-datar.               "1129287
435      FIELD-SYMBOLS: <rf_ranges_tab> TYPE table,
436                     <rf_ranges>,
437                     <rf_ranges_sign>,
438                     <rf_ranges_option>,
439                     <rf_ranges_low>,
440                     <rf_ranges_high>.
441
442    * Ranges-Tabellen löschen
443      LOOP AT drilldown_fcodes WHERE fcode <> con_fcode_aper.
444        CONCATENATE rf_ranges_praefix drilldown_fcodes-ranges_suf '[]'
445                    INTO rf_feldname.
446        ASSIGN (rf_feldname) TO <rf_ranges_tab>.
447        REFRESH <rf_ranges_tab>.
448      ENDLOOP.
449
450      LOOP AT rf_tab WHERE valsign <> space.
451        IF rf_sav_fname <> rf_tab-fname.
452    *     Wechsel des Feldnames => Feldsymbole neu zuweisen
453          rf_sav_fname = rf_tab-fname.
454          READ TABLE drilldown_fcodes WITH KEY ddicfeld = rf_sav_fname.
455          CONCATENATE rf_ranges_praefix drilldown_fcodes-ranges_suf
456                      INTO rf_feldname.
457          CASE drilldown_fcodes-domname.                          "1129287
458            WHEN 'TPLNR'.                                         "1129287
459              CASE drilldown_fcodes-tabfeld(4).                   "1129287
460                WHEN 'S061' OR 'S063' OR 'S070' OR 'S115'.        "1129287
461                  rf_feldname = 'STRNO'.                          "1129287
462                  l_change_tplnr_to_strno = 'X'.                  "1129287
463              ENDCASE.                                            "1129287
464            WHEN OTHERS.                                          "1129287
465    *       ..continue...                                         "1129287
466          ENDCASE.                                                "1129287
467          ASSIGN (rf_feldname) TO <rf_ranges>.
468          ASSIGN COMPONENT 1 OF STRUCTURE <rf_ranges> TO <rf_ranges_sign>.
469          ASSIGN COMPONENT 2 OF STRUCTURE <rf_ranges> TO <rf_ranges_option>.
470          ASSIGN COMPONENT 3 OF STRUCTURE <rf_ranges> TO <rf_ranges_low>.
471          ASSIGN COMPONENT 4 OF STRUCTURE <rf_ranges> TO <rf_ranges_high>.
472          CONCATENATE rf_feldname '[]' INTO rf_feldname.
473          ASSIGN (rf_feldname) TO <rf_ranges_tab>.
474        ENDIF.
475        <rf_ranges_sign>   = rf_tab-valsign.
476        <rf_ranges_option> = rf_tab-valoption.
477        IF NOT l_change_tplnr_to_strno IS INITIAL.                "1129287
478          IF NOT rf_tab-vallow IS INITIAL.                        "1129287
479            CALL FUNCTION 'CONVERSION_EXIT_TPLNR_OUTPUT'          "1129287
480                 EXPORTING                                        "1129287
481                    INPUT  = rf_tab-vallow                        "1129287
482                 IMPORTING                                        "1129287
483                    OUTPUT = rf_tab-vallow.                       "1129287
484          ENDIF.                                                  "1129287
485          IF NOT rf_tab-valhigh IS INITIAL.                       "1129287
486            CALL FUNCTION 'CONVERSION_EXIT_TPLNR_OUTPUT'          "1129287
487                 EXPORTING                                        "1129287
488                    INPUT  = rf_tab-valhigh                       "1129287
489                 IMPORTING                                        "1129287
490                    OUTPUT = rf_tab-valhigh.                      "1129287
491          ENDIF.                                                  "1129287
492        ENDIF.                                                    "1129287
493        <rf_ranges_low>    = rf_tab-vallow.
494        <rf_ranges_high>   = rf_tab-valhigh.
495        APPEND <rf_ranges> TO <rf_ranges_tab>.
496      ENDLOOP.
497    ENDFORM.                               "RANGES_FUELLEN
