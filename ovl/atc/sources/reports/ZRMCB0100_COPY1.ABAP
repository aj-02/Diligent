2569   *       FORM PROGNOSE_AUF_ZEITREIHE                                   *
2570   *---------------------------------------------------------------------*
2571   *       ........                                                      *
2572   *---------------------------------------------------------------------*
2573   FORM prognose_auf_zeitreihe.
2574
2575     DATA: kz_dummy.
2576     DATA: pa_anzperioden LIKE sy-tabix.
2577     DATA: pa_summe TYPE f.
2578   * PERIODEN_RAUS enthält Anzahl Zwischenperioden zwischen SY-datum-Period
2579   * und letzter Periode in SL_SPXXX
2580
2581   *--------- Anfangsnullen wegstreichen, mind. 1 Zeile bleibt stehen
2582     LOOP AT zeitreihe.
2583       IF zeitreihe-value <> 0.
2584         EXIT.
2585       ELSE.
2586         DELETE zeitreihe.
2587       ENDIF.
2588     ENDLOOP.
2589     DESCRIBE TABLE zeitreihe LINES pa_anzperioden.
2590     IF pa_anzperioden = 0.
2591   *--------- Nur 1 Wert übrig: 0 einfuegen
2592       CLEAR zeitreihe.
2593       INSERT zeitreihe INDEX 1.
2594       pa_anzperioden = 1.
2595     ENDIF.
2596
2597   *-------- Statistischer Test:
2598     IF pa_anzperioden < 5.
2599       pa_summe = 0.
2600       LOOP AT zeitreihe.
2601         pa_summe = pa_summe + zeitreihe-value.
2602       ENDLOOP.
2603       exc_grundwert = pa_summe / pa_anzperioden.
2604       exc_delta = 0.
2605     ELSE.
2606   *-------- Ab 5 Perioden: Test auf Trend
2607       PERFORM check_trend_statistik USING true
2608                                           kz_dummy
2609                                           exc_grundwert
2610                                           exc_delta.
2611     ENDIF.
2612
2613   *-------- Ergebnis ist Wert fuer sy-datum-Periode !!!!!!!
2614     DO perioden_raus TIMES.
2615       exc_grundwert = exc_grundwert + exc_delta.
2616     ENDDO.
2617
2618   *--------- Eigentliche Prognose fuer entspr. Anzahl Perioden
2619     CLEAR zeitreihe.
2620     REFRESH zeitreihe.
2621     zeitreihe-value = exc_grundwert.
2622     DO int_mcyc-anzper TIMES.
2623       zeitreihe-value = zeitreihe-value + exc_delta.
2624       APPEND zeitreihe.
2625     ENDDO.
2626
2627   ENDFORM.
