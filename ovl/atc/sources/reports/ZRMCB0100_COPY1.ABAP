164    *       FORM kennzahlen_zum_vergleich_auswaehlen                       *
165    *---------------------------------------------------------------------*
166    *       Auswählen der Kennzahlen, die zum Vergleich angeboten werden  *
167    *       --> ka_akt_kz : Kennzahl, auf der der Cursor steht.           *
168    *       --> ka_alle_kz: Menge der Kennzahlen, aus denen die Kennzahlen*
169    *           auszuwählen sind, die zum Vergleich angeboten werden      *
170    *           sollen                                                    *
171    *       <-- ka_vgl_kz:  Menge der der Kennzahlen, die zum Vergleich   *
172    *           angeboten werden.                                         *
173    *---------------------------------------------------------------------*
174    FORM KENNZAHLEN_ZUM_VERGL_AUSW
175                      TABLES KA_ALLE_KZ STRUCTURE AKT_KENNZAHLEN
176                             KA_VGL_KZ  STRUCTURE AKT_KENNZAHLEN
177                      USING  KA_AKT_KZ  STRUCTURE AKT_KENNZAHLEN.
178
179      DATA: KA_AKT_KZ_UNIT_DATATYPE LIKE UNIT_TAB-DATATYPE.
180
181      REFRESH KA_VGL_KZ.
182      IF NOT KA_AKT_KZ-REFFIELD IS INITIAL.
183        READ TABLE UNIT_TAB WITH KEY FIELDNAME = KA_AKT_KZ-REFFIELD.
184        KA_AKT_KZ_UNIT_DATATYPE = UNIT_TAB-DATATYPE.
185      ENDIF.
186      LOOP AT KA_ALLE_KZ WHERE FIELDNAME <> KA_AKT_KZ-FIELDNAME.
187        IF NOT KA_AKT_KZ-REFFIELD IS INITIAL.
188    *     Kennzahl mit Einheitenfeld
189          IF KA_AKT_KZ-REFFIELD = CON_FELD_UNIT_PERCENT.
190            IF KA_ALLE_KZ-REFFIELD = CON_FELD_UNIT_PERCENT.
191              MOVE-CORRESPONDING KA_ALLE_KZ TO KA_VGL_KZ.
192              APPEND KA_VGL_KZ.
193            ENDIF.
194          ELSE.
195            IF NOT KA_ALLE_KZ-REFFIELD IS INITIAL.
196              READ TABLE UNIT_TAB WITH KEY FIELDNAME = KA_ALLE_KZ-REFFIELD.
197              IF SY-SUBRC = 0.
198                IF UNIT_TAB-DATATYPE = KA_AKT_KZ_UNIT_DATATYPE.
199                  MOVE-CORRESPONDING KA_ALLE_KZ TO KA_VGL_KZ.
200                  APPEND KA_VGL_KZ.
201                ENDIF.
202              ENDIF.                       "if sy-subrc = 0.
203            ENDIF.  "if not ka_alle_kz-reffield is initial.
204          ENDIF.  "if ka_akt_kz-reffield = con_feld_unit_percent.
205        ELSE.
206    *     ka_akt_kz-reffield = initial; Kennzahl ohne Einheitenfeld
207          IF KA_ALLE_KZ-REFFIELD IS INITIAL.
208            IF KA_AKT_KZ-INTTYPE CA 'NXPF'.
209              IF KA_ALLE_KZ-INTTYPE  CA 'NXPF'.
210                MOVE-CORRESPONDING KA_ALLE_KZ TO KA_VGL_KZ.
211                APPEND KA_VGL_KZ.
212              ENDIF.
213            ELSE.
214              IF KENNZAHLEN_TAB-DATATYPE = KENNZAHL_SPALTE-DATATYPE.
215                MOVE-CORRESPONDING KA_ALLE_KZ TO KA_VGL_KZ.
216                APPEND KA_VGL_KZ.
217              ENDIF.
218            ENDIF.                         "if ka_akt_kz-inttype ca 'NXPF'.
219          ENDIF.    "if ka_alle_kz-reffield is initial.
220        ENDIF.   "if not ka_akt_kz-reffield is initial.
221      ENDLOOP.                             "loop at kennzahlen_tab where ...
222
223    ENDFORM.                               "kennzahlen_zum_vergleich_ausw
