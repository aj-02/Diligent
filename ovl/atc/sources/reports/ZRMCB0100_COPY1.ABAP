470    *---------------------------------------------------------------------*
471    *       FORM SEITENKOPF_KGES_AUSGEBEN                                 *
472    *---------------------------------------------------------------------*
473    *       Ausgabe Überschrift bei der Anzeige aller Kennzahlen          *
474    *---------------------------------------------------------------------*
475    FORM SEITENKOPF_KGES_AUSGEBEN.
476
477      DATA: SK_ZEILEN LIKE SY-TABIX,
478            SK_OBJEKT LIKE AUSTAB_GLOBAL-Text,
479            SK_OBJEKTLAENGE LIKE SY-COLNO.
480      FIELD-SYMBOLS <SK_OBJEKT>.
481
482      SKIP.
483      DESCRIBE FIELD SK_OBJEKT LENGTH SK_OBJEKTLAENGE IN CHARACTER MODE.
484      SK_OBJEKTLAENGE = SK_OBJEKTLAENGE + 22.
485      IF SK_OBJEKTLAENGE > SY-LINSZ.
486        SK_OBJEKTLAENGE = SY-LINSZ.
487      ENDIF.
488      SK_OBJEKTLAENGE = SK_OBJEKTLAENGE - 22.
489      ASSIGN SK_OBJEKT(SK_OBJEKTLAENGE) TO <SK_OBJEKT>.
490      DESCRIBE TABLE AKT_DRILLDOWN LINES SK_ZEILEN.
491      LOOP AT AKT_DRILLDOWN.
492        IF SY-TABIX = SK_ZEILEN.
493          IF DARSTELLUNGSART = CON_DARST_EINZEL.
494    *       Merkmal unter Cursor zusätzlich ausgeben
495            IF AKT_ID IS INITIAL.
496    *         Merkmal
497              PERFORM OBJEKTTEXT_ERMITTELN USING    AKT_DRILLDOWN-DOMNAME
498                                                    AKT_DRILLDOWN-ROLLNAME
499                                                    AKT_DRILLDOWN-CONVEXIT
500                                                    AKT_DRILLDOWN-OUTPUTLEN
501                                                    AKT_OBJEKT
502                                           CHANGING SK_OBJEKT.
503              WRITE: /(20) AKT_DRILLDOWN-SCRTEXT_L COLOR COL_BACKGROUND
504                           INTENSIFIED, <SK_OBJEKT>.
505            ELSE.
506    *         Hierarchieknoten => Textermittlung über Knotentyp
507              READ TABLE RSTHIE_TAB WITH KEY ID = AKT_ID BINARY SEARCH.
508              IF RSTTYP_INFO-TYPE <> RSTHIE_TAB-TYPE.
509                READ TABLE RSTTYP_INFO WITH KEY TYPE = RSTHIE_TAB-TYPE.
510              ENDIF.
511              PERFORM OBJEKTTEXT_ERMITTELN USING    RSTTYP_INFO-TDOMNM
512                                                    SPACE
513                                                    RSTTYP_INFO-CONVEXIT
514                                                    RSTTYP_INFO-OUTPUTLEN
515                                                    AKT_OBJEKT
516                                           CHANGING SK_OBJEKT.
517              WRITE: /(20) RSTTYP_INFO-SCRTEXT_L COLOR COL_BACKGROUND
518                           INTENSIFIED, <SK_OBJEKT>.
519            ENDIF.
520            ULINE.
521          ELSEIF SY-TABIX > 1.
522    *       Strich nur bei Liststufen > 1 notwendig
523            ULINE (68).
524          ENDIF.
525        ELSE.
526          PERFORM OBJEKTTEXT_ERMITTELN USING    AKT_DRILLDOWN-DOMNAME
527                                                AKT_DRILLDOWN-ROLLNAME
528                                                AKT_DRILLDOWN-CONVEXIT
529                                                AKT_DRILLDOWN-OUTPUTLEN
530                                                AKT_DRILLDOWN-OBJEKT
531                                       CHANGING SK_OBJEKT.
532    *     Merkmal ausgeben
533          WRITE: /(20) AKT_DRILLDOWN-SCRTEXT_L COLOR COL_BACKGROUND
534                       INTENSIFIED, <SK_OBJEKT>.
535        ENDIF.
536      ENDLOOP.
537
538    ENDFORM.                               "SEITENKOPF_KGES_AUSGEBEN
