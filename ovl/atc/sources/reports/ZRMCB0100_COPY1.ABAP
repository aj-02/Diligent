570    *---------------------------------------------------------------------*
571    *       FORM XXL_EINHEIT_FUELLEN                                      *
572    *---------------------------------------------------------------------*
573    *       Einheitenfeld in XXL_DATA füllen, wenn die aktuelle Kennzahl  *
574    *       eine Einheit hat. Bei Währungsfeldern werden die vorkommenden *
575    *       Währungen pro Spalte zur späteren Semantikermittl. gesammelt. *
576    *---------------------------------------------------------------------*
577    *  -->  XF_EINHEIT       : Einheit der aktuellen Kennzahl             *
578    *  -->  VALUE(XF_SPALTE) : Aktuelle Spaltennr.                        *
579    *---------------------------------------------------------------------*
580    FORM XXL_EINHEIT_FUELLEN USING XF_EINHEIT       TYPE CSEQUENCE
581                                   VALUE(XF_SPALTE) LIKE SY-TABIX.
582
583      DATA: XF_XXL_EINHEITEN_FELD(35) VALUE 'UNIT_',
584            XF_CONV_FUNCTION_NAME(28).
585      FIELD-SYMBOLS: <XF_XXL_EINHEIT>.
586
587      IF XXL_KENNZAHLEN-REFLEN <> 0.
588    *   Kennzahl hat Einheit
589        XF_XXL_EINHEITEN_FELD+5 = XXL_KENNZAHLEN-FIELDNAME.
590        ASSIGN COMPONENT XF_XXL_EINHEITEN_FELD OF STRUCTURE XXL_DATA
591                                               TO <XF_XXL_EINHEIT>.
592        IF SY-SUBRC NE 0.                             " note 153946, ver.02
593    *     "XXL-Funktion nicht möglich"
594          MESSAGE E076 WITH AKT_KENNZAHLEN-SCRTEXT_L.
595        ENDIF.
596        IF XXL_KENNZAHLEN-DATATYPE = CON_DATATYPE_CURR.
597          IF NOT ANALYSE_WAEHRUNG IS INITIAL.
598    *       Analysewährung als Einheit setzen
599            <XF_XXL_EINHEIT> = ANALYSE_WAEHRUNG.
600          ELSE.
601            <XF_XXL_EINHEIT> = XF_EINHEIT.
602    *       Währung spaltenabhängig sammeln
603            XXL_WAEHRUNGEN-SPALTE = XF_SPALTE.
604            XXL_WAEHRUNGEN-WAERS  = XF_EINHEIT.
605            READ TABLE XXL_WAEHRUNGEN WITH KEY XXL_WAEHRUNGEN BINARY SEARCH.
606            IF SY-SUBRC <> 0.
607    *         Währungseintrag für diese Spalte noch nicht vorhanden
608              XXL_WAEHRUNGEN-SPALTE = XF_SPALTE.
609              XXL_WAEHRUNGEN-WAERS  = XF_EINHEIT.
610              INSERT XXL_WAEHRUNGEN INDEX SY-TABIX.
611            ENDIF.
612          ENDIF.
613        ELSE.
614          <XF_XXL_EINHEIT> = XF_EINHEIT.
615        ENDIF.
616      ENDIF.
617    ENDFORM.                               "XXL_EINHEIT_FUELLEN
