1584         ENDIF.
1585         ASSIGN SA_KRITERIUMTEXT(SA_SCRTEXT_LENGTH) TO <SA_SCRTEXT>.
1586         REPLACE '&' WITH <SA_SCRTEXT> INTO SA_ZEILE.
1587   *     Aufbereiten der Statuszeile für Ausgabe
1588         SA_EINTRAEGE = AUSTAB_EINTRAEGE.
1589         CONDENSE SA_EINTRAEGE.
1590         IF NOT AUSTAB_ANGEZEIGTE_EINTRAEGE IS INITIAL AND
1591            AUSTAB_ANGEZEIGTE_EINTRAEGE     <> AUSTAB_EINTRAEGE.
1592           SA_ANGEZEIGTE_EINTRAEGE = AUSTAB_ANGEZEIGTE_EINTRAEGE.
1593           CONDENSE SA_ANGEZEIGTE_EINTRAEGE.
1594           CONCATENATE SA_ANGEZEIGTE_EINTRAEGE '(' SA_EINTRAEGE ')'
1595                       INTO SA_EINTRAEGE.
1596         ENDIF.
1597         REPLACE '&' WITH SA_EINTRAEGE INTO SA_ZEILE.
1598         SA_SCRTEXT_LENGTH =
1599           cl_abap_list_utilities=>dynamic_output_length( SA_ZEILE ).
1600         WRITE AT SA_HLP_COLNO(SA_SCRTEXT_LENGTH) SA_ZEILE.
1601         SA_HLP_COLNO = SA_HLP_COLNO +
1602           cl_abap_list_utilities=>dynamic_output_length( SA_ZEILE ) + 2.
1603
1604       ELSE.
1605         IF FLG_TOPLISTE = TRUE.
1606           PERFORM TEXT_ERMITTELN USING    020
1607   *                                       'Top & &'
1608                                  CHANGING SA_ZEILE.
1609         ELSE.
1610           PERFORM TEXT_ERMITTELN USING    021
1611   *                                      'Last & &'
1612                                  CHANGING SA_ZEILE.
1613         ENDIF.
1614         SA_HLP_ANZAHL = HITLISTEN_GROESSE.
1615         IF HITLISTEN_GROESSE < 10.
1616           REPLACE '&' WITH SA_HLP_ANZAHL+2(1) INTO SA_ZEILE.
1617         ELSEIF HITLISTEN_GROESSE < 100.
1618           REPLACE '&' WITH SA_HLP_ANZAHL+1(2) INTO SA_ZEILE.
1619         ELSE.
1620           REPLACE '&' WITH SA_HLP_ANZAHL(3) INTO SA_ZEILE.
1621         ENDIF.
1622   *     Kennzahlentext ermitteln
1623         READ TABLE AKT_KENNZAHLEN WITH KEY AUSTABFELD = HITL_KRITERIUM.
1624         PERFORM KENNZAHLENTEXT_ERMITTELN USING    AKT_KENNZAHLEN
1625                                          CHANGING SA_KRITERIUMTEXT.
1626         REPLACE '&' WITH SA_KRITERIUMTEXT INTO SA_ZEILE.
1627         SA_SCRTEXT_LENGTH =
1628           cl_abap_list_utilities=>dynamic_output_length( SA_ZEILE ).
1629         WRITE AT SA_HLP_COLNO(SA_SCRTEXT_LENGTH) SA_ZEILE.
1630         SA_HLP_COLNO = SA_HLP_COLNO +
1631           cl_abap_list_utilities=>dynamic_output_length( SA_ZEILE ) + 2.
1632       ENDIF.
1633     ENDIF.
1634
1635     IF NOT SORT_KRITERIUM IS INITIAL AND FLG_HIERARCHIE = FALSE.
1636   *   Sortierkriterien ausgeben
1637       POSITION SA_HLP_COLNO.
1638       FLG_SORT_ABST = '*'.
1639       LOOP AT SORT_KENNZAHLEN WHERE FLG_GRUPPE = FALSE.
1640         ASSIGN COMPONENT SY-TABIX OF STRUCTURE SORT_STATUS
1641                                                           TO <SA_SCRTEXT>.
1642         IF FLG_SORT_ABST <> SORT_KENNZAHLEN-FLG_ABST.
1643           FLG_SORT_ABST = SORT_KENNZAHLEN-FLG_ABST.
1644   *       Icon ausgeben
1645           PERFORM SORT_ICON_AUSGEBEN USING FLG_SORT_ABST.
1646         ENDIF.
1647   *     Sortierkriterium ausgeben
1648         IF SORT_KENNZAHLEN-OUTPUTLEN < 10.
1649           SORT_KENNZAHLEN-OUTPUTLEN = 10.
1650         ENDIF.
1651         PERFORM KENNZAHLENTEXT_ERMITTELN USING    SORT_KENNZAHLEN
1652                                          CHANGING SA_KENNZEICHENTEXT.
1653         <SA_SCRTEXT> = SA_KENNZEICHENTEXT.
1654         SA_SCRTEXT_LENGTH =
1655           cl_abap_list_utilities=>dynamic_output_length( <SA_SCRTEXT> ).
1656         WRITE AT (SA_SCRTEXT_LENGTH) <SA_SCRTEXT>.
1657       ENDLOOP.
1658     ENDIF.
1659     IF GF_ACC_ON = TRUE.
1660   *   IF NOT ANALYSE_WAEHRUNG IS INITIAL.
1661   *    Analysewährung ist vorhanden
1662        PERFORM TEXT_ERMITTELN USING    106
1663   *                                   'Analysewährung &
1664                               CHANGING SA_ZEILE.
1665        REPLACE '&' WITH ANALYSE_WAEHRUNG INTO SA_ZEILE.
1666        WRITE AT SA_HLP_COLNO SA_ZEILE.
1667   *   ENDIF.
1668     ENDIF.
1669     DARSTELLUNGSART = CON_DARST_STATUS.
1670     HIDE DARSTELLUNGSART.
1671
1672     PERFORM ZUSATZ_STATUSZEILE_AUSGEBEN IN PROGRAM (LIS_PROGNAME)
1673                                         IF FOUND.
1674
1675   ENDFORM.                               "STATUSZEILE_AUSGEBEN
