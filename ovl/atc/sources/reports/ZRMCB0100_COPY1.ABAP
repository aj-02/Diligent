6869       PERFORM plantab_ermitteln.
6870   *--------- Retten Planzahlen hlp_kennz_plan_sub1
6871       CLEAR hlp_kennz_plan_sub.
6872       REFRESH hlp_kennz_plan_sub.
6873       LOOP AT int_ex_kennz_plan_sub.
6874         hlp_kennz_plan_sub = int_ex_kennz_plan_sub.
6875         APPEND hlp_kennz_plan_sub.
6876       ENDLOOP.
6877   *--------- Abschicken zum Check
6878       IF int_mcyc-singl <> space.
6879         IF int_mcyc-anzper > 0.
6880   *--------- Prognosefall
6881           LOOP AT hlp_kennz_plan_sub2.
6882             cc_tabix = sy-tabix.
6883             CLEAR int_ex_kennz_forc_sub.
6884             REFRESH int_ex_kennz_forc_sub.
6885             CLEAR int_ex_kennz_plan_sub.
6886             REFRESH int_ex_kennz_plan_sub.
6887   *--------- Prognose
6888             int_ex_kennz_forc_sub = hlp_kennz_plan_sub2.
6889             APPEND int_ex_kennz_forc_sub.
6890   *--------- Planzahl
6891             READ TABLE hlp_kennz_plan_sub INDEX cc_tabix.
6892             int_ex_kennz_plan_sub = hlp_kennz_plan_sub.
6893             APPEND int_ex_kennz_plan_sub.
6894             PERFORM uebernahme_merkmale_farbe.
6895           ENDLOOP.
6896         ELSE.
6897   *--------- Ist-Daten-Fall
6898           LOOP AT hlp_kennz_sub.
6899             cc_tabix = sy-tabix.
6900             PERFORM perio_check_index USING cc_tabix.
6901             CLEAR int_ex_kennz_sub.
6902             REFRESH int_ex_kennz_sub.
6903             CLEAR int_ex_kennz_plan_sub.
6904             REFRESH int_ex_kennz_plan_sub.
6905   *--------- Ist-Daten
6906             int_ex_kennz_sub = hlp_kennz_sub.
