305    *---------------------------------------------------------------------*
306    *       FORM MCSI_EXPORT                                              *
307    *---------------------------------------------------------------------*
308    *       Die selektierten Daten werden auf der INDX-ähnlichen          *
309    *       Datei MCSI abgespeichert (einschließlich der eingegebenen     *
310    *       Selektionsparametern).                                        *
311    *       Beim Sichern aus der Standardanalyse heraus werden zusätzlich *
312    *       noch die Kopfdaten der Selektionsversion gesichert            *
313    *---------------------------------------------------------------------*
314    *  -->  ME_SELVS: Name der Selektionsversion                          *
315    *---------------------------------------------------------------------*
316    form mcsi_export using me_selvs like mcrsv-selvs
317                           value(me_setxt) like mcrsvt-setxt.
318
319      data: me_sav_selvs like mcrsv-selvs.
320      data: sav_mcrsv  like mcrsv.
321      data: sav_mcrsvt like mcrsvt.
322
323      me_sav_selvs = me_selvs.
324    * Sichern Kopfaten der alten Selektionsversion
325      sav_mcrsv  = mcrsv.
326      sav_mcrsvt = mcrsvt.
327
328    * Keybestandteile für MCSI versorgen
329      clear: mcsi_key-mcapp,
330             mcsi_key-mcana,
331             mcsi_key-uname.
332      if sy-batch = true and not slv_no is initial.
333    *   Hintergrundlauf der Selektionsversion
334    *   Selektionsbenutzer, -datum und -zeit setzen
335        mcrsv-selusr = sy-uname.
336        mcrsv-seldat = sy-datum.
337        mcrsv-seltim = sy-uzeit.
338        update mcrsv.
339      else.
340    *   Abspeicherung im Online bzw. Hintergrundlauf ohne bekannte
341    *   Selektionsversion => Kopfdaten und Text sichern
342
343    *   Kopfdaten zur Selektionsversion sichern
344    *   Zuerst sichern Kopfdaten der alten Selektionsversion+
345        clear mcrsv.
346        clear mcrsvt.
347        mcrsv-selvs     = me_selvs.
348        mcrsv-gstru     = gstru.
349        mcrsv-annam     = mcrsv-selusr = sy-uname.
350        mcrsv-andat     = mcrsv-seldat = sy-datum.
351        mcrsv-kurst     = type_of_rate.
352        mcrsv-waers     = analyse_waehrung.
353        if sy-slset(1) <> '&'.
354    *     Keine interne Variante, die bei Auswahl von 'Im Hintergrund ausf.
355    *     auf dem Selektionsbild vergeben wurde
356          mcrsv-selset  = sy-slset.
357        else.
358    *     Zurücksetzen der internen Variante
359          clear mcrsv-selset.
360        endif.
361        mcrsv-selusr    = sy-uname.
362        mcrsv-seldat    = sy-datum.
363        mcrsv-seltim    = sy-uzeit.
364        mcrsv-spras     = sy-langu.
365    *   Eingefügt zu 4.0A -------------------------------------------------
366        concatenate '~' me_selvs into mcrsv-kennzsicht.
367        mcrsv-mcana     = akt_tmc7-mcana.
368        mcrsv-mmspb     = strich_anfang - 2.
369        mcrsv-kzspb     = spalten_breite.
370        mcrsv-selvs_typ = con_selvs_typ_gesichert.
371        mcrsv-ident     = flg_objekttext.
372    *   Reportnamen der Analyse ermitteln
373        if flg_selektion = true.
374          mcrsv-repid = lis_progname.
375        else.
376          call function 'MCS_ANALYSE_CALL'
377            exporting
378              i_flg_no_submit               = 'X'
379              i_mcana                       = akt_tmc7-mcana
380              i_mcapp                       = akt_tmc7-mcapp
381            importing
382              e_reportname                  = mcrsv-repid
383            exceptions
384              evaluative_info_structure     = 1
385              info_structure_not_generated  = 2
386              no_analysis_selected          = 3
387              info_structure_does_not_exist = 4
388              analyse_does_not_exist        = 5
389              others                        = 6.
390        endif.
391    *   Ende 40A ----------------------------------------------------------
392        insert mcrsv.
393        if sy-subrc <> 0.
394    *     "Fehler beim Sichern von Selektionsversion &"
395          message e007 with me_selvs.
396        endif.
397    *   Text zur Selektionsversion sichern
398        mcrsvt-spras = sy-langu.
399        mcrsvt-selvs = me_selvs.
400        mcrsvt-setxt = me_setxt.
401    *    if mcrsvt-setxt is initial.
402    **     Text noch nicht gesetzt, da es sich um den Umsetzreport zu 3.0D
403    **     handelt => direkt aus der MCSI übernehmen
404    *      mcrsvt-setxt = mcsi-setxt.
405    *    endif.
406        insert mcrsvt.
407        if sy-subrc <> 0.
408    *     "Fehler beim Sichern von Selektionsversion &"
409          message e007 with me_selvs.
410        endif.
411    *   ab 4.0A: Merkmale und Kennzahlen speichern
412        perform mcrmk_mckzsf_export using me_selvs.
413      endif.
414
415      if inttab_eintraege = 0.
416    *   Falls bisher nur Grundliste angezeigt wurde => int_s000 ist noch
417    *   leer und muß deshalb nachgelesen werden
418        perform mcsi_import using space
419                                  space
420                                  slv_no
421                                  space
422                                  true.
423
424    *   me_selvs auf neuen Namen zurücksetzen, da die Variable mcsi-selvs
425    *   in mcsi_import geändert wurde => auch me_selvs enthält jetzt den
426    *   den Namen der alten Selektionsversion
427        me_selvs       = mcrsv-selvs.
428      endif.
429      mcsi_key-selvs = me_selvs.
430      mcsi-selvs     = me_selvs.
431    * Export der Selektionsparameter und der selektierten Daten in MCSI
432      mcsidir-relid  = 'IS'.
433      mcsidir-mcapp  = mcsi_key-mcapp.
434      mcsidir-mcana  = mcsi_key-mcana.
435      mcsidir-uname  = mcsi_key-uname.
436      mcsidir-selvs  = mcsi_key-selvs.
437      mcsidir-release = sy-saprl.
438      modify mcsidir.
439
440      export sel_tab
441             int_s000
442             exception
443             to database mcsi(is) id mcsi_key.
444
445    * Name Selektionsversion auf ursprüngliche Version zurücksetzen
446      mcsi_key-selvs = slv_no.
447      mcsi-selvs     = slv_no.
448      mcrsv          = sav_mcrsv.
449      mcrsvt         = sav_mcrsvt.
450
451      if sy-subrc = 0.
452    *   "Selektionsversion & wurde gesichert"
453        message s006 with me_sav_selvs.
454        flg_selektion_gesichert = true.
455      else.
456    *   "Fehler beim Sichern von Selektionsversion &"
457        message e007 with me_sav_selvs.
458      endif.
459    endform.                               "MCSI_EXPORT
