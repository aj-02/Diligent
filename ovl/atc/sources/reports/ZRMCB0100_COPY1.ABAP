506          get run time field sav_duration.
507          select single * from mcsidir
508            where relid = 'IS'
509              and mcapp = mi_mcapp
510              and mcana = mi_mcana
511              and uname = mi_uname
512              and selvs = mi_selvs.
513
514          if sy-subrc ne 0.
515    *     Selektionsversion vor Rel. 4.0 abgespeichert
516            flg_found = false.
