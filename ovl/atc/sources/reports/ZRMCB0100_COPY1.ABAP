7166   *&---------------------------------------------------------------------*
7167   *&      Form  CHECK_INT_S032
7168   *&---------------------------------------------------------------------*
7169   *       Spezialität: Infos aus Rechnungsprüfung, die auf Lagerort     *
7170   *       "blank" gebucht werden. Hierbei werden bestimmte Merkmale     *
7171   *       nicht mit in die S032 übernommen.                             *
7172   *       Lösung: Nachlesen aus gepuffertem Materialstamm               *
7173   *----------------------------------------------------------------------*
7174   *  -->  p1        text
7175   *  <--  p2        text
7176   *----------------------------------------------------------------------*
7177   FORM check_int_s032.
7178
7179     DATA: cs_gsber LIKE t134h-gsber.
7180
7181     DATA: BEGIN OF cs_mara.
7182             INCLUDE STRUCTURE mara.
7183     DATA: END OF cs_mara.
7184
7185     DATA: BEGIN OF cs_marc.
7186             INCLUDE STRUCTURE marc.
7187     DATA: END OF cs_marc.
7188
7189     DATA: BEGIN OF cs_mbew.
7190             INCLUDE STRUCTURE mbew.
7191     DATA: END OF cs_mbew.
7192
7193     SORT int_s032 BY lgort.
7194
7195     LOOP AT int_s032 WHERE lgort IS initial
7196                        AND mtart IS initial.
7197
7198       CLEAR: cs_mara, cs_marc, cs_mbew.
7199
7200       CALL FUNCTION 'MARA_SINGLE_READ'
7201         EXPORTING
7202                 maxtz             = 10000
7203           matnr             = int_s032-matnr
7204         IMPORTING
7205           wmara             = cs_mara
7206         EXCEPTIONS
7207           lock_on_material  = 1
7208           lock_system_error = 2
7209           wrong_call        = 3
7210           not_found         = 4
7211           OTHERS            = 5.
7212
