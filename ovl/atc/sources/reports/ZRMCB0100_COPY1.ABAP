79     *       FORM FCODE_INFO_LESEN                                         *
80     *---------------------------------------------------------------------*
81     *       Die FCode-Tabellen DRILLDOWN_FCODES und HIERARCHIE_FCODES     *
82     *       werden mit den Informationen zu den FCodes angereichert       *
83     *       Die Tabelle HIERARCHIE_TAB wird mit den möglichen Hierarchie- *
84     *       aufrissen gefüllt.
85     *---------------------------------------------------------------------*
86     FORM fcode_info_lesen.
87
88       DATA: fl_trsthv     LIKE trsthv OCCURS 0 WITH HEADER LINE,
89             fl_trsthv_dom LIKE trsthv OCCURS 0 WITH HEADER LINE,
90             fl_outputlen  LIKE tmcnv-lmatnr.
91       DATA: BEGIN OF fl_hienm OCCURS 0,
92               hienm  LIKE trsthv-hienm,
93               anzahl LIKE sy-tabix.
94       DATA: END   OF fl_hienm,
95             ls_mcshierk TYPE mcshierk.
96
97     * Fcode für Periodenaufriß in DRILLDOWN_FCODES eintragen
98       CONCATENATE gstru '-' INTO drilldown_fcodes-tabfeld.
99       drilldown_fcodes-fcode = con_fcode_aper.
100      CASE sav_speri.
101        WHEN con_speri_sptag.
102          drilldown_fcodes-tabfeld+5 = con_feld_sptag.
103        WHEN con_speri_spwoc.
104          drilldown_fcodes-tabfeld+5 = con_feld_spwoc.
105        WHEN con_speri_spmon.
106          drilldown_fcodes-tabfeld+5 = con_feld_spmon.
107        WHEN con_speri_spbup.
108          drilldown_fcodes-tabfeld+5 = con_feld_spbup.
109      ENDCASE.
110      drilldown_fcodes-ddicfeld = drilldown_fcodes-ranges_suf
111                                = drilldown_fcodes-tabfeld+5.
112      IF tmc4-spzis NE 'C'.
113        CASE TMC4-gstru.                                           "803676
114          WHEN 'S065'.                                             "803676
115    *       do nothing.....                                        "803676
116          WHEN OTHERS.                                             "803676
117    *       Periode nur einfügen bei Infostrukturen vom Typ <> 'C'
118            APPEND drilldown_fcodes.
119        ENDCASE.                                                   "803676
120      ENDIF.
121
122    * DD-Infos zu Aufriß-Fcodes ermitteln
123      LOOP AT drilldown_fcodes.
124        IF drilldown_fcodes-fcode = con_fcode_aper.
125    *     Periodenaufriß
126          PERFORM get_field(rddfie00)
127            USING    gstru
128                     drilldown_fcodes-tabfeld+5(10)
129                     sy-langu
130            CHANGING dfies
131                     sy-subrc.
132          IF sy-subrc = 0.
133            MOVE-CORRESPONDING dfies TO drilldown_fcodes.
134            MODIFY drilldown_fcodes.
135          ENDIF.
136        ELSE.
137    *     'Normaler' Aufriß
138          PERFORM get_field(rddfie00)
139            USING    gstru
140                     drilldown_fcodes-tabfeld+5(10)
141                     sy-langu
142            CHANGING dfies
143                     sy-subrc.
144          IF dfies-domname = 'MATNR'.
145    *        Materialnummer: Länge aus dem Customizing übernehmen
146            SELECT SINGLE lmatnr FROM tmcnv INTO fl_outputlen.
147            IF ( sy-subrc = 0 AND fl_outputlen > 0 ).
148              dfies-outputlen = fl_outputlen.
149            ENDIF.
150          ENDIF.
151          IF sy-subrc = 0.
152            MOVE-CORRESPONDING dfies TO drilldown_fcodes.
153            MODIFY drilldown_fcodes.
154          ELSE.
155            DELETE drilldown_fcodes.
156          ENDIF.
157        ENDIF.
158      ENDLOOP.
159
160    * Infos zu Hierarchieaufriß-Fcodes ermitteln
161      SORT hierarchie_fcodes BY fcode.
162      LOOP AT hierarchie_fcodes.
163    *   Lese Info zum Hierarchienamen
164        SELECT * FROM  trsthv
165               WHERE  appl  = 'MCS'
166               AND    hienm = hierarchie_fcodes-hienm.
167          MOVE-CORRESPONDING trsthv TO hierarchie_fcodes.
168          EXIT.
169        ENDSELECT.
170    *   Lese DD-Info und Texte zur Hierarchie
171        PERFORM hierarchie_text_lesen USING    trsthv
172                                      CHANGING hierarchie_fcodes-scrtext_s
173                                               hierarchie_fcodes-scrtext_m
174                                               hierarchie_fcodes-scrtext_l.
175    *   Lese Hierarchieklasseninfo
176        SELECT SINGLE * FROM  trsthc
177               WHERE  hclass = hierarchie_fcodes-hclass.
178        MOVE-CORRESPONDING trsthc TO hierarchie_fcodes.
179
180        READ TABLE drilldown_fcodes WITH KEY
181           fcode = hierarchie_fcodes-merkmals_fcode. "<--- note 660057
182    *      fcode = hierarchie_fcodes-merkmals_fcode BINARY SEARCH.
183        hierarchie_fcodes-merkmals_feldname   = drilldown_fcodes-ddicfeld.
184        hierarchie_fcodes-merkmals_ranges_suf = drilldown_fcodes-ranges_suf.
185        MODIFY hierarchie_fcodes.
186      ENDLOOP.
187
188    * Mögliche Hierarchieaufrisse ermitteln
189      LOOP AT drilldown_fcodes.
190    *   Mögliche Hierarchien zum Datenelement lesen
191        SELECT * FROM  trsthv INTO TABLE fl_trsthv
192               WHERE  appl   = 'MCS'
193               AND    rolnm  =  drilldown_fcodes-rollname.
194    *   Mögliche Hierarchien zur Domäne lesen
195        SELECT * FROM  trsthv INTO TABLE fl_trsthv_dom
196               WHERE  appl  = 'MCS'
197               AND    domnm = drilldown_fcodes-domname.
198        APPEND LINES OF fl_trsthv_dom TO fl_trsthv.
199
200    *   Texte zu den Hierarchieaufrissen ermitteln
201        LOOP AT fl_trsthv.
202          IF fl_trsthv-hclass = 'LGEN'.
203    *     Check for invalid LIS general hierarchies
204            SELECT SINGLE * FROM mcshierk INTO ls_mcshierk
205              WHERE appl  = 'MCS'
206                AND hname = fl_trsthv-hienm.
207            CHECK sy-subrc = 0.
208          ENDIF.
209    *     Hierarchieklasse, -name und MerkmalsFCode in HIERARCHIE_TAB
210    *     übertragen (Achtung: Mißbrauch der Variablennamen)
211          hierarchie_tab-tabname   = fl_trsthv-hclass.
212          hierarchie_tab-fieldname = fl_trsthv-hienm.
213          hierarchie_tab-fieldtext = fl_trsthv-hienm.
214          hierarchie_tab-domname   = drilldown_fcodes-fcode.
215    *     Lese DD-Info und Texte zur Hierarchie
216          PERFORM hierarchie_text_lesen USING    fl_trsthv
217                                        CHANGING hierarchie_tab-scrtext_s
218                                                 hierarchie_tab-scrtext_m
219                                                 hierarchie_tab-scrtext_l.
220          APPEND hierarchie_tab.
221    *     Häufigkeit der vorkommenden Hierarchienamen ermitteln
222          READ TABLE fl_hienm WITH KEY hienm = fl_trsthv-hienm
223                                       BINARY SEARCH.
224          IF sy-subrc = 0.
225    *       Hierarchienamen gibt es schon
226            ADD 1 TO fl_hienm-anzahl.
227            MODIFY fl_hienm INDEX sy-tabix.
228          ELSE.
229    *       Neuer Hierarchiename
230            fl_hienm-hienm  = fl_trsthv-hienm.
231            fl_hienm-anzahl = 1.
232            INSERT fl_hienm INDEX sy-tabix.
233          ENDIF.
234        ENDLOOP.
235      ENDLOOP.
236
237    * Hierarchienamentexte für mehrfach vorkommenden Hierarchien nachbearb.
238      LOOP AT fl_hienm WHERE anzahl > 1.
239    *   (Achtung: Mißbrauch der Variablennamen in HIERARCHIE_TAB)
240        LOOP AT hierarchie_tab WHERE fieldname = fl_hienm-hienm.
241          READ TABLE drilldown_fcodes
242               WITH KEY fcode = hierarchie_tab-domname BINARY SEARCH.
243          IF sy-subrc = 0.
244    *       Merkmalsbezeichnung an den Hierarchienamen anhängen
245            CONCATENATE hierarchie_tab-scrtext_l
246                        drilldown_fcodes-scrtext_l
247                   INTO hierarchie_tab-scrtext_l SEPARATED BY ' - '.
248            MODIFY hierarchie_tab.
249          ENDIF.
250        ENDLOOP.
251      ENDLOOP.
252
253    * Hierarchienamen sortieren (Periodenhierachien ans Ende hängen)
254      SORT hierarchie_tab BY scrtext_l.
255      LOOP AT hierarchie_tab WHERE tabname = 'LPER'. "TABNAME = HCLASS !!!
256    *   Periodenaufrisse markieren
257        hierarchie_tab-tabix = 1.
258        MODIFY hierarchie_tab.
259      ENDLOOP.
260      DO.
261    *   Periodenhierarchien ans Ende schieben
262        READ TABLE hierarchie_tab WITH KEY tabix = 1.
263        IF sy-subrc = 0.
264          hierarchie_tab-tabix = 0.
265          DELETE hierarchie_tab INDEX sy-tabix.
266          APPEND hierarchie_tab.
267        ELSE.
268    *     Alle Periodenhierarchie abgearbeitet
269          EXIT.
270        ENDIF.
271      ENDDO.
272    ENDFORM.                               "FCODE_INFO_LESEN
