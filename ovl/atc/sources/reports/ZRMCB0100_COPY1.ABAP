652    *---------------------------------------------------------------------*
653    *       FORM DRILLDOWN_AUSWAEHLEN                                     *
654    *---------------------------------------------------------------------*
655    *       Auswahl des Merkmalsaufrisses über Dialogfenster              *
656    *---------------------------------------------------------------------*
657    *  -->  DE_FLG_CURSOR: Überprüfung der Cursorposistion                *
658    *                      = TRUE: Cursor muß auf Merkmalszeile stehen    *
659    *  -->  DE_TITEL     : Textnr. für Titel des Dialogfensters
660    *  <--  DE_FCODE     : Ausgewählter Merkmalsfcode                     *
661    *                      = SPACE, wenn die Auswahl abgebrochen wurde    *
662    *---------------------------------------------------------------------*
663    FORM DRILLDOWN_AUSWAEHLEN USING    DE_FLG_CURSOR TYPE BOOLEAN
664                                       DE_TITEL      LIKE TMCRT-TXTNR
665                              CHANGING DE_FCODE      LIKE SAV_FCODE.
666
667      STATICS: DE_DRILLDOWN_TAB  LIKE MCS01 OCCURS 0 WITH HEADER LINE,
668               DE_SAV_FCODE      LIKE SAV_FCODE.
669      DATA:    DE_MARK_DRILLDOWN LIKE MCS01 OCCURS 0 WITH HEADER LINE,
670               DE_FLG_MARK       TYPE BOOLEAN.
671
672      IF DE_FLG_CURSOR = TRUE.
673        PERFORM CURSORPOS_PRUEFEN.
674      ENDIF.
675
676      IF DE_DRILLDOWN_TAB IS INITIAL.
677    *   Tabelle ist noch leer => Tab. mit den möglichen Aufrissen füllen
678        LOOP AT DRILLDOWN_FCODES.
679          MOVE-CORRESPONDING DRILLDOWN_FCODES TO DE_DRILLDOWN_TAB.
680          DE_DRILLDOWN_TAB-FIELDNAME = DRILLDOWN_FCODES-DDICFELD.
681          APPEND DE_DRILLDOWN_TAB.
682        ENDLOOP.
683        SORT DE_DRILLDOWN_TAB BY SCRTEXT_L.
684    *   Periodenaufriß ans Ende der Liste stellen
685        IF TMC4-SPZIS NE 'C'.
686          CASE TMC4-gstru.                                         "803676
687            WHEN 'S065'.                                           "803676
688    *         do nothing.....                                      "803676
689            WHEN OTHERS.                                           "803676
690              READ TABLE DE_DRILLDOWN_TAB WITH KEY FCODE = CON_FCODE_APER.
691              DELETE DE_DRILLDOWN_TAB INDEX SY-TABIX.
692              APPEND DE_DRILLDOWN_TAB.
693          ENDCASE.                                                 "803676
694        ENDIF.
695      ENDIF.
696
697    * Merkmale nach den schon aufgerissen wurde deaktivieren
698      PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
699      LOOP AT DE_DRILLDOWN_TAB.
700        READ TABLE AKT_DRILLDOWN WITH KEY FCODE = DE_DRILLDOWN_TAB-FCODE.
701        IF SY-SUBRC = 0.
702          DE_DRILLDOWN_TAB-DISPL_ONLY = TRUE.
703        ELSE.
704          DE_DRILLDOWN_TAB-DISPL_ONLY = FALSE.
705        ENDIF.
706        MODIFY DE_DRILLDOWN_TAB.
707      ENDLOOP.
708
709    * ggf. zuletzt ausgewähltes Merkmal wieder markieren
710      IF NOT DE_SAV_FCODE IS INITIAL.
711        READ TABLE DE_DRILLDOWN_TAB WITH KEY FCODE = DE_SAV_FCODE.
712        IF SY-SUBRC = 0 AND DE_DRILLDOWN_TAB-DISPL_ONLY = FALSE.
713          DE_MARK_DRILLDOWN = DE_DRILLDOWN_TAB.
714          APPEND DE_MARK_DRILLDOWN.
715        ENDIF.
716      ENDIF.
717
718      PERFORM TEXT_ERMITTELN USING    50
719    *                                 'Merkmale'
720                             CHANGING HLP_TEXT1.
721      PERFORM TEXT_ERMITTELN USING    49
722    *                                 'Merkmal'
723                             CHANGING HLP_TEXT2.
724      PERFORM TEXT_ERMITTELN USING    DE_TITEL
725                             CHANGING HLP_TEXT3.
726      CALL FUNCTION 'MC_POPUP_TO_MARK_FIELDS'
727           EXPORTING
728                I_FIELD_NUMBER_MAX     = 1
729                I_FIELD_NUMBER_MIN     = 1
730                I_MARK_BY_TABLE        = TRUE
731                I_OBJECT_NAME_PLURAL   = HLP_TEXT1
732                I_OBJECT_NAME_SINGULAR = HLP_TEXT2
733                I_POPUP_TITLE          = HLP_TEXT3
734           IMPORTING
735                E_MARKED               = DE_FLG_MARK
736           TABLES
737                T_FIELDS               = DE_DRILLDOWN_TAB
738                T_MARKED_FIELDS        = DE_MARK_DRILLDOWN.
739      IF DE_FLG_MARK = TRUE.
740        READ TABLE DE_MARK_DRILLDOWN INDEX 1.
741        DE_FCODE = DE_SAV_FCODE = DE_MARK_DRILLDOWN-FCODE.
742      ELSE.
743        CLEAR DE_FCODE.
744      ENDIF.
745    ENDFORM.                               "DRILLDOWN_AUSWAEHLEN
