627    *&---------------------------------------------------------------------*
628    *&      Form  SET_AUSTAB_SORT_FIELD
629    *&---------------------------------------------------------------------*
630    *       Sortierkriterium für Merkmalsspalte setzen
631    *       Setzt voraus, dass das Sortierfeld in der Tabelle
632    *       SORT_KENNZAHLEN bereits enthalten ist.
633    *----------------------------------------------------------------------*
634    *      -->P_SORT_OBJEKT   Feld, dessen Sortierkriterium gesetzt wird
635    *      -->P_FLG_DOWN      TRUE:  absteigend sortieren
636    *                         FALSE: aufsteigend sortieren
637    *      <--P_FLG_OK        TRUE:  erfolgreich
638    *                         FALSE: Fehler
639    *----------------------------------------------------------------------*
640    form set_austab_sort_field using    p_sort_objekt like sort_kriterium
641                                        p_flg_down  type c
642                               changing p_flg_ok  type c.
643
644      data: l_tmp_tabix      like sy-tabix,
645            second_sort_crit like sort_kriterium.
646
647      data: l_tmp_sort_kennzahlen like sort_kennzahlen.
648
649      p_flg_ok = false.
650
651      read table sort_kennzahlen
652                       with key austabfeld = p_sort_objekt.
653      if sy-subrc is initial.
654    *   Aktuelles Sortierkriterium soll in der Sortierreihenfolge vor einem
655    *   evt. vorhandenen zweiten Sortierkriterium der Merkmalsspalte stehen
656        l_tmp_tabix = sy-tabix.
657        if p_sort_objekt eq con_feld_austabobjekt.
658          second_sort_crit = con_feld_austabtext.
659        else.
660          second_sort_crit = con_feld_austabobjekt.
661        endif.
662        read table sort_kennzahlen into l_tmp_sort_kennzahlen
663                                   with key austabfeld = second_sort_crit.
664        if sy-subrc is initial and
665           sy-tabix < l_tmp_tabix.
666    *     Merkmals-Sortierkriterien vertauschen und Austab neu sortieren
667          modify sort_kennzahlen index sy-tabix.
668          modify sort_kennzahlen from l_tmp_sort_kennzahlen
669                                 index l_tmp_tabix.
670
671          clear kennzahlen_sstab_s.
672          refresh kennzahlen_sstab_s.
673          loop at sort_kennzahlen.
674            move-corresponding sort_kennzahlen to kennzahlen_sstab_s.
675            kennzahlen_sstab_s-sort_down = sort_kennzahlen-flg_abst.
676            append kennzahlen_sstab_s.
677          endloop.
678
679          call function 'CNSG_SET_SORT_FIELDS'
680               exporting
681                    i_flg_display           = false
