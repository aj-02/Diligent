1103   *---------------------------------------------------------------------*
1104   *       FORM ZEITREIHE_PERIODEN_ERMITTELN                             *
1105   *---------------------------------------------------------------------*
1106   *       Ermittelt Perioden-Zeitraum der Selektion.                    *
1107   *       Für jede Periode des Selektionszeitraums ist ein Eintrag in   *
1108   *       PERIODENTAB-LOW vorhanden (nach Aufruf von PERIODENTAB).      *
1109   *---------------------------------------------------------------------*
1110   FORM ZEITREIHE_PERIODEN_ERMITTELN.
1111
1112     CASE SAV_SPERI.
1113       WHEN CON_SPERI_SPTAG.
1114         DESCRIBE TABLE SL_SPTAG LINES SY-TFILL.
1115       WHEN CON_SPERI_SPWOC.
1116         DESCRIBE TABLE SL_SPWOC LINES SY-TFILL.
1117       WHEN CON_SPERI_SPMON.
1118         DESCRIBE TABLE SL_SPMON LINES SY-TFILL.
1119       WHEN CON_SPERI_SPBUP.
1120         DESCRIBE TABLE SL_SPBUP LINES SY-TFILL.
1121     ENDCASE.
1122
1123     IF SY-TFILL = 0.
1124   *   keine Perioden selektiert => Anfangs-/Endperiode bestimmen
1125       FLG_EMPTYRANGE = TRUE.
1126       PERFORM ZEITREIHE_PERI_MIN_MAX_BEST
1127                              USING FLG_EMPTYRANGE.
1128     ELSE.
1129   *   Bestimmung der selektierten Perioden
1130       FLG_EMPTYRANGE = FALSE.
1131       PERFORM ZEITREIHE_PERI_MIN_MAX_BEST
1132                              USING FLG_EMPTYRANGE.
1133     ENDIF.
1134
1135   * Anzahl der Perioden feststellen gem. Selektionsbild
1136     REFRESH ZEIT_PERIODEN.
1137     ZEITREIHEN_ERSTE_SPALTE = 1.
1138     LOOP AT PERIODENTAB.
1139       ZEIT_PERIODEN = PERIODENTAB-LOW.
1140       APPEND ZEIT_PERIODEN.
1141     ENDLOOP.
1142
1143   ENDFORM.                               "ZEITREIHE_PERIODEN_ERMITTELN
1144
1145
1146   *---------------------------------------------------------------------*
1147   *       FORM ZEITREIHE_PERI_MIN_MAX_BEST                              *
1148   *---------------------------------------------------------------------*
1149   *       Bestimmt die minimale und die maximale Periode der verdichte- *
1150   *       ten Daten und die Perioden, die dazwischen liegen anhand der  *
1151   *       verdichteten Daten.                                           *
1152   *       Ein Aufruf erfolgt nur, wenn keine Periode auf dem Selektions-*
1153   *       bild gewählt wurde.                                           *
1154   *---------------------------------------------------------------------*
1155   FORM ZEITREIHE_PERI_MIN_MAX_BEST
1156                                     USING FLG_EMPTYRANGE TYPE BOOLEAN.
1157
1158     DATA: ZP_MIN(10),
1159           ZP_MAX(10).
1160
1161   * Anfangsminimum bestimmen
1162     READ TABLE ZEIT_S000 INDEX 1.
1163     CHECK SY-SUBRC = 0.
1164     ZP_MIN = <ZEIT_MERKMAL2>.
1165
1166     LOOP AT ZEIT_S000.
1167       IF <ZEIT_MERKMAL2> < ZP_MIN.
1168   *     neues Minimum gefunden
1169         ZP_MIN = <ZEIT_MERKMAL2>.
1170       ENDIF.
1171       IF <ZEIT_MERKMAL2> > ZP_MAX.
1172   *     neues Maximum gefunden
1173         ZP_MAX = <ZEIT_MERKMAL2>.
1174       ENDIF.
1175     ENDLOOP.
1176
1177     SAV_PERIO_MIN = ZP_MIN.
1178     SAV_PERIO_MAX = ZP_MAX.
1179
1180     IF FLG_EMPTYRANGE EQ TRUE.
1181       CASE SAV_SPERI.
1182         WHEN CON_SPERI_SPTAG.
1183           SL_SPTAG-LOW    = ZP_MIN.
1184           SL_SPTAG-HIGH   = ZP_MAX.
1185           SL_SPTAG-SIGN   = 'I'.
1186           SL_SPTAG-OPTION = 'BT'.
1187           APPEND SL_SPTAG.
1188         WHEN CON_SPERI_SPWOC.
1189           SL_SPWOC-LOW    = ZP_MIN.
1190           SL_SPWOC-HIGH   = ZP_MAX.
1191           SL_SPWOC-SIGN   = 'I'.
1192           SL_SPWOC-OPTION = 'BT'.
1193           APPEND SL_SPWOC.
1194         WHEN CON_SPERI_SPMON.
1195           SL_SPMON-LOW    = ZP_MIN.
1196           SL_SPMON-HIGH   = ZP_MAX.
1197           SL_SPMON-SIGN   = 'I'.
1198           SL_SPMON-OPTION = 'BT'.
1199           APPEND SL_SPMON.
1200         WHEN CON_SPERI_SPBUP.
1201           SL_SPBUP-LOW    = ZP_MIN.
1202           SL_SPBUP-HIGH   = ZP_MAX.
1203           SL_SPBUP-SIGN   = 'I'.
1204           SL_SPBUP-OPTION = 'BT'.
1205           APPEND SL_SPBUP.
1206       ENDCASE.
1207     ENDIF.
1208   * Periodentab fuellen
1209     CON_MCINF = HLP_MCINF.
1210     PERFORM ZEITR_PERIODENTAB_FUELLEN.
1211
1212   * Eintrag wieder löschen
1213     IF FLG_EMPTYRANGE EQ TRUE.
1214       CASE SAV_SPERI.
1215         WHEN CON_SPERI_SPTAG.
1216           REFRESH SL_SPTAG.
1217         WHEN CON_SPERI_SPWOC.
1218           REFRESH SL_SPWOC.
1219         WHEN CON_SPERI_SPMON.
1220           REFRESH SL_SPMON.
1221         WHEN CON_SPERI_SPBUP.
1222           REFRESH SL_SPBUP.
1223       ENDCASE.
1224     ENDIF.
1225
1226   ENDFORM.
1227
1228
1229   *---------------------------------------------------------------------*
1230   *       FORM ZEITREIHE_PERI_SUM_BERECHNEN                             *
1231   *---------------------------------------------------------------------*
1232   *       Berechnet die Summenzeile für jede Periodenspalte             *
1233   * und Zusatzkennzahlen
1234   *---------------------------------------------------------------------*
1235   FORM ZEITREIHE_PERI_SUM_BERECHNEN.
1236
1237     DATA: ZP_INDEX_ZEIT       TYPE I,
1238           ZP_INDEX_ZEIT_SUM   TYPE I.
1239
1240   * Summentabelle erzeugen
1241     REFRESH ZEIT_SUM_S000.
1242     CLEAR ZEIT_SUM_S000.
1243     LOOP AT ZEIT_PERIODEN.
1244       ZEIT_SUM_S000-OBJEKT = ZEIT_PERIODEN.
1245       APPEND ZEIT_SUM_S000.
1246     ENDLOOP.
1247
1248     LOOP AT ZEIT_S000.
1249       ZP_INDEX_ZEIT = SY-TABIX.
1250       READ TABLE ZEIT_SUM_S000 WITH KEY OBJEKT = <ZEIT_MERKMAL2>.
1251       IF SY-SUBRC = 0.
1252   *     Perioden liegt im Selektionszeitraum
1253         ZP_INDEX_ZEIT_SUM = SY-TABIX.
1254         MOVE-CORRESPONDING ZEIT_S000-KENNZ TO INT_S000.
1255         ADD-CORRESPONDING  INT_S000        TO ZEIT_SUM_S000.
1256   *     Spezialsumme berechnen (für Summenkorrektur)
1257         PERFORM SPEZIAL_SUMME_BERECHNEN IN PROGRAM (LIS_PROGNAME)
1258                                            USING    ZEIT_S000-KENNZ
1259                                            CHANGING ZEIT_SUM_S000
1260                                            IF FOUND.
1261         PERFORM SUMEINHEITEN_SETZEN USING    ZEIT_S000-KENNZ
1262                                     CHANGING ZEIT_SUM_S000.
1263
1264   *     Zusatzkennzahlen berechnen
1265         PERFORM ZUSATZKENNZAHLEN_BERECHNEN IN PROGRAM (LIS_PROGNAME)
1266                                            CHANGING ZEIT_S000-KENNZ
1267                                            IF FOUND.
1268         MODIFY ZEIT_S000 INDEX ZP_INDEX_ZEIT.
1269         MODIFY ZEIT_SUM_S000 INDEX ZP_INDEX_ZEIT_SUM.
1270       ELSE.
1271   *     Periode liegt nicht im Selektionszeitraum
1272         DELETE ZEIT_S000 INDEX ZP_INDEX_ZEIT.
1273       ENDIF.
1274     ENDLOOP.
1275
1276   * Zusatzkennzahlen für Summenzeilen bestimmen
1277     LOOP AT ZEIT_SUM_S000.
1278       PERFORM ZUSATZKENNZAHLEN_BERECHNEN IN PROGRAM (LIS_PROGNAME)
1279                                          CHANGING ZEIT_SUM_S000
1280                                          IF FOUND.
1281       MODIFY ZEIT_SUM_S000.
1282     ENDLOOP.
1283
1284   ENDFORM.                               "ZEITREIHE_PERI_SUM_BERECHNEN
1285
1286
1287   *---------------------------------------------------------------------*
1288   *       FORM ZEITREIHE_SPALTE_BLAETTERN                               *
1289   *---------------------------------------------------------------------*
1290   *       Blättert eine Periode weiter oder ganz an den Anfang oder ans *
1291   *       Ende der Perioden.                                            *
1292   *       Hierbei wird unterschieden, ob das Blättern innerhalb der an- *
1293   *       zeigbaren Perioden (durch LINESIZE beschränkt) oder über die  *
1294   *       anzeigbaren Perioden hinaus erfolgen muß.                     *
1295   *       Wird innerhalb der LINESIZE geblättert, so wird dafür der FB  *
1296   *       aufgerufen. Wird über die anzeigbaren Perioden hinaus ge-     *
1297   *       blätter, so muß ein Neuaufbau der Liste erfolgen und an die   *
1298   *       entsprechende Zeile wieder gescrollt werden.                  *
1299   *---------------------------------------------------------------------*
1300   *  -->  ZS_COMMAND = '+' oder '-' für Spalte rechts oder Spalte links *
1301   *                    '++' oder '--' für ganz rechts oder links        *
1302   *---------------------------------------------------------------------*
1303   FORM ZEITREIHE_SPALTE_BLAETTERN USING ZS_COMMAND TYPE C.
1304
1305     DATA: ZS_ANZ_PERIODEN    TYPE I,
1306           ZS_HLP_SPALTE      TYPE I,
1307           ZS_SCROLL_COLUMN   LIKE SY-STACO,
1308           ZS_SAV_CPAGE       LIKE SY-CPAGE,
1309           ZS_SAV_STARO       LIKE SY-STARO,
1310           ZS_SAV_STACO       LIKE SY-STACO,
1311           ZS_SAV_LSIND       LIKE SY-LSIND.
1312
1313     ZS_HLP_SPALTE = ZEITREIHEN_ERSTE_SPALTE + ZEITREIHEN_ANZ_SPALTEN.
1314     DESCRIBE TABLE ZEIT_PERIODEN LINES ZS_ANZ_PERIODEN.
1315
1316     IF ( ZS_COMMAND = '-' OR ZS_COMMAND = '+' ).
1317   *   Spalte links oder Spalte rechts
1318       CALL FUNCTION 'LIST_SCROLL_COLUMN'
1319            EXPORTING
1320                 SCROLL_COMMAND         = ZS_COMMAND
1321            IMPORTING
1322                 SCROLL_COLUMN          = ZS_SCROLL_COLUMN
1323            EXCEPTIONS
1324                 LIST_INDEX_INVALID     = 1
1325                 NO_LIST_ACTIVE         = 2
1326                 SCROLL_COMMAND_INVALID = 3
1327                 OTHERS                 = 4.
1328
1329       IF ZS_SCROLL_COLUMN < 1.
1330   *     Blättern nach links über LINE SIZE hinaus
1331         IF ZEITREIHEN_ERSTE_SPALTE = 1.
1332   *       'Blättern nicht möglich: erste Periode erreicht'
1333           MESSAGE S168.
1334         ELSE.
1335   *       Blättern nach links noch möglich
1336           ZEITREIHEN_ERSTE_SPALTE = ZEITREIHEN_ERSTE_SPALTE - 1.
1337
1338   *       alte Listenposition merken
1339           ZS_SAV_LSIND = SY-LSIND.
1340           ZS_SAV_CPAGE = SY-CPAGE.
1341           ZS_SAV_STARO = SY-STARO.
1342           ZS_SAV_STACO = SY-STACO.
1343
1344           PERFORM ZEITREIHE_AUSGEBEN_VORBEREITEN USING TRUE.
1345           PERFORM ZEITREIHE_AUSGEBEN USING ZEITREIHEN_ERSTE_SPALTE
1346                                            ZEITREIHEN_ANZ_SPALTEN.
1347
1348   *       Listenposition wiederherstellen
