6      *---------------------------------------------------------------------*
7      *       FORM AKT_DRILLDOWN_AKTUALISIEREN                              *
8      *---------------------------------------------------------------------*
9      *       Tabelle AKT_DRILLDOWN gemäß der aktuellen Liststufe aktualis. *
10     *---------------------------------------------------------------------*
11     FORM AKT_DRILLDOWN_AKTUALISIEREN.
12       DATA: AA_LSIND LIKE SY-LSIND.        " logische Liststufe
13
14       IF FLG_VERGLEICH = FALSE OR
15          SY-LSIND <= 1         OR
16          SY-PFKEY CS 'LIST'.
17         AA_LSIND = SY-LSIND.
18       ELSE.
19     *   Im Normalfall ist sy-lsind = 0 bei 1. Liste (=Grundliste), 1 bei
20     *   2. Liste (= 1. Aufrißliste), usw.. Bei Vergleich (Plan/Ist usw.)
21     *   ist aber sy-lsind um 1 erhöht. Deshalb wird aa_lsind um 1 verringert
22         AA_LSIND = SY-LSIND - 1.
23       ENDIF.
24     *  aa_lsind = sy-lsind.   "vorläufig
25       IF DRILLDOWN_EINTRAEGE > AA_LSIND AND AA_LSIND > 0 OR
26          SAV_FCODE = 'CLOS'.
27     *   Aufriß mit größerer Liststufe wurde erzeugt und es soll nicht als
28     *   nächstes die Grundliste ausgegeben werden => AUSTAB nicht aktuell
29     *   oder: Nach Verlassen Vergleichspopup muß immer der alte Zustand
30     *   zurückgesetzt werden
31         REFRESH AKT_DRILLDOWN.
32     *   AKT_DRILLDOWN aktualisieren, weil nicht mehr aktuell
33         LOOP AT SAV_AKT_DRILLDOWN.
34           IF SAV_AKT_DRILLDOWN-LSIND > SY-LSIND.
35             DELETE SAV_AKT_DRILLDOWN.
36           ELSEIF SAV_AKT_DRILLDOWN-LSIND = SY-LSIND.
37             AKT_DRILLDOWN = SAV_AKT_DRILLDOWN.
38             INSERT AKT_DRILLDOWN INDEX 1.
39     **        if flg_vergleich = false or
40     **           sav_akt_drilldown-lsind >= mainlist_lsind.
41             DELETE SAV_AKT_DRILLDOWN.
42     **        endif.
43           ELSE.
44             EXIT.
45           ENDIF.
46         ENDLOOP.
47         FLG_AUSTAB_AKTUELL  = FALSE.
48     *   ausgewählte Kennzahlen wiederherstellen
49         REFRESH: AKT_KENNZAHLEN.
50         LOOP AT SAV_KENNZAHLEN.
51           IF SAV_KENNZAHLEN-LSIND > SY-LSIND.
52             DELETE SAV_KENNZAHLEN.
53           ELSEIF SAV_KENNZAHLEN-LSIND = SY-LSIND.
54             AKT_KENNZAHLEN = SAV_KENNZAHLEN.
55             INSERT AKT_KENNZAHLEN INDEX 1.
56     **        if flg_vergleich = false or
57     **           sav_kennzahlen-lsind >= mainlist_lsind.
58             DELETE SAV_KENNZAHLEN.
59     **        endif.
60           ELSE.
61             EXIT.
62           ENDIF.
63         ENDLOOP.
64         PERFORM AUSTAB_TEXT_ZUWEISEN.
65         DESCRIBE TABLE AKT_KENNZAHLEN LINES KENNZAHL_ANZAHL.
66         LOOP AT AKT_KENNZAHLEN.
67           PERFORM AUSGABEFELD_ZUWEISEN USING SY-TABIX.
68         ENDLOOP.
69     *   ausgewählte Sortier- und Gruppierkriterien wiederherstellen
70         REFRESH: SORT_KENNZAHLEN.
71         LOOP AT SAV_SORT_KENNZAHLEN.
72           IF SAV_SORT_KENNZAHLEN-LSIND > SY-LSIND.
73             DELETE SAV_SORT_KENNZAHLEN.
74           ELSEIF SAV_SORT_KENNZAHLEN-LSIND = SY-LSIND.
75             SORT_KENNZAHLEN = SAV_SORT_KENNZAHLEN.
76             INSERT SORT_KENNZAHLEN INDEX 1.
77     **        if flg_vergleich = false or
78     **           sav_sort_kennzahlen-lsind >= mainlist_lsind.
79             DELETE SAV_SORT_KENNZAHLEN.
80     **       endif.
81           ELSE.
82             EXIT.
83           ENDIF.
84         ENDLOOP.
85     *   Anzahl Sortier- und Gruppenkriterien bestimmen
86         CLEAR ANZ_GRUPPENKRIT.
87         LOOP AT SORT_KENNZAHLEN WHERE FLG_GRUPPE = TRUE.
88           ADD 1 TO ANZ_GRUPPENKRIT.
89         ENDLOOP.
90         DESCRIBE TABLE SORT_KENNZAHLEN LINES ANZ_SORTKRIT.
91         ANZ_SORTKRIT = ANZ_SORTKRIT - ANZ_GRUPPENKRIT.
92         IF ANZ_SORTKRIT = 1.
93     *     Es existiert genau ein Sortierkriterium
94           SORT_KRITERIUM = SORT_KENNZAHLEN-AUSTABFELD.
95         ELSE.
96           CLEAR SORT_KRITERIUM.
97         ENDIF.
98         PERFORM GRUPPENFELDER_ZUWEISEN IN PROGRAM (LIS_PROGNAME) IF FOUND.
99       ENDIF.
100
101      CLEAR ANZ_HIERARCHIE_AUFRISSE.
102      LOOP AT AKT_DRILLDOWN.
103        IF SY-TABIX > AA_LSIND.
104    *     Überflüssig, da AKT_DRILLDOWN sowie so ganz zurückgelesen wird
105    *     Nicht mehr benötigte Aufrißinfo löschen
106    *     delete akt_drilldown.
107        ELSE.
108          IF AKT_DRILLDOWN-FCODE(1) = 'H'.
109    *       Hierarchieaufriß
110            ADD 1 TO ANZ_HIERARCHIE_AUFRISSE.
111          ENDIF.
112          IF SY-TABIX = AA_LSIND.
113            IF FLG_AUSTAB_AKTUELL = FALSE.
114    *         Merkmalsausprägung des Aufrisses löschen
115              CLEAR AKT_DRILLDOWN-OBJEKT.
116              MODIFY AKT_DRILLDOWN.
117    *         Layouteinstellung wiederherstellen
118              ANALYSE_WAEHRUNG  = AKT_DRILLDOWN-WAEHRUNG.
119              FLG_HEADER_PATH   = AKT_DRILLDOWN-FLG_HEADER_PATH.
120              FLG_OBJEKTTEXT    = AKT_DRILLDOWN-FLG_OBJEKTTEXT.
121              FLG_PROZENTWERT   = AKT_DRILLDOWN-FLG_PROZENTWERT.
122              FLG_TOPLISTE      = AKT_DRILLDOWN-FLG_TOPLISTE.
123              FLG_SORT_ABST     = AKT_DRILLDOWN-FLG_SORT_ABST.
124              SPALTEN_ANFANG    = AKT_DRILLDOWN-SPALTEN_ANFANG.
125              SPALTEN_BREITE    = AKT_DRILLDOWN-SPALTEN_BREITE.
126              SPALTEN_BREITE_P  = SPALTEN_BREITE - 1.
127              HITLISTEN_GROESSE = AKT_DRILLDOWN-HITL_GROESSE.
128              HITL_KRITERIUM    = AKT_DRILLDOWN-HITL_KRITERIUM.
129            ENDIF.
130          ENDIF.
131        ENDIF.
132      ENDLOOP.
133      DESCRIBE TABLE AKT_DRILLDOWN LINES DRILLDOWN_EINTRAEGE.
134
135      IF FLG_AUSTAB_AKTUELL = FALSE AND FLG_STD_DRILLDOWN = FALSE.
136    *   Aufriß- und Standardaufriß waren bei tieferer Aufrißstufe verschie-
137    *   den => es muß überprüft werden, ob dies noch immer der Fall ist
138        FLG_STD_DRILLDOWN = TRUE.
139        LOOP AT AKT_DRILLDOWN.
140          READ TABLE STD_DRILLDOWN WITH KEY FCODE = AKT_DRILLDOWN-FCODE.
141          IF SY-SUBRC <> 0.
142            FLG_STD_DRILLDOWN = FALSE.
143            EXIT.
144          ENDIF.
145        ENDLOOP.
146      ENDIF.
147      PERFORM SPEZIAL_AKT_DRILLDOWN IN PROGRAM (LIS_PROGNAME) IF FOUND.
148    ENDFORM.                               "AKT_DRILLDOWN_AKTUALISIEREN
