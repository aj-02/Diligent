1311   *&      Form  CHECK_KF_COLUMN
1312   *&---------------------------------------------------------------------*
1313   *       Checks whether cursor is positioned on a NUMERICAL
1314   *       key-figure colum of the current output list.
1315   *----------------------------------------------------------------------*
1316   *      <--P_KF_OBJECT: Identifier of key-figure. Is set to INITIAL
1317   *                      if cursor is not located on a numerical
1318   *                      key-figure column
1319   *----------------------------------------------------------------------*
1320   FORM check_kf_column CHANGING p_kf_object LIKE kennzahlen_tab-fieldname.
1321
1322     DATA: sb_hlp_cucol LIKE sy-cucol,
1323           sb_akt_curow LIKE sy-cucol,
1324           sb_akt_cucol LIKE sy-cucol,
1325           sb_spalte    LIKE sy-tabix.
1326
1327     IF darstellungsart <> con_darst_einzel      AND
1328        darstellungsart <> con_darst_summe       AND
1329        darstellungsart <> con_darst_restsumme   AND
1330        darstellungsart <> con_darst_verdichtung AND
1331        darstellungsart <> con_darst_ueberschrift.
1332       CLEAR p_kf_object.
1333       EXIT.
1334     ENDIF.
1335
1336     sb_hlp_cucol = spalten_anfang.
1337     GET CURSOR LINE sb_akt_curow OFFSET sb_akt_cucol.
1338     sb_akt_cucol = sb_akt_cucol + 2.
1339
1340     IF sb_akt_cucol > sb_hlp_cucol.
1341       LOOP AT akt_kennzahlen.
1342         ADD 1 TO sb_spalte.
1343         sb_hlp_cucol = sb_hlp_cucol + akt_kennzahlen-outputlen + 1.
1344         IF NOT akt_kennzahlen-reflen IS INITIAL AND
1345            flg_einheitenzeile        =  false.
1346   *       Einheitenfeld vorhanden
1347           sb_hlp_cucol = sb_hlp_cucol + akt_kennzahlen-reflen + 1.
1348         ENDIF.
1349         IF sb_akt_cucol <= sb_hlp_cucol.
1350           EXIT.
1351         ENDIF.
1352       ENDLOOP.
1353     ENDIF.
1354
1355   * Read identifier of selected key-figure
1356     READ TABLE akt_kennzahlen INDEX sb_spalte.
1357     IF sb_spalte IS INITIAL  OR
1358        akt_kennzahlen-inttype NA con_inttype_zahl.
1359       CLEAR p_kf_object.
1360     ELSE.
1361       p_kf_object = akt_kennzahlen-fieldname.
1362     ENDIF.
1363
1364   ENDFORM.                               " CHECK_KF_COLUMN
