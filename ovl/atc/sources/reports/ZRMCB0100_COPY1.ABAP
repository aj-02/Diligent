3891                                    CHANGING hlp_summe.
3892           PERFORM sumeinheiten_setzen USING    puffertab
3893                                       CHANGING hlp_summe.
3894
3895           PERFORM lagerhue_kennzahlen_puffertab CHANGING hlp_letztzug
3896                                                          hlp_letztabg
3897                                                          hlp_letztver
3898                                                          hlp_letztbew.
