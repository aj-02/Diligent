744    *---------------------------------------------------------------------*
745    *       FORM XXL_FELDSYMBOLE_ZUWEISEN                                 *
746    *---------------------------------------------------------------------*
747    *       Feldsymbole zum Füllen den Datentabelle zuweisen              *
748    *       Sind Merkmale in XXL_DATA_MERKMALE eingetragen, die kein Feld *
749    *       der Tabelle XXL_DATA sind, werden diese ignoriert.            *
750    *---------------------------------------------------------------------*
751    *  -->  XZ_INTTAB: Tabelle, aus der die Daten nach XXL übertragen     *
752    *                  werden sollen. Dies ist INT_S000 oder XXL_S000     *
753    *---------------------------------------------------------------------*
754    FORM XXL_FELDSYMBOLE_ZUWEISEN TABLES XZ_INTTAB.
755                               " nicht typisiert weil verschiedene Strukt.
756
757      DATA: XZ_INT TYPE I,
758            XZ_TMERKMALSKETTUNG TYPE T_MERKMALSKETTUNG,
759            XZ_MERKMALSKETTUNG  TYPE MERKMALSKETTUNG,
760            XZ_VARIABLE,
761            XZ_ANZ_MERKMALSKETTUNGEN TYPE I,
762            APPENDFLG.
763
764    * Feldsymbole für Merkmale zuweisen
765      LOOP AT XXL_DATA_MERKMALE.
766        DEFINE _WHEN_ASSIGN_MERKMAL.
767        WHEN &1.
768          ASSIGN COMPONENT XXL_DATA_MERKMALE-FIELDNAME:
769                 OF STRUCTURE XZ_INTTAB TO <INT_MERKMAL&1>,
770                 OF STRUCTURE XXL_DATA  TO <XXL_MERKMAL&1>.
771          XZ_INT = &1.
772        END-OF-DEFINITION.
773        CASE SY-TABIX.
774            _WHEN_ASSIGN_MERKMAL 1.
775            _WHEN_ASSIGN_MERKMAL 2.
776            _WHEN_ASSIGN_MERKMAL 3.
777            _WHEN_ASSIGN_MERKMAL 4.
778            _WHEN_ASSIGN_MERKMAL 5.
779            _WHEN_ASSIGN_MERKMAL 6.
780            _WHEN_ASSIGN_MERKMAL 7.
781            _WHEN_ASSIGN_MERKMAL 8.
782            _WHEN_ASSIGN_MERKMAL 9.
783        ENDCASE.
784
785        REFRESH XZ_TMERKMALSKETTUNG.
786        CLEAR   XXL_DATA_MERKMALE-ANZ_MERKMALSKETTUNGEN.
787        PERFORM MERKMALSKETTUNG_KEY_FOLGE
788          IN PROGRAM (LIS_PROGNAME) IF FOUND
789          USING    XXL_DATA_MERKMALE-ROLLNAME
790          CHANGING XZ_TMERKMALSKETTUNG
791                   XXL_DATA_MERKMALE-ANZ_MERKMALSKETTUNGEN.
792        MODIFY XXL_DATA_MERKMALE.
793        XZ_ANZ_MERKMALSKETTUNGEN = XXL_DATA_MERKMALE-ANZ_MERKMALSKETTUNGEN.
794
795        DEFINE _WHEN_ASSIGN_MERKMAL_2.
796        WHEN &1.
797          ASSIGN COMPONENT XXL_DATA_MERKMALE-FIELDNAME
798                 OF STRUCTURE XZ_INTTAB TO <INT_MERKMAL&1>.
799          INT_OFFSET&1 = XXL_DATA_MERKMALE-OUTPUTLEN.
800        END-OF-DEFINITION.
801
802        IF XZ_ANZ_MERKMALSKETTUNGEN GE 1.
803          ADD 9 TO XZ_INT.
804          READ TABLE XZ_TMERKMALSKETTUNG INDEX 1 INTO XZ_MERKMALSKETTUNG.
805          IF XZ_MERKMALSKETTUNG-ROLLNAME EQ XXL_DATA_MERKMALE-ROLLNAME.
806            READ TABLE XZ_TMERKMALSKETTUNG INDEX 2 INTO XZ_MERKMALSKETTUNG.
807          ENDIF.
808          READ TABLE XXL_DATA_MERKMALE WITH KEY
809            ROLLNAME = XZ_MERKMALSKETTUNG-ROLLNAME.
810          IF SY-SUBRC EQ 0.
811            CASE XZ_INT.
812                _WHEN_ASSIGN_MERKMAL_2 10.
813                _WHEN_ASSIGN_MERKMAL_2 11.
814                _WHEN_ASSIGN_MERKMAL_2 12.
815                _WHEN_ASSIGN_MERKMAL_2 13.
816                _WHEN_ASSIGN_MERKMAL_2 14.
817                _WHEN_ASSIGN_MERKMAL_2 15.
818                _WHEN_ASSIGN_MERKMAL_2 16.
819                _WHEN_ASSIGN_MERKMAL_2 17.
820                _WHEN_ASSIGN_MERKMAL_2 18.
821            ENDCASE.
822          ENDIF.
823    * Kein Löschen von geketten Merkmalen
824          SY-SUBRC = 0.
825        ENDIF.
826        IF XZ_ANZ_MERKMALSKETTUNGEN EQ 2.
827          ADD 9 TO XZ_INT.
828          READ TABLE XZ_TMERKMALSKETTUNG INDEX 2 INTO XZ_MERKMALSKETTUNG.
829          READ TABLE XXL_DATA_MERKMALE WITH KEY
830            ROLLNAME = XZ_MERKMALSKETTUNG-ROLLNAME.
831          IF SY-SUBRC EQ 0.
832            CASE XZ_INT.
833                _WHEN_ASSIGN_MERKMAL_2 19.
834                _WHEN_ASSIGN_MERKMAL_2 20.
835                _WHEN_ASSIGN_MERKMAL_2 21.
836                _WHEN_ASSIGN_MERKMAL_2 22.
837                _WHEN_ASSIGN_MERKMAL_2 23.
838                _WHEN_ASSIGN_MERKMAL_2 24.
839                _WHEN_ASSIGN_MERKMAL_2 25.
840                _WHEN_ASSIGN_MERKMAL_2 26.
841                _WHEN_ASSIGN_MERKMAL_2 27.
842            ENDCASE.
843          ENDIF.
844    * Kein Löschen von geketten Merkmalen
845          SY-SUBRC = 0.
846        ENDIF.
847
848        PERFORM XXL_MERKMAL_PRUEFEN USING SY-SUBRC
849                                          SY-TABIX
850                                          XXL_DATA_MERKMALE-FIELDNAME.
851      ENDLOOP.
852
853      IF NOT SAV_SPERI IS INITIAL AND FLG_PERIODE_GEWAEHLT = TRUE.
854    *   Feldsymbole für Periodenfeld zuweisen, wenn Periode gewählt
855        CASE SAV_SPERI.
856          WHEN CON_SPERI_SPTAG.
857            ASSIGN COMPONENT CON_FELD_SPTAG OF STRUCTURE XZ_INTTAB
858                                            TO <INT_PERIODE>.
859          WHEN CON_SPERI_SPMON.
860            ASSIGN COMPONENT CON_FELD_SPMON OF STRUCTURE XZ_INTTAB
861                                            TO <INT_PERIODE>.
862          WHEN CON_SPERI_SPWOC.
863            ASSIGN COMPONENT CON_FELD_SPWOC OF STRUCTURE XZ_INTTAB
864                                            TO <INT_PERIODE>.
865          WHEN CON_SPERI_SPBUP.
866            ASSIGN COMPONENT CON_FELD_SPBUP OF STRUCTURE XZ_INTTAB
867                                            TO <INT_PERIODE>.
868        ENDCASE.
869        ASSIGN COMPONENT CON_FELD_XXL_PERIO OF STRUCTURE XXL_DATA
870                                            TO <XXL_PERIODE>.
871      ELSE.
872    *   Feldsymbole für Periodenfeld initialisieren
873        ASSIGN SPACE TO <INT_PERIODE>.
874        ASSIGN SPACE TO <XXL_PERIODE>.
875      ENDIF.
876
877    * Feldsymbole für ausgewählte Kennzahlen zuweisen
878      REFRESH XXL_KENNZAHLEN.
879      CLEAR XXL_KENNZAHLEN.
880
881      LOOP AT AKT_KENNZAHLEN.
882        DEFINE _WHEN_ASSIGN_KENNZAHL.
883        WHEN &1.
884          APPENDFLG = TRUE.
885          ASSIGN COMPONENT AKT_KENNZAHLEN-FIELDNAME
886                 OF STRUCTURE XZ_INTTAB TO <INT_KENNZAHL&1>.
887            IF SY-SUBRC <> 0.
888              APPENDFLG = FALSE.
889            ENDIF.
890          ASSIGN COMPONENT AKT_KENNZAHLEN-FIELDNAME
891                 OF STRUCTURE XXL_DATA  TO <XXL_KENNZAHL&1>.
892            IF SY-SUBRC <> 0.
893              APPENDFLG = FALSE.
894            ENDIF.
895          ASSIGN COMPONENT AKT_KENNZAHLEN-REFFIELD
896                 OF STRUCTURE XZ_INTTAB TO <INT_EINHEIT&1>.
897          IF APPENDFLG EQ TRUE.
898            MOVE-CORRESPONDING AKT_KENNZAHLEN TO XXL_KENNZAHLEN.
899            APPEND XXL_KENNZAHLEN.
900          ELSE.
901    *       Gewählte Kennzahl in XXL-Ausgabestruktur nicht enthalten
902            MESSAGE I180(M5) WITH AKT_KENNZAHLEN-FIELDNAME.
903          ENDIF.
904        END-OF-DEFINITION.
905    * Nur wenn das assign-Statement erfolgreich ist, wird die Kennzahl
906    * in xxl_Kennzahlen eingefügt. Anschließend muß noch einmal umkopiert
907    * werden, damit die Pointer <int_kennzahl&>, <xxl_kennzahl&>
