446                    NAME          = HL_RSTTYP_TAB-TDOMNM
447               IMPORTING
448                    GOTSTATE      = HL_GOTSTATE
449                    DD01V_WA      = HL_DD01V_WA
450               EXCEPTIONS
451                    ILLEGAL_INPUT = 1
452                    OTHERS        = 2.
453          IF SY-SUBRC = 0.
454            MOVE-CORRESPONDING HL_DD01V_WA TO RSTTYP_INFO.
455    *       move-corresponding hl_dd01v_wa to hierarchie_fcodes.
456          ENDIF.
457        ENDIF.
458        APPEND RSTTYP_INFO.
459      ENDLOOP.
460
461
462    * Farbinformationsermittlung
463      CLEAR   HL_RSTTYP_HLP.
464      REFRESH HL_RSTTYP_HLP.
465      CLEAR HL_TYP_ZAEHLER.
466      DESCRIBE TABLE RSTTYP_INFO LINES HL_TYP_ANZAHL.
467      LOOP AT RSTHIE_TAB.
468        READ TABLE HL_RSTTYP_HLP WITH KEY TYPE = RSTHIE_TAB-TYPE.
469        IF SY-SUBRC NE 0.
470          ADD 1 TO HL_TYP_ZAEHLER.
471          READ TABLE RSTTYP_INFO WITH KEY TYPE = RSTHIE_TAB-TYPE.
472          IF SY-SUBRC EQ 0.                " Sollte stets stimmen
473            CASE HL_TYP_ZAEHLER.
474              WHEN 1.
475                RSTTYP_INFO-COLOR = '1'.
476              WHEN 2.
477                RSTTYP_INFO-COLOR = '4'.
478              WHEN 3.
479                RSTTYP_INFO-COLOR = '3'.
480              WHEN 4.
481                RSTTYP_INFO-COLOR = '7'.
482            ENDCASE.
483            IF NOT RSTHIE_TAB-LEAF IS INITIAL.
484              RSTTYP_INFO-COLOR = '0'.
485            ENDIF.
486            MODIFY RSTTYP_INFO INDEX SY-TABIX. " Farbinformation schreiben
487            IF HL_TYP_ZAEHLER = HL_TYP_ANZAHL.
488              EXIT.
489            ENDIF.
490            HL_RSTTYP_HLP-TYPE = RSTHIE_TAB-TYPE.
491            APPEND HL_RSTTYP_HLP.
492          ENDIF.
493        ENDIF.
494      ENDLOOP.                             " rsthie_tab
495
496    ENDFORM.                               "HSEL_HIERARCHIE_LESEN
