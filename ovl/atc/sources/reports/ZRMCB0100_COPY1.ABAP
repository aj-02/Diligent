925    *---------------------------------------------------------------------*
926    *       FORM HIERARCHIE_AUFREISSEN                                    *
927    *---------------------------------------------------------------------*
928    *       Der übergebenen Hierarchieknoten HA_KNOTEN_ID wird aufgeris-  *
929    *       sen, d.h. seine Nachfolger werden ermittelt und die Werte der *
930    *       dazugehörigen Blätter werden kumuliert                        *
931    *---------------------------------------------------------------------*
932    *  -->  HA_KNOTEN_ID: Aufzureißender Hierarchieknoten                 *
933    *---------------------------------------------------------------------*
934    FORM hierarchie_aufreissen USING ha_knoten_id LIKE rsthie-id.
935      DATA: ha_flg_alles_blaetter TYPE boolean,
936    *       Flag ist TRUE, wenn alle Nachf. des akt. Knotens Blätter sind
937    *               FALSE, wenn min. 1 Nachf. des akt. Knoten kein Blatt ist
938            ha_flg_blatt          TYPE boolean,
939    *       Flag ist TRUE, wenn Knoten, zu dem Nachfolger ermittelt werden
940    *                      sollten, selbst ein Blatt ist
941            ha_nachf_anzahl       LIKE sy-tabix,
942    *       Anzahl der Nachfolger des Hierarchieknoten
943            ha_flg_kein_standard  TYPE boolean,
944            ha_flg_letzter_succ   TYPE boolean,
945    *       Flag ist TRUE, falls letzter Eintrag in Tab. SUCCTAB erreicht
946            ha_flg_letzter_leaf   TYPE boolean,
947    *       Flag ist TRUE, falls letzter Eintrag in Tab. LEAFTAB erreicht
948            ha_leaf_anzahl        LIKE sy-tabix.
949    *       Anzahl Einträge in Tabelle LEAFTAB
950
951
952      PERFORM text_ermitteln USING    46
953    *                                 'Hierarchie wird verarbeitet...'
954                             CHANGING hlp_text1.
955      CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
956           EXPORTING
957                text = hlp_text1.
958      IF NOT analyse_waehrung IS INITIAL.
959    *   Analysewährung gewählt => Umrechnung ggf. notwendig
960        IF flg_puffertab_aktuell = false.
961    *     Puffertabelle ist leer => Puffertab füllen
962          IF AKT_DRILLDOWN-KETT_AKT IS INITIAL.          " ==>> note 401881
963    *       Verdichtungsmerkmal neu setzen:
964    *         die Initialiserung des Feldsymbols <INTTAB_OBJEKT> kann
965    *         durch Aufrisswechsel verloren gehen
966            ASSIGN COMPONENT AKT_HIERARCHIE-MERKMALS_FELDNAME
967                            OF STRUCTURE INT_S000 TO <INTTAB_OBJEKT>.
968          ELSE.
969            PERFORM MERKMALSKETTUNG_INTTAB
970                    CHANGING ANZ_MERKMALSKETTUNGEN.
971          ENDIF.                                         " <<== note 401881
972          IF sav_spzis = 'D' OR sav_spzis = 'E'.
973    *     Puffertab spezial für Bestandscontrolling
974            PERFORM puffertab_fuellen_invcon IN PROGRAM (lis_progname)
975                                                         IF FOUND.
976          ELSE.
977            PERFORM puffertab_fuellen.
978    *       Puffertab umrechnen
979          ENDIF.
980    *     perform puffertab_umrechnen tables u_auspraegungstab. " <= TR
981    *     refresh u_auspraegungstab.                   " <= TR 31.10.1998
982          REFRESH u_auspraegungstab.       " <= TR 31.10.1998
983          PERFORM puffertab_umrechnen TABLES u_auspraegungstab. " <= TR
984        ENDIF.
985      ENDIF.
986
987    * Flag initialisieren
988      ha_flg_alles_blaetter = true.
989    * Nachfolger bestimmen
990      CALL FUNCTION 'RSTH_SUCCESSORS_COMPUTE'
991           EXPORTING
992                node_id      = ha_knoten_id
993           TABLES
994                i_rsthie     = rsthie_tab
995                e_successors = succtab.
996      DESCRIBE TABLE succtab LINES ha_nachf_anzahl.
997      IF ha_nachf_anzahl > 0.
998    *   Aufzureißender Hierarchieknoten ist kein Blatt
999        SORT succtab BY name.
1000       REFRESH aus_s000.
1001       CLEAR   sum_s000.
1002       LOOP AT succtab.
1003         IF sy-tabix EQ ha_nachf_anzahl.
1004           ha_flg_letzter_succ = true.
1005         ELSE.
1006           ha_flg_letzter_succ = false.
1007         ENDIF.
1008         CLEAR hlp_summe.
1009         hlp_summe-xobjekt = succtab-name.
1010         hlp_summe-xid     = succtab-id.
1011         IF akt_hierarchie-hpost = false.
1012   *       Hierarchie nicht bebuchbar => ermittle alle Blätter zum Nachf.
1013           CALL FUNCTION 'RSTH_LEAFS_COMPUTE'
1014                EXPORTING
1015                     node_id      = succtab-id
1016                IMPORTING
1017                     node_is_leaf = ha_flg_blatt
1018                TABLES
1019                     i_rsthie     = rsthie_tab
1020                     e_leafs      = leaftab.
1021         ELSE.
1022   *       Hierarchie bebuchbar => erm. alle Knoten und Blätter zum Nachf.
1023           CALL FUNCTION 'RSTH_NODES_COMPUTE'
1024                EXPORTING
1025                     node_id      = succtab-id
1026                IMPORTING
1027                     node_is_leaf = ha_flg_blatt
1028                TABLES
1029                     i_rsthie     = rsthie_tab
1030                     e_nodes      = leaftab.
1031         ENDIF.
1032         IF ha_flg_blatt = true.
1033   *       Nachfolger ist Blatt
1034           IF akt_hierarchie-hpost = false.
1035   *         und Hierarchie ist nicht bebuchbar => LEAFTAB mit Nachfolger
1036   *         füllen, da Nachfolger keine 'echten' Blätter hat
1037             leaftab-name = succtab-name.
1038             APPEND leaftab.
1039           ENDIF.
1040         ELSE.
1041   *       Nachfolger ist kein Blatt => Flag entsprechend setzen und die
1042   *       Blätter zum Nachfolger bestimmen
1043           ha_flg_alles_blaetter = false.
1044         ENDIF.
1045
1046         SORT leaftab BY name.
1047         DESCRIBE TABLE leaftab LINES ha_leaf_anzahl.
1048
1049   *     Kumuliere die Werte der Merkmalsausprägungen (Blätter)
1050         IF analyse_waehrung IS INITIAL.
1051   *       Keine Analysewährung gewählt => Werte aus AUSPRAEGUNGSTAB
1052   *       kumulieren
1053           PERFORM auspraegungstab_kumulieren TABLES auspraegungstab
1054                                                     auspraegungstab
1055                                              USING  true.
1056   *       LOOP AT LEAFTAB.
1057   *         READ TABLE AUSPRAEGUNGSTAB WITH KEY OBJEKT = LEAFTAB-NAME
1058   *                                         BINARY SEARCH.
1059   *         IF SY-SUBRC = 0.
1060   *           ADD-CORRESPONDING AUSPRAEGUNGSTAB TO HLP_SUMME.
1061   *           PERFORM SUMEINHEITEN_SETZEN USING    AUSPRAEGUNGSTAB
1062   *                                       CHANGING HLP_SUMME.
1063   *         ENDIF.
1064   *       ENDLOOP.
1065         ELSE.
1066           PERFORM auspraegungstab_kumulieren TABLES u_auspraegungstab
1067                                                     u_auspraegungstab
1068                                              USING  true.
1069   *       Analysewährung gewählt => Werte aus PUFFERTAB kumulieren
1070   *       LOOP AT LEAFTAB.
1071   *         READ TABLE U_AUSPRAEGUNGSTAB WITH KEY OBJEKT = LEAFTAB-NAME
1072   *                                           BINARY SEARCH.
1073   *         IF SY-SUBRC = 0.
1074   *           ADD-CORRESPONDING U_AUSPRAEGUNGSTAB TO HLP_SUMME.
1075   *           PERFORM SUMEINHEITEN_SETZEN USING    U_AUSPRAEGUNGSTAB
1076   *                                       CHANGING HLP_SUMME.
1077   *         ENDIF.
1078   *       ENDLOOP.
1079         ENDIF.
1080         IF sy-subrc = 0.
1081   *       Knoten bzw. Blatt kommt in Ausprägungstabelle vor
1082           aus_s000 = hlp_summe.
1083           PERFORM zusatzkennzahlen_berechnen IN PROGRAM (lis_progname)
1084                                              CHANGING aus_s000
1085                                              IF FOUND.
1086           APPEND aus_s000.
1087   *       Summe ermitteln
1088           PERFORM spezial_add_austab IN PROGRAM (lis_progname)
1089                                      USING    hlp_summe
1090                                               true
1091                                               ha_flg_letzter_succ
1092                                      CHANGING sum_s000
1093                                               ha_flg_kein_standard
1094                                      IF FOUND.
1095           IF ha_flg_kein_standard NE true.
1096             ADD-CORRESPONDING hlp_summe TO sum_s000.
1097           ENDIF.
1098   *       Einheiten der Summe setzen
1099           PERFORM sumeinheiten_setzen USING    hlp_summe
1100                                       CHANGING sum_s000.
1101         ENDIF.
1102       ENDLOOP.
1103
1104       IF akt_hierarchie-hpost = true.
1105   *     Hierarchie ist bebuchbar => Bestimme Werte für Wurzelknoten, da er
1106   *     auch Werte tragen kann
1107         READ TABLE RSTHIE_TAB WITH KEY ID = ha_knoten_id BINARY SEARCH.
1108         CLEAR hlp_summe.
1109         hlp_summe-xobjekt = rsthie_tab-name.
1110         hlp_summe-xid     = rsthie_tab-id.
1111         IF analyse_waehrung IS INITIAL.
1112   *       Keine Analysewährung gewählt => Werte aus AUSPRAEGUNGSTAB kumul.
1113           PERFORM auspraegungstab_kumulieren TABLES auspraegungstab
1114                                                     auspraegungstab
1115                                              USING  false.
1116   *       READ TABLE AUSPRAEGUNGSTAB WITH KEY OBJEKT = HLP_SUMME-XOBJEKT
1117   *                                       BINARY SEARCH.
1118   *       IF SY-SUBRC = 0.
1119   *         ADD-CORRESPONDING AUSPRAEGUNGSTAB TO HLP_SUMME.
1120   *         PERFORM SUMEINHEITEN_SETZEN USING    AUSPRAEGUNGSTAB
1121   *                                     CHANGING HLP_SUMME.
1122   *       ENDIF.
1123         ELSE.
1124   *       Analysewährung gewählt => Werte aus PUFFERTAB kumulieren
1125           PERFORM auspraegungstab_kumulieren TABLES u_auspraegungstab
1126                                                     u_auspraegungstab
1127                                              USING  false.
1128   *      READ TABLE U_AUSPRAEGUNGSTAB WITH KEY OBJEKT = HLP_SUMME-XOBJEKT
1129   *                                                         BINARY SEARCH.
1130   *       IF SY-SUBRC = 0.
1131   *         ADD-CORRESPONDING U_AUSPRAEGUNGSTAB TO HLP_SUMME.
1132   *         PERFORM SUMEINHEITEN_SETZEN USING    U_AUSPRAEGUNGSTAB
1133   *                                     CHANGING HLP_SUMME.
1134   *       ENDIF.
1135         ENDIF.
1136         IF sy-subrc = 0.
1137   *       Wurzel hat Werte
1138           aus_s000 = hlp_summe.
1139           PERFORM zusatzkennzahlen_berechnen IN PROGRAM (lis_progname)
1140                                              CHANGING aus_s000
1141                                              IF FOUND.
1142           INSERT aus_s000 INDEX 1.
1143   *       Summe ermitteln
1144           PERFORM spezial_add_austab IN PROGRAM (lis_progname)
1145                                      USING    hlp_summe
1146                                               true
1147                                               true
1148                                      CHANGING sum_s000
1149                                               ha_flg_kein_standard
1150                                      IF FOUND.
1151           IF ha_flg_kein_standard NE true.
1152             ADD-CORRESPONDING hlp_summe TO sum_s000.
1153           ENDIF.
1154   *       Einheiten der Summe setzen
1155           PERFORM sumeinheiten_setzen USING    hlp_summe
1156                                       CHANGING sum_s000.
1157         ENDIF.
1158       ENDIF.
1159
1160   *   Zusatzkennzahlen für Summenzeile bestimmen
1161       PERFORM zusatzkennzahlen_berechnen IN PROGRAM (lis_progname)
1162                                          CHANGING sum_s000
1163                                          IF FOUND.
1164     ENDIF.
1165   * Info zum Hierarchieaufriß in Tabelle AKT_DRILLDOWN anpassen
1166     PERFORM hierarchie_akt_ddown_anpassen USING ha_flg_alles_blaetter
1167                                                 ha_nachf_anzahl.
1168   ENDFORM.                               "HIERARCHIE_AUFREISSEN
