6281   *&---------------------------------------------------------------------*
6282   *&      Form  UMSCHLAG_BERECHNEN
6283   *&---------------------------------------------------------------------*
6284   *       Der genaue Lagerumschlag wird berechnet.                       *
6285   *----------------------------------------------------------------------*
6286   *  Umschlagshäufigkeit gesamt:   Gilt für den gesamten Sel.zeitr.      *
6287   *  mittlere Umschlagshäufigkeit: Auf Basis eines Tagesverbrauchs       *
6288   *                                berechnet.                            *
6289   *----------------------------------------------------------------------*
6290   FORM umschlag_berechnen USING kz_eintrag STRUCTURE aus_s000.
6291
6292     DATA:  zu_verbrauch     TYPE f,
6293            zu_umschlag      TYPE f,
6294            zu_verbrwert     TYPE f,
6295            zu_verbrjahr     TYPE f,
6296            zu_verbrwertjahr TYPE f,
6297            zu_umschlag_j    TYPE f,
6298            ub_periodenlaenge TYPE i,
6299            ub_monat          TYPE d.
6300
6301     CLEAR: zu_verbrauch, zu_umschlag, zu_verbrwert, zu_verbrjahr,
6302            zu_verbrwertjahr.
6303
6304     IF ( flg_dd = true OR akt_drilldown-fcode = con_fcode_aper )
6305       AND sum_kz = false.
6306   *   Periode im Aufrißpfad bzw. aktuelles Objekt in der Liste
6307       IF flg_monat IS INITIAL.
6308         zu_verbrauch     = kz_eintrag-mgvbr / periodenlaenge.
6309         zu_verbrwert     = kz_eintrag-wgvbr / periodenlaenge.
6310       ELSE.
6311         IF akt_drilldown-objekt NE con_fcode_aper.
6312           PERFORM akt_drilldown_lesen.
6313           ub_monat = hlp_akt_drilldown-objekt.
6314         ELSE.
6315           ub_monat = kz_eintrag-objekt(8).
6316         ENDIF.
6317         PERFORM anzahl_tage USING    ub_monat
6318                             CHANGING ub_periodenlaenge.
6319         zu_verbrauch = kz_eintrag-mgvbr / ub_periodenlaenge.
6320         zu_verbrwert = kz_eintrag-wgvbr / ub_periodenlaenge.
6321       ENDIF.
6322     ELSE.
6323   *   Aufrißcode = periodenübergreifend, z.B. Werk
6324       IF flg_monat IS INITIAL.
6325         zu_verbrauch =
6326           kz_eintrag-mgvbr / ( anzahl_perio * periodenlaenge ).
6327         zu_verbrwert =
6328           kz_eintrag-wgvbr / ( anzahl_perio * periodenlaenge ).
6329       ELSE.
6330         zu_verbrauch = kz_eintrag-mgvbr / anz_tage.
6331         zu_verbrwert = kz_eintrag-wgvbr / anz_tage.
6332       ENDIF.
6333     ENDIF.
6334   *  Umschlagshäufigkeit-Gesamt u. mittlere Umschlagshäufigkeit
6335   *  des bewerteten Bestandes Menge/Wert pro Tag und pro Jahr
6336     PERFORM berechne_zahl_360 USING zu_verbrauch
6337                                     kz_eintrag-dbwbest
6338                            CHANGING kz_eintrag-duhbwbest
6339                                     kz_eintrag-juhbwbest.
6340     PERFORM berechne_zahl USING kz_eintrag-mgvbr
6341                                 kz_eintrag-dbwbest
6342                        CHANGING kz_eintrag-uhbwbest.
6343
6344     PERFORM berechne_zahl_360 USING zu_verbrwert
6345                                     kz_eintrag-dwbwbest
6346                            CHANGING kz_eintrag-duhwbwbest
6347                                     kz_eintrag-juhwbwbest.
6348     PERFORM berechne_zahl USING kz_eintrag-wgvbr
6349                                 kz_eintrag-dwbwbest
6350                        CHANGING kz_eintrag-uhwbwbest.
6351   * Umschlagshäufigkeit-Gesamt u. mittlere Umschlagshäufigkeit
6352   * des Konsi-Bestandes
6353     PERFORM berechne_zahl_360 USING zu_verbrauch
6354                                     kz_eintrag-dkobest
6355                            CHANGING kz_eintrag-duhkobest
6356                                     kz_eintrag-juhkobest.
6357     PERFORM berechne_zahl USING kz_eintrag-mgvbr
6358                                 kz_eintrag-dkobest
6359                        CHANGING kz_eintrag-uhkobest.
6360   * Umschlagshäufigkeit-Gesamt u. mittlere Umschlagshäufigkeit
6361   * des Gesamtbestandes Wert/Menge
6362     PERFORM berechne_zahl_360 USING zu_verbrauch
6363                                     kz_eintrag-dgsbest
6364                            CHANGING kz_eintrag-duhgsbest
6365                                     kz_eintrag-juhgsbest.
6366     PERFORM berechne_zahl USING kz_eintrag-mgvbr
6367                                 kz_eintrag-dgsbest
6368                        CHANGING kz_eintrag-uhgsbest.
6369     kz_eintrag-duhwgsbest = kz_eintrag-duhwbwbest.
6370     kz_eintrag-uhwgsbest  = kz_eintrag-uhwbwbest.
6371     kz_eintrag-juhwgsbest = kz_eintrag-juhwbwbest.
6372   ENDFORM.                               " UMSCHLAG_BERECHNEN
