386                                         '000'
387                                         HLP_TEXT1.
388          WINDOW  STARTING AT AA_START_COL AA_START_ROW
389                    ENDING AT AA_END_COL   AA_END_ROW.
390          NEW-PAGE LINE-SIZE AA_POPUP_WIDTH.
391        ENDIF.
392      ENDIF.
393      PERFORM KENNZAHLEN_LISTE_AUSGEBEN.
