6      *---------------------------------------------------------------------*
7      *       FORM WAEHRUNGSBETRAG_KONVERTIEREN                             *
8      *---------------------------------------------------------------------*
9      *       Konvertierung eines Währungsbetrages gemäß der übergebenen    *
10     *       Währung von der internen Darstellung in den absoluten Wert.   *
11     *       Bsp.: WK_WERT = 1,00  WK_WAERS = ITL => WK_ABS_BETRAG = 100   *
12     *       Ist eine Fremdwährung angegeben, wird der Währungsbetrag zu-  *
13     *       sätzlich vor der Konvertierung noch umgerechnet.              *
14     *---------------------------------------------------------------------*
15     *  -->  WK_DATATYPE   : Datentyp des übergebenen Wertes               *
16     *                       =  CON_DATATYPE_CURR => Währungsbetrag konv.  *
17     *                       <> CON_DATATYPE_CURR => keine Konv. notwendig *
18     *  -->  WK_WERT       : Kennzahlenwert bzw. Währungsbetrag            *
19     *  -->  WK_WAERS      : Währung                                       *
20     *  -->  WK_FREMDWAERS : Fremdwährung                                  *
21     *                       =  SPACE => keine Währungsumrechnung          *
22     *                       <> SPACE => Umrechnung in diese Währung       *
23     *  <--  WK_ABS_BETRAG : absoluter Betrag                              *
24     *---------------------------------------------------------------------*
25     FORM WAEHRUNGSBETRAG_KONVERTIEREN
26                         USING    WK_DATATYPE    LIKE DFIES-DATATYPE
27                                  WK_WERT        TYPE SIMPLE
28                                  WK_WAERS       TYPE CLIKE
29                                  WK_FREMDWAERS  TYPE CLIKE
30                         CHANGING WK_ABS_BETRAG  TYPE SIMPLE.
31
32       DATA: WK_FREMDBETRAG TYPE F.
33
34       IF WK_DATATYPE <> CON_DATATYPE_CURR.
35     *   WK_WERT ist kein Währungsbetrag
36         WK_ABS_BETRAG = WK_WERT.
37         EXIT.
38       ENDIF.
39       IF WK_FREMDWAERS IS INITIAL.
40     *   Keine Fremdwährung => Währungsbetrag konvertieren
41         READ TABLE WAEHRUNGS_KONVERT WITH KEY WK_WAERS BINARY SEARCH.
42         IF SY-SUBRC = 0.
43     *     Konvertierung notwendig
44           WK_ABS_BETRAG = WK_WERT * WAEHRUNGS_KONVERT-FAKTOR.
45         ELSE.
46     *     Keine Konvertierung notwendig
47           WK_ABS_BETRAG = WK_WERT.
48         ENDIF.
49       ELSE.
50     *   Fremdwährung => Währungsbetrag umrechnen und Fremdbetrag konvert.
51         PERFORM WAEHRUNGSBETRAG_UMRECHNEN USING    WK_WERT
52                                                    WK_WAERS
53                                                    WK_FREMDWAERS
54                                           CHANGING WK_FREMDBETRAG.
55         READ TABLE WAEHRUNGS_KONVERT WITH KEY WK_FREMDWAERS BINARY SEARCH.
56         IF SY-SUBRC = 0.
57     *     Konvertierung notwendig
58           WK_ABS_BETRAG = WK_FREMDBETRAG * WAEHRUNGS_KONVERT-FAKTOR.
59         ELSE.
60     *     Keine Konvertierung notwendig
61           WK_ABS_BETRAG = WK_FREMDBETRAG.
62         ENDIF.
63       ENDIF.
64
65     ENDFORM.                               "WAEHRUNGSBETRAG_KONVERTIEREN
66
67
68     *---------------------------------------------------------------------*
69     *       FORM WAEHRUNGSBETRAG_UMRECHNEN                                *
70     *---------------------------------------------------------------------*
71     *       Währungsbetrag von der WU_WAERS in die WU_FREMDWAERS umrechnen*
72     *---------------------------------------------------------------------*
73     *  -->  WU_BETRAG     : Währungsbetrag                                *
74     *  -->  WU_WAERS      : Währung                                       *
75     *  -->  WU_FREMDWAERS : Fremdwährung                                  *
76     *                       =  SPACE => keine Währungsumrechnung          *
77     *                       <> SPACE => Umrechnung in diese Währung       *
78     *  -->  WU_FREMDBETRAG: Umgerechneter Währungsbetrag                  *
79     *---------------------------------------------------------------------*
80     FORM WAEHRUNGSBETRAG_UMRECHNEN
81                         USING    WU_BETRAG       TYPE  NUMERIC
82                                  WU_WAERS        TYPE  WAERS
83                                  WU_FREMDWAERS   TYPE  WAERS
84                         CHANGING WU_FREMDBETRAG  TYPE  NUMERIC.
85
86       DATA: WU_UMRECH_FAKTOR TYPE F,       "Umrechnungsfaktor
87             WU_RETURNCODE    LIKE SY-SUBRC.
88
89       IF NOT WU_FREMDWAERS IS INITIAL AND
90          WU_WAERS <> WU_FREMDWAERS    AND
91          NOT WU_WAERS IS INITIAL.
92     *   Umrechnung notwendig
93         PERFORM UMRECHNUNGSFAKTOR_BESTIMMEN USING    WU_WAERS
94                                                      WU_FREMDWAERS
95                                             CHANGING WU_UMRECH_FAKTOR
96                                                      WU_RETURNCODE.
97         IF WU_RETURNCODE <> 0.
98     *     Fehlermeldung wurde schon in UMRECHNUNGSFAKTOR_BESTIMMEN ausgelöst
99         ELSE.
100    *     Währungsbetrag umrechnen
101          WU_FREMDBETRAG = WU_BETRAG * WU_UMRECH_FAKTOR.
102        ENDIF.
103      ELSE.
104    *   Umrechnung nicht notwendig
105        WU_FREMDBETRAG = WU_BETRAG.
106      ENDIF.
107
108    ENDFORM.                               "WAEHRUNGSBETRAG_UMRECHNEN
