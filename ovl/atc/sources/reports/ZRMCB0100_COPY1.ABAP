393    *---------------------------------------------------------------------*
394    *       Ausgabe des Selektionsprotokolls wahlweise auf Drucker, Bild- *
395    *       schirm oder in eine Puffertabelle                             *
396    *---------------------------------------------------------------------*
397    *       Datenstruktur           Bedeutung                             *
398    *  <T>  SA_SELPROT_CONT         Container für Selektionsprotokoll     *
399    *  I->  SA_OUTPUT_DEVICE        legt fest, wohin die Ausgabe soll
400    *                               P=physikalisches Device (z.B. Drucker *
401    *                                 oder Display)                       *
402    *                               B=Buffercontainer zum Weiterreichen an*
403    *                                 einen Editor                        *
404    *---------------------------------------------------------------------*
405    FORM SELEKTIONSPROTOKOLL_AUSGEBEN
406         TABLES SA_SELPROT_CONT  STRUCTURE MS_MAILOBJECT_CONT
407         USING SA_OUTPUT_DEVICE  TYPE      C.
408      TABLES: TMC4T.                       "Info-Struktur-Bezeichnung
409
410    * Feldleiste für 2-spaltige Zeile des Selektionsprotokolls
411    * (Achtung: Wenn die Länge von SELPROT_ZEILE_2SP vergrößert wird, muß
412    * dies auch in LISTE_DRUCKEN bei 'IF LD_MAX_LAENGE < 72.' entsprechend
413    * berücksichtigt werden)
414      DATA: BEGIN OF SELPROT_ZEILE_2SP,
415             NAME(20)       TYPE C,
416             FILLERA        TYPE C,
417             INHALT(51)     TYPE C,
418            END OF SELPROT_ZEILE_2SP.
419    * Feldleiste für 5-spaltige Zeile des Selektionsprotokolls
420      DATA: BEGIN OF SELPROT_ZEILE_5SP,
421             NAME(20)       TYPE C,
422             FILLERA        TYPE C,
423             SIGN           LIKE RSPARAMS-SIGN,
424             FILLERB        TYPE C,
425             OPTION         LIKE RSPARAMS-OPTION,
426             FILLERC        TYPE C,
427             LOW(22)        TYPE C,
428             FILLERD        TYPE C,
429             HIGH(22)       TYPE C,
430            END OF SELPROT_ZEILE_5SP.
431
432    * Protkollzeile unstrukturiert
433      DATA: SELPROT_ZEILE LIKE MCMAILOBJ-OBJLINE.
434
435      DATA: SA_FLG_KEIN_STANDARD,
436            SA_HLP_DATUM  LIKE MCS0-SPTAG,
437            SA_HLP_PERIO  LIKE MCS0-SPMON,
438            SA_HLP_ISTXT  LIKE TMC4T-ISTXT,
439            SA_HLP_CONVEXIT(7) VALUE '==',
440            SA_HLP_TEXT(67),
441            SA_HLP_OFFSET TYPE I,
442            SA_ANZ_SELPROT_KOPFZEILEN LIKE SY-TABIX,
443            SA_SELPROT_ZL             LIKE SY-TABIX,  " Zeilenlänge
444            SA_WIN_X1     TYPE I,          " obere linke Fensterecke X
445            SA_WIN_Y1     TYPE I,          " obere Linke Fensterecke Y
446            SA_WIN_X2     TYPE I,          " untere rechte Fensterecke X
447            SA_WIN_Y2     TYPE I.          " untere rechte Fensterecke Y
448
449      PERFORM SPEZIAL_SELPROTOKOLL_AUSGEBEN IN PROGRAM (LIS_PROGNAME)
450                                            IF FOUND
451                                            TABLES   SA_SELPROT_CONT
452                                            USING    SA_OUTPUT_DEVICE
453                                            CHANGING SA_FLG_KEIN_STANDARD.
454      CHECK SA_FLG_KEIN_STANDARD = FALSE.
455
456    *   *** Leeren des Containers für das Selektionsprotokoll und Initia-
457    *   *** lisieren der hilfsfeldleisten
458    *   *** Feststellen der Länge einer Ausgabezeile
459      MOVE SY-ULINE TO SELPROT_ZEILE_2SP.
460      SA_SELPROT_ZL = STRLEN( SELPROT_ZEILE_2SP ).
461    *   *** Variablen initialisieren
462      CLEAR SA_ANZ_SELPROT_KOPFZEILEN.
463      CLEAR   SA_SELPROT_CONT.
464      REFRESH SA_SELPROT_CONT.
465      CLEAR: SELPROT_ZEILE_2SP,
466             SELPROT_ZEILE_5SP.
467
468    *   *** Name der Analyse plus 1 Leerzeile in Container
469    *   Selektionsversion nur anzeigen, wenn keine Neuselektion
470    *                                   'Selektionsprotokoll '
471      PERFORM TEXT_ERMITTELN USING    200
472                             CHANGING HLP_TEXT1.
473      IF SA_OUTPUT_DEVICE = CON_OUTP_TO_PHYSICAL_DEVICE.
474        SA_HLP_TEXT = ANALYSE_TEXT.
475      ELSE.
476        SA_HLP_TEXT = HLP_TEXT1.
477      ENDIF.
478      MOVE HLP_TEXT1 TO SA_SELPROT_CONT-OBJDES.
479      ADD 1 TO SA_SELPROT_CONT-OBJNR.
480      SA_HLP_OFFSET =
481                     TRUNC( ( SA_SELPROT_ZL - STRLEN( SA_HLP_TEXT ) ) / 2 ).
482      MOVE SA_HLP_TEXT TO SA_SELPROT_CONT-OBJLINE+SA_HLP_OFFSET.
483    *                                 'Sel.-Prot'
484      PERFORM TEXT_ERMITTELN USING    306
485                             CHANGING HLP_TEXT1.
486      MOVE HLP_TEXT1 TO SA_SELPROT_CONT-OBJNAM.
487      MOVE CON_MS_OBJ_IS_ATTACHM TO SA_SELPROT_CONT-OBJLEVEL.
488      MOVE CON_MS_OBJTYPE_RAW    TO SA_SELPROT_CONT-OBJTYPE.
489      APPEND SA_SELPROT_CONT.
490    *   *** Leerzeile in den Objekt-Conatiner
491      CLEAR  SA_SELPROT_CONT-OBJLINE.
492      APPEND SA_SELPROT_CONT.
493
494      IF FLG_SELEKTION = FALSE.
495    *   Selektionsversion nur anzeigen, wenn keine Neuselektion
496    *                                   'Selektionsversion   '
497        PERFORM TEXT_ERMITTELN USING    197
498                               CHANGING HLP_TEXT1.
499        MOVE HLP_TEXT1  TO SELPROT_ZEILE_2SP-NAME.
500        CONCATENATE MCRSV-SELVS MCRSVT-SETXT INTO SELPROT_ZEILE_2SP-INHALT
501          SEPARATED BY ' - '.
502    *   Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
503        CLEAR SELPROT_ZEILE.
504        MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
505    *   *** Inhalt des zeilenpuffers in Container ablegen.
506        PERFORM SELPROT_ZEILE_SICHERN
507                TABLES   SA_SELPROT_CONT
508                CHANGING SELPROT_ZEILE.
509      ENDIF.
510    *                                 'Selektion durch     '
511      PERFORM TEXT_ERMITTELN USING    201
512                             CHANGING HLP_TEXT1.
513      MOVE HLP_TEXT1 TO SELPROT_ZEILE_2SP-NAME.
514      MOVE MCRSV-SELUSR TO SELPROT_ZEILE_2SP-INHALT.
515    * Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
516      CLEAR SELPROT_ZEILE.
517      MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
518    * *** Inhalt des zeilenpuffers in Container ablegen.
519      PERFORM SELPROT_ZEILE_SICHERN
520              TABLES SA_SELPROT_CONT
521              CHANGING SELPROT_ZEILE.
522    *                                 'am'
523      PERFORM TEXT_ERMITTELN USING    202
524                             CHANGING HLP_TEXT2.
525      MOVE HLP_TEXT2 TO SELPROT_ZEILE_2SP-NAME.
526      WRITE MCRSV-SELDAT TO SELPROT_ZEILE_2SP-INHALT.
527      WRITE '/'        TO SELPROT_ZEILE_2SP-INHALT+11.
528      WRITE MCRSV-SELTIM TO SELPROT_ZEILE_2SP-INHALT+13.
529    * Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
530      CLEAR SELPROT_ZEILE.
531      MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
532      PERFORM SELPROT_ZEILE_SICHERN
533              TABLES SA_SELPROT_CONT
534              CHANGING SELPROT_ZEILE.
535    *                                 'System / Mandant'
536      PERFORM TEXT_ERMITTELN USING    225
537                             CHANGING HLP_TEXT3.
538      MOVE HLP_TEXT3  TO SELPROT_ZEILE_2SP-NAME.
539      CONCATENATE SY-SYSID SY-MANDT INTO SELPROT_ZEILE_2SP-INHALT
540        SEPARATED BY ' / '.
541    * Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
542      CLEAR SELPROT_ZEILE.
543      MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
544      PERFORM SELPROT_ZEILE_SICHERN
545              TABLES SA_SELPROT_CONT
546              CHANGING SELPROT_ZEILE.
547      IF FLG_SELEKTION = TRUE AND NOT SY-SLSET IS INITIAL.
548    *                                   'Variante'
549        PERFORM TEXT_ERMITTELN USING    220
550                               CHANGING HLP_TEXT1.
551        MOVE HLP_TEXT1 TO SELPROT_ZEILE_2SP-NAME.
552        MOVE SY-SLSET  TO SELPROT_ZEILE_2SP-INHALT.
553    *   Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
554        CLEAR SELPROT_ZEILE.
555        MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
556        PERFORM SELPROT_ZEILE_SICHERN
557                TABLES   SA_SELPROT_CONT
558                CHANGING SELPROT_ZEILE.
559      ENDIF.
560    *                                 'Info-Struktur'
561      PERFORM TEXT_ERMITTELN USING    196
562                             CHANGING HLP_TEXT3.
563      MOVE HLP_TEXT3  TO SELPROT_ZEILE_2SP-NAME.
564    *   *** Lesen der Bezeichnung der IS aus TMC4T
565      SELECT ISTXT FROM TMC4T INTO SA_HLP_ISTXT
566        WHERE SPRAS = SY-LANGU
567         AND MCINF = HLP_MCINF.
568      ENDSELECT.
569      CONCATENATE HLP_MCINF SA_HLP_ISTXT
570             INTO SELPROT_ZEILE_2SP-INHALT
571        SEPARATED BY ' - '.
572    * Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
573      CLEAR SELPROT_ZEILE.
574      MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
575      PERFORM SELPROT_ZEILE_SICHERN
576              TABLES SA_SELPROT_CONT
577              CHANGING SELPROT_ZEILE.
578    *                                 'Version'
579    *   *** Der Text wird in der SELTAB im Feld Name bereitgestellt
580    *   *** Version wird nur angezeigt, wenn sie von den Istdaten abweicht
581      READ TABLE SEL_TAB WITH KEY FNAME = 'VRSIO'.
582      IF SY-SUBRC = 0.
583        IF SEL_TAB-LOW NE CON_VRSIO_IST.
584          MOVE SEL_TAB-NAME TO SELPROT_ZEILE_2SP-NAME.
585          SELECT SINGLE VETXT FROM P44V
586            INTO SELPROT_ZEILE_2SP-INHALT
587           where gstru = gstru
588             AND SSOUR = SPACE
589             AND VRSIO = SEL_TAB-LOW.
590          IF SY-SUBRC = 0.
591            CONCATENATE SEL_TAB-LOW SELPROT_ZEILE_2SP-INHALT
592                   INTO SELPROT_ZEILE_2SP-INHALT
593              SEPARATED BY ' - '.
594          ELSE.
595            MOVE SEL_TAB-LOW  TO SELPROT_ZEILE_2SP-INHALT.
596          ENDIF.
597    *     Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
598          CLEAR SELPROT_ZEILE.
599          MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
600          PERFORM SELPROT_ZEILE_SICHERN
601                  TABLES SA_SELPROT_CONT
602                  CHANGING SELPROT_ZEILE.
603        ENDIF.
604      ENDIF.
605    *   *** Exeption nur ausgeben, wenn im Selektionsbild angegeben
606      IF NOT EXCEPTION IS INITIAL.
607    *                                   'Exception'
608        PERFORM TEXT_ERMITTELN USING    300
609                               CHANGING HLP_TEXT4.
610        MOVE HLP_TEXT4        TO SELPROT_ZEILE_2SP-NAME.
611        MOVE EXCEPTION
612          TO SELPROT_ZEILE_2SP-INHALT.
613    *   Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
614        CLEAR SELPROT_ZEILE.
615        MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
616        PERFORM SELPROT_ZEILE_SICHERN
617                TABLES SA_SELPROT_CONT
618                CHANGING SELPROT_ZEILE.
619      ENDIF.
620      IF INTTAB_EINTRAEGE > 0.
621    *   INTTAB ist gefüllt, d.h. Selektionsprotokoll wurde nicht aus der
622    *   Liste der Selektionsversionen aufgerufen => Zeit u. Volumen ausgeben
623    *                                   'Anzahl selekt. Sätze'
624        PERFORM TEXT_ERMITTELN USING    199
625                               CHANGING HLP_TEXT4.
626        MOVE HLP_TEXT4        TO SELPROT_ZEILE_2SP-NAME.
627        WRITE INTTAB_EINTRAEGE LEFT-JUSTIFIED
628           TO SELPROT_ZEILE_2SP-INHALT.
629    *   Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
630        CLEAR SELPROT_ZEILE.
631        MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
632        PERFORM SELPROT_ZEILE_SICHERN
633                TABLES SA_SELPROT_CONT
634                CHANGING SELPROT_ZEILE.
635    *                                   'Selektionszeit'
636        PERFORM TEXT_ERMITTELN USING    222
637                               CHANGING HLP_TEXT1.
638        MOVE HLP_TEXT1        TO SELPROT_ZEILE_2SP-NAME.
639        WRITE SAV_DURATION EXPONENT 0 DECIMALS 3 LEFT-JUSTIFIED NO-SIGN
640           TO SELPROT_ZEILE_2SP-INHALT.
641    *   Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
642        CLEAR SELPROT_ZEILE.
643        MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
644        PERFORM SELPROT_ZEILE_SICHERN
645                TABLES SA_SELPROT_CONT
646                CHANGING SELPROT_ZEILE.
647    *                                  'SelektVolumen [KB]'
648        PERFORM TEXT_ERMITTELN USING    223
649                               CHANGING HLP_TEXT2.
650    *   *** Selektionsvolumen berechnen
651        DESCRIBE FIELD INT_S000 LENGTH INTTAB_GROESSE IN BYTE MODE.
652        INTTAB_GROESSE = INTTAB_GROESSE * ( INTTAB_EINTRAEGE / 1024 ).
653        MOVE HLP_TEXT2       TO SELPROT_ZEILE_2SP-NAME.
654        WRITE INTTAB_GROESSE LEFT-JUSTIFIED
655           TO SELPROT_ZEILE_2SP-INHALT.
656    *   Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
657        CLEAR SELPROT_ZEILE.
658        MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
659        PERFORM SELPROT_ZEILE_SICHERN
660                TABLES   SA_SELPROT_CONT
661                CHANGING SELPROT_ZEILE.
662      ENDIF.
663
664      WRITE SY-ULINE TO SELPROT_ZEILE_2SP.
665    * Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
666      CLEAR SELPROT_ZEILE.
667      MOVE SELPROT_ZEILE_2SP TO SELPROT_ZEILE.
668      PERFORM SELPROT_ZEILE_SICHERN
669              TABLES   SA_SELPROT_CONT
670              CHANGING SELPROT_ZEILE.
671    *   *** An dieser Stelle Sy-tabix merken, um Anzahl Kopfzeilen zu wissen
672      SA_ANZ_SELPROT_KOPFZEILEN = SY-TABIX.
673
674    * Ausgabe der Selektionsparameter
675      LOOP AT SEL_TAB.
676    *   Nur Selektionskriterien werden berücksichtigt
677        CHECK SEL_TAB-FNAME(3) = 'SL_'.
678        IF SEL_TAB-OPTION IS INITIAL.
679          PERFORM SEL_PARAM_INIT CHANGING SEL_TAB.
680        ELSEIF SEL_TAB-FNAME = 'SL_ZEITR' OR
681               SEL_TAB-FNAME = 'SL_SPTAG' OR
682               SEL_TAB-FNAME = 'SL_SPWOC' OR
683               SEL_TAB-FNAME = 'SL_SPMON' OR
684               SEL_TAB-FNAME = 'SL_SPBUP'.
685    *     Für Selektionsversionen, die vor 3.0 abgespeichert wurden, ist
686    *     SEL_TAB-FNAME = 'SL_ZEITR'. Ab 3.0 gilt einer der anderen 4 Werte.
687          IF SAV_SPERI = CON_SPERI_SPTAG.
688    *       Konvertierung eines Tagesdatums
689            SA_HLP_DATUM = SEL_TAB-LOW.
690            IF NOT SA_HLP_DATUM IS INITIAL.
691              WRITE SA_HLP_DATUM TO SEL_TAB-LOW.
692            ELSE.
693              CLEAR SEL_TAB-LOW.
694            ENDIF.
695            SA_HLP_DATUM = SEL_TAB-HIGH.
696            IF NOT SA_HLP_DATUM IS INITIAL.
697              WRITE SA_HLP_DATUM TO SEL_TAB-HIGH.
698            ELSE.
699              CLEAR SEL_TAB-HIGH.
700            ENDIF.
701          ELSE.
702    *       Konvertierung einer Periode (Woche, Monat oder Buper)
703            SA_HLP_PERIO = SEL_TAB-LOW.
704            IF NOT SA_HLP_PERIO IS INITIAL.
705              WRITE SA_HLP_PERIO TO SEL_TAB-LOW.
706            ELSE.
707              CLEAR SEL_TAB-LOW.
708            ENDIF.
709            SA_HLP_PERIO = SEL_TAB-HIGH.
710            IF NOT SA_HLP_PERIO IS INITIAL.
711              WRITE SA_HLP_PERIO TO SEL_TAB-HIGH.
712            ELSE.
713              CLEAR SEL_TAB-HIGH.
714            ENDIF.
715          ENDIF.
716        ELSE.
717    *     Merkmalsselektionskriterium => Berücksichtigung des KonvExits
718          READ TABLE DRILLDOWN_FCODES WITH KEY RANGES_SUF = SEL_TAB-FNAME+3.
719          IF SY-SUBRC = 0 AND NOT DRILLDOWN_FCODES-CONVEXIT IS INITIAL.
720    *       Konvertierungsexit vorhanden
721            SA_HLP_CONVEXIT+2 = DRILLDOWN_FCODES-CONVEXIT.
722            DATA lv_sel_value_cnv(60) TYPE c. " 60 = max length in LIS
723            lv_sel_value_cnv = sel_tab-low.
724            WRITE lv_sel_value_cnv TO SEL_TAB-LOW  USING EDIT MASK
725                                                     SA_HLP_CONVEXIT.
726            lv_sel_value_cnv = sel_tab-high.
727            WRITE lv_sel_value_cnv TO SEL_TAB-HIGH USING EDIT MASK
728                                                     SA_HLP_CONVEXIT.
729          ENDIF.
730        ENDIF.
731    *   *** Ablegen der mom. Seltab-Zeile im Protokollcontainer
732        MOVE-CORRESPONDING SEL_TAB TO SELPROT_ZEILE_5SP.
733    *   Strukturierte Zeile in Einzelfeld konvertieren (UNICODE)
734        CLEAR SELPROT_ZEILE.
735        MOVE SELPROT_ZEILE_5SP TO SELPROT_ZEILE.
736        PERFORM SELPROT_ZEILE_SICHERN
737                TABLES   SA_SELPROT_CONT
738                CHANGING SELPROT_ZEILE.
739      ENDLOOP.
740    *   *** zum Schluss noch zwei Leerzeilen an das Protokoll anhängen
741    *   *** nur im Buffercontainer
742      IF SA_OUTPUT_DEVICE = CON_OUTP_TO_BUFFER_VAR.
743        CLEAR  SA_SELPROT_CONT-OBJLINE.
744        APPEND SA_SELPROT_CONT.
745        APPEND SA_SELPROT_CONT.
746      ENDIF.
747    *   *** bei physikalischem Ausgabedevice jetzt noch den Inhalt der
748    *   *** Puffertabelle auf Bildschirm ausgeben.
749      IF SA_OUTPUT_DEVICE = CON_OUTP_TO_PHYSICAL_DEVICE.
750    *   *** Fenstergröße dynamisch bestimmen aus Zeilenlänge und Anzahl
751    *   *** Textcontainerzeilen
752        DESCRIBE TABLE SA_SELPROT_CONT LINES SA_WIN_Y2.
753        SA_WIN_X1 = 6.
754        SA_WIN_Y1 = 3.
755        SA_WIN_X2 = SA_WIN_X1 + SA_SELPROT_ZL.
756        IF SA_WIN_Y2 > SY-SROWS.
757          SA_WIN_Y2 = SY-SROWS + SA_WIN_Y1.
758        ELSE.
759          SA_WIN_Y2 = SA_WIN_Y2 + SA_WIN_Y1.
760        ENDIF.
761    *   *** Helptext1 bestimmen als Fenstertitel
762        PERFORM TEXT_ERMITTELN USING    200" Text Selektionsprotokoll
763                               CHANGING HLP_TEXT1.
764    *   *** Ausgabe der Titelzeile je nach Ausgabemedium umlenken
765        IF FLG_DRUCKEN = FALSE.
766    *   *** Prüfen, auf welches Ausgabedevice ausgegeben werden soll
767    *   *** Wenn sa_output_device = B kein Window aufblenden
768          PERFORM PF_STATUS_SETZEN USING SPACE
769                                         '000'
770                                          HLP_TEXT1.
771          WINDOW STARTING AT SA_WIN_X1 SA_WIN_Y1
772                 ENDING   AT SA_WIN_X2 SA_WIN_Y2.
773          NEW-PAGE LINE-SIZE SA_SELPROT_ZL.
774        ENDIF.
775
776    *   Selektionsprotokoll ausgeben
777        CLEAR SELPROT_ZEILE_2SP.
778        CLEAR SELPROT_ZEILE_5SP.
779        LOOP AT SA_SELPROT_CONT.
780          CASE SY-TABIX.
781    *   *** Wenn Tabindex = 1  Kopfzeile intensiv unstrukturiert ausgeben
782            WHEN 1.
783              WRITE / SA_SELPROT_CONT-OBJLINE INTENSIFIED.
784    *   *** Wenn Tabindex = AnzKopfzeilen unstrukturiert ausgeben
785            WHEN SA_ANZ_SELPROT_KOPFZEILEN.
786              WRITE / SA_SELPROT_CONT-OBJLINE.
787            WHEN OTHERS.
788    *   *** Wenn Tabindex < Anzkopfzeilen 2-Spaltig ausgeben
789              IF SY-TABIX < SA_ANZ_SELPROT_KOPFZEILEN.
790                MOVE SA_SELPROT_CONT-OBJLINE TO SELPROT_ZEILE_2SP.
791    *   *** Wenn das Namensfeld leer ist für Bildschirmausgabe Skipen
792                IF SELPROT_ZEILE_2SP-NAME IS INITIAL.
793                  SKIP.
794                ELSE.
795                  WRITE: / SELPROT_ZEILE_2SP-NAME
796                             COLOR COL_BACKGROUND INTENSIFIED NO-GAP,
797                           SELPROT_ZEILE_2SP-FILLERA NO-GAP,
798                           SELPROT_ZEILE_2SP-INHALT NO-GAP.
799                ENDIF.
800              ELSE.
801    *   *** Wenn Tabindex > Kopfzeilenzahl dann  5-Spaltig ausgeben
802                MOVE SA_SELPROT_CONT-OBJLINE TO SELPROT_ZEILE_5SP.
803                WRITE: / SELPROT_ZEILE_5SP-NAME
804                           COLOR COL_BACKGROUND INTENSIFIED.
805    *           write:      selprot_zeile_5sp-option,
806    *                       selprot_zeile_5sp-sign.
807                PERFORM SELPROT_OPTION_AUSGEBEN
808                        USING SELPROT_ZEILE_5SP-OPTION
809                              SELPROT_ZEILE_5SP-SIGN.
810                WRITE:      SELPROT_ZEILE_5SP-LOW     NO-GAP,
811                            SELPROT_ZEILE_5SP-FILLERB NO-GAP,
812                            SELPROT_ZEILE_5SP-HIGH    NO-GAP.
813              ENDIF.
814          ENDCASE.
815        ENDLOOP.
816      ENDIF.
817    ENDFORM.                               "SELEKTIONSPROTOKOLL_AUSGEBEN
818
819
820    *---------------------------------------------------------------------*
821    *       FORM SELEKTIONSTABELLEN_FUELLEN                               *
822    *---------------------------------------------------------------------*
823    *       Füllen der Selektionstabellen für den Analysewechsel bzw. zur *
824    *       Übergabe an SAPoffice.                                        *
825    *---------------------------------------------------------------------*
826    *  -->  AP_FLG_ANALYSE_WECHSEL: Flag, für Aufruf zum Wechseln der     *
827    *                               Analyse                               *
828    *       = TRUE:  SelektKrit., akt. Aufriß und Cursorpos. berücksicht. *
829    *       = FALSE: Nur Selektionskriterien berücksichtigen              *
830    *---------------------------------------------------------------------*
831    FORM SELEKTIONSTABELLEN_FUELLEN USING
832                                        AP_FLG_ANALYSE_WECHSEL TYPE BOOLEAN.
833      FIELD-SYMBOLS: <AP_SL_RANGES>,
834                     <AP_SL_RANGES_TAB> TYPE TABLE,
835                     <AP_SL_RANGES_LOW>,
836                     <AP_SL_RANGES_HIGH>,
837                     <AP_SL_RANGES_SIGN>,
838                     <AP_SL_RANGES_OPTION>.
839      DATA: AP_FELDNAME(30),
840            AP_SAV_TABIX LIKE SY-TABIX.
841      DATA: LT_MERKMALSKETTUNG           TYPE T_MERKMALSKETTUNG.
842      DATA: L_MERKMALSKETTUNG            TYPE MERKMALSKETTUNG.
843      DATA: L_ANZ_MERKMALSKETTUNGEN      LIKE ANZ_MERKMALSKETTUNGEN.
844
845      DATA: BEGIN OF L_SPLIT,
846              OUTPUTLEN                  LIKE MCS04-OUTPUTLEN,
847              OFFSET                     LIKE DFIES-OFFSET,
848            END   OF L_SPLIT.
849
850      DATA: L_SUBRC                      LIKE SY-SUBRC,
851            L_TABIX                      LIKE SY-TABIX.
852
853      REFRESH SELTAB_SEL.
854      REFRESH SELTAB_FIELDS.
855
856      PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
857      LOOP AT DRILLDOWN_FCODES WHERE NOT RANGES_SUF IS INITIAL.
858        CLEAR SELTAB_FIELDS.
859        CLEAR SELTAB_SEL.
860        CONCATENATE 'DD_' DRILLDOWN_FCODES-RANGES_SUF INTO
861          SELTAB_FIELDS-FIELD.
862        SELTAB_FIELDS-RFIELD = SELTAB_FIELDS-FIELD .
863        SELTAB_FIELDS-ROLLNAME = DRILLDOWN_FCODES-ROLLNAME.
864        SELTAB_FIELDS-DOMNAME = DRILLDOWN_FCODES-DOMNAME.
865        SELTAB_FIELDS-KIND    = 'S'.
866        AP_SAV_TABIX = SY-TABIX.
867        READ TABLE AKT_DRILLDOWN WITH KEY FCODE = DRILLDOWN_FCODES-FCODE.
868        IF AP_FLG_ANALYSE_WECHSEL = TRUE AND SY-SUBRC = 0.
869    *     Aufruf für Analysewechsel und nach dem Merkmal wurde schon aufge-
870    *     rissen => aktuellen Aufriß bzw. Cursorpos. mitberücksichtigen
871          IF SY-TABIX < DRILLDOWN_EINTRAEGE.
872    *       Nach diesem Merkmal wurde bereits aufgerissen
873            IF AKT_DRILLDOWN-KETT_AKT IS INITIAL.
874    *         normal - ohne Merkmalskettung
875              APPEND SELTAB_FIELDS.
876              SELTAB_SEL-FIELD = SELTAB_FIELDS-FIELD.
877              SELTAB_SEL-LOW   = AKT_DRILLDOWN-OBJEKT.
878              SELTAB_SEL-OPTION = 'EQ'.
879              SELTAB_SEL-SIGN   = 'I'.
880              APPEND SELTAB_SEL.
881            ELSE.
882    *         mit Merkmalskettung
883              PERFORM MERKMALSKETTUNG_KEY_FOLGE
884                      USING    AKT_DRILLDOWN-ROLLNAME01
885                      CHANGING LT_MERKMALSKETTUNG
886                               L_ANZ_MERKMALSKETTUNGEN.
887              CLEAR L_SPLIT.
888              LOOP AT LT_MERKMALSKETTUNG INTO L_MERKMALSKETTUNG.
889    *--         Merkmalkettung zerlegen
890    *           Offset
891                L_SPLIT-OFFSET = L_SPLIT-OFFSET + L_SPLIT-OUTPUTLEN.
892    *           Länge
893                L_SPLIT-OUTPUTLEN = L_MERKMALSKETTUNG-OUTPUTLEN.
894    *
895                CLEAR SELTAB_FIELDS.
896                CLEAR SELTAB_SEL.
897                CONCATENATE 'DD_' L_MERKMALSKETTUNG-RANGES_SUF INTO
898                  SELTAB_FIELDS-FIELD.
899
900                SELTAB_FIELDS-RFIELD    = SELTAB_FIELDS-FIELD .
901                READ TABLE SELTAB_FIELDS
902                              WITH KEY FIELD = SELTAB_FIELDS-FIELD
903                              TRANSPORTING NO FIELDS.
904                IF SY-SUBRC NE 0.
905                  SELTAB_FIELDS-ROLLNAME  = L_MERKMALSKETTUNG-ROLLNAME.
906                  SELTAB_FIELDS-DOMNAME   = L_MERKMALSKETTUNG-DOMNAME.
907                  SELTAB_FIELDS-KIND      = 'S'.
908                  APPEND SELTAB_FIELDS.
909                ENDIF.
910    *           Eintrag kann bereits vorhanden aus vorigem Schleifendurch-
911    *           lauf vorhanden sein = > ändern
912                READ TABLE SELTAB_SEL
913                   WITH KEY FIELD = SELTAB_FIELDS-FIELD.
914                L_SUBRC = SY-SUBRC.
915                L_TABIX = SY-TABIX.
916                SELTAB_SEL-LOW
917                  = AKT_DRILLDOWN-OBJEKT+L_SPLIT-OFFSET(L_SPLIT-OUTPUTLEN).
918                CLEAR SELTAB_SEL-HIGH.
919                SELTAB_SEL-OPTION = 'EQ'.
920                SELTAB_SEL-SIGN   = 'I'.
921                IF L_SUBRC EQ 0.
922                  MODIFY SELTAB_SEL INDEX L_TABIX.
923                ELSE.
924                  SELTAB_SEL-FIELD = SELTAB_FIELDS-FIELD.
925                  APPEND SELTAB_SEL.
926                ENDIF.
927              ENDLOOP.
928            ENDIF.
929          ELSE.
930    *       Neuestes Aufrißkriterium
931            IF DARSTELLUNGSART = CON_DARST_EINZEL.
932              IF AKT_DRILLDOWN-KETT_AKT IS INITIAL.
933                APPEND SELTAB_FIELDS.
934                SELTAB_SEL-FIELD = SELTAB_FIELDS-FIELD.
935                SELTAB_SEL-LOW   = AKT_OBJEKT.
936                SELTAB_SEL-OPTION = 'EQ'.
937                SELTAB_SEL-SIGN   = 'I'.
938                APPEND SELTAB_SEL.
939              ELSE.
940                PERFORM MERKMALSKETTUNG_KEY_FOLGE
941                        USING    DRILLDOWN_FCODES-ROLLNAME01
942                        CHANGING LT_MERKMALSKETTUNG
943                                 L_ANZ_MERKMALSKETTUNGEN.
944                CLEAR L_SPLIT.
945                LOOP AT LT_MERKMALSKETTUNG INTO L_MERKMALSKETTUNG.
946    *--         Merkmalkettung zerlegen
947    *           Offset
948                  L_SPLIT-OFFSET = L_SPLIT-OFFSET + L_SPLIT-OUTPUTLEN.
949    *           Länge
950                  L_SPLIT-OUTPUTLEN = L_MERKMALSKETTUNG-OUTPUTLEN.
951    *
952                  CLEAR SELTAB_FIELDS.
953                  CLEAR SELTAB_SEL.
954                  CONCATENATE 'DD_' L_MERKMALSKETTUNG-RANGES_SUF INTO
955                    SELTAB_FIELDS-FIELD.
956
957                  SELTAB_FIELDS-RFIELD    = SELTAB_FIELDS-FIELD .
958                  READ TABLE SELTAB_FIELDS
959                                WITH KEY FIELD = SELTAB_FIELDS-FIELD
960                                TRANSPORTING NO FIELDS.
961                  IF SY-SUBRC NE 0.
962                    SELTAB_FIELDS-ROLLNAME  = L_MERKMALSKETTUNG-ROLLNAME.
963                    SELTAB_FIELDS-DOMNAME   = L_MERKMALSKETTUNG-DOMNAME.
964                    SELTAB_FIELDS-KIND      = 'S'.
965                    APPEND SELTAB_FIELDS.
966                  ENDIF.
967    *--         Eintrag kann bereits vorhanden sein, dann ändern
968                  READ TABLE SELTAB_SEL
969                     WITH KEY FIELD = SELTAB_FIELDS-FIELD.
970                  L_SUBRC = SY-SUBRC.
971                  L_TABIX = SY-TABIX.
972
973                  SELTAB_SEL-LOW
974                   = AKT_OBJEKT+L_SPLIT-OFFSET(L_SPLIT-OUTPUTLEN).
975                  SELTAB_SEL-OPTION = 'EQ'.
976                  SELTAB_SEL-SIGN   = 'I'.
977                  IF L_SUBRC EQ 0.
978                    MODIFY SELTAB_SEL INDEX L_TABIX.
979                  ELSE.
980                    SELTAB_SEL-FIELD = SELTAB_FIELDS-FIELD.
981                    APPEND SELTAB_SEL.
982                  ENDIF.
983                ENDLOOP.
984              ENDIF.
985    *=== begin INSERTATION note 171308 ====================================
986            ELSE.
987    *         Cursor ist nicht auf Einzelwert plaziert
988    *         => alle Merkmalsausprägungen
989              append seltab_fields.
990              seltab_sel-field  = seltab_fields-field.
991              loop at aus_s000.
992                seltab_sel-low  =  aus_s000-objekt.
993                seltab_sel-option = 'EQ'.
994                seltab_sel-sign   = 'I'.
995                append seltab_sel.
996              endloop.
997    *=== End INSERTATION note 171308 ======================================
998            ENDIF.
999          ENDIF.
1000       ELSE.
1001   *     Assign der Kopfleiste von SL_...
1002         CONCATENATE 'SL_' DRILLDOWN_FCODES-RANGES_SUF INTO AP_FELDNAME.
1003         ASSIGN (AP_FELDNAME) TO <AP_SL_RANGES>.
1004   *     Assign der Tabelle SL_...
1005         CONCATENATE AP_FELDNAME '[]' INTO AP_FELDNAME.
1006         ASSIGN (AP_FELDNAME) TO <AP_SL_RANGES_TAB>.
1007   *     SIGN setzen
1008         ASSIGN COMPONENT 1 OF STRUCTURE <AP_SL_RANGES>
1009           TO <AP_SL_RANGES_SIGN>.
1010   *     OPTION setzen
1011         ASSIGN COMPONENT 2 OF STRUCTURE <AP_SL_RANGES>
1012           TO <AP_SL_RANGES_OPTION>.
1013   *     LOW setzen
1014         ASSIGN COMPONENT 3 OF STRUCTURE <AP_SL_RANGES>
1015           TO <AP_SL_RANGES_LOW>.
1016   *     HIGH setzen
1017         ASSIGN COMPONENT 4 OF STRUCTURE <AP_SL_RANGES>
1018           TO <AP_SL_RANGES_HIGH>.
1019         APPEND SELTAB_FIELDS.
1020         LOOP AT <AP_SL_RANGES_TAB> INTO <AP_SL_RANGES>.
1021           SELTAB_SEL-SIGN   = <AP_SL_RANGES_SIGN>.
1022           SELTAB_SEL-OPTION = <AP_SL_RANGES_OPTION>.
1023           SELTAB_SEL-LOW    = <AP_SL_RANGES_LOW>.
1024           SELTAB_SEL-HIGH   = <AP_SL_RANGES_HIGH>.
1025           SELTAB_SEL-FIELD  = SELTAB_FIELDS-FIELD.
1026           APPEND SELTAB_SEL.
1027         ENDLOOP.
1028         IF SY-SUBRC <> 0.
1029   *       Leere Selektionsoptionen mit leeren Eintrag aufnehmen, damit
1030   *       beim SUBMIT WITH SELECTION-TABLE die Optionen gelöscht werden
1031           DESCRIBE TABLE SELTAB_FIELDS LINES SY-TFILL.
1032           DELETE SELTAB_FIELDS INDEX SY-TFILL.
1033         ENDIF.
1034       ENDIF.
1035     ENDLOOP.
1036   * Parameter übertragen
1037     CLEAR SELTAB_FIELDS.
1038     SELTAB_FIELDS-KIND = 'P'.
1039     CLEAR SELTAB_SEL.
1040     SELTAB_SEL-OPTION  = 'EQ'.
1041     SELTAB_SEL-SIGN    = 'I'.
1042   * Version setzen
1043     SELTAB_FIELDS-FIELD    = CON_FELD_VRSIO.
1044     SELTAB_FIELDS-RFIELD   = SELTAB_FIELDS-FIELD .
1045     SELTAB_FIELDS-ROLLNAME = 'VRSIO'.
1046     SELTAB_FIELDS-DOMNAME  = 'VRSIO'.
1047     APPEND SELTAB_FIELDS.
1048     SELTAB_SEL-FIELD       = SELTAB_FIELDS-FIELD.
1049     SELTAB_SEL-LOW         = VRSIO.
1050     APPEND SELTAB_SEL.
1051   * Analysewährung setzen
1052     SELTAB_FIELDS-FIELD    = 'SL_WAERS'.
1053     SELTAB_FIELDS-RFIELD   = SELTAB_FIELDS-FIELD .
1054     SELTAB_FIELDS-ROLLNAME = 'MCAWAER1'.
1055     SELTAB_FIELDS-DOMNAME  = 'WAERS'.
1056     APPEND SELTAB_FIELDS.
1057     SELTAB_SEL-FIELD       = SELTAB_FIELDS-FIELD.
1058     SELTAB_SEL-LOW         = ANALYSE_WAEHRUNG.
1059     APPEND SELTAB_SEL.
1060     IF AP_FLG_ANALYSE_WECHSEL = FALSE.
1061   *   Exception zusätzlich übertragen
1062       SELTAB_FIELDS-FIELD    = 'EXC_NO'.
1063       SELTAB_FIELDS-RFIELD   = SELTAB_FIELDS-FIELD .
1064       SELTAB_FIELDS-ROLLNAME = 'EXCEP'.
1065       SELTAB_FIELDS-DOMNAME  = 'CHAR12'.
1066       APPEND SELTAB_FIELDS.
1067       SELTAB_SEL-FIELD       = SELTAB_FIELDS-FIELD.
1068       SELTAB_SEL-LOW         = EXCEPTION.
1069       APPEND SELTAB_SEL.
1070     ENDIF.
1071
1072   ENDFORM.                               "SELEKTIONSTABELLEN_FUELLEN
