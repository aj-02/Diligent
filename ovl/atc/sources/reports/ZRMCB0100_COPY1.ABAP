1211   *---------------------------------------------------------------------*
1212   *       FORM SEL_ZEITRAUM_INITIALISIEREN                              *
1213   *---------------------------------------------------------------------*
1214   *       Analysezeitraum als Vorschlagswert der Selektion initialis.   *
1215   *---------------------------------------------------------------------*
1216   *  -->  SI_MCEXC       : Flag für Einbeziehen der aktuellen Periode   *
1217   *  -->  SI_MCPER       : Periodenanzahl für Analysezeitraum           *
1218   *  -->  VALUE(SI_SPERI): Periodenkennzeichen der Info-Struktur        *
1219   *---------------------------------------------------------------------*
1220   FORM SEL_ZEITRAUM_INITIALISIEREN USING SI_MCEXC        TYPE MCEXC
1221                                          SI_MCPER        TYPE MCPER
1222                                          VALUE(SI_SPERI) TYPE SPERI.
1223
1224     FIELD-SYMBOLS: <SL_ZEITR_SIGN>,
1225                    <SL_ZEITR_OPTION>,
1226                    <SL_ZEITR_HIGH>,
1227                    <SL_ZEITR_LOW>.
1228     DATA: SI_HLP_BUKRS       LIKE T001-BUKRS,
1229           SI_PERIV           LIKE MCS0-PERIV,
1230           SI_VON_DATUM       LIKE SY-DATLO,
1231           SI_BIS_DATUM       LIKE SY-DATLO,
1232           SI_PERIODEN        LIKE SY-TABIX,
1233           SI_PERIODEN_JAHRE  LIKE SY-TABIX,
1234           SI_PERIODEN_MONATE LIKE SY-TABIX,
1235           SI_ENDPERIODE(3)   TYPE N.
1236
1237   * Ranges initial füllen, damit DB-Optimizer DB-Index vollständig nutzt
1238     REFRESH: SL_SPTAG,
1239              SL_SPWOC,
1240              SL_SPMON,
1241              SL_SPBUP.
1242
1243     CLEAR SL_SPTAG.
1244     SL_SPTAG-SIGN   = 'I'.
1245     SL_SPTAG-OPTION = 'EQ'.
1246     APPEND SL_SPTAG.
1247     CLEAR SL_SPMON.
1248     SL_SPMON-SIGN   = 'I'.
1249     SL_SPMON-OPTION = 'EQ'.
1250     APPEND SL_SPMON.
1251     CLEAR SL_SPWOC.
1252     SL_SPWOC-SIGN   = 'I'.
1253     SL_SPWOC-OPTION = 'EQ'.
1254     APPEND SL_SPWOC.
1255     CLEAR SL_SPBUP.
1256     SL_SPBUP-SIGN   = 'I'.
1257     SL_SPBUP-OPTION = 'EQ'.
1258     APPEND SL_SPBUP.
1259
1260     CASE SI_SPERI.
1261       WHEN CON_SPERI_SPTAG.
1262         ASSIGN SL_SPTAG-OPTION TO <SL_ZEITR_OPTION>.
1263         ASSIGN SL_SPTAG-SIGN   TO <SL_ZEITR_SIGN>.
1264         ASSIGN SL_SPTAG-LOW    TO <SL_ZEITR_LOW>.
1265         ASSIGN SL_SPTAG-HIGH   TO <SL_ZEITR_HIGH>.
1266         REFRESH SL_SPTAG.
1267       WHEN CON_SPERI_SPWOC.
1268         ASSIGN SL_SPWOC-OPTION TO <SL_ZEITR_OPTION>.
1269         ASSIGN SL_SPWOC-SIGN   TO <SL_ZEITR_SIGN>.
1270         ASSIGN SL_SPWOC-LOW    TO <SL_ZEITR_LOW>.
1271         ASSIGN SL_SPWOC-HIGH   TO <SL_ZEITR_HIGH>.
1272         REFRESH SL_SPWOC.
1273       WHEN CON_SPERI_SPMON.
1274         ASSIGN SL_SPMON-OPTION TO <SL_ZEITR_OPTION>.
1275         ASSIGN SL_SPMON-SIGN   TO <SL_ZEITR_SIGN>.
1276         ASSIGN SL_SPMON-LOW    TO <SL_ZEITR_LOW>.
1277         ASSIGN SL_SPMON-HIGH   TO <SL_ZEITR_HIGH>.
1278         REFRESH SL_SPMON.
1279       WHEN CON_SPERI_SPBUP.
1280         ASSIGN SL_SPBUP-OPTION TO <SL_ZEITR_OPTION>.
1281         ASSIGN SL_SPBUP-SIGN   TO <SL_ZEITR_SIGN>.
1282         ASSIGN SL_SPBUP-LOW    TO <SL_ZEITR_LOW>.
1283         ASSIGN SL_SPBUP-HIGH   TO <SL_ZEITR_HIGH>.
1284         REFRESH SL_SPBUP.
1285   * Bei Periode ' ' wird der Selektionszeitraum wie bei Tag (Dummy)
1286   * initialisiert (Typ C)
1287       WHEN OTHERS.
1288         ASSIGN SL_SPTAG-OPTION TO <SL_ZEITR_OPTION>.
1289         ASSIGN SL_SPTAG-SIGN   TO <SL_ZEITR_SIGN>.
1290         ASSIGN SL_SPTAG-LOW    TO <SL_ZEITR_LOW>.
1291         ASSIGN SL_SPTAG-HIGH   TO <SL_ZEITR_HIGH>.
1292         REFRESH SL_SPTAG.
1293     ENDCASE.
1294
1295     IF SI_MCPER = 0.
1296   *   Vorschlagswert für Analysezeitraum ist nicht gewünscht
1297       EXIT.
1298     ENDIF.
1299
1300     <SL_ZEITR_SIGN>   = 'I'.
1301     <SL_ZEITR_OPTION> = 'BT'.
1302
1303   * Bis-Periode ermitteln
1304     IF SI_MCEXC = FALSE.
1305   *   aktuelle Periode wird nicht in die Bis-Periode einbezogen
1306       CASE SI_SPERI.
1307         WHEN CON_SPERI_SPTAG.
1308           SI_BIS_DATUM = SY-DATLO - 1.
1309         WHEN CON_SPERI_SPWOC.
1310           SI_BIS_DATUM = SY-DATLO - 7.
1311         WHEN CON_SPERI_SPMON.
1312           SI_BIS_DATUM = SY-DATLO.
1313         WHEN CON_SPERI_SPBUP.
1314           SI_BIS_DATUM = SY-DATLO.
1315       ENDCASE.
1316       PERFORM PERIODE_ERMITTELN(RMCS1000)
1317         USING    SI_BIS_DATUM
1318                  HLP_MCINF
1319                  SI_HLP_BUKRS
1320         CHANGING SL_SPTAG-HIGH
1321                  SL_SPWOC-HIGH
1322                  SL_SPMON-HIGH
1323                  SL_SPBUP-HIGH
1324                  SI_PERIV.
1325       CASE SI_SPERI.
1326         WHEN CON_SPERI_SPBUP.
1327           IF NOT SI_PERIV IS INITIAL.
1328   *         Geschäftsjahresvariante ist zur Info-Struktur angegeben
1329             SELECT SINGLE * FROM  T009
1330                    WHERE  PERIV       = SI_PERIV.
1331           ENDIF.
1332       ENDCASE.
1333
1334       IF SI_SPERI = CON_SPERI_SPMON OR
1335          SI_SPERI = CON_SPERI_SPBUP.
1336   *     Sonderberechnung bei Buchungsperiode bzw. Monat
1337         IF SI_SPERI = CON_SPERI_SPBUP AND
1338            NOT SI_PERIV IS INITIAL.
1339   *         Geschäftsjahresvariante ist zur Info-Struktur angegeben =>
1340   *         Endperiode berechnen
1341           SI_ENDPERIODE = T009-ANZBP.
1342         ELSE.
1343   *       Monat bzw. Buchungsperiode ohne Geschäftsjahresvariante
1344           SI_ENDPERIODE = '12'.
1345         ENDIF.
1346         CASE SI_SPERI.
1347           WHEN CON_SPERI_SPMON.
1348             IF SL_SPMON-HIGH+4(2) = '01'.
1349   *           Aktuelle Periode ist '01' => Vorperiode liegt im Vorjahr
1350               SL_SPMON-HIGH+4(2) = SI_ENDPERIODE.
1351               SL_SPMON-HIGH(4) = SL_SPMON-HIGH(4) - 1.
1352             ELSE.
1353   *           Vorperiode liegt im gleichen Jahr
1354               SL_SPMON-HIGH     = SL_SPMON-HIGH - 1.
1355             ENDIF.
1356           WHEN CON_SPERI_SPBUP.
1357             IF SL_SPBUP-HIGH+4(2) = '01'.
1358   *           Aktuelle Periode ist '01' => Vorperiode liegt im Vorjahr
1359               SL_SPBUP-HIGH+4(2) = SI_ENDPERIODE.
1360               SL_SPBUP-HIGH(4) = SL_SPBUP-HIGH(4) - 1.
1361             ELSE.
1362   *           Vorperiode liegt im gleichen Jahr
1363               SL_SPBUP-HIGH     = SL_SPBUP-HIGH - 1.
1364             ENDIF.
1365         ENDCASE.
1366       ENDIF.
1367     ELSE.
1368   *   aktuelle Periode in die Bis-Periode einbeziehen
1369       SI_BIS_DATUM = SY-DATLO.
1370       PERFORM PERIODE_ERMITTELN(RMCS1000)
1371         USING    SI_BIS_DATUM
1372                  HLP_MCINF
1373                  SI_HLP_BUKRS
1374         CHANGING SL_SPTAG-HIGH
1375                  SL_SPWOC-HIGH
1376                  SL_SPMON-HIGH
1377                  SL_SPBUP-HIGH
1378                  SI_PERIV.
1379       CASE SI_SPERI.
1380         WHEN CON_SPERI_SPBUP.
1381           IF NOT SI_PERIV IS INITIAL.
1382   *         Geschäftsjahresvariante ist zur Info-Struktur angegeben
1383             SELECT SINGLE * FROM  T009
1384                    WHERE  PERIV       = SI_PERIV.
1385           ENDIF.
1386       ENDCASE.
1387     ENDIF.
1388
1389   * Von-Zeitraum ermitteln
1390     IF SI_MCPER IS INITIAL.
1391       <SL_ZEITR_LOW> = <SL_ZEITR_HIGH>.
1392     ELSE.
1393       IF SI_SPERI = CON_SPERI_SPMON OR
1394          SI_SPERI = CON_SPERI_SPBUP.
1395   *     Sonderberechnung bei Buchungsperiode bzw. Monat
1396         IF SI_SPERI = CON_SPERI_SPBUP AND
1397            NOT SI_PERIV IS INITIAL.
1398   *         Geschäftsjahresvariante ist zur Info-Struktur angegeben =>
1399   *         Endperiode berechnen
1400           SI_ENDPERIODE = T009-ANZBP.
1401         ELSE.
1402   *       Monat bzw. Buchungsperiode ohne Geschäftsjahresvariante
1403           SI_ENDPERIODE = '12'.
1404         ENDIF.
1405         <SL_ZEITR_LOW>     = <SL_ZEITR_HIGH>.
1406         SI_PERIODEN        = SI_MCPER - 1.
1407         SI_PERIODEN_JAHRE  = SI_PERIODEN DIV SI_ENDPERIODE.
1408         SI_PERIODEN_MONATE = SI_PERIODEN MOD SI_ENDPERIODE.
1409         CASE SI_SPERI.
1410           WHEN CON_SPERI_SPMON.
1411             IF SI_PERIODEN_MONATE >= SL_SPMON-LOW+4(2).
1412   *           zusätzlicher Jahreswechsel
1413               SL_SPMON-LOW+4(2) = SI_ENDPERIODE + SL_SPMON-LOW+4(2) -
1414                                   SI_PERIODEN_MONATE.
1415               SL_SPMON-LOW(4)   = SL_SPMON-LOW(4) - SI_PERIODEN_JAHRE - 1.
1416             ELSE.
1417   *           kein zusätzlicher Jahreswechsel
1418               SL_SPMON-LOW+4(2) = SL_SPMON-LOW+4(2) - SI_PERIODEN_MONATE.
1419               SL_SPMON-LOW(4)   = SL_SPMON-LOW(4) - SI_PERIODEN_JAHRE.
1420             ENDIF.
1421           WHEN CON_SPERI_SPBUP.
1422             IF SI_PERIODEN_MONATE >= SL_SPBUP-LOW+4(2).
1423   *           zusätzlicher Jahreswechsel
1424               SL_SPBUP-LOW+4(2) = SI_ENDPERIODE + SL_SPBUP-LOW+4(2) -
1425                                   SI_PERIODEN_MONATE.
1426               SL_SPBUP-LOW(4)   = SL_SPBUP-LOW(4) - SI_PERIODEN_JAHRE - 1.
1427             ELSE.
1428   *           kein zusätzlicher Jahreswechsel
1429               SL_SPBUP-LOW+4(2) = SL_SPBUP-LOW+4(2) - SI_PERIODEN_MONATE.
1430               SL_SPBUP-LOW(4)   = SL_SPBUP-LOW(4) - SI_PERIODEN_JAHRE.
1431             ENDIF.
1432         ENDCASE.
1433       ELSE.
