1093   *---------------------------------------------------------------------*
1094   *       FORM KONVERT_FAKTOREN_BESTIMMEN                               *
1095   *---------------------------------------------------------------------*
1096   *       Ermitteln der Umrechnungsfaktoren für die Konvertierung eines *
1097   *       Währungsbetrags in den absoluten Wert                         *
1098   *---------------------------------------------------------------------*
1099   FORM KONVERT_FAKTOREN_BESTIMMEN.
1100
1101     DATA:   KB_DEZ_VERSCHIEBUNG TYPE I.
1102
1103     REFRESH WAEHRUNGS_KONVERT.
1104
1105     SELECT * FROM TCURX ORDER BY PRIMARY KEY.
1106       WAEHRUNGS_KONVERT-CURRDEC = TCURX-CURRDEC.
1107       WAEHRUNGS_KONVERT-CURRKEY = TCURX-CURRKEY.
1108       KB_DEZ_VERSCHIEBUNG = 2 - TCURX-CURRDEC.
1109       IF KB_DEZ_VERSCHIEBUNG > 0.
1110   *     Weniger als 2 Nachkommastellen
1111         WAEHRUNGS_KONVERT-FAKTOR = 1.
1112         DO KB_DEZ_VERSCHIEBUNG TIMES.
1113           WAEHRUNGS_KONVERT-FAKTOR = WAEHRUNGS_KONVERT-FAKTOR * 10.
1114         ENDDO.
1115         APPEND WAEHRUNGS_KONVERT.
1116       ELSEIF KB_DEZ_VERSCHIEBUNG < 0.
1117   *     Mehr als 2 Nachkommastellen
1118         KB_DEZ_VERSCHIEBUNG  = KB_DEZ_VERSCHIEBUNG * -1.
1119         WAEHRUNGS_KONVERT-FAKTOR = 1.
1120         DO KB_DEZ_VERSCHIEBUNG TIMES.
1121           WAEHRUNGS_KONVERT-FAKTOR = WAEHRUNGS_KONVERT-FAKTOR * 10.
1122         ENDDO.
1123         WAEHRUNGS_KONVERT-FAKTOR = 1 / WAEHRUNGS_KONVERT-FAKTOR.
1124         APPEND WAEHRUNGS_KONVERT.
1125       ENDIF.
1126     ENDSELECT.
1127
1128   ENDFORM.                               "KONVER_FAKTOREN_BESTIMMEN
