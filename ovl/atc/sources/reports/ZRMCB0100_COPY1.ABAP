3027   *       FORM EWS_TO_WORKFLOW
3028   *----------------------------------------------------------------------
3029   *  45A:  Sends exception data to workflow. One BOR-event is created
3030   *        for every combination of characteristics matching the
3031   *        exception conditions!
3032   *        Uses 'merkmale_tab' to read relevant characteristics and
3033   *        'int_mcyc' to read corresponding key-figure values.
3034   *  99A:  Optionally, only one BOR-event is created for the entire
3035   *        exception data.
3036   *----------------------------------------------------------------------
3037   FORM ews_to_workflow.
3038
3039     TABLES: awu_lis.
3040
3041     DATA int_awu_lis LIKE TABLE OF awu_lis WITH HEADER LINE.
3042
3043     DATA: objtype LIKE swetypecou-objtype,
3044           objkey  LIKE sweinstcou-objkey,
3045           event   LIKE swetypecou-event,
3046           exception LIKE awu_lis-event,
3047           sammler_index LIKE sy-tabix,
3048           table_index(5) TYPE n,
3049           table_subrc LIKE sy-subrc,
3050           string(60),
3051           key_figure_string(40),
3052           key_figure_string_len TYPE i,
3053           dec_separator,
3054           pot_translate(2),
3055           dec_translate(2) VALUE ',.',
3056           current_key_figure LIKE  kennzahlen_tab-fieldname.
3057
3058
3059   * Structure to hold key-figure value and unit.
3060     DATA: BEGIN OF struc_key_figure,
3061             value TYPE p DECIMALS 3,
3062             unit LIKE mcr_wf_unit-unit.
3063     DATA: END OF struc_key_figure.
3064
3065   *  Names of characteristics following workflow conventions
3066     DATA: element_name  LIKE swcontdef-element,
3067           element_name1 LIKE swcontdef-element,
3068           element_name2 LIKE swcontdef-element,
3069           element_name3 LIKE swcontdef-element,
3070           element_name4 LIKE swcontdef-element,
3071           element_name5 LIKE swcontdef-element,
3072           element_name6 LIKE swcontdef-element,
3073           element_name7 LIKE swcontdef-element,
3074           element_name8 LIKE swcontdef-element,
3075           element_name9 LIKE swcontdef-element,
3076           element_name10 LIKE swcontdef-element,
3077           key_figure_name LIKE swcontdef-element.
3078
3079   * Declare Containers which holds single exception data
3080     swc_container  ews_container.
3081
3082   ***** This part is taken from Form 'create_sende_info'
3083   *--------- Zunächst Abgleich der SAMMLER_EXC mit MERKMALE_FARBE
3084     LOOP AT sammler_exc.
3085       MOVE-CORRESPONDING sammler_exc TO key_merkmale_farbe.
3086       READ TABLE merkmale_farbe WITH KEY key_merkmale_farbe
3087                                                      BINARY SEARCH.
3088       IF sy-subrc <> 0.
3089         CLEAR merkmale_farbe.
3090       ENDIF.
3091       IF merkmale_farbe-ges_farbe = color_init.
3092         DELETE sammler_exc.
3093       ENDIF.
3094     ENDLOOP.
3095
3096   *--------- Evtl. Anfuegen Periode
3097     IF exc_merkmal_periode = true.
3098       CLEAR merkmale_tab-fname.
3099       CASE sav_speri.
3100         WHEN con_speri_spbup.
3101           merkmale_tab-fname = con_feld_spbup.
3102         WHEN con_speri_spmon.
3103           merkmale_tab-fname = con_feld_spmon.
3104         WHEN con_speri_spwoc.
3105           merkmale_tab-fname = con_feld_spwoc.
3106         WHEN con_speri_sptag.
3107           merkmale_tab-fname = con_feld_sptag.
3108       ENDCASE.
3109       INSERT merkmale_tab INDEX exc_merkmal_periode_index.
3110     ENDIF.
3111
3112   *--------- ASSIGNs
3113     anz_fsymbols = 0.
3114     LOOP AT merkmale_tab.
3115       anz_fsymbols = anz_fsymbols + 1.
3116       LOOP AT fieldtab WHERE fieldname = merkmale_tab-fname.
3117         EXIT.
3118       ENDLOOP.
3119       CASE anz_fsymbols.
3120         WHEN 1.
