532    *---------------------------------------------------------------------*
533    *       FORM HIER_ZUSATZINFO_BESTIMMEN                                *
534    *---------------------------------------------------------------------*
535    *       Hierarchieklassenabhängige  Zusatzinfo ermitteln              *
536    *---------------------------------------------------------------------*
537    *  <--  HB_INFO         : Hierarchiezusatzinfo                        *
538    *  <--  HB_FLG_ABBRECHEN: = TRUE, wenn Ermittlung der Hierarchiezu-   *
539    *                                 satzinfo abgebrochen wurde          *
540    *---------------------------------------------------------------------*
541    FORM hier_zusatzinfo_bestimmen CHANGING hb_info LIKE hier_zusatzinfo
542                                            hb_flg_abbrechen TYPE boolean.
543      DATA: hb_returncode,
544            hlp_domname LIKE mcs04-domname.
545
546      STATICS: hb_hityp LIKE thit-hityp,
547               hb_datum LIKE rmcs0-datum_kh.
548
549    *  data: begin of prh_vko_vtw occurs 6,
550    *          fname  like sel_tab-fname,
551    *          sign   like sel_tab-sign,
552    *          option like sel_tab-option,
553    *          low    like sel_tab-low,
554    *          high   like sel_tab-high.
555    *  data: end   of prh_vko_vtw.
556
557      IF hb_hityp IS INITIAL.
558    *   1. Aufruf der Kundenhierarchie => Werte initialisieren
559        hb_hityp = 'A'.
560        hb_datum = sy-datlo.
561      ENDIF.
562
563      CLEAR hb_info.
564
565    * Zusätzliche Infos für bestimmte Hierarchieklassen in Abhängigkeit
566    * des durchgeführten Aufrisses ermitteln
567      CASE akt_hierarchie-hclass.
568        WHEN 'CUST'.
569    *     Hierarchie über Customer-Exit => Drilldown übertragen
570          LOOP AT akt_drilldown.
571            IF sy-tabix < drilldown_eintraege.
572              CONCATENATE hb_info akt_drilldown-rollname
573                          akt_drilldown-objekt
574                          INTO hb_info SEPARATED BY '#'.
575            ELSE.
576              CONCATENATE hb_info akt_drilldown-rollname
577                          akt_objekt
578                          INTO hb_info SEPARATED BY '#'.
579            ENDIF.
580          ENDLOOP.
581        WHEN 'LPGR'.
582    *     Produktgruppe => Werksaufriß überprüfen
583          PERFORM aufrissobjekt_bestimmen USING    'WERKS'
584                                          CHANGING hb_info(4).
585        WHEN 'LAPH'.
586    *     Arbeitsplatz => Werksaufriß überprüfen
587          PERFORM aufrissobjekt_bestimmen USING    'WERKS'
588                                          CHANGING hb_info(4).
589        WHEN 'LKDH'.
590    *     Kundenhierarchie => Hierarchietyp, Gültigkeitsdatum und ggf.
591    *     Vertriebsweg ermitteln
592          REFRESH popup_fields.
593    *     Hierarchietyp
594          CLEAR popup_fields.
595          popup_fields-tabname    = 'THITT'.
596          popup_fields-fieldname  = 'HITYP'.
597          popup_fields-value      = hb_hityp.
598          popup_fields-field_obl  = true.
599          APPEND popup_fields.
600    *     Gültigkeitsdatum
601          CLEAR popup_fields.
602          popup_fields-tabname    = 'RMCS0'.
603          popup_fields-fieldname  = 'DATUM_KH'.
604          popup_fields-value      = hb_datum.
605          popup_fields-field_obl  = true.
606          popup_fields-comp_code  = 'NC'.
607          APPEND popup_fields.
608
609          PERFORM text_ermitteln USING    219
610    *                                     'Hierachieaufriß: Kundenhierarchie
611                                 CHANGING hlp_text1.
612          CALL FUNCTION 'POPUP_GET_VALUES_DB_CHECKED'
613               EXPORTING
614                    popup_title  = hlp_text1
615                    start_column = 25
616               IMPORTING
617                    returncode   = hb_returncode
618               TABLES
619                    fields       = popup_fields.
620          IF hb_returncode = 'A'.
621    *       Anwender hat die Eingabe abgebrochen
622            hb_flg_abbrechen = true.
623          ELSE.
624    *       Anwender hat gültigen Hierarchietyp und Datum angegeben
625            READ TABLE popup_fields INDEX 1.
626            hb_info(1)       = popup_fields-value.
627            hb_hityp         = popup_fields-value.
628            READ TABLE popup_fields INDEX 2.
629            hb_info+1(8)     = popup_fields-value.
630            hb_datum         = popup_fields-value.
631    *       Verkaufsorganistions-Aufriß prüfen
632            PERFORM aufrissobjekt_bestimmen USING    'VKORG'
633                                            CHANGING hb_info+9(4).
634    *       Vertriebsweg-Aufriß prüfen
635            PERFORM aufrissobjekt_bestimmen USING    'VTWEG'
636                                            CHANGING hb_info+13(2).
637    *       Sparten-Aufriß prüfen
638            PERFORM aufrissobjekt_bestimmen USING    'SPART'
639                                            CHANGING hb_info+15(2).
640          ENDIF.
641        WHEN 'LPRH'.
642          PERFORM selektionstabellen_fuellen USING true.
643
644    *     Bestimmen der Verkaufsorganisation/en Vertriebsweg/e zur
645    *     Ermittlung der Produkthierarchiedaten => MVKE
646    *     Einstieg in Standardanalyse => Grundliste
647
648          CLEAR   s_prh_vko_vtw.
649          REFRESH prh_vko_vtw.
650
651    *     => Verkaufsorganisation/en
652          hlp_domname = 'VKORG'.
653          PERFORM produkthierarchie_vko_vtw USING hlp_domname.
654
655    *     => Vertriebsweg/e
656          hlp_domname = 'VTWEG'.
657          PERFORM produkthierarchie_vko_vtw USING hlp_domname.
658
659    *     read table akt_drilldown with key domname = 'VKORG'.
660    *     if sy-subrc ne 0.
661    *       Nicht erstes Aufrißkriterium - aber evtl. im Std-Aufriß
662    *       loop at drilldown_fcodes where domname = 'VKORG'.
663    *         concatenate 'SL_' drilldown_fcodes-ranges_suf
664    *                      into hlp_fname.
665    *       endloop.
666    *       loop at sel_tab where fname = hlp_fname.
667    *         move-corresponding sel_tab to s_prh_vko_vtw.
668    *         s_prh_vko_vtw-selname = 'SL_VKORG'.
669    *         append s_prh_vko_vtw to prh_vko_vtw.
670    *       endloop.
671    *     else.
672    *       Infos aus jew. Aufriß-Liste übernehmen
673    *       if darstellungsart = con_darst_einzel.
674    *         concatenate 'SL_' akt_drilldown-domname
675    *                      into   s_prh_vko_vtw-selname.
676    *         move: 'I'        to s_prh_vko_vtw-sign,
677    *               'EQ'       to s_prh_vko_vtw-option,
678    *               akt_objekt to s_prh_vko_vtw-low.
679    *         append s_prh_vko_vtw to prh_vko_vtw.
680    *       endif.
681    *     endif.
682    *
683    *     Einstieg in Standardanalyse => Grundliste
684    *     read table akt_drilldown with key domname = 'VTWEG'.
685    *     if sy-subrc ne 0.
686    *       Nicht erstes Aufrißkriterium - aber evtl. im Std-Aufriß
687    *       loop at drilldown_fcodes where domname = 'VTWEG'.
688    *         concatenate 'SL_' drilldown_fcodes-ranges_suf
689    *                      into hlp_fname.
690    *       endloop.
691    *       loop at sel_tab where fname = hlp_fname.
692    *         move-corresponding sel_tab to s_prh_vko_vtw.
693    *         s_prh_vko_vtw-selname = 'SL_VTWEG'.
694    *         append s_prh_vko_vtw to prh_vko_vtw.
695    *       endloop.
696    *     else.
697    *       Infos aus jew. Aufriß-Liste übernehmen
698    *       if darstellungsart = con_darst_einzel.
699    *         concatenate 'SL_' akt_drilldown-domname
700    *                      into   s_prh_vko_vtw-selname.
701    *         move: 'I'        to s_prh_vko_vtw-sign,
702    *               'EQ'       to s_prh_vko_vtw-option,
703    *               akt_objekt to s_prh_vko_vtw-low.
704    *         append s_prh_vko_vtw to prh_vko_vtw.
705    *       endif.
706    *     endif.
707
708      ENDCASE.
709
710      IF akt_hierarchie-kett_akt EQ true.
711        CONCATENATE hb_info con_klammer INTO hb_info.
712      ENDIF.
713
714    ENDFORM.                               "HIER_ZUSATZINFO_BESTIMMEN
