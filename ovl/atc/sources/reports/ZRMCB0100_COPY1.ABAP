5485   *       FORM FUELLEN_PLAN_OHNE_IST                                    *
5486   *---------------------------------------------------------------------*
5487   *       Gibt es Planzahlen ohne Ist-Daten ?                           *
5488   *       Wenn ja: 1. Merken Merkmalskombination in KEY_PLAN_OHNE_IST   *
5489   *                2. Append an INT_S000 (damit Merkmal in Liste der    *
5490   *                                       Standardanalyse)              *
5491   *                3. Append in Verdichtete INTTAB, d.h. ab sofort      *
5492   *                   existieren Ist_Zahlen mit Wert INITIAL            *
5493   *---------------------------------------------------------------------*
5494   FORM fuellen_plan_ohne_ist.
5495
5496     DATA: BEGIN OF fp_tab OCCURS 1,
5497           mandt LIKE key_s000-mandt,
5498           ssour LIKE key_s000-ssour,
5499           vrsio LIKE key_s000-vrsio.
5500             INCLUDE STRUCTURE key_s000_op.
5501     DATA: END OF fp_tab.
5502
5503     DATA: fp_flag,
5504           fp_lines TYPE p.
5505
5506     DESCRIBE TABLE periodentab LINES fp_lines.
5507     READ TABLE periodentab INDEX fp_lines.
5508
5509     MOVE-CORRESPONDING int_ex_key_plan TO key_s000_op.
5510     IF key_s000_op <> key_plan_ohne_ist.
5511       key_plan_ohne_ist = key_s000_op.
5512       PERFORM check_planzahl_bereinigen USING fp_flag.
5513       IF fp_flag = space.
5514         APPEND key_plan_ohne_ist.
5515         MOVE-CORRESPONDING int_ex_key_plan TO fp_tab.
5516         READ TABLE int_ex_key WITH KEY fp_tab BINARY SEARCH.
5517         IF sy-subrc <> 0.
5518   *       move-corresponding int_ex_key_plan to int_ex_key.
5519   *       insert int_ex_key index sy-tabix.
5520   *       clear int_ex_kennz.
5521   *       insert int_ex_kennz index sy-tabix.
5522   *       clear int_s000.
5523   *       move-corresponding int_ex_key_plan to int_s000.
5524   *       append int_s000.
5525           CLEAR int_s000.
5526           MOVE-CORRESPONDING int_ex_key_plan TO int_s000.
5527           MOVE-CORRESPONDING int_ex_key_plan TO int_ex_key.
5528           CASE sav_speri.
5529             WHEN 'P'.
5530               IF int_ex_key_plan-spbup > periodentab-low.
5531                 int_ex_key-spbup      = periodentab-low.
5532                 int_s000-spbup        = periodentab-low.
5533               ENDIF.
5534             WHEN 'M'.
5535               IF int_ex_key_plan-spmon > periodentab-low.
5536                 int_ex_key-spmon      = periodentab-low.
5537                 int_s000-spmon        = periodentab-low.
5538               ENDIF.
5539             WHEN 'T'.
5540               IF int_ex_key_plan-sptag > periodentab-low.
5541                 int_ex_key-sptag      = periodentab-low.
5542                 int_s000-sptag        = periodentab-low.
5543               ENDIF.
5544             WHEN 'W'.
5545               IF int_ex_key_plan-spwoc > periodentab-low.
5546                 int_ex_key-spwoc      = periodentab-low.
5547                 int_s000-spwoc        = periodentab-low.
5548               ENDIF.
5549           ENDCASE.
5550           INSERT int_ex_key INDEX sy-tabix.
5551           CLEAR int_ex_kennz.                          " <= note 174458
5552           INSERT int_ex_kennz INDEX sy-tabix.          " <= note 174458
5553           APPEND int_s000.
5554   *       CLEAR int_ex_kennz.                          " <= note 174458
5555   *       INSERT int_ex_kennz INDEX sy-tabix.          " <= note 174458
5556         ENDIF.
5557       ENDIF.
5558     ENDIF.
