1386                                       hl_scrtext_m LIKE dfies-scrtext_m
1387                                       hl_scrtext_l LIKE dfies-scrtext_l.
1388
1389   * Lese Texte zur Hierarchie
1390     SELECT SINGLE * FROM  trsthvt
1391            WHERE  spras       = sy-langu
1392            AND    appl        = hl_trsthv-appl
1393            AND    tabnm       = hl_trsthv-tabnm
1394            AND    fienm       = hl_trsthv-fienm
1395            AND    rolnm       = hl_trsthv-rolnm
1396            AND    domnm       = hl_trsthv-domnm
1397            AND    hclass      = hl_trsthv-hclass
1398            AND    hienm       = hl_trsthv-hienm.
1399     IF sy-subrc = 0.
1400   *   Text gefunden
1401       hl_scrtext_s = trsthvt-text10.
1402       hl_scrtext_m = trsthvt-text20.
1403       hl_scrtext_l = trsthvt-text40.
1404     ELSE.
1405       hl_scrtext_s = hl_scrtext_m
1406                    = hl_scrtext_l
1407                    = hl_trsthv-hienm.
1408     ENDIF.
1409   ENDFORM.                               "HIERARCHIE_TEXT_LESEN
