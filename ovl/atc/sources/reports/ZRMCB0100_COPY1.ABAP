359    *---------------------------------------------------------------------*
360    *       FORM PLANIST_ABGLEICH                                         *
361    *---------------------------------------------------------------------*
362    *       Ausgehend von den angezeigten Istwerten werden die ent-       *
363    *       sprechenden Planwerte bzw. Vorjahreswerte ermitteln und in    *
364    *       der Tabelle PLAN_TAB gespeichert.                             *
365    *---------------------------------------------------------------------*
366    FORM PLANIST_ABGLEICH.
367
368      FIELD-SYMBOLS: <PA_SUM>,
369                     <PA_EINHEIT_SUM>.
370      DATA: PA_SAV_SUMME LIKE SUM_S000,
371            PA_TABIX     LIKE SY-TABIX.  " Index für geschachtelte Schleife
372      DATA: PA_CHECK_LOG TYPE F.
373
374      PERFORM TEXT_ERMITTELN USING    44
375    *                                 'Daten werden verarbeitet...'
376                             CHANGING HLP_TEXT1.
377      CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
378           EXPORTING
379                TEXT = HLP_TEXT1.
380
381    * Summenwerte bilden für Überschrift und Prozentdarstellung
382      CLEAR PLAN_SUM.
383    * Istwerte
384      _ASSIGN_% COMPONENT KENNZAHL_SPALTE-FIELDNAME OF STRUCTURE SUM_S000
385                                                    TO <PA_SUM>.
386
387      PLAN_SUM-IST = <PA_SUM>.
388      IF NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL.
389        _ASSIGN_X COMPONENT KENNZAHL_SPALTE-REFFIELD OF STRUCTURE SUM_S000
390                                                     TO <PA_EINHEIT_SUM>.
391      ENDIF.
392      PLAN_SUM-EINH_I = <PA_EINHEIT_SUM>.
393
394    * Planwerte
395      DESCRIBE TABLE PLAN_S000 LINES SY-TFILL.
396      IF SY-TFILL = 0.
397    *   keine Planwerte => Einheit der Istwert-Summe übernehmen
398        PLAN_SUM-EINH_P = PLAN_SUM-EINH_I.
399      ELSE.
400        IF NOT ANALYSE_WAEHRUNG IS INITIAL.
401    *     Währungsbetrag in Analysewährung umrechnen
402          FLG_PUFFERTAB_AKTUELL = FALSE.
403          REFRESH PUFFERTAB.
404          LOOP AT PLAN_S000.
405            APPEND PLAN_S000 TO PUFFERTAB.
406          ENDLOOP.
407          PERFORM PUFFERTAB_UMRECHNEN TABLES PLAN_S000.
408        ENDIF.
409    *   Summe zur AUS_S000 retten und Summe zur Plan_S000 berechnen
410        PA_SAV_SUMME    = SUM_S000.
411        PERFORM SUMME_BERECHNEN TABLES PLAN_S000.
412        PLAN_SUM-PLAN   = <PA_SUM>.
413        PLAN_SUM-EINH_P = <PA_EINHEIT_SUM>.
414        SUM_S000        = PA_SAV_SUMME.
415      ENDIF.
416    * Differenz
417      PLAN_SUM-DIFF = PLAN_SUM-IST - PLAN_SUM-PLAN.
418      PLAN_SUM-EINH_D = PLAN_SUM-EINH_I.
419      PERFORM SUMEINHEIT_BESTIMMEN USING    PLAN_SUM-EINH_P
420                                   CHANGING PLAN_SUM-EINH_D.
421
422    * Istzahlen den Planzahlen gegenüberstellen und abspeichern
423      REFRESH PLAN_TAB.
424      CLEAR   PLAN_TAB.
425    * Sortieren zum schnelleren Zugriff
426      SORT PLAN_S000 BY OBJEKT.
427      READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
428      IF FLG_VERGLEICH = CON_VERGLEICH_VORJAHR AND
429         AKT_DRILLDOWN-FCODE = CON_FCODE_APER.
430    *   Vorjahresvgl. u. Periodenaufriß => Jahr bei Abgleich dekrementieren
431        LOOP AT AUS_S000.
432          CHECK <AUSTAB_GLOBAL>-FLG_AUSBLENDEN = FALSE.
433
434          PLAN_TAB-INDEX     = SY-TABIX. "Index zum Aufheben der Sortierung
435          PLAN_TAB-OBJEKT    = <AUSTAB_GLOBAL>-TEXT.
436          PLAN_TAB-OBJEKT_NR = <AUSTAB_GLOBAL>-OBJEKT.
437          PLAN_TAB-IST       = <KENNZ_1>.
438    *     WRITE <EINHEIT_KENNZ_1> TO PLAN_TAB-EINH_I.         <= note 88679
439          MOVE <EINHEIT_KENNZ_1> TO PLAN_TAB-EINH_I.         "<= note 88679
440    *     Jahreszahl vermindern
441          <AUSTAB_GLOBAL>-OBJEKT(4) = <AUSTAB_GLOBAL>-OBJEKT(4) - 1.
442          READ TABLE PLAN_S000
443                      WITH KEY ('OBJEKT') = <AUSTAB_GLOBAL>-OBJEKT
444                      BINARY SEARCH.
445          PA_TABIX = SY-TABIX.
446    *     passende Vorjahreszahl gefunden
447          IF SY-SUBRC = 0.
448            PLAN_S000-MARKIERUNG = TRUE.
449    *       MODIFY PLAN_S000 INDEX SY-TABIX TRANSPORTING MARKIERUNG.
450            MODIFY PLAN_S000 INDEX PA_TABIX TRANSPORTING MARKIERUNG.
451            PLAN_TAB-PLAN = <KENNZ_2>.
452    *       WRITE <EINHEIT_KENNZ_2> TO PLAN_TAB-EINH_P.   <= note 88679
453            move <EINHEIT_KENNZ_2> TO PLAN_TAB-EINH_P.   "<= note 88679
454            ADD 1 TO PA_TABIX.
455            READ TABLE PLAN_S000 INDEX PA_TABIX.
456            WHILE SY-SUBRC = 0 AND
457              PLAN_S000-OBJEKT = <AUSTAB_GLOBAL>-OBJEKT.
458    * mehrere Einträge pro aus_s000 Eintrag --> unterschiedliche Einheiten
459              ADD <KENNZ_2> TO PLAN_TAB-PLAN.
460              PERFORM SUMEINHEIT_BESTIMMEN USING  <EINHEIT_KENNZ_2>
461                                           CHANGING PLAN_TAB-EINH_P.
462    *        IF <EINHEIT_KENNZ_2> NE PLAN_TAB-EINH_P.    " <= note 138971
463    *            PLAN_TAB-EINH_P = CON_EINHEIT_UNGUELTIG.
464    *        ENDIF.                                      " <= note 138971
465              PLAN_S000-MARKIERUNG = TRUE.
466              MODIFY PLAN_S000 INDEX PA_TABIX TRANSPORTING MARKIERUNG.
467              ADD 1 TO PA_TABIX.
468              READ TABLE PLAN_S000 INDEX PA_TABIX.
469            ENDWHILE.
470          ELSE.
471            CLEAR PLAN_TAB-PLAN.
472            PLAN_TAB-EINH_P = PLAN_TAB-EINH_I.
473          ENDIF.
474          PLAN_TAB-DIFF = PLAN_TAB-IST - PLAN_TAB-PLAN.
475          IF NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL.
476    *       Setzen der Differenzeinheit gemäß Konstellation der Ausgangs-
477    *       einheiten. Hierbei dient die Einheit des Istwertes als Referenz
478            PLAN_TAB-EINH_D = PLAN_TAB-EINH_I.
479            PERFORM SUMEINHEIT_BESTIMMEN USING    PLAN_TAB-EINH_P
480                                         CHANGING PLAN_TAB-EINH_D.
481          ENDIF.
482          APPEND PLAN_TAB.
483        ENDLOOP.
484
485      ELSE.
486    *   Vorjahresvergleich ohne Periodenaufriß oder Plan-/Istvergleich
487        LOOP AT AUS_S000.
488          CHECK <AUSTAB_GLOBAL>-FLG_AUSBLENDEN = FALSE.
489
490          PLAN_TAB-INDEX     = SY-TABIX. "Index zum Aufheben der Sortierung
491          PLAN_TAB-OBJEKT    = <AUSTAB_GLOBAL>-TEXT.
492          PLAN_TAB-OBJEKT_NR = <AUSTAB_GLOBAL>-OBJEKT.
493          PLAN_TAB-COLOR_ID  = <AUSTAB_GLOBAL>-COLOR_ID.
494          PLAN_TAB-IST       = <KENNZ_1>.
495    *     WRITE <EINHEIT_KENNZ_1> TO PLAN_TAB-EINH_I.         <= note 88679
496          MOVE <EINHEIT_KENNZ_1> TO PLAN_TAB-EINH_I.         "<= note 88679
497          READ TABLE PLAN_S000
498                      WITH KEY ('OBJEKT') = <AUSTAB_GLOBAL>-OBJEKT
499                      BINARY SEARCH.
500          PA_TABIX = SY-TABIX.
501          IF SY-SUBRC = 0.
502            PLAN_S000-MARKIERUNG = TRUE.
503    *       modify plan_s000 index sy-tabix transporting markierung.
504                                                            "TR 29.09.98
505            MODIFY PLAN_S000 INDEX PA_TABIX TRANSPORTING MARKIERUNG.
506            PLAN_TAB-PLAN   = <KENNZ_2>.
507    *       WRITE <EINHEIT_KENNZ_2> TO PLAN_TAB-EINH_P.   <= note 88679
508            move <EINHEIT_KENNZ_2> TO PLAN_TAB-EINH_P.   "<= note 88679
509            ADD 1 TO PA_TABIX.
510            READ TABLE PLAN_S000 INDEX PA_TABIX.
511            WHILE SY-SUBRC = 0 AND
512              PLAN_S000-OBJEKT = <AUSTAB_GLOBAL>-OBJEKT.
513    * mehrere Einträge pro aus_s000 Eintrag --> unterschiedliche Einheiten
514              ADD <KENNZ_2> TO PLAN_TAB-PLAN.
515              perform sumeinheit_bestimmen using  <EINHEIT_KENNZ_2>
516                                           CHANGING PLAN_TAB-EINH_P.
517    *         IF <EINHEIT_KENNZ_2> NE PLAN_TAB-EINH_P.    " <= note 138971
518    *            PLAN_TAB-EINH_P = CON_EINHEIT_UNGUELTIG.
519    *         ENDIF.                                      " <= note 138971
520              PLAN_S000-MARKIERUNG = TRUE.
521              MODIFY PLAN_S000 INDEX PA_TABIX TRANSPORTING MARKIERUNG.
522              ADD 1 TO PA_TABIX.
523              READ TABLE PLAN_S000 INDEX PA_TABIX.
524            ENDWHILE.
525          ELSE.
526            CLEAR PLAN_TAB-PLAN.
527            PLAN_TAB-EINH_P = PLAN_TAB-EINH_I.
528          ENDIF.
529          PLAN_TAB-DIFF = PLAN_TAB-IST - PLAN_TAB-PLAN.
530          IF NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL.
531    *       Setzen der Differenzeinheit gemäß Konstellation der Ausgangs-
532    *       einheiten. Hierbei dient die Einheit des Istwertes als Referenz
533            PLAN_TAB-EINH_D = PLAN_TAB-EINH_I.
534            PERFORM SUMEINHEIT_BESTIMMEN USING    PLAN_TAB-EINH_P
535                                         CHANGING PLAN_TAB-EINH_D.
536          ENDIF.
537          APPEND PLAN_TAB.
538        ENDLOOP.
539      ENDIF.
540
541      IF HITL_KRITERIUM IS INITIAL
542                      AND  EXC_MODE IS INITIAL.            " TR 29.09.98
543    *   Keine Hitliste => Anzeige auch von Werten aus der PLAN_S000 zu denen
544    *   keine Istwerte existieren
545        CLEAR PLAN_TAB.
546        LOOP AT PLAN_S000 WHERE MARKIERUNG NE TRUE.
547    *     CHECK NOT <PLANTAB_GLOBAL>-OBJEKT IS INITIAL.    " <= note 173963
548    *     Planwert für Merkmalswert SPACE wird nicht berücksichtigt, da
549    *     er für den 'Rest' (nicht spezifizierte Merkmale) steht
550          PLAN_TAB-INDEX     = SY-TABIX. "Index zum Aufheben der Sortierung
551          IF FLG_VERGLEICH = CON_VERGLEICH_VORJAHR AND
552            AKT_DRILLDOWN-FCODE = CON_FCODE_APER.
553    *       Vorjahresvergleich und Periodenaufriß => Jahr inkremtieren
554            ADD 1 TO <PLANTAB_GLOBAL>-OBJEKT(4).
555          ENDIF.
556          PERFORM OBJEKTTEXT_ERMITTELN USING    AKT_DRILLDOWN-DOMNAME
557                                                AKT_DRILLDOWN-ROLLNAME
558                                                AKT_DRILLDOWN-CONVEXIT
559                                                AKT_DRILLDOWN-OUTPUTLEN
560                                                <PLANTAB_GLOBAL>-OBJEKT
561                                       CHANGING PLAN_TAB-OBJEKT.
562          PLAN_TAB-OBJEKT_NR = <PLANTAB_GLOBAL>-OBJEKT.
563          PLAN_TAB-COLOR_ID  = <AUSTAB_GLOBAL>-COLOR_ID.
564
565          READ TABLE PLAN_TAB
566                     WITH KEY ('OBJEKT_NR') = <PLANTAB_GLOBAL>-OBJEKT.
567          IF SY-SUBRC eq 0.
568            PA_TABIX = SY-TABIX.
569            ADD <KENNZ_2> TO PLAN_TAB-PLAN.
570            PERFORM sumeinheit_bestimmen using  <EINHEIT_KENNZ_2>
571                                         CHANGING PLAN_TAB-EINH_P.
572            PLAN_TAB-EINH_I    = PLAN_TAB-EINH_P.
573            PLAN_TAB-EINH_D    = PLAN_TAB-EINH_P.
574            PLAN_TAB-DIFF      = - PLAN_TAB-PLAN.
575            MODIFY PLAN_TAB INDEX PA_TABIX.
576          ELSE.
577            PLAN_TAB-PLAN      = <KENNZ_2>.
578            MOVE <EINHEIT_KENNZ_2> TO PLAN_TAB-EINH_P.
579            PLAN_TAB-EINH_I    = PLAN_TAB-EINH_P.
580            PLAN_TAB-EINH_D    = PLAN_TAB-EINH_P.
581            PLAN_TAB-DIFF      = - PLAN_TAB-PLAN.
582            APPEND PLAN_TAB.
583          ENDIF.
584        ENDLOOP.
585        IF SY-SUBRC = 0.
586    *     Es existieren Werte in PLAN_S000 ohne Istwerte
587          IF AKT_DRILLDOWN-FCODE = CON_FCODE_APER AND
588             ( SORT_KRITERIUM IS INITIAL OR
589               SORT_KRITERIUM = CON_FELD_AUSTABOBJEKT ).
590            SORT PLAN_TAB BY OBJEKT_NR.
591          ENDIF.
592        ENDIF.
593      ENDIF.
594
595      IF NOT HITL_KRITERIUM IS INITIAL.                " ===>>> note 184345
596    *  Wenn Hitliste aktiv, dann Restsumme der Planwerte bestimmen
597        Clear Plan_rest_sum.
598        LOOP AT PLAN_S000 WHERE MARKIERUNG NE TRUE.
599    *  Summe ermitteln
600          ADD <KENNZ_2> to plan_rest_sum-plan.
601          perform sumeinheit_bestimmen using  <EINHEIT_KENNZ_2>
602                                       changing plan_rest_sum-einh_p.
603        ENDLOOP.
604    *  Restsumme Ist-Wert aus der Grundliste
605        _ASSIGN_% COMPONENT KENNZAHL_SPALTE-FIELDNAME
606                                    OF STRUCTURE SUM_REST TO <PA_SUM>.
607        PLAN_REST_SUM-IST = <PA_SUM>.
608        IF NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL.
609        _ASSIGN_X COMPONENT KENNZAHL_SPALTE-REFFIELD
610                             OF STRUCTURE SUM_REST TO <PA_EINHEIT_SUM>.
611        ENDIF.
612        PLAN_REST_SUM-EINH_I = <PA_EINHEIT_SUM>.
613    *  Absolute Differenz berechnen und Einheit setzen
614        PLAN_REST_SUM-DIFF = PLAN_REST_SUM-IST - PLAN_REST_SUM-PLAN.
615        IF NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL.
616            PLAN_REST_SUM-EINH_D = PLAN_REST_SUM-EINH_I.
617            PERFORM SUMEINHEIT_BESTIMMEN USING    PLAN_REST_SUM-EINH_P
618                                         CHANGING PLAN_REST_SUM-EINH_D.
619        ENDIF.
620    *  Prozentuale Differenz berechnen
621        IF PLAN_REST_SUM-DIFF <> 0 AND PLAN_REST_SUM-PLAN <> 0.
622          PA_CHECK_LOG = log10( abs( PLAN_REST_SUM-DIFF ) )
623                         - log10( abs( PLAN_REST_SUM-PLAN ) ).
624        ELSE.
625          PA_CHECK_LOG = 0.
626        ENDIF.
627        IF PA_CHECK_LOG < 7 AND PLAN_REST_SUM-PLAN NE 0.
628          IF PLAN_REST_SUM-EINH_D <> CON_EINHEIT_UNGUELTIG.
629            PLAN_REST_SUM-DIFF_PROZ  = 100 * PLAN_REST_SUM-DIFF /
630                                             ABS( PLAN_REST_SUM-PLAN ).
631          ENDIF.
632        endif.
633      ENDIF.                                           " <<<=== note 184345
634
635      LOOP AT PLAN_TAB.
636    *   Differenz prozentual nur berechnen, wenn Planwert > 0
637        IF PLAN_TAB-DIFF <> 0 AND PLAN_TAB-PLAN <> 0.
638          PA_CHECK_LOG = log10( abs( PLAN_TAB-DIFF ) )
639                         - log10( abs( PLAN_TAB-PLAN ) ).
640        ELSE.
641          PA_CHECK_LOG = 0.
642        ENDIF.
643        IF PA_CHECK_LOG < 7 AND PLAN_TAB-PLAN NE 0.
644    *     prozentuale Differenz berechnen macht keinen Sinn bei unter-
645    *     schiedlichen Einheiten der zu vergleichenden Werte
646    *     wenn Einheit der Differenz = '***'
647          IF PLAN_TAB-EINH_D <> CON_EINHEIT_UNGUELTIG.
648            PLAN_TAB-DIFF_PROZ  = 100 * PLAN_TAB-DIFF /
649                                             ABS( PLAN_TAB-PLAN ).
650            MODIFY PLAN_TAB.
651          ENDIF.
652        ENDIF.
653      ENDLOOP.
654    ENDFORM.                               "PLANIST_ABGLEICH
