5263           APPEND sl_sptag.
5264         WHEN con_speri_spwoc.
5265           IF sl_spwoc-low+4(2) LE '52'.
5266             sl_spwoc-low+4(2) = sl_spwoc-low+4(2) + 1.
5267           ENDIF.
