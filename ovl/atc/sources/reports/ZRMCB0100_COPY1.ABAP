228      ADD as_austab-azukb TO as_struc-azukb.
229      ADD as_austab-magbb TO as_struc-magbb.
230      ADD as_austab-wagbb TO as_struc-wagbb.
231      ADD as_austab-aagbb TO as_struc-aagbb.
232      ADD as_austab-magkb TO as_struc-magkb.
233      ADD as_austab-aagkb TO as_struc-aagkb.
234      ADD as_austab-ambwg TO as_struc-ambwg.
235      ADD as_austab-mgvbr TO as_struc-mgvbr.
236      ADD as_austab-wgvbr TO as_struc-wgvbr.
237      ADD as_austab-agvbr TO as_struc-agvbr.
238      ADD as_austab-muvbr TO as_struc-muvbr.
239      ADD as_austab-wuvbr TO as_struc-wuvbr.
240      ADD as_austab-auvbr TO as_struc-auvbr.
241      ADD as_austab-astor TO as_struc-astor.
242      ADD as_austab-bbnull TO as_struc-bbnull.
243      ADD as_austab-kbnull TO as_struc-kbnull.
244      ADD as_austab-gbnull TO as_struc-gbnull.
245
246    * Summation der Bestände für Berechnung mittlerer Bestand
247      as_struc-s_gsbest = as_struc-s_gsbest + as_austab-s_gsbest.
248      as_struc-s_mbwbest = as_struc-s_mbwbest + as_austab-s_mbwbest.
249      as_struc-s_mkobest = as_struc-s_mkobest + as_austab-s_mkobest.
250      as_struc-s_wbwbest = as_struc-s_wbwbest + as_austab-s_wbwbest.
251
252      IF akt_drilldown-fcode EQ con_fcode_aper.
253        CASE sav_speri.
254          WHEN con_speri_sptag.
255            IF as_austab-objekt = akt_tag.
256              as_struc-mbwbest = as_struc-mbwbest + as_austab-mbwbest.
257              as_struc-mkobest = as_struc-mkobest + as_austab-mkobest.
258              as_struc-wbwbest = as_struc-wbwbest + as_austab-wbwbest.
259              as_struc-beszug  = as_struc-beszug  + as_austab-beszug .
260              as_struc-wbeszug = as_struc-wbeszug + as_austab-wbeszug.
261    *         if akt_drilldown-fcode <> con_fcode_algo.
262              as_struc-eisbe   = as_struc-eisbe   + as_austab-eisbe.
263    *         else.
264    *           as_struc-eisbe   = as_austab-eisbe.
265    *         endif.
266            ENDIF.
267          WHEN con_speri_spwoc.
268            IF as_austab-objekt = akt_woc.
269              as_struc-mbwbest = as_struc-mbwbest + as_austab-mbwbest.
270              as_struc-mkobest = as_struc-mkobest + as_austab-mkobest.
271              as_struc-wbwbest = as_struc-wbwbest + as_austab-wbwbest.
272              as_struc-beszug  = as_struc-beszug  + as_austab-beszug .
273              as_struc-wbeszug = as_struc-wbeszug + as_austab-wbeszug.
274    *         if akt_drilldown-fcode <> con_fcode_algo.
275              as_struc-eisbe   = as_struc-eisbe   + as_austab-eisbe.
276    *         else.
277    *           as_struc-eisbe   = as_austab-eisbe.
278    *         endif.
279            ENDIF.
280          WHEN con_speri_spmon.
281            IF as_austab-objekt = akt_mon.
282              as_struc-mbwbest = as_struc-mbwbest + as_austab-mbwbest.
283              as_struc-mkobest = as_struc-mkobest + as_austab-mkobest.
284              as_struc-wbwbest = as_struc-wbwbest + as_austab-wbwbest.
285              as_struc-beszug  = as_struc-beszug  + as_austab-beszug .
286              as_struc-wbeszug = as_struc-wbeszug + as_austab-wbeszug.
287    *         if akt_drilldown-fcode <> con_fcode_algo.
288              as_struc-eisbe   = as_struc-eisbe   + as_austab-eisbe.
289    *         else.
290    *           as_struc-eisbe   = as_austab-eisbe.
291    *         endif.
292            ENDIF.
293          WHEN con_speri_spbup.
294            IF as_austab-objekt = akt_bup.
295              as_struc-mbwbest = as_struc-mbwbest + as_austab-mbwbest.
296              as_struc-mkobest = as_struc-mkobest + as_austab-mkobest.
297              as_struc-wbwbest = as_struc-wbwbest + as_austab-wbwbest.
298              as_struc-beszug  = as_struc-beszug  + as_austab-beszug .
299              as_struc-wbeszug = as_struc-wbeszug + as_austab-wbeszug.
300    *         if akt_drilldown-fcode <> con_fcode_algo.
301              as_struc-eisbe   = as_struc-eisbe   + as_austab-eisbe.
302    *         else.
303    *           as_struc-eisbe   = as_austab-eisbe.
304    *         endif.
305            ENDIF.
306        ENDCASE.
307      ELSE.
308    *Hat die AUSTAB mehrere Einträge, kann der Bestand problemlos addiert
309    *werden, wenn Aufrißcode <> Periode
310        as_struc-mbwbest = as_struc-mbwbest + as_austab-mbwbest.
311        as_struc-mkobest = as_struc-mkobest + as_austab-mkobest.
312        as_struc-wbwbest = as_struc-wbwbest + as_austab-wbwbest.
313        as_struc-beszug  = as_struc-beszug  + as_austab-beszug .
314        as_struc-wbeszug = as_struc-wbeszug + as_austab-wbeszug.
