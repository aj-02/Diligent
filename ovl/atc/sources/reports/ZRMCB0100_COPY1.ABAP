432    *       FORM AUSTAB_FUELLEN                                           *
433    *---------------------------------------------------------------------*
434    *       Ausgabetabelle füllen                                         *
435    *---------------------------------------------------------------------*
436    FORM AUSTAB_FUELLEN.
437      DATA: AF_NODE_ID           LIKE SNODETEXT-ID,
438            AF_FLG_KEIN_STANDARD TYPE BOOLEAN,
439            AF_HLP_TFILL         LIKE SY-TFILL,
440            AF_FLG_NO_KETT       TYPE BOOLEAN,
441            AF_NUM2(2)           TYPE N.
442
443      PERFORM SPEZIAL_AUSTAB_INITIALISIEREN IN PROGRAM (LIS_PROGNAME)
444                                               IF FOUND.
445
446      PERFORM SPEZIAL_AUSTAB_FUELLEN IN PROGRAM (LIS_PROGNAME) IF FOUND
447                                     TABLES AUS_S000
448                                   CHANGING AF_FLG_KEIN_STANDARD.
449
450      CHECK AF_FLG_KEIN_STANDARD = FALSE.
451
452      CLEAR ANZ_MERKMALSKETTUNGEN.
453
454      IF INTTAB_EINTRAEGE = 0.
455    *   Inttab noch nicht gelesen, da Selektionsversion angezeigt wird
456        PERFORM MCSI_IMPORT USING SPACE
457                                  SPACE
458                                  SLV_NO
459                                  SPACE
460                                  TRUE.
461      ENDIF.
462
463      PERFORM DD_RANGES_FUELLEN.
464
465    * Aus letztem Drilldown-Funktionscode Drilldown-Objekt ermitteln
466      READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
467      IF SAV_FCODE(1) = 'H' OR AKT_DRILLDOWN-FCODE(1) = 'H'.
468    *   Hierarchieaufriß
469        IF ANZ_HIERARCHIE_AUFRISSE = 0 AND SAV_FCODE(1) = 'H'.
470    *     Erster Aufriß nach Hierarchie => Hierarchiebaum ermitteln
471
472    *     Verdichtungsmerkmal setzen und AUSPRAEGUNGSTAB füllen
473          IF AKT_DRILLDOWN-KETT_AKT IS INITIAL.       " >>> TR 04.03.1999
474    *       Verdichtungsmerkmal setzen
475            ASSIGN COMPONENT AKT_HIERARCHIE-MERKMALS_FELDNAME
476                            OF STRUCTURE INT_S000 TO <INTTAB_OBJEKT>.
477          ELSE.
478            PERFORM MERKMALSKETTUNG_INTTAB
479                    CHANGING ANZ_MERKMALSKETTUNGEN.
480            IF SAV_FCODE EQ 'HALL' OR
481               AKT_DRILLDOWN-FCODE EQ 'HALL'.
482    * Für allgemeine Hiearchie Offset der Kettung übergeben
483              IF OUTPUTLEN_INTTAB_OBJEKT_KETT2 EQ 0.
484                AF_NUM2 = '00'.
485              ELSEIF OUTPUTLEN_INTTAB_OBJEKT_KETT3 EQ 0.
486                AF_NUM2 = OUTPUTLEN_INTTAB_OBJEKT_KETT1.
487              ELSE.
488                AF_NUM2 = OUTPUTLEN_INTTAB_OBJEKT_KETT1 +
489                          OUTPUTLEN_INTTAB_OBJEKT_KETT2.
490              ENDIF.
491              CONCATENATE HIER_ZUSATZINFO AF_NUM2 INTO HIER_ZUSATZINFO.
492            ENDIF.
493          ENDIF.                           " <<< ENDE TR 04.03.1999
494
495
496          IF SAV_SPZIS = 'D' OR SAV_SPZIS = 'E'.
497    *    Austab sieht für Bestandscontrolling anders aus
498            PERFORM INTTAB_VERDICHTEN_INVCON IN PROGRAM (LIS_PROGNAME)
499                                      IF FOUND TABLES AUSPRAEGUNGSTAB.
500          ELSE.
501            PERFORM INTTAB_VERDICHTEN TABLES AUSPRAEGUNGSTAB.
502          ENDIF.
503    *     Hierarchie aufbauen
504          PERFORM HIERARCHIE_LESEN IN PROGRAM (LIS_PROGNAME) IF FOUND.
505    *     Aufrißknoten ist erster Knoten
506          DESCRIBE TABLE RSTHIE_TAB LINES SY-TFILL.
507          IF SY-TFILL > 0.
508    *       Hierarchie konnte aufgebaut werden
509           PERFORM HIERARCHIE_AUFREISSEN IN PROGRAM (LIS_PROGNAME) IF FOUND
510                                                 USING 1.
511          ENDIF.
512        ELSE.
513    *     Aufriß innerhalb der Hierarchie
514          AF_HLP_TFILL = DRILLDOWN_EINTRAEGE - 1.
515          READ TABLE AKT_DRILLDOWN INDEX AF_HLP_TFILL.
516          IF AKT_DRILLDOWN-FCODE(1) = 'H'.
517    *       Vorletzter Aufriß war Hierarchieaufriß => HierKnoten bekannt
518            AF_NODE_ID = AKT_DRILLDOWN-ID.
519          ELSE.
520    *       Aktueller Aufriß ist erster HierAufriß => Aufriß HierWurzel
521            AF_NODE_ID = 1.
522          ENDIF.
523          PERFORM HIERARCHIE_AUFREISSEN IN PROGRAM (LIS_PROGNAME) IF FOUND
524                                        USING AF_NODE_ID.
525        ENDIF.
526      ELSE.
527    *   Kein Hierarchieaufriß
528    *   Merkmalskettung notwendig
529    *-- Es muß immer gekettet, wegen der Eindeutigkeit des Textes im
530    *   Textpuffer
531    *   if not akt_drilldown-rollname01 is initial.
532    *     Merkmalskettung ist nur notwendig, wenn im aktuellen Drilldown
533    *     not nicht über die zu kettende Merkmale aufgerißen wurde.
534    *     loop at int_tmc7k
535    *          where rolln_akt =  akt_drilldown-rollname01
536    *          and   rolln_add ne akt_drilldown-rollname01.
537
538    *       read table akt_drilldown
539    *                   with key rollname = int_tmc7k-rolln_add
540    *                   transporting no fields.
541
542    *       if sy-subrc ne 0.
543    *         af_flg_no_kett = false.
544    *         exit.
545    *       else.
546    *         af_flg_no_kett = true.
547    *       endif.
548    *     endloop.
549    *------ Wurde bereits ein Außriß über die abhängigen Merkmal
550    *       durchgeführt -> keine Merkmalkettung notwendig
551    *     if af_flg_no_kett = true.
552    *       clear akt_drilldown-kett_akt.
553    *       modify akt_drilldown index drilldown_eintraege.
554    *     endif.
555    *   endif.
556
557        IF AKT_DRILLDOWN-KETT_AKT IS INITIAL.
558    *     Verdichtungsmerkmal setzen
559          ASSIGN COMPONENT AKT_DRILLDOWN-TABFELD+5
560                           OF STRUCTURE INT_S000 TO <INTTAB_OBJEKT>.
561        ELSE.
562          PERFORM MERKMALSKETTUNG_INTTAB
563                  CHANGING ANZ_MERKMALSKETTUNGEN.
564        ENDIF.
565
566        IF ANALYSE_WAEHRUNG IS INITIAL.
567    *     Keine Analysewährung gewählt
568          IF SAV_SPZIS = 'D' OR SAV_SPZIS = 'E'.
569    *    Austab spezial für Bestandscontrolling
570            PERFORM INTTAB_VERDICHTEN_INVCON IN PROGRAM (LIS_PROGNAME)
571                                      IF FOUND TABLES AUS_S000.
572          ELSE.
573            PERFORM INTTAB_VERDICHTEN TABLES AUS_S000.
574          ENDIF.
575    *     Summenzeile und Zusatzkennzahlen berechnen
576          PERFORM SUMME_BERECHNEN TABLES AUS_S000.
577        ELSE.
578    *     Analysewährung gewählt => Puffertabelle füllen und umrechnen
579          IF SAV_SPZIS = 'D' OR SAV_SPZIS = 'E'.
580    *     Puffertab spezial für Bestandscontrolling
581            PERFORM PUFFERTAB_FUELLEN_INVCON IN PROGRAM (LIS_PROGNAME)
582                                                         IF FOUND.
583          ELSE.
584            PERFORM PUFFERTAB_FUELLEN.
585          ENDIF.
586          PERFORM PUFFERTAB_UMRECHNEN TABLES AUS_S000.
587    *     Summenzeile und Zusatzkennzahlen berechnen
588          PERFORM SUMME_BERECHNEN TABLES AUS_S000.
589        ENDIF.
590      ENDIF.
591    ENDFORM.                               "AUSTAB_FUELLEN
