704    *---------------------------------------------------------------------*
705    *       FORM SPALTENANFANG_AUSGEBEN                                   *
706    *---------------------------------------------------------------------*
707    *       Gibt Spaltenanfang aus (d.h. Merkmal und evtl. zusätzlich     *
708    *       Check-Box zum Markieren und Hierarchiefelder).                *
709    *---------------------------------------------------------------------*
710    FORM SPALTENANFANG_AUSGEBEN USING SA_FLG_NONSUM TYPE BOOLEAN.
711    * SA_FLG_NONSUM give us the information: Is the line
712    * Summenzeile or Restsummenzeile
713    * 1) in the case SA_FLG_NONSUM EQ FALSE -> this line is
714    * Summenzeile oder Restsummenzeile
715    * 2) in the case SA_FLG_NONSUM EQ TRUE -> this line is NOT
716    * Summenzeile oder Restsummenzeile
717
718
719
720
721
722
723    *
724      LOCAL: <AUSTAB_TEXT>.
725
726      DATA: SA_FLG_KEIN_STANDARD,
727            SA_LAENGE     LIKE SY-COLNO,
728            SA_TEXTLAENGE LIKE SY-COLNO,
729            SA_QUICKINFO(255),
730            SA_HELP_QUICKINFO(255),
731            SA_NUR TYPE I,
732            SA_NUR_HELP TYPE I.
733
734      IF GF_ACC_INIT = FALSE.
735          CALL FUNCTION 'GET_ACCESSIBILITY_MODE'
736       IMPORTING
737         ACCESSIBILITY           = gf_acc_on
738       EXCEPTIONS
739         ITS_NOT_AVAILABLE       = 1
740         OTHERS                  = 2
741               .
742        gf_acc_init = true.
743      ENDIF.
744
745      PERFORM SPEZIAL_SPALTENANFANG_AUSGBEN IN PROGRAM (LIS_PROGNAME)
746                                            IF FOUND
747                                            CHANGING SA_FLG_KEIN_STANDARD.
748      CHECK SA_FLG_KEIN_STANDARD = FALSE.
749
750      IF FLG_LIS_REPORTING = TRUE.
751        WRITE: / SY-VLINE NO-GAP.
752
753      ELSE.
754        PERFORM ZUSATZ_SPALTENANFANG_AUSGEBEN IN PROGRAM (LIS_PROGNAME)
755                                              IF FOUND
756                                              TABLES AUS_S000.
757      ENDIF.
758
759      IF FLG_HIERARCHIE = TRUE.
760    *   senkrechte Striche im Merkmal machen bei Hierarchiedarstellung
761    *   keinen Sinn, da sie nicht untereinander stehen
762        TRANSLATE <AUSTAB_TEXT> USING '| '."<- ist lokal
763      ENDIF.
764
765      IF GF_ACC_ON = FALSE.
766    * Merkmal ausgeben
767       IF STRICH_ANFANG > SY-COLNO.
768        SA_LAENGE = STRICH_ANFANG - SY-COLNO.
769        SA_TEXTLAENGE = STRLEN( <AUSTAB_TEXT> ).
770        IF SA_TEXTLAENGE > SA_LAENGE.
771          SA_QUICKINFO = <AUSTAB_TEXT>.
772        ENDIF.
773        WRITE: AT (SA_LAENGE) <AUSTAB_TEXT> NO-GAP
774                              COLOR       = COLOR_TAB-COL_MERKMAL
775                              INTENSIFIED = COLOR_TAB-INT_MERKMAL
776                              INVERSE     = COLOR_TAB-INV_MERKMAL
777                              QUICKINFO SA_QUICKINFO.
778       ENDIF.
779       WRITE AT STRICH_ANFANG SY-VLINE NO-GAP.
780
781    * Farbformat für Kennzahlen setzen
782       FORMAT COLOR       = COLOR_TAB-COL_KENNZAHL
783             INTENSIFIED = COLOR_TAB-INT_KENNZAHL
784             INVERSE     = COLOR_TAB-INV_KENNZAHL.
785      ELSE.
786
787     IF SA_FLG_NONSUM EQ FALSE.   "line is Summenzeile oder Restsummenzeile
788        SA_LAENGE = STRICH_ANFANG - SY-COLNO.
789        SA_TEXTLAENGE = STRLEN( <AUSTAB_TEXT> ).
790        IF SA_TEXTLAENGE > SA_LAENGE.
791          SA_QUICKINFO = <AUSTAB_TEXT>.
792        ELSE.
793          SA_QUICKINFO = SA_HELP_QUICKINFO.
794        ENDIF.
795
796        WRITE: AT (SA_LAENGE) <AUSTAB_TEXT>
797                  COLOR       = COLOR_TAB-COL_MERKMAL
798                  INTENSIFIED = COLOR_TAB-INT_MERKMAL
799                  INVERSE     = COLOR_TAB-INV_MERKMAL
800                  QUICKINFO SA_QUICKINFO NO-GAP.
801      CLEAR SA_QUICKINFO.
802      CLEAR SA_HELP_QUICKINFO.
803      WRITE AT STRICH_ANFANG SY-VLINE NO-GAP.
804    * Farbformat für Kennzahlen setzen
805      FORMAT COLOR       = COLOR_TAB-COL_KENNZAHL
806             INTENSIFIED = COLOR_TAB-INT_KENNZAHL
807             INVERSE     = COLOR_TAB-INV_KENNZAHL.
808
809
810     ELSE.
811        SA_NUR = COLOR_TAB-COL_MERKMAL.
812        IF SA_NUR = 5.
813           SA_NUR_HELP = 501.
814           CLEAR SA_NUR.
815           SA_NUR = 4.
816        ELSEIF SA_NUR = 3.
817           SA_NUR_HELP = 502.
818           CLEAR SA_NUR.
819           SA_NUR = 4.
820        ELSEIF SA_NUR = 6.
821           SA_NUR_HELP = 503.
822           CLEAR SA_NUR.
823           SA_NUR = 4.
824        ELSE.
825
826        ENDIF.
827        IF SA_NUR_HELP <> 0.
828         SELECT SINGLE NTEXT FROM TMCRT INTO SA_HELP_QUICKINFO
829                WHERE SPRAS = SY-LANGU AND TXTNR = SA_NUR_HELP.
830        ENDIF.
831
832
833        SA_LAENGE = STRICH_ANFANG - SY-COLNO.
834        SA_TEXTLAENGE = STRLEN( <AUSTAB_TEXT> ).
835        IF SA_TEXTLAENGE > SA_LAENGE.
836          SA_QUICKINFO = <AUSTAB_TEXT>.
837          WRITE SA_HELP_QUICKINFO TO SA_QUICKINFO+SA_TEXTLAENGE.
838        ELSE.
839          SA_QUICKINFO = SA_HELP_QUICKINFO.
840        ENDIF.
841
842        WRITE: AT (SA_LAENGE) <AUSTAB_TEXT>
843                  COLOR       = SA_NUR
844                  INTENSIFIED = COLOR_TAB-INT_MERKMAL
845                  INVERSE     = COLOR_TAB-INV_MERKMAL
846                  QUICKINFO SA_QUICKINFO NO-GAP.
847
848      WRITE AT STRICH_ANFANG SY-VLINE NO-GAP.
849    * Farbformat für Kennzahlen setzen
850      FORMAT COLOR       = 2
851             INTENSIFIED = COLOR_TAB-INT_KENNZAHL
852             INVERSE     = COLOR_TAB-INV_KENNZAHL
853             .
854
855     ENDIF.
856    ENDIF.
857
858    ENDFORM.                               "SPALTENANFANG_AUSGEBEN
