1817   *---------------------------------------------------------------------*
1818   *       FORM STD_DRILLDOWN_ANZEIGEN                                   *
1819   *---------------------------------------------------------------------*
1820   *       Anzeige des Standardaufrisses in Abhängigkeit der Aufruf-     *
1821   *       stelle (Selektionsbild bzw. Liste) steuern                    *
1822   *---------------------------------------------------------------------*
1823   FORM STD_DRILLDOWN_ANZEIGEN.
1824
1825     DATA: SA_POPUP_LENGTH  LIKE SY-CUROW,
1826           SA_POPUP_WIDTH   LIKE SY-CUCOL,
1827           SA_START_COL     LIKE SY-CUCOL,
1828           SA_START_ROW     LIKE SY-CUROW,
1829           SA_END_COL       LIKE SY-CUCOL,
1830           SA_END_ROW       LIKE SY-CUROW.
1831
1832     PERFORM TEXT_ERMITTELN USING    217
1833   *                                 'Standardaufriß anzeigen'
1834                            CHANGING HLP_TEXT1.
1835
1836   * Fenstergröße bestimmen
1837     DESCRIBE TABLE STD_DRILLDOWN LINES SY-TFILL.
1838     SA_POPUP_LENGTH = SY-TFILL * 2 + 1.
1839     SA_POPUP_WIDTH  = 20 + ( SY-TFILL - 1 ) * 3.
1840     SY-FDPOS = STRLEN( HLP_TEXT1 ) + 3.
1841     IF SA_POPUP_WIDTH < SY-FDPOS.
1842       SA_POPUP_WIDTH = SY-FDPOS.
1843     ENDIF.
1844
1845   * Startpunkte des Fensters ermitteln
1846     SA_START_COL = ( SY-SCOLS - SA_POPUP_WIDTH ) DIV 2.
1847     IF SA_START_COL < 1.
1848       SA_START_COL = 1.
1849     ENDIF.
1850     SA_START_ROW  = 4. "( SY-SROWS - SA_POPUP_LENGTH ) DIV 2.
1851
1852     IF SY-LSIND = 0.
1853   *   Aufruf vom Selektionsbild => Anzeige über FB
1854       CALL FUNCTION 'MC_LIST_POPUP'
1855            EXPORTING
1856                 I_FORMNAME1    = ' '
1857                 I_FORMNAME2    = 'STD_DRILLDOWN_AUSGEBEN'
1858                 I_POPUP_LENGTH = SA_POPUP_LENGTH
1859                 I_POPUP_LINSZ  = SA_POPUP_WIDTH
1860                 I_POPUP_TITLE  = HLP_TEXT1
1861                 I_POPUP_WIDTH  = SA_POPUP_WIDTH
1862                 I_PROGNAME     = LIS_PROGNAME
1863                 I_START_COLUMN = SA_START_COL
1864                 I_START_ROW    = SA_START_ROW.
1865     ELSE.
1866   *   Aufruf von Liste => direkte Anzeige
1867
1868   *   Endpunkte des Fensters ermitteln
1869       SA_END_COL = SA_START_COL + SA_POPUP_WIDTH.
1870       SA_END_ROW = SA_START_ROW + SA_POPUP_LENGTH.
1871       PERFORM PF_STATUS_SETZEN
1872                   USING
1873                      SPACE
1874                      '000'
1875                      HLP_TEXT1.
1876       WINDOW  STARTING AT SA_START_COL SA_START_ROW
1877               ENDING   AT SA_END_COL   SA_END_ROW.
1878       NEW-PAGE LINE-SIZE SA_POPUP_WIDTH.
1879       PERFORM STD_DRILLDOWN_AUSGEBEN.
1880     ENDIF.
1881   ENDFORM.                               "STD_DRILLDOWN_ANZEIGEN
1882
1883
1884   *---------------------------------------------------------------------*
1885   *       FORM STD_DRILLDOWN_AUSGEBEN                                   *
1886   *---------------------------------------------------------------------*
1887   *       Ausgabe des Standardaufrisses in einer Liste                  *
1888   *---------------------------------------------------------------------*
1889   FORM STD_DRILLDOWN_AUSGEBEN.
1890
1891     DATA: SA_ZAEHLER LIKE SY-TABIX,
1892           lf_num     LIKE SY-TABIX,
1893           lf_len     LIKE SY-FDPOS.
1894
1895     IF GF_ACC_INIT = FALSE.
1896         CALL FUNCTION 'GET_ACCESSIBILITY_MODE'
1897      IMPORTING
1898        ACCESSIBILITY           = gf_acc_on
1899      EXCEPTIONS
1900        ITS_NOT_AVAILABLE       = 1
1901        OTHERS                  = 2
1902              .
1903       gf_acc_init = true.
1904     ENDIF.
1905
1906     FORMAT INTENSIFIED OFF.
1907     SKIP.
1908     CLEAR lf_num.
1909     LOOP AT STD_DRILLDOWN.
1910       ADD 1 TO lf_num.
1911       SA_ZAEHLER = SY-TABIX - 2.
1912       read table drilldown_fcodes with key fcode = std_drilldown-fcode.
1913   *   BINARY SEARCH hier nicht möglich, da auf Selektionsbild die Tabelle
1914   *   DRILLDOWN_FCODES noch nicht sortiert ist
1915       IF SY-SUBRC = 0.
1916         IF gf_acc_on IS INITIAL.
1917           DO SA_ZAEHLER TIMES.
1918             WRITE '  '.
1919           ENDDO.
1920           IF SA_ZAEHLER > -1.
1921             WRITE: SY-VLINE, / SY-VLINE UNDER SY-VLINE NO-GAP,
1922             '--' NO-GAP  .
1923           ENDIF.
1924   *      WRITE (20) DRILLDOWN_FCODES-SCRTEXT_L NO-GAP.
1925           PERFORM write_at USING sy-colno 20
1926                                  drilldown_fcodes-scrtext_l ' ' true.
1927           NEW-LINE.
1928         ELSE.
1929           WRITE lf_num TO gf_linebuf.
1930           CONDENSE gf_linebuf NO-GAPS.
1931           CONCATENATE gf_linebuf '.' INTO gf_linebuf.
1932   *        lf_len = STRLEN( gf_linebuf ).
1933   *        WRITE: AT (lf_len) gf_linebuf,
1934   *                 (20) DRILLDOWN_FCODES-SCRTEXT_L NO-GAP, /.
1935           PERFORM write_at USING sy-colno 3 gf_linebuf ' ' false.
1936           PERFORM write_at USING sy-colno 20
1937                                  drilldown_fcodes-scrtext_l ' ' true.
1938           NEW-LINE.
1939         ENDIF.
1940       ENDIF.
1941     ENDLOOP.
1942   ENDFORM.                               "STD_DRILLDOWN_AUSGEBEN
