416    *---------------------------------------------------------------------*
417    *       FORM KENNZAHLEN_LESEN                                         *
418    *---------------------------------------------------------------------*
419    *       Voreingestellte Kennzahlen für den Benutzer SY-UNAME und die  *
420    *       Analyse KE_MCANA in der Applikation KE_MCAPP ermitteln        *
421    *---------------------------------------------------------------------*
422    FORM KENNZAHLEN_LESEN.
423      DATA: KL_UNAME LIKE SY-UNAME.
424
425    * Tabelle mit voreingestellen Kennzahlen für Aufruf über LIB
426      DATA: BEGIN OF MEMORYTAB OCCURS 50.  "Info-Set für MEMORY
427              INCLUDE STRUCTURE MCINFOSET.
428      DATA: END OF MEMORYTAB.
429    * Tabelle mit voreingestellen Kennzahlen für Aufruf über LIB
430      data: begin of lib_memorytab occurs 50.  "Info-Set für MEMORY
431              include structure mcinfoset.
432      data: end of lib_memorytab.
433    * Kennzahlen, die über das Memory mitgegeben wurden
434      DATA: BEGIN OF KL_FIGURES_MEMORY OCCURS 30.
435              INCLUDE STRUCTURE MCS03.
436      DATA: END OF KL_FIGURES_MEMORY.
437    * Kennzahlen, die über das Memory mitgegeben wurden
438      data: begin of lib_akt_kennzahlen occurs 30.
439              include structure akt_kennzahlen.
440      data: end of lib_akt_kennzahlen.
441
442
443      DATA: KL_ADD_FIG.            "Flag, ob Memory-Kennzahlen zusätzlich zu
444                                           "Benutzer-/Standardeinstellungen
445      REFRESH  AKT_KENNZAHLEN.
446      CLEAR    AKT_KENNZAHLEN.
447
448    * Kennzahlvoreinstellungen der LIB aus dem Memory lesen
449      import: lib_memorytab      from memory id 'LIBCALL_MEM',
450              lib_akt_kennzahlen from memory id 'LIBCALL_AKT',
451              flg_lib_aufruf     from memory id 'LIBCALL_FLG'.
452
453    * Kennzahlen nur lesen, wenn sie beim LIB-Aufruf noch nicht aus dem
454    * Memory gelesen wurden. (Dieses ist beim 2. Aufruf der Routine möglich)
455      IF FLG_LIB_AUFRUF <> TRUE.                            " <= note 95291
456    * Kennzahlvoreinstellungen der LIB aus dem Memory lesen
457        IMPORT MEMORYTAB FROM MEMORY ID 'INFOSET'.
458        DESCRIBE TABLE MEMORYTAB LINES SY-TFILL.
459        IF SY-TFILL > 0.
460    *   Kennzahlen über Info-Set eingestellt => Übernahme in AKT_KENNZAHLEN
461          FLG_LIB_AUFRUF = TRUE.
462          LOOP AT MEMORYTAB.
463            AKT_KENNZAHLEN-TABNAME   = MEMORYTAB-LRTAB.
464            AKT_KENNZAHLEN-FIELDNAME = MEMORYTAB-LRNAM.
465            LIB_MEMORYTAB-LRTAB          = MEMORYTAB-LRTAB.
466            LIB_MEMORYTAB-LRNAM          = MEMORYTAB-LRNAM.
467            LIB_AKT_KENNZAHLEN-TABNAME   = MEMORYTAB-LRTAB.
468            LIB_AKT_KENNZAHLEN-FIELDNAME = MEMORYTAB-LRNAM.
469            APPEND: AKT_KENNZAHLEN,
470                    LIB_MEMORYTAB,
471                    LIB_AKT_KENNZAHLEN.
472          ENDLOOP.
473          CLEAR MEMORYTAB.
474    *   MEMORYTAB für späteren Aufruf zurücksetzen
475          EXPORT: MEMORYTAB TO MEMORY ID 'INFOSET',
476                  LIB_MEMORYTAB      TO MEMORY ID 'LIBCALL_MEM',
477                  LIB_AKT_KENNZAHLEN TO MEMORY ID 'LIBCALL_AKT',
478                  FLG_LIB_AUFRUF     TO MEMORY ID 'LIBCALL_FLG'.
479        ELSE.
480    *   Keine Kennzahlen über Info-Set eingestellt => Kennzahlen aus TMC8
481
482    *   Über das Memory mitgegebene Kennzahlen lesen
483          IMPORT FIGURES TO KL_FIGURES_MEMORY
484                 ADD_FIG TO KL_ADD_FIG
485            FROM MEMORY ID 'MC_FIGURES'.
486          DESCRIBE TABLE KL_FIGURES_MEMORY LINES SY-TFILL.
487          IF SY-TFILL > 0.
488            LOOP AT KL_FIGURES_MEMORY.
489    *       Kennz. wurden über das Memory mitgegeben => Kennzahlinfo lesen
490              READ TABLE KENNZAHLEN_TAB
491                           WITH KEY FIELDNAME = KL_FIGURES_MEMORY-FIELDNAME.
492              IF SY-SUBRC = 0.
493    *         Kennzahl übernehmen
494                MOVE-CORRESPONDING KENNZAHLEN_TAB TO AKT_KENNZAHLEN.
495              ELSE.
496                CLEAR AKT_KENNZAHLEN.
497              ENDIF.
498              IF NOT AKT_KENNZAHLEN-FIELDNAME IS INITIAL.
499    *         Kennzahl übernehmen
500                APPEND AKT_KENNZAHLEN.
501              ENDIF.
502            ENDLOOP.
503          ENDIF.
504          READ TABLE AKT_KENNZAHLEN INDEX 1.
505          IF KL_ADD_FIG = TRUE OR SY-SUBRC <> 0.
506    *     Benutzereinstellungen sollten hinzugefügt werden oder das
507    *     Kennzahl-Mapping hat zu keinem Ergebnis geführt
508            KL_UNAME = SY-UNAME.
509    *     Benutzerabhängige Voreinstellung lesen. Falls diese nicht vorhand
510    *     ist, wird im 2. Schleifendurchlauf die Standardeinstellung gelesen
511            DO 2 TIMES.
512              SELECT        * FROM  TMC8
513                     WHERE  UNAME       = KL_UNAME
514                     AND    MCAPP       = AKT_TMC7-MCAPP
515                     AND    MCANA       = AKT_TMC7-MCANA.
516    *         Überprüfen, ob die Kennzahlen bereits aus Memory übernommen
517    *         wurde
518              READ TABLE AKT_KENNZAHLEN WITH KEY FIELDNAME = TMC8-FIELDNAME.
519
520                AKT_KENNZAHLEN-TABNAME   = TMC8-TABNAME.
521                AKT_KENNZAHLEN-FIELDNAME = TMC8-FIELDNAME.
522                AKT_KENNZAHLEN-FACTOR    = TMC8-FACTOR.
523                AKT_KENNZAHLEN-ODECIMALS = TMC8-ODECIMALS.
524                APPEND AKT_KENNZAHLEN.
525              ENDSELECT.
526              IF SY-SUBRC = 0.
527    *         Benutzerabhängige Voreinstellung vorhanden
528                EXIT.
529              ELSE.
530                IF KL_UNAME = SY-UNAME.
531    *           Standardeinstellung lesen, da keine Benutzereinst. vorhanden
532                  KL_UNAME = CON_STD_UNAME.
533                ELSE.
534    *           auch keine Standardeinst. vorhanden => die ersten 6
535    *           Kennzahlen der Info-Struktur werden uebernommen
536                  DESCRIBE TABLE AKT_KENNZAHLEN LINES SY-TFILL.
537                  IF SY-TFILL < 6.
538                    SELECT * FROM TMC1D WHERE GSTRU = GSTRU
539                                          AND SFEIN <> SPACE.
540    *               Überprüfen, ob die Kennzahlen bereits aus Memory über-
541    *               nommen wurde
542                      READ TABLE AKT_KENNZAHLEN
543                        WITH KEY FIELDNAME = TMC1D-STFNA.
544                      CHECK SY-SUBRC <> 0.
545
546                      AKT_KENNZAHLEN-TABNAME   = GSTRU.
547                      AKT_KENNZAHLEN-FIELDNAME = TMC1D-STFNA.
548                      APPEND AKT_KENNZAHLEN.
549                      IF SY-TABIX >= 6.
550                        EXIT.
551                      ENDIF.
552                    ENDSELECT.
553                  ENDIF.
554                ENDIF.
555              ENDIF.
556            ENDDO.
557          ENDIF.
558        ENDIF.
559
560    * Berechtigungsprüfung der voreingestellten Kennzahlen
561        PERFORM KENNZAHLEN_UEBERPRUEFEN.
562
563    * Gelesene Kennzahlen verarbeiten
564        PERFORM KENNZAHLEN_VERARBEITEN.
565      ELSE.
566        LOOP AT LIB_AKT_KENNZAHLEN.
567          READ TABLE KENNZAHLEN_TAB          WITH KEY
568                                 TABNAME   = LIB_AKT_KENNZAHLEN-TABNAME.
569          IF SY-SUBRC                     <> 0.
570            READ TABLE KENNZAHLEN_TAB        WITH KEY
571                              TABNAME      = KENNZAHLEN_TAB-TABNAME
572                              FIELDNAME    = LIB_AKT_KENNZAHLEN-FIELDNAME.
573            IF SY-SUBRC = 0.
574              MOVE KENNZAHLEN_TAB            TO AKT_KENNZAHLEN.
575              APPEND                         AKT_KENNZAHLEN.
576            ENDIF.
577          ELSE.
578            MOVE LIB_AKT_KENNZAHLEN[]        TO AKT_KENNZAHLEN[].
579          ENDIF.
580        ENDLOOP.
581    *   Berechtigungsprüfung der voreingestellten Kennzahlen
582        PERFORM KENNZAHLEN_UEBERPRUEFEN.
583
584    *   Gelesene Kennzahlen verarbeiten
585        PERFORM KENNZAHLEN_VERARBEITEN.
586
587      ENDIF.
588      PERFORM STORE_ACT_FIGURES IN PROGRAM (LIS_PROGNAME) IF FOUND.
589    ENDFORM.                               "KENNZAHLEN_LESEN
