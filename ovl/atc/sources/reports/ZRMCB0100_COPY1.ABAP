424            IF ac_inttab-spwoc EQ akt_woc OR ac_inttab-spwoc IS INITIAL.
425              ac_austab-mbwbest = ac_austab-mbwbest + ac_inttab-mbwbest.
426              ac_austab-mkobest = ac_austab-mkobest + ac_inttab-mkobest.
427              ac_austab-wbwbest = ac_austab-wbwbest + ac_inttab-wbwbest.
