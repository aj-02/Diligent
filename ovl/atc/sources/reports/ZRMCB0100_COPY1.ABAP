1244         XXL_SEMANTIK-COL_OPS = 'ADD'.
1245       ELSE.
1246         XXL_SEMANTIK-COL_OPS = 'NOP'.
1247       ENDIF.
1248       ADD 1 TO XXL_SEMANTIK-COL_NO.
1249   *   perform xxl_feldindex_bestimmen using    akt_kennzahlen-fieldname
1250       PERFORM XXL_FELDINDEX_BESTIMMEN USING    XXL_KENNZAHLEN-FIELDNAME
1251                                       CHANGING XXL_SEMANTIK-COL_SRC.
1252       APPEND XXL_SEMANTIK.
1253       IF XXL_KENNZAHLEN-REFLEN <> 0.
1254   *     Kennzahl hat Einheit => Semantik für Einheitenspalte anhängen
1255         XXL_SEMANTIK-COL_TYP = 'STR'.
1256         XXL_SEMANTIK-COL_OPS = 'DFT'.
1257         ADD 1 TO XXL_SEMANTIK-COL_NO.
1258         ADD 1 TO XXL_SEMANTIK-COL_SRC.
1259         APPEND XXL_SEMANTIK.
1260       ENDIF.
1261     ENDLOOP.
1262   ENDFORM.                               "XXL_SEMANTIK_FUELLEN
