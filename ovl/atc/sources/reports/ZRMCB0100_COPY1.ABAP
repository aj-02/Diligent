191    FORM OBJEKTTEXT_PREFETCH TABLES OP_MERKMALSTAB  STRUCTURE AUSTAB_GLOBAL
192                             USING  OP_DOMNAME      TYPE      DOMNAME
193                                    OP_DRILLDOWN_NR TYPE      I.
194
195    * Eintrag erfolgt nur, wennn Prefetch auf Grundliste durchgeführt wird
196      STATICS: OP_DOMNAME_TAB LIKE DFIES-DOMNAME OCCURS 3 WITH HEADER LINE.
197      CONSTANTS: CON_DOMNAME_MATNR LIKE DFIES-DOMNAME  VALUE 'MATNR',
198                 CON_DOMNAME_LIFNR LIKE DFIES-DOMNAME  VALUE 'LIFNR',
199                 CON_DOMNAME_KUNNR LIKE DFIES-DOMNAME  VALUE 'KUNNR'.
200    * Übergabetabellen für Prefetch-Funktionsbausteine
201      DATA: BEGIN OF PREFETCH_TAB_MATNR OCCURS 0.
202              INCLUDE STRUCTURE PRE03.
203      DATA: END OF PREFETCH_TAB_MATNR.
204      DATA: BEGIN OF PREFETCH_TAB_LIFNR OCCURS 0,
205              LIFNR LIKE LFA1-LIFNR,
206            END OF PREFETCH_TAB_LIFNR.
207      DATA: BEGIN OF PREFETCH_TAB_KUNNR OCCURS 0,
208              KUNNR LIKE KNA1-KUNNR,
209            END OF PREFETCH_TAB_KUNNR.
210
211      IF FLG_OBJEKTTEXT = CON_OBJEKTTEXT_TEXT OR
212         FLG_OBJEKTTEXT = CON_OBJEKTTEXT_NR_TEXT.
213    *   Textuelle Aufbereitung der Nummern gewünscht
214        READ TABLE OP_DOMNAME_TAB WITH KEY OP_DOMNAME.
215        IF SY-SUBRC <> 0.
216    *     Prefetch noch nicht auf der Grundliste gemacht, d.h. es sind noch
217    *     nicht alle Materialien, Lieferanten bzw. Kunden gelesen
218          CASE OP_DOMNAME.
219            WHEN CON_DOMNAME_MATNR.
220    *         AUSTAB enthält Materialnummern
221              LOOP AT OP_MERKMALSTAB.
222                PREFETCH_TAB_MATNR-MATNR = OP_MERKMALSTAB-OBJEKT.
223                APPEND PREFETCH_TAB_MATNR.
224              ENDLOOP.
225              CALL FUNCTION 'MATERIAL_PRE_READ_MAKT'
226    *            EXPORTING
227    *                 KZRFB = E01
228                   TABLES
229                        IPRE03 = PREFETCH_TAB_MATNR.
230              IF OP_DRILLDOWN_NR = 1.
231    *           Prefetch für die Grundliste gemacht
232                APPEND OP_DOMNAME TO OP_DOMNAME_TAB.
233              ENDIF.
234            WHEN CON_DOMNAME_LIFNR.
235    *         AUSTAB enthält Lieferantennummern
236              LOOP AT OP_MERKMALSTAB.
237                PREFETCH_TAB_LIFNR-LIFNR = OP_MERKMALSTAB-OBJEKT.
238                APPEND PREFETCH_TAB_LIFNR.
239              ENDLOOP.
240              CALL FUNCTION 'MC_VENDOR_TEXT_ARRAY_READ'
241                   TABLES
242                        T_LIFNR = PREFETCH_TAB_LIFNR.
243              IF OP_DRILLDOWN_NR = 1.
244    *           Prefetch für die Grundliste gemacht
245                APPEND OP_DOMNAME TO OP_DOMNAME_TAB.
246              ENDIF.
247            WHEN CON_DOMNAME_KUNNR.
248    *         AUSTAB enthält Kundennummern
249              LOOP AT OP_MERKMALSTAB.
250                PREFETCH_TAB_KUNNR-KUNNR = OP_MERKMALSTAB-OBJEKT.
251                APPEND PREFETCH_TAB_KUNNR.
252              ENDLOOP.
253              CALL FUNCTION 'MC_CUSTOMER_TEXT_ARRAY_READ'
254                   TABLES
255                        T_KUNNR = PREFETCH_TAB_KUNNR.
256              IF OP_DRILLDOWN_NR = 1.
257    *           Prefetch für die Grundliste gemacht
258                APPEND OP_DOMNAME TO OP_DOMNAME_TAB.
259              ENDIF.
260          ENDCASE.
261        ENDIF.
262      ENDIF.
263
264    ENDFORM.                               "OBJEKTTEXT_PREFETCH
