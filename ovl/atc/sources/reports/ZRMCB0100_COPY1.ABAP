119                     XF_OBJEKT              LIKE AUSTAB_GLOBAL-OBJEKT,
120                     XF_OFFSET              TYPE I.
121
122      IF XF_FLG_XXL_INTTAB = TRUE.
123    *   Datenquelle ist XXL_S000
124        XF_INTTAB_NAME = XXL_INTTAB_NAME.
125      ELSE.
126    *   Datenquelle ist INT_S000
127        XF_INTTAB_NAME = INTTAB_NAME.
128      ENDIF.
129      REPLACE '-' WITH ' ' INTO XF_INTTAB_NAME.
130      ASSIGN (XF_INTTAB_NAME) TO <XF_INTTAB>.
131      CONCATENATE XF_INTTAB_NAME '[]' INTO XF_INTTAB_NAME.
132      ASSIGN (XF_INTTAB_NAME) TO <XF_INTTAB_TAB>.
133
134      IF NOT SAV_SPERI IS INITIAL AND FLG_PERIODE_GEWAEHLT = TRUE.
135    *   Periodizität vorhanden => Trennzeichen ermitteln
136        WRITE SY-DATUM TO XF_HLP_DATUM.
137        IF XF_HLP_DATUM CS '.'.
138          XF_PERIO_TRENNER = '.'.
139        ELSEIF XF_HLP_DATUM CS '-'.
140          XF_PERIO_TRENNER = '-'.
141        ELSE.
142          XF_PERIO_TRENNER = '/'.
143        ENDIF.
144      ENDIF.
145
146    * Merkmale und ausgewählte Kennzahlen in XXL_DATA kopieren
147      REFRESH XXL_DATA.
148      CLEAR   XXL_DATA.
149      REFRESH XXL_WAEHRUNGEN.
150      IF FLG_OBJEKTTEXT = CON_OBJEKTTEXT_TEXT OR
151         FLG_OBJEKTTEXT = CON_OBJEKTTEXT_NR_TEXT.
152    *   Aktuellen Drilldown puffern
153        XF_AKT_DRILLDOWN[] = AKT_DRILLDOWN[].
154        REFRESH AKT_DRILLDOWN.
155        CLEAR   AKT_DRILLDOWN.
156    *   Für Domänenermittlung in der Textroutine akt_drilldown füllen,
157    *   da Übergabe nach Excel vom aktuellen Drilldown unabhängig ist
158        LOOP AT XXL_DATA_MERKMALE.
159          MOVE-CORRESPONDING XXL_DATA_MERKMALE TO AKT_DRILLDOWN.
160          IF XXL_DATA_MERKMALE-ANZ_MERKMALSKETTUNGEN GE 1.
161            AKT_DRILLDOWN-KETT_AKT = TRUE.
162          ENDIF.
163          APPEND AKT_DRILLDOWN.
164          CLEAR AKT_DRILLDOWN-KETT_AKT.
165        ENDLOOP.
166      ENDIF.
167    * Bei Umrechnungsfehler soll E-Message ausgegeben werden
168      FLG_UMRECH_FEHLER = TRUE.
169
170      DEFINE _WHEN_OBJEKTTEXT_ERMITTELN.
171      WHEN &1.
172        PERFORM OBJEKTTEXT_ERMITTELN USING XXL_DATA_MERKMALE-DOMNAME
173                                             XXL_DATA_MERKMALE-ROLLNAME
174                                             XXL_DATA_MERKMALE-CONVEXIT
175                                             XXL_DATA_MERKMALE-OUTPUTLEN
176                                             <INT_MERKMAL&1>
177                                       CHANGING <XXL_MERKMAL&1>.
178      END-OF-DEFINITION.
179
180    * eine Merkmalskettung
181      DEFINE _WHEN_OBJEKTTEXT_ERMITTELN_1.
182      WHEN &1.
183        XF_OBJEKT = <INT_MERKMAL&2>.
184        XF_OBJEKT+INT_OFFSET&2 = <INT_MERKMAL&1>.
185        PERFORM OBJEKTTEXT_ERMITTELN USING XXL_DATA_MERKMALE-DOMNAME
186                                             XXL_DATA_MERKMALE-ROLLNAME
187                                             XXL_DATA_MERKMALE-CONVEXIT
188                                             30
189                                             XF_OBJEKT
190                                       CHANGING <XXL_MERKMAL&1>.
191      END-OF-DEFINITION.
192
193    * zwei Merkmalskettungen
194      DEFINE _WHEN_OBJEKTTEXT_ERMITTELN_2.
195      WHEN &1.
196        XF_OBJEKT = <INT_MERKMAL&2>.
197        XF_OBJEKT+INT_OFFSET&2 = <INT_MERKMAL&3>.
198        XF_OFFSET = INT_OFFSET&2 + INT_OFFSET&3.
199        XF_OBJEKT+XF_OFFSET = <INT_MERKMAL&1>.
200        PERFORM OBJEKTTEXT_ERMITTELN USING XXL_DATA_MERKMALE-DOMNAME
201                                             XXL_DATA_MERKMALE-ROLLNAME
202                                             XXL_DATA_MERKMALE-CONVEXIT
203                                             30
204                                             XF_OBJEKT
205                                       CHANGING <XXL_MERKMAL&1>.
206      END-OF-DEFINITION.
207
208      LOOP AT <XF_INTTAB_TAB> INTO <XF_INTTAB>.
209    *   Merkmalsfelder füllen
210        LOOP AT XXL_DATA_MERKMALE.
211          IF FLG_OBJEKTTEXT = CON_OBJEKTTEXT_NR.
212    * Key zusammengesetzte Merkmalskettung nicht übergeben, da Excel
213    * vollständig aufreißt. Bei con_objekttext_nr_text nicht vermeidbar.
214            XXL_DATA_MERKMALE-ANZ_MERKMALSKETTUNGEN = 0.
215          ENDIF.
216          CASE XXL_DATA_MERKMALE-ANZ_MERKMALSKETTUNGEN.
217            WHEN 0.
218              CASE SY-TABIX.
219                  _WHEN_OBJEKTTEXT_ERMITTELN 1.
220                  _WHEN_OBJEKTTEXT_ERMITTELN 2.
221                  _WHEN_OBJEKTTEXT_ERMITTELN 3.
222                  _WHEN_OBJEKTTEXT_ERMITTELN 4.
223                  _WHEN_OBJEKTTEXT_ERMITTELN 5.
224                  _WHEN_OBJEKTTEXT_ERMITTELN 6.
225                  _WHEN_OBJEKTTEXT_ERMITTELN 7.
226                  _WHEN_OBJEKTTEXT_ERMITTELN 8.
227                  _WHEN_OBJEKTTEXT_ERMITTELN 9.
228              ENDCASE.
229            WHEN 1.
230              CASE SY-TABIX.
231                  _WHEN_OBJEKTTEXT_ERMITTELN_1 1 10.
232                  _WHEN_OBJEKTTEXT_ERMITTELN_1 2 11.
233                  _WHEN_OBJEKTTEXT_ERMITTELN_1 3 12.
234                  _WHEN_OBJEKTTEXT_ERMITTELN_1 4 13.
235                  _WHEN_OBJEKTTEXT_ERMITTELN_1 5 14.
236                  _WHEN_OBJEKTTEXT_ERMITTELN_1 6 15.
237                  _WHEN_OBJEKTTEXT_ERMITTELN_1 7 16.
238                  _WHEN_OBJEKTTEXT_ERMITTELN_1 8 17.
239                  _WHEN_OBJEKTTEXT_ERMITTELN_1 9 18.
240              ENDCASE.
241            WHEN 2.
242              CASE SY-TABIX.
243                  _WHEN_OBJEKTTEXT_ERMITTELN_2 1 10 19.
244                  _WHEN_OBJEKTTEXT_ERMITTELN_2 2 11 20.
245                  _WHEN_OBJEKTTEXT_ERMITTELN_2 3 12 21.
246                  _WHEN_OBJEKTTEXT_ERMITTELN_2 4 13 22.
247                  _WHEN_OBJEKTTEXT_ERMITTELN_2 5 14 23.
248                  _WHEN_OBJEKTTEXT_ERMITTELN_2 6 15 24.
249                  _WHEN_OBJEKTTEXT_ERMITTELN_2 7 16 25.
250                  _WHEN_OBJEKTTEXT_ERMITTELN_2 8 17 26.
251                  _WHEN_OBJEKTTEXT_ERMITTELN_2 9 18 27.
252              ENDCASE.
253          ENDCASE.
254        ENDLOOP.
255
256        IF NOT SAV_SPERI IS INITIAL AND FLG_PERIODE_GEWAEHLT = TRUE.
257    *     Periodizität vorhanden => Periode füllen mit R/3-Trennzeichen
258    *     füllen (Abfrage ist nur bei Kapa-Bedarfsliste relevant)
259
260          XF_HLP_INT_PERIODE = <INT_PERIODE>.
261          CASE SAV_SPERI.
262            WHEN CON_SPERI_SPTAG.
263              xf_hlp_int_tag = <int_periode>.
264              write xf_hlp_int_tag to xf_hlp_xxl_periode.
265              <xxl_periode> = xf_hlp_xxl_periode.
266            WHEN CON_SPERI_SPWOC OR CON_SPERI_SPMON OR CON_SPERI_SPBUP.
267              write <int_periode> to xf_hlp_xxl_periode.
268              <xxl_periode> = xf_hlp_xxl_periode.
269          ENDCASE.
270        ENDIF.
271
272    *   Kennzahlen füllen
273        DEFINE _WHEN_XXL_KENNZAHL_FUELLEN.
274        WHEN &1.
275          PERFORM XXL_KENNZAHL_FUELLEN
276                  USING    <INT_KENNZAHL&1> <INT_EINHEIT&1> SY-TABIX
277                  CHANGING <XXL_KENNZAHL&1>.
278        END-OF-DEFINITION.
279
280        LOOP AT XXL_KENNZAHLEN.
281          CASE SY-TABIX.
282              _WHEN_XXL_KENNZAHL_FUELLEN 1.
283              _WHEN_XXL_KENNZAHL_FUELLEN 2.
284              _WHEN_XXL_KENNZAHL_FUELLEN 3.
285              _WHEN_XXL_KENNZAHL_FUELLEN 4.
286              _WHEN_XXL_KENNZAHL_FUELLEN 5.
287              _WHEN_XXL_KENNZAHL_FUELLEN 6.
288              _WHEN_XXL_KENNZAHL_FUELLEN 7.
289              _WHEN_XXL_KENNZAHL_FUELLEN 8.
290              _WHEN_XXL_KENNZAHL_FUELLEN 9.
291              _WHEN_XXL_KENNZAHL_FUELLEN 10.
292              _WHEN_XXL_KENNZAHL_FUELLEN 11.
293              _WHEN_XXL_KENNZAHL_FUELLEN 12.
294              _WHEN_XXL_KENNZAHL_FUELLEN 13.
295              _WHEN_XXL_KENNZAHL_FUELLEN 14.
296              _WHEN_XXL_KENNZAHL_FUELLEN 15.
297              _WHEN_XXL_KENNZAHL_FUELLEN 16.
298              _WHEN_XXL_KENNZAHL_FUELLEN 17.
299              _WHEN_XXL_KENNZAHL_FUELLEN 18.
300              _WHEN_XXL_KENNZAHL_FUELLEN 19.
301              _WHEN_XXL_KENNZAHL_FUELLEN 20.
302              _WHEN_XXL_KENNZAHL_FUELLEN 21.
303              _WHEN_XXL_KENNZAHL_FUELLEN 22.
304              _WHEN_XXL_KENNZAHL_FUELLEN 23.
305              _WHEN_XXL_KENNZAHL_FUELLEN 24.
