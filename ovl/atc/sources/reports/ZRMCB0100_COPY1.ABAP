874    *---------------------------------------------------------------------*
875    *       FORM ZEITREIHE_DRUCKEN                                        *
876    *---------------------------------------------------------------------*
877    *       Ausdruck der Zeitreihe.                                       *
878    *---------------------------------------------------------------------*
879    FORM ZEITREIHE_DRUCKEN.
880
881      DATA: ZD_SAV_ZEITREIHEN_ERSTE_SPALTE  TYPE I,
882            ZD_SAV_ZEITREIHEN_ANZ_SPALTEN   TYPE I,
883            ZD_SAV_ZEITREIHEN_POPUP_WIDTH   TYPE I,
884            ZD_ANZ_PERIODEN                 TYPE I,
885            ZD_HLP_ZAEHLER                  TYPE I.
886
887    * Globale Variablen sichern (werden in SEITENKOPF_ZEITREIHE_AUSGEBEN
888    * benutzt!)
889      ZD_SAV_ZEITREIHEN_ERSTE_SPALTE = ZEITREIHEN_ERSTE_SPALTE.
890      ZD_SAV_ZEITREIHEN_ANZ_SPALTEN  = ZEITREIHEN_ANZ_SPALTEN.
891      ZD_SAV_ZEITREIHEN_POPUP_WIDTH  = ZEITREIHEN_POPUP_WIDTH.
892      ZEITREIHEN_ERSTE_SPALTE = 1.
893      DESCRIBE TABLE ZEIT_PERIODEN LINES ZD_ANZ_PERIODEN.
894
895    * Maximale Druckspaltenbreite unterscheidet sich von der maximalen
896    * Ausgabebreite auf dem Bildschirm                    <= note 416638
897      ZEITREIHEN_ANZ_SPALTEN = ( 255 - STRICH_ANFANG ) DIV
898                               ( ZEITREIHEN_SPALTEN_BREITE + 1 ).
899      IF ZEITREIHEN_ANZ_SPALTEN > ZD_ANZ_PERIODEN.
900    *   mehr Spalten anzeigbar als nötig
901        ZEITREIHEN_ANZ_SPALTEN = ZD_ANZ_PERIODEN.
902      ENDIF.
903    * Fensterbreite kann so nicht mehr überschritten werden !
904      ZEITREIHEN_POPUP_WIDTH = STRICH_ANFANG + ZEITREIHEN_ANZ_SPALTEN *
905                               ( ZEITREIHEN_SPALTEN_BREITE + 1 ).
906
907      CLEAR ZEITREIHEN_DRUCK_SPALTE.
908      WHILE ZEITREIHEN_ERSTE_SPALTE <= ZD_ANZ_PERIODEN.
909    *   Seitenzahlen zum Drucken initialiseiern
910        CLEAR ZEITREIHEN_DRUCK_SEITE.
911        ZEITREIHEN_DRUCK_SPALTE = ZEITREIHEN_DRUCK_SPALTE + 1.
912        PERFORM ZEITREIHE_AUSGEBEN USING ZEITREIHEN_ERSTE_SPALTE
913                                         ZEITREIHEN_ANZ_SPALTEN.
914        ZEITREIHEN_ERSTE_SPALTE = ZEITREIHEN_ERSTE_SPALTE +
915                                  ZEITREIHEN_ANZ_SPALTEN.
916
917        ZD_HLP_ZAEHLER = ZEITREIHEN_ERSTE_SPALTE +
918                         ZEITREIHEN_ANZ_SPALTEN - 1.
919        IF ZD_HLP_ZAEHLER > ZD_ANZ_PERIODEN.
920    *     Auf der letzten Seite nicht alle Spalten drucken, sondern
921    *     nur die Spalten, die noch nicht gedruckt wurden
922          ZEITREIHEN_ANZ_SPALTEN = ZD_ANZ_PERIODEN -
923                                   ZEITREIHEN_ERSTE_SPALTE + 1.
924          ZEITREIHEN_POPUP_WIDTH = STRICH_ANFANG + ZEITREIHEN_ANZ_SPALTEN *
925                                   ( ZEITREIHEN_SPALTEN_BREITE + 1 ).
926        ENDIF.
927
928      ENDWHILE.
929
930    * Werte wieder zurückschreiben
931      ZEITREIHEN_ERSTE_SPALTE = ZD_SAV_ZEITREIHEN_ERSTE_SPALTE.
932      ZEITREIHEN_ANZ_SPALTEN  = ZD_SAV_ZEITREIHEN_ANZ_SPALTEN.
933      ZEITREIHEN_POPUP_WIDTH  = ZD_SAV_ZEITREIHEN_POPUP_WIDTH.
934
935    ENDFORM.                               "ZEITREIHE_DRUCKEN
