2814   *---------------------------------------------------------------------*
2815   *       FORM PERIO_UND_LGORT_FUELLEN                                  *
2816   *---------------------------------------------------------------------*
2817   *       Füllen der Rangestabelle PERIO und LGORT                      *
2818   *---------------------------------------------------------------------*
2819   FORM perio_und_lgort_fuellen.
2820
2821   *Füllen Rangestabelle PERIO
2822   *Entweder ist Aufriß nach Periode erfolgt oder Cursor steht auf Periode
2823     CLEAR perio.
2824     REFRESH perio.
2825
2826   * Tag
2827     IF ori_detail-flg_sptag = true.
2828       perio-low = ori_detail-sptag.
2829       perio-high = perio-low.
2830       perio-option = 'EQ'.
2831       perio-sign   = 'I'.
2832       APPEND perio.
2833     ENDIF.
2834
2835   * Monat
2836     IF ori_detail-flg_spmon = true.
2837       perio-low+6(2) = '01'.
2838       perio-low+4(2) =  ori_detail-spmon+4(2).
2839       perio-low(4)   =  ori_detail-spmon(4).
2840   *Für den High-wert wird zunächst der 1.Tag des neuen Monats ermittelt,
2841   *anschließend wird davon ein Tag subtrahiert.
2842       perio-high+6(2) = '01'.
2843       perio-high+4(2) = perio-low+4(2) + 1.
2844       IF perio-high+4(2) = '13'.
2845         perio-high+4(2) = '01'.
2846         perio-high(4) = perio-low(4) + 1.
2847       ELSE.
2848         perio-high(4) = perio-low(4).
2849       ENDIF.
2850       perio-high = perio-high - 1.
2851       IF perio-high GT sy-datlo.
2852         perio-high = sy-datlo.
2853       ENDIF.
2854       perio-option = 'BT'.
2855       perio-sign   = 'I'.
2856       APPEND perio.
2857     ENDIF.
2858
2859   * Woche
2860     IF ori_detail-flg_spwoc = true.
2861       CALL FUNCTION 'WEEK_GET_FIRST_DAY'
2862         EXPORTING
2863           week = ori_detail-spwoc
2864         IMPORTING
2865           date = perio-low.
2866       perio-high = perio-low + 6.
2867       IF perio-high GT sy-datlo.
2868         perio-high = sy-datlo.
2869       ENDIF.
2870       perio-option = 'BT'.
2871       perio-sign   = 'I'.
2872       APPEND perio.
2873     ENDIF.
2874
2875   * Buchungsperiode
2876   *Detailinfos koennen nur sinnvoll ausgegeben werden bei einer einzigen
2877   *einheitlichen Geschäftsjahresvariante. Die Variable PERIVAR ist belegt,
2878   *wenn in der TMC4 die Gjvariante voreingestellt ist.
2879     IF sav_speri = con_speri_spbup.
2880       IF perivar = space.
2881   *Gjvariante nicht voreingestellt
2882   *Pruefen, ob Werk eindeutig.
2883         IF ori_detail-werks NE space.
2884
2885           SELECT SINGLE * FROM t001w WHERE werks = ori_detail-werks.
2886           IF sy-subrc = 0.
2887             hlp_bwkey = t001w-bwkey.
2888           ENDIF.
2889
2890           SELECT SINGLE * FROM t001k WHERE bwkey = hlp_bwkey.
2891           IF sy-subrc = 0.
2892             hlp_bukrs = t001k-bukrs.
2893           ENDIF.
2894
2895           SELECT SINGLE * FROM t001 WHERE bukrs = hlp_bukrs.
2896           IF sy-subrc = 0.
2897             perivar = t001-periv.
2898           ENDIF.
2899         ELSE.
2900   *Detailinfos nicht möglich , da Analyse werksübergreifend ist und
2901   *Zuordnung zur Geschäftsjahresvariante nicht möglich
2902           MESSAGE e382.
2903         ENDIF.
2904       ENDIF.
2905     ENDIF.
2906     IF ori_detail-flg_spbup = true.
2907       PERFORM period_day_determine.
2908       perio-low = hlp_low.
2909       perio-high = hlp_high.
2910       IF perio-high GT sy-datlo.
2911         perio-high = sy-datlo.
2912       ENDIF.
2913       perio-option = 'BT'.
2914       perio-sign   = 'I'.
2915       APPEND perio.
2916     ENDIF.
2917
2918     READ TABLE perio INDEX 1.
2919     IF sy-subrc <> 0.
2920   *Es ist kein Aufriß nach Periode erfolgt bzw. Cursor steht nicht auf
2921   *Periode. Die Rangestabelle PERIO wird aus der Rangestabelle ZEITR
2922   *des Selektionsbildes gefüllt.
2923       PERFORM perio_fuellen_aus_selzeitr.
2924     ENDIF.
2925
2926   *Füllen Rangestabelle LGORT
2927     CLEAR lgort.
2928     REFRESH lgort.
2929
2930     IF ori_detail-flg_lgort = true.
2931       lgort-low = ori_detail-lgort.
2932       lgort-high = lgort-low.
2933       lgort-option = 'EQ'.
2934       lgort-sign   = 'I'.
2935       APPEND lgort.
2936     ELSE.
2937       LOOP AT sl_lgort.
2938         lgort = sl_lgort.
2939         APPEND lgort.
2940       ENDLOOP.
2941     ENDIF.
2942
2943   ENDFORM.                               "perio_und_lgort_fuellen
2944
2945
2946   *---------------------------------------------------------------------*
2947   *       FORM PERIOTAB_FUELLEN                                         *
2948   *---------------------------------------------------------------------*
2949   *       Füllen der Ranges-Tabelle Periotab                            *
2950   *---------------------------------------------------------------------*
2951   FORM periotab_fuellen.
2952     DATA: pf_hlp_wert LIKE periotab-high,
2953           pf_hlp_periv LIKE t009-periv.
2954
2955     flg_periotab = true.
2956   *Bestimmen Periotab-Low aus Rangestabelle ZEITR
2957     READ TABLE i_zeitr INDEX 1.
2958     IF NOT i_zeitr-low IS INITIAL.
2959       periotab-low = i_zeitr-low.
2960       APPEND periotab.
2961     ELSE.
2962   *Kleinste Periode wird aus Datenbank S031 gelesen.
2963       CASE sav_speri.
2964         WHEN con_speri_sptag.
2965           PERFORM kleinste_periode_allgemein.
2966           periotab-low = min_perio_tag.
2967         WHEN con_speri_spwoc.
2968           PERFORM kleinste_periode_allgemein.
2969           periotab-low = min_perio_woc.
2970         WHEN con_speri_spmon.
2971           PERFORM kleinste_periode_allgemein.
2972           periotab-low = min_perio_mon.
2973         WHEN con_speri_spbup.
2974           PERFORM kleinste_periode_buperiode.
2975           periotab-low = min_perio_bup.
2976       ENDCASE.
2977       APPEND periotab.
2978     ENDIF.
2979   * Ermitteln des Wertes PERIOTAB-HIGH = SY-DATUM
2980
2981   *Für Periodizität Buchungsperiode Geschäftsjahresvariante  übergeben
2982     IF sav_speri = con_speri_spbup.
2983       IF flg_periv = true.
2984   * Geschjvariante aus Voreinstellung TMC4
2985         periv = perivar.
2986       ELSE.
2987   * Es gibt mehrere Geschjvarianten - Ermittlung über BUKRS
2988         bukrs = hlp_tab-bukrs.
2989       ENDIF.
2990     ENDIF.
2991
2992     PERFORM periode_ermitteln(rmcs1000) USING  sy-datlo
2993                                                hlp_mcinf
2994                                                bukrs
2995                                      CHANGING  perio_tag
2996                                                perio_woc
2997                                                perio_mon
2998                                                perio_bup
2999                                                periv.
3000     CASE sav_speri.
3001       WHEN con_speri_sptag.
3002         IF zeitr-high GT perio_tag.
3003           periotab-high = zeitr-high.
3004         ELSE.
3005           periotab-high = perio_tag.
3006         ENDIF.
3007       WHEN con_speri_spwoc.
3008         IF zeitr-high GT perio_woc.
3009           periotab-high = zeitr-high.
3010         ELSE.
3011           periotab-high = perio_woc.
3012         ENDIF.
3013       WHEN con_speri_spmon.
3014         IF zeitr-high GT perio_mon.
3015           periotab-high = zeitr-high.
3016         ELSE.
3017           periotab-high = perio_mon.
3018         ENDIF.
3019       WHEN con_speri_spbup.
3020         IF zeitr-high GT perio_bup.
3021           periotab-high = zeitr-high.
3022         ELSE.
3023           periotab-high = perio_bup.
3024         ENDIF.
3025     ENDCASE.
3026
3027   *Aufnahme aller Perioden von PERIOTAB-LOW bis SY-DATUM
3028     WHILE periotab-low LT periotab-high.
3029       CASE sav_speri.
3030         WHEN con_speri_sptag.
3031           periotab-low = periotab-low + 1.
3032           APPEND periotab.
3033         WHEN con_speri_spmon.
3034           periotab-low+4(2) = periotab-low+4(2) + 1.
3035           IF periotab-low+4(2) = '13'.
3036             periotab-low+4(2) = '01'.
3037             periotab-low(4)   = periotab-low(4) + 1.
3038           ENDIF.
3039           APPEND periotab.
3040         WHEN con_speri_spwoc.
3041           IF periotab-low+4(2) LT '52'.
3042             periotab-low+4(2) = periotab-low+4(2) + 1.
3043             APPEND periotab.
3044           ENDIF.
3045           IF periotab-low+4(2) = '52'.
3046             PERFORM kalenderwoche_ermitteln.
3047             APPEND periotab.
3048           ELSEIF periotab-low+4(2) = '53'.
3049             periotab-low+4(2) = '01'.
3050             periotab-low(4) = periotab-low(4) + 1.
3051             APPEND periotab.
3052           ENDIF.
3053         WHEN con_speri_spbup.
3054   *Lesen Geschjvariante
3055           IF hlp_periv NE periv.
3056             hlp_periv = periv.
3057             SELECT SINGLE * FROM t009 WHERE periv = hlp_periv.
3058             PERFORM tabelle_t009_pruefen.
3059           ELSE.
3060             PERFORM tabelle_t009_pruefen.
3061           ENDIF.
3062           APPEND periotab.
3063       ENDCASE.
3064     ENDWHILE.
3065     SORT periotab BY low DESCENDING.
3066   ENDFORM.                               "periotab_fuellen
3067
