156    *       FORM SPEZIAL_MERKMALSKETTUNG                                  *
157    *---------------------------------------------------------------------*
158    *       ........                                                      *
159    *---------------------------------------------------------------------*
160    *  -->  P_MERKMALKETTUNG_TAB                                          *
161    *---------------------------------------------------------------------*
162    FORM spezial_merkmalskettung
163         TABLES p_ddown_fcodes STRUCTURE mcs04.
164
165      DATA: BEGIN OF l_tab OCCURS 0,
166              rollname LIKE dfies-rollname,
167            END   OF l_tab.
168      DATA: l_merkmalkettung TYPE merkmalkettung_rolln.
169
170    *--
171      LOOP AT drilldown_fcodes
172           WHERE domname NE 'MCPERIOD'.
173        l_tab-rollname = drilldown_fcodes-rollname.
174        APPEND l_tab.
175      ENDLOOP.
176      SORT l_tab BY rollname.
177
178      SELECT * FROM tmc7k FOR ALL ENTRIES IN l_tab
179             WHERE rolln_akt = l_tab-rollname.
180        APPEND tmc7k TO int_tmc7k.
181      ENDSELECT.
182
183    *-- Merkmalskettung in Drilldown_fcodes einmischen
184      LOOP AT drilldown_fcodes
185           WHERE domname NE 'MCPERIOD'.
186        READ TABLE int_tmc7k
187             WITH KEY rolln_akt = drilldown_fcodes-rollname
188                      nr        = '01'.
189        IF sy-subrc EQ 0.
190          drilldown_fcodes-rollname01 = int_tmc7k-rolln_akt.
191          drilldown_fcodes-kett_akt   = true.
192          MODIFY drilldown_fcodes.
193        ENDIF.
194      ENDLOOP.
195
196    * Hinw. 383548: Merkmalskettung wieder löschen, wenn nicht alle
197    *               übergeordneten Merkmale in der Infostruktur
198      LOOP AT int_tmc7k.
199        READ TABLE drilldown_fcodes WITH KEY
200                          rollname = int_tmc7k-rolln_add.
201        IF sy-subrc <> 0.
202          READ TABLE drilldown_fcodes WITH KEY
203                          rollname = int_tmc7k-rolln_akt.
204          IF sy-subrc EQ 0.
205            drilldown_fcodes-kett_akt = false.
206            MODIFY drilldown_fcodes INDEX sy-tabix.
207          ENDIF.
208        ENDIF.
209      ENDLOOP.
210
211    ENDFORM.                    "SPEZIAL_MERKMALSKETTUNG
