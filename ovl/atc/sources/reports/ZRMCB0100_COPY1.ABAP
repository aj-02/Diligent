29       AKT_DRILLDOWN-HITL_GROESSE    = HITLISTEN_GROESSE.
30       AKT_DRILLDOWN-HITL_KRITERIUM  = HITL_KRITERIUM.
31       AKT_DRILLDOWN-FLG_SORT_ABST   = FLG_SORT_ABST.
32       AKT_DRILLDOWN-FLG_HEADER_PATH = FLG_HEADER_PATH.
33       AKT_DRILLDOWN-FLG_OBJEKTTEXT  = FLG_OBJEKTTEXT.
34       AKT_DRILLDOWN-FLG_PROZENTWERT = FLG_PROZENTWERT.
35       AKT_DRILLDOWN-SPALTEN_ANFANG  = SPALTEN_ANFANG.
36       AKT_DRILLDOWN-SPALTEN_BREITE  = SPALTEN_BREITE.    "<- note 602938
37
38       APPEND AKT_DRILLDOWN.
39       ADD 1 TO DRILLDOWN_EINTRAEGE.
40     * Inhalt der Ausgabetabelle aktualisieren
41       FLG_AUSTAB_AKTUELL = FALSE.
42       PERFORM AUSTAB_AKTUALISIEREN.
43
44       CASE FLG_VERGLEICH.
45         WHEN CON_VERGLEICH_PLANIST OR CON_VERGLEICH_VORJAHR.
46           IF FLG_VERGLEICH = CON_VERGLEICH_VORJAHR.
47     *       Planversion auf Istdaten setzen
48             DD_SAV_PLAN_VRSIO = PLAN_VRSIO.
49             PLAN_VRSIO = SELEKTIONS_VRSIO.
50           ENDIF.
51     *     Planzahlen aus Info-Struktur nachlesen
52           IF SAV_SPZIS = 'D'.
53     *     Plandaten spezial für Bestandscontrolling
54             PERFORM PLANDATEN_INVCON_D IN PROGRAM (LIS_PROGNAME)
55                                                    IF FOUND.
56           ELSE.
57             PERFORM PLANDATEN_LESEN.
58           ENDIF.
59           IF FLG_VERGLEICH = CON_VERGLEICH_VORJAHR.
60     *       Planversion zurücksetzen
61             PLAN_VRSIO = DD_SAV_PLAN_VRSIO.
62           ENDIF.
63     *     Istzahlen und Planzahlen abgleichen
64           PERFORM PLANIST_ABGLEICH.
65         WHEN CON_VERGLEICH_KENNZAHL.
66     *     Kennzahlen abgleichen
67           PERFORM PLAN_SUM_FUELLEN.
68           PERFORM KENNZAHLEN_ABGLEICH.
69       ENDCASE.
70
71     * Vergleich im Fenster ausgeben
72       PERFORM PLANTAB_AUSGEBEN USING TRUE.
73     ENDFORM.                               "DDOWN_VERGLEICH_DURCHFUEHREN
