1691   *       FORM MERKMALSBERECHTIGUNG_PRUEFEN                             *
1692   *---------------------------------------------------------------------*
1693   *       Berechtigungsprüfung der Merkmale, die durch die Selektions-  *
1694   *       kriterien selektiert werden sollen                            *
1695   *---------------------------------------------------------------------*
1696   *  -->  mp_selopt_check   = true falls FORM beim Import einer Selek-  *
1697   *                         tionsversion aufgerufen wurde und deshalb   *
1698   *                         zu prüfen ist, ob im Custer-Exit oder bei   *
1699   *                         der SAP-Berechtigungsprüfung die Select-    *
1700   *                         Option erweitert wurde.                     *
1701   *---------------------------------------------------------------------*
1702   FORM MERKMALSBERECHTIGUNG_PRUEFEN
1703                USING MP_FLG_SELOPT_CHECK TYPE BOOLEAN.
1704     DATA: MP_FLG_END_CHECK  TYPE BOOLEAN,
1705           MP_FORMNAME       LIKE SY-XFORM,
1706           MP_SEL_NAME       LIKE RSPARAMS-SELNAME,
1707           MP_SELTAB_NAME    LIKE DFIES-TABNAME.
1708
1709     DATA: MP_FLG_SELOPT_CHANGED TYPE C.
1710   *       = true, falls ranges-Tabelle im Customer-Exit verändert wurde
1711     DATA: MP_SL_LINES_OLD TYPE I,
1712           MP_SL_LINES_NEW TYPE I.
1713     DATA: MP_FLG_MESSAGE_AU_CHECK LIKE MP_FLG_SELOPT_CHECK.
1714   *       = true wenn beim Authority-Check keine Fehlermeldung
1715   *       erzeugt werden soll
1716     FIELD-SYMBOLS: <MP_SL_RANGES_TAB> TYPE TABLE.
1717
1718
1719     CHECK FLG_LIS_REPORTING = TRUE.
1720     IF MP_FLG_SELOPT_CHECK = TRUE.
1721       MP_FLG_MESSAGE_AU_CHECK = FALSE.
1722     ELSE.
1723       MP_FLG_MESSAGE_AU_CHECK = TRUE.
1724     ENDIF.
1725   * Merkmale bzw. Kennzahlen zur Abgrenzung auf Berechtigung prüfen
1726     LOOP AT DRILLDOWN_FCODES.
1727       MP_FLG_END_CHECK = FALSE.
1728       CONCATENATE 'SL_' DRILLDOWN_FCODES-RANGES_SUF INTO MP_SEL_NAME.
1729       CONCATENATE MP_SEL_NAME '[]' INTO MP_SELTAB_NAME.
1730       ASSIGN (MP_SELTAB_NAME) TO <MP_SL_RANGES_TAB>.
1731
1732       IF DRILLDOWN_FCODES-DOMNAME = 'TPLNR'.                    "1031546
1733          DATA: l_exit_mcr00001_active LIKE SY-datar.            "1031546
1734          CALL FUNCTION 'MODX_FUNCTION_ACTIVE_CHECK'             "1031546
1735               EXPORTING                                         "1031546
1736                  CPROGNAME  = 'RMCREPAU'                        "1031546
1737                  FUNCNUMBER = '001'                             "1031546
1738               IMPORTING                                         "1031546
1739                  ACTIVE     = l_exit_mcr00001_active            "1031546
1740               EXCEPTIONS                                        "1031546
1741                  NOT_FOUND  = 1                                 "1031546
1742                  OTHERS     = 2.                                "1031546
1743          IF NOT l_exit_mcr00001_active IS INITIAL.              "1031546
1744             ASSIGN ('strno[]') TO <MP_SL_RANGES_TAB>.           "1031546
1745          ENDIF.                                                 "1031546
1746       ENDIF.                                                    "1031546
1747
1748   *   Berechtigungsprüfung über Customer-Exit
1749       PERFORM AU_CHECK_CUSTOMER_EXIT IN PROGRAM RMCREPAU
1750         TABLES   <MP_SL_RANGES_TAB>
1751         USING    HLP_MCINF
1752                  DRILLDOWN_FCODES-ROLLNAME
1753                  DRILLDOWN_FCODES-DOMNAME
1754                  MP_SEL_NAME
1755                  MP_FLG_SELOPT_CHECK
1756         CHANGING MP_FLG_END_CHECK
1757                  MP_FLG_SELOPT_CHANGED.
1758
1759       IF MP_FLG_END_CHECK = FALSE.
1760         DESCRIBE TABLE <MP_SL_RANGES_TAB> LINES MP_SL_LINES_OLD.
1761   *     Berechtigungsprüfung über SAP-Berechtigungsobjekte
1762         CONCATENATE 'AU_CHECK_' DRILLDOWN_FCODES-DOMNAME INTO MP_FORMNAME.
1763         PERFORM (MP_FORMNAME) IN PROGRAM RMCREPAU
1764           TABLES <MP_SL_RANGES_TAB>
1765           USING  HLP_MCINF
1766                  DRILLDOWN_FCODES
1767                  MP_FLG_MESSAGE_AU_CHECK
1768                  IF FOUND.
1769         DESCRIBE TABLE <MP_SL_RANGES_TAB> LINES MP_SL_LINES_NEW.
1770         IF MP_SL_LINES_NEW <> MP_SL_LINES_OLD.
1771           MP_FLG_SELOPT_CHANGED = TRUE.
1772         ENDIF.
1773
1774         IF ( MP_FLG_SELOPT_CHECK = TRUE )  AND
1775            ( MP_FLG_SELOPT_CHANGED = TRUE ).
1776   *       Im Customer-Exit oder während der SAP-Berechtigungsprüfung
1777   *       wurden aufgrund fehlender Berechtigungen die Select-Options
1778   *       erweitert. => Selektionsversion wird nicht angezeigt.
1779   *       Berechtigung fehlt, um alle Daten der Selektionsversion
1780   *       anzuzeigen.
1781           MESSAGE S127 WITH HLP_MCINF DRILLDOWN_FCODES-SCRTEXT_L.
1782           SET SCREEN 0.
1783           LEAVE SCREEN.
1784         ENDIF.
1785       ENDIF.
1786     ENDLOOP.
1787   ENDFORM.                               "MERKMALSBERECHTIGUNG_PRUEFEN
