2373   *       FORM SICHERN_ABFRAGEN                                         *
2374   *---------------------------------------------------------------------*
2375   *       Sicherheitsabfrage beim Verlassen                             *
2376   *---------------------------------------------------------------------*
2377   FORM SICHERN_ABFRAGEN.
2378     DATA: SA_TITEL(100),
2379           SA_ANTWORT,
2380           SA_RETURNCODE,
2381           SA_USER_COMMAND LIKE SY-UCOMM,
2382           SA_LENGTH TYPE I.
2383
2384     IF SAV_FCODE = 'BCK'.
2385   *   Funktion 'Zurück'.
2386       PERFORM TEXT_ERMITTELN USING    009
2387   *                                   '& zurück'
2388                              CHANGING HLP_TEXT1.
2389       SA_USER_COMMAND = 'BACK'.
2390     ELSE.
2391   *   Funktion 'Beenden'
2392       PERFORM TEXT_ERMITTELN USING    015
2393   *                                   '& beenden'
2394                              CHANGING HLP_TEXT1.
2395       SA_USER_COMMAND = '%EX'.
2396     ENDIF.
2397     SA_TITEL = HLP_TEXT1.
2398     REPLACE '&' WITH <ANALYSE_NAME> INTO SA_TITEL.
2399     SA_LENGTH = STRLEN( SA_TITEL ).
2400     IF SA_LENGTH > 35.
2401   *   Titel ist zu lang für das PopUp und muß verkürzt werden
2402       SA_TITEL = HLP_TEXT1.
2403       REPLACE '&' WITH ANALYSEMENUE_TEXT INTO SA_TITEL.
2404       CONDENSE SA_TITEL.
2405     ENDIF.
2406
2407     IF FLG_SELEKTION = TRUE AND FLG_SELEKTION_GESICHERT = FALSE.
2408   *   Selektionsreport und Selektionsdaten wurden nicht gesichert
2409       PERFORM TEXT_ERMITTELN USING     010
2410   *                          'Die selektierten Daten werden'
2411                              CHANGING HLP_TEXT1.
2412       PERFORM TEXT_ERMITTELN USING     011
2413   *                          'verlorengehen.'
2414                              CHANGING HLP_TEXT2.
2415       PERFORM TEXT_ERMITTELN USING     012
2416   *                          ''
2417                              CHANGING HLP_TEXT3.
2418       PERFORM TEXT_ERMITTELN USING     013
2419   *                          'Möchten Sie die Analyse'
2420                              CHANGING HLP_TEXT4.
2421       PERFORM TEXT_ERMITTELN USING     014
2422   *                          'vorher sichern?'
2423                              CHANGING HLP_TEXT5.
2424
2425       CALL FUNCTION 'POPUP_TO_CONFIRM_WITH_MESSAGE'
2426            EXPORTING
2427                 DEFAULTOPTION = 'J'
2428                 DIAGNOSETEXT1 = HLP_TEXT1
2429                 DIAGNOSETEXT2 = HLP_TEXT2
2430                 DIAGNOSETEXT3 = HLP_TEXT3
2431                 TEXTLINE1     = HLP_TEXT4
2432                 TEXTLINE2     = HLP_TEXT5
2433                 TITEL         = SA_TITEL
2434            IMPORTING
2435                 ANSWER        = SA_ANTWORT.
2436       CASE SA_ANTWORT.
2437         WHEN  'J'.
2438   *==== begin of insertation note 108868 ====
2439   *       Sichern SELVS aus Standardanalyse/01=Hinzufügen oder Erzeugen:
2440   *       Berechtigungsprüfung nur auf Aktion => Hinzufügen/Erzeugen
2441           AUTHORITY-CHECK OBJECT 'M_IS_SELVS' ID 'MCAPP' DUMMY
2442                                               ID 'MCINF' FIELD HLP_MCINF
2443                                               ID 'SELVS' DUMMY
2444                                               ID 'ACTVT' FIELD '01'.
2445           IF SY-SUBRC <> 0.
2446   *         Sie haben keine Berechtigung zum Anlegen
2447   *         von Selektionsversionen
2448             MESSAGE E192.
2449           ELSE.
2450   *==== end of insertation note 108868 ====
2451   *       Benutzer will vor dem Verlassen Sichern
2452             CALL FUNCTION 'MC_POPUP_SELECT_VERSION_SAVE'
2453                  EXPORTING
2454                       I_MCANA      = SPACE
2455                       I_MCAPP      = SPACE
2456                       I_RELID      = CON_MCSI_RELID_IS
2457                  IMPORTING
2458                       E_RETURNCODE = SA_RETURNCODE
2459                       E_SELVS      = MCSI-SELVS
2460                       E_SETXT      = MCSI-SETXT.
2461   *==== begin of insertation note 108868 ====
2462           ENDIF.
2463   *      Sichern SELVS aus Standardanalyse/01=Hinzufügen oder Erzeugen:
2464   *      Berechtigungsprüfung nur auf Aktion => Hinzufügen/Erzeugen
2465   *      + Namenskonvention
2466           AUTHORITY-CHECK OBJECT 'M_IS_SELVS' ID 'MCAPP' DUMMY
2467                                               ID 'MCINF' FIELD HLP_MCINF
2468                                               ID 'SELVS' FIELD MCSI-SELVS
2469                                               ID 'ACTVT' FIELD '01'.
2470
2471           IF SY-SUBRC <> 0.
2472             MESSAGE E147 WITH MCSI-SELVS.
2473           ELSE.
2474   *==== end of insertation note 108868 ====
2475             IF SA_RETURNCODE <> 'A'.
2476               PERFORM MCSI_EXPORT USING MCSI-SELVS
2477                                         MCSI-SETXT.
2478               IF FLG_SELEKTION_GESICHERT = TRUE.
2479   *             Sichern war erfolgreich
2480                 SET USER-COMMAND SA_USER_COMMAND.
2481               ENDIF.
2482             ENDIF.
2483           endif.                                        " <= note 108868
2484
2485         WHEN 'N'.
2486   *       Verlassen ohne Sichern
2487           SET USER-COMMAND SA_USER_COMMAND.
2488         WHEN 'A'.
2489           EXIT.
2490       ENDCASE.
2491     ELSE.
2492   *   Anzeigereport
2493       PERFORM TEXT_ERMITTELN USING     033
2494   *                          'Möchten Sie die Analyse beenden?'
2495                              CHANGING HLP_TEXT1.
2496       PERFORM TEXT_ERMITTELN USING     034
2497   *                          ''
2498                              CHANGING HLP_TEXT2.
2499       CALL FUNCTION 'POPUP_TO_CONFIRM_STEP'
2500            EXPORTING
2501                 DEFAULTOPTION = 'N'
2502                 TEXTLINE1     = HLP_TEXT1
2503                 TEXTLINE2     = HLP_TEXT2
2504                 TITEL         = SA_TITEL
2505            IMPORTING
2506                 ANSWER        = SA_ANTWORT.
2507       IF SA_ANTWORT = 'J'.
2508   *     Analyse beenden
2509         SET USER-COMMAND SA_USER_COMMAND.
2510       ENDIF.
2511     ENDIF.
2512   ENDFORM.                               "SICHERN_ABFRAGEN
