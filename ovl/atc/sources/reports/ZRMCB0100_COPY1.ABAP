4456             i_zeitr-option = 'GE'.
4457             i_zeitr-sign = 'I'.
4458             APPEND i_zeitr.
4459             IF i_zeitr-low IS INITIAL OR i_zeitr-low(6) = '000000'.
4460   *           clear i_zeitr-low.
4461   *           clear i_zeitr-high.
4462               CLEAR   i_zeitr.
4463               REFRESH i_zeitr.
4464   *           i_zeitr-option = 'GE'.
4465   *           i_zeitr-sign = 'I'.
4466   *           append i_zeitr.
4467               PERFORM zeitr_minimum_bestimmen.
4468             ENDIF.
4469           ENDIF.
4470           IF zeitr-option = 'LE'.
4471             CLEAR i_zeitr.
4472             REFRESH i_zeitr.
4473           ENDIF.
4474           IF zeitr-option = 'CP'.
4475             PERFORM zeitr_minimum_bestimmen.
4476           ENDIF.
4477         ELSE.
4478           IF zeitr-option = 'BT' OR zeitr-option = 'EQ' OR
4479              zeitr-option = 'GE'.
4480             CLEAR i_zeitr.
4481             REFRESH i_zeitr.
4482           ENDIF.
4483           IF zeitr-option = 'LE'.
4484             i_zeitr-low = zeitr-low.
4485             CLEAR i_zeitr-high.
4486             i_zeitr-option = 'GE'.
4487             i_zeitr-sign = 'I'.
