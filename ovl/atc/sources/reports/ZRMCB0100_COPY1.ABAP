839    *---------------------------------------------------------------------*
840    *       FORM BESTAND_ZURUECKRECHNEN_ALLG                              *
841    *---------------------------------------------------------------------*
842    *       ........                                                      *
843    *---------------------------------------------------------------------*
844    FORM bestand_zurueckrechnen_allg.
845
846      LOOP AT int_s032.
847    *INITIALISIERUNG DER BESTÄNDE
848        bw_bestand_neu = bw_bestand_alt   = int_s032-mbwbest.
849        ko_bestand_neu = ko_bestand_alt   = int_s032-mkobest.
850        bw_wert_neu    = bw_wert_alt      = int_s032-wbwbest.
851        gesamtbestand = bw_bestand_neu + ko_bestand_neu.
852
853        PERFORM feldleiste_fuellen.
854        CLEAR int_s031.
855        LOOP AT periotab.
856    *Ermitteln der Periodizität für Feldleiste
857          CASE sav_speri.
858            WHEN con_speri_spmon.
859              feldleiste-spmon = periotab-low.
860            WHEN con_speri_sptag.
861              feldleiste-sptag = periotab-low.
862            WHEN con_speri_spwoc.
863              feldleiste-spwoc = periotab-low.
864            WHEN con_speri_spbup.
865              feldleiste-spbup = periotab-low.
866          ENDCASE.
867    *Sichern der Bewegungen zur Bestandsrückrechnung
868          mzubb = int_s031-mzubb.
869          magbb = int_s031-magbb.
870          mzukb = int_s031-mzukb.
871          magkb = int_s031-magkb.
872          wzubb = int_s031-wzubb.
873          wagbb = int_s031-wagbb.
874    *Bewerteter Bestand
875          bw_bestand_neu   = bw_bestand_neu - mzubb  + magbb.
876    *Konsignationsbestand
877          ko_bestand_neu   = ko_bestand_neu - mzukb + magkb.
878    *Wert bewerteter Bestand
879          bw_wert_neu      = bw_wert_neu    - wzubb + wagbb.
880    *Gesamtbestand der aktuellen gelesenen Periode in der Periotab
881          gesamtbestand = bw_bestand_neu + ko_bestand_neu.
882          READ TABLE int_s031 WITH KEY feldleiste BINARY SEARCH.
883          IF sy-subrc <> 0.
884            CLEAR int_s031.
885
886            IF ( NOT gesamtbestand IS INITIAL OR
887                 NOT bw_wert_neu   IS INITIAL
888                 OR NOT  int_s032-letztbew  IS INITIAL
889                 OR NOT  int_s032-letztver  IS INITIAL
890                 OR int_s032-eisbe  GT 0 ) AND
891               periotab-low IN zeitr.
892    * Wenn keine Bewegungen - gibt es einen Bestand <> 0 ?
893    * Eintrag in die Int_S000 erfolgt, wenn Periode im Selektionszeitraum
894              PERFORM daten_zuweisen.
895              APPEND int_s000.
896              CLEAR int_s000.
897            ENDIF.
898          ELSE.
899            IF periotab-low IN zeitr.
900    *         Eintrag in die Int_S000
901              PERFORM daten_zuweisen.
902              APPEND int_s000.
903              CLEAR int_s000.
904            ENDIF.
905          ENDIF.
906        ENDLOOP.
907      ENDLOOP.
908    ENDFORM.                               "bestand_zurueckrechnen_allg
909
