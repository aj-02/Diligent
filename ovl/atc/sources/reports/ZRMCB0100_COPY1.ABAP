7909   *&---------------------------------------------------------------------*
7910   *&      Form  MATERIAL_LEDGER_READ
7911   *&---------------------------------------------------------------------*
7912   *       text
7913   *----------------------------------------------------------------------*
7914   *      -->P_BA_BDATJ  text                                             *
7915   *      -->P_BA_POPER  text                                             *
7916   *      -->P_KALNR  text                                                *
7917   *      -->P_CKMLCR  text                                               *
7918   *      -->P_CKMLPP  text                                               *
7919   *----------------------------------------------------------------------*
7920   FORM material_ledger_read TABLES   ml_kalnr
7921                                      ml_ckmlcr        STRUCTURE ckmlcr
7922                                      ml_ckmlpp        STRUCTURE ckmlpp
7923                             USING    ml_bdatj         LIKE ckml3-bdatj
7924                                      ml_poper         LIKE ckml3-poper
7925                                      ml_vprsv         LIKE mbew-vprsv
7926                             CHANGING ml_preis         TYPE f
7927                                      ml_preis_zu      TYPE f
7928                                      ml_preis_bestand TYPE f.
7929     DATA: ml_stprs TYPE f,
7930           ml_hlp_preis TYPE f.
7931
7932   * Tabelle mit Verrechungspreisen zu Kalkulationsnummer und Periode
7933     CALL FUNCTION 'CKMS_PERIOD_READ_WITH_ITAB'
7934       EXPORTING
7935         i_refresh_buffer        = space
7936         i_read_only_buffer      = space
7937         i_use_buffer            = space
7938         i_bdatj_1               = ml_bdatj
7939         i_poper_1               = ml_poper
7940       TABLES
7941         t_kalnr                 = ml_kalnr
7942         t_ckmlpp                = ml_ckmlpp
7943         t_ckmlcr                = ml_ckmlcr
7944       EXCEPTIONS
7945         no_data_found           = 1
7946         input_data_inconsistent = 2
7947         buffer_inconsistent     = 3
7948         OTHERS                  = 4.
7949
7950     READ TABLE ml_ckmlcr INDEX 1.
7951     IF sy-subrc = 0.
7952   * ML-Satz vorhanden
7953       READ TABLE ml_ckmlpp INDEX 1.
7954       IF sy-subrc = 0 AND ml_ckmlpp-status = '70'.
7955   * Abschlußbuchung erfolgt
7956         IF ckmlpp-lbkum NE 0.
7957   * Bestand vorhanden
7958           ml_preis         = ml_ckmlcr-salk3 / ckmlpp-lbkum.
7959           ml_preis_bestand = ml_ckmlcr-salk3 / ckmlpp-lbkum.
7960         ELSE.
7961   * Nimm periodischen Verrechnungspreis direkt
7962           ml_preis         = ml_ckmlcr-pvprs / ml_ckmlcr-peinh.
7963           ml_preis_bestand = ml_ckmlcr-pvprs / ml_ckmlcr-peinh.
7964         ENDIF.
7965         IF ml_ckmlpp-zukumo NE 0.
7966   * Zugangspreis
7967           IF ml_ckmlpp-lbkum NE 0.
7968             ml_stprs = ( ml_ckmlcr-salk3 - ml_ckmlcr-ebprd_ea )
7969                      / ml_ckmlpp-lbkum.
7970           ELSE.
7971             ml_stprs = ml_ckmlcr-stprs / ml_ckmlcr-peinh.
7972           ENDIF.
7973           ml_preis_zu = ( ( ml_ckmlpp-zukumo * ml_stprs )
7974                        + ml_ckmlcr-zuprd_o ) / ml_ckmlpp-zukumo.
7975         ENDIF.
7976       ELSE.
7977   * Noch keine Abschlussbuchung erfolgt
7978         IF ckmlpp-lbkum NE 0.
7979   * Bestand vorhanden, das ist genauer als ein S/V-Preis
7980           ml_preis         = ml_ckmlcr-salk3 / ckmlpp-lbkum.
7981           ml_preis_bestand = ml_ckmlcr-salk3 / ckmlpp-lbkum.
7982           ml_preis_zu      = ml_ckmlcr-salk3 / ckmlpp-lbkum.
7983         ELSEIF ml_vprsv EQ 'S'.
7984   * Standardpreis
7985           ml_preis         = ml_ckmlcr-stprs / ml_ckmlcr-peinh.
7986           ml_preis_bestand = ml_ckmlcr-stprs / ml_ckmlcr-peinh.
7987           ml_preis_zu      = ml_ckmlcr-stprs / ml_ckmlcr-peinh.
7988         ELSE.
7989   * Verrechnungspreis
7990           ml_preis         = ml_ckmlcr-pvprs / ml_ckmlcr-peinh.
7991           ml_preis_bestand = ml_ckmlcr-pvprs / ml_ckmlcr-peinh.
7992           ml_preis_zu      = ml_ckmlcr-pvprs / ml_ckmlcr-peinh.
7993         ENDIF.
7994       ENDIF.                             " ml_ckmlpp-status = '70'
7995     ELSE.
7996   * Kein ML-Satz vorhanden: Zuletzt gültigen Preis nehmen
7997       ml_preis         = preis_alt.
7998       ml_preis_bestand = preis_bestand_alt.
7999       ml_preis_zu      = preis_zugang_alt.
8000     ENDIF.
8001   ENDFORM.                               " MATERIAL_LEDGER_READ
