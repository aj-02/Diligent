606    *---------------------------------------------------------------------*
607    *       FORM  HSEL_AUSPRAEGUNGEN_UEBERNEHMEN                          *
608    *---------------------------------------------------------------------*
609    *       Die selektierten Knoten werden in das Selektionsbild          *
610    *       eingetragen. Aufruf von hsel_hierarchie_anzeigen              *
611    *---------------------------------------------------------------------*
612    *      -->P_HA_MARK_NODETAB  text                                     *
613    *---------------------------------------------------------------------*
614    FORM HSEL_AUSPRAEGUNGEN_UEBERNEHMEN
615                TABLES P_MARK_NODETAB STRUCTURE STREENODE.
616
617      DATA: SELOPT_NAME(10),
618            SELOPT_NAME2(10),
619            HLP_ANZ TYPE P,
620            HLP_ANTWORT.
621
622      FIELD-SYMBOLS: <FL_FOO>,
623                     <FS_KOPFZEILE>,
624                     <FS_TABELLE> TYPE TABLE,
625                     <FS_TABELLE_SIGN>,
626                     <FS_TABELLE_OPTION>,
627                     <FS_TABELLE_LOW>.
628
629      READ TABLE DRILLDOWN_FCODES
630               WITH KEY DDICFELD = HSEL_AKT_HIERARCHIE-MERKMALS_FELDNAME.
631      CONCATENATE 'SL_' DRILLDOWN_FCODES-RANGES_SUF INTO SELOPT_NAME.
632      ASSIGN (SELOPT_NAME) TO <FS_KOPFZEILE>.
633      CHECK SY-SUBRC = 0.
634      CONCATENATE SELOPT_NAME '[]' INTO SELOPT_NAME.
635      ASSIGN (SELOPT_NAME) TO <FS_TABELLE>.
636      CHECK SY-SUBRC = 0.
637
638    ** Erst schauen, ob schon was selektiert wurde
639    *  DESCRIBE TABLE <FS_TABELLE> LINES HLP_ANZ.
640    *  IF HLP_ANZ > 0 .
641    *
642    *    PERFORM TEXT_ERMITTELN USING 352
643    **                     Merkmalsauswahl über Hierarchie
644    *                      CHANGING HLP_TEXT1.
645    *    PERFORM TEXT_ERMITTELN USING 351
646    **                   Die bereits selektierten Werte zum
647    *                      CHANGING HLP_TEXT2.
648    *    PERFORM TEXT_ERMITTELN USING 355
649    **                     Merkmal & werden überschrieben
650    *                      CHANGING HLP_TEXT3.
651    *    REPLACE '&' WITH DRILLDOWN_FCODES-SCRTEXT_L INTO HLP_TEXT3.
652    *    PERFORM TEXT_ERMITTELN USING 353
653    **                     Vorhandene Selektion überschreiben ?
654    *                      CHANGING HLP_TEXT4.
655    *    CALL FUNCTION 'POPUP_TO_CONFIRM_WITH_MESSAGE'
656    *          EXPORTING
657    *              DEFAULTOPTION  = 'Y'
658    *             DIAGNOSETEXT1  = HLP_TEXT2
659    *          DIAGNOSETEXT2  = HLP_TEXT3
660    **         DIAGNOSETEXT3  = 'diag 3 '
661    *               TEXTLINE1      = HLP_TEXT4
662    **         textline2      = ' '
663    *               TITEL          = HLP_TEXT1
664    **         START_COLUMN   = 25
665    **         START_ROW      = 6
666    *           CANCEL_DISPLAY = ' '
667    *          IMPORTING
668    *               ANSWER         = HLP_ANTWORT
669    *          EXCEPTIONS
670    *               OTHERS         = 0.
671    *    CHECK HLP_ANTWORT = 'J'.
672    *  ENDIF.
673    * Entsprechende Sel.Opt wird zuerst geleert !
674      CLEAR <FS_TABELLE>.
675      REFRESH <FS_TABELLE>.
676
677    * Feld für Abgrenzung über Hier. ggf. löschen
678      IF SEL_HIER-FELDNAME = HSEL_AKT_HIERARCHIE-MERKMALS_FELDNAME.
679        CLEAR SEL_HIER.
680        CLEAR H_NAME.
681    *   hsel_selopt = ' '.   "wurde abgelöst, steht in sel_hier
682      ENDIF.
683    * Markierte Knoten werden in richtige Sel.Opt. eingetragen
684      LOOP AT P_MARK_NODETAB.
685        ASSIGN COMPONENT 1 OF STRUCTURE <FS_KOPFZEILE>
686             TO <FS_TABELLE_SIGN>.
687        <FS_TABELLE_SIGN> = 'I'.
688        ASSIGN COMPONENT 2 OF STRUCTURE <FS_KOPFZEILE>
689             TO <FS_TABELLE_OPTION>.
690        <FS_TABELLE_OPTION> = 'EQ'.
691        ASSIGN COMPONENT 3 OF STRUCTURE <FS_KOPFZEILE>
692             TO <FS_TABELLE_LOW>.
693        <FS_TABELLE_LOW> = P_MARK_NODETAB-NAME.
694        APPEND <FS_KOPFZEILE> TO <FS_TABELLE>.
695      ENDLOOP.
696      MESSAGE S385.
697    ENDFORM.                               "HSEL_AUSPRAEGUNGEN_UEBERNEHMEN
