1475   *       FORM ZEITR_PERIODENTAB                                        *
1476   *---------------------------------------------------------------------*
1477   *       Variation der Routine Periodentab für die                     *
1478   *       Darstellung der Zeitreihe                                     *
1479   *---------------------------------------------------------------------*
1480   FORM ZEITR_PERIODENTAB.
1481
1482     DATA: PE_DRIN.
1483     DATA: PE_LINES TYPE I.
1484
1485     FLG_PERIOTAB = TRUE.
1486     READ TABLE I_ZEITR INDEX 1.
1487     IF NOT I_ZEITR-LOW IS INITIAL.
1488   *--------- Bestimmen Periotab-Low aus Rangestabelle ZEITR
1489       PERIODENTAB-LOW = I_ZEITR-LOW.
1490       APPEND PERIODENTAB.
1491     ELSE.
1492   *--------- Falls nicht in Ranges, kleinsten Wert der
1493   *--------- Datenreihe nehmen
1494       PERIODENTAB-LOW = SAV_PERIO_MIN.
1495       APPEND PERIODENTAB.
1496     ENDIF.
1497
1498     PERFORM ZEITR_MAXIMUM_BESTIMMEN USING PERIODENTAB-HIGH.
1499     IF PERIODENTAB-HIGH EQ '000000'.
1500       PERIODENTAB-HIGH = SAV_PERIO_MAX.
1501     ENDIF.
1502
1503   *Aufnahme aller Perioden von periodentab-LOW bis periodentab-HIGH
1504     WHILE periodentab-LOW LT periodentab-HIGH.
1505       CASE SAV_SPERI.
1506         WHEN CON_SPERI_SPTAG.
1507           periodentab-LOW = periodentab-LOW + 1.
1508         WHEN CON_SPERI_SPMON.
1509           periodentab-LOW+4(2) = periodentab-LOW+4(2) + 1.
1510           IF periodentab-LOW+4(2) = '13'.
1511             periodentab-LOW+4(2) = '01'.
1512             periodentab-LOW(4)   = periodentab-LOW(4) + 1.
1513           ENDIF.
1514         WHEN CON_SPERI_SPWOC.
1515           IF PERIODENTAB-LOW+4(2) LT '52'.
1516             periodentab-LOW+4(2) = periodentab-LOW+4(2) + 1.
1517           ELSEIF PERIODENTAB-LOW+4(2) = '52'.
1518             PERFORM KALENDERWOCHE_ERMITTELN_EXC USING PERIODENTAB-LOW.
1519           ELSEIF PERIODENTAB-LOW+4(2) = '53'.
1520             PERIODENTAB-LOW(4) = PERIODENTAB-LOW(4) + 1.
1521             PERIODENTAB-LOW+4(2) = '01'.
1522           ENDIF.
1523         WHEN CON_SPERI_SPBUP.
1524           PERFORM TABELLE_T009_PRUEFEN_EXC USING PERIODENTAB-LOW.
1525       ENDCASE.
1526       APPEND PERIODENTAB.
1527     ENDWHILE.
1528
1529     SORT periodentab BY LOW DESCENDING.
1530
1531   *--------- Vom aktuellen Datum ausgehend nicht in PERIODENTAB gehoerende
1532   *--------- rauswerfen und mitzaehlen der Anzahl Perioden zwischen
1533   *--------- sy-datum - periode und erster Periode der Analyse fuer
1534   *--------- evtl. Prognose bei Plan/Ist-Vergleich
1535     PERIODEN_RAUS = 0.
1536     CLEAR PE_DRIN.
1537     LOOP AT PERIODENTAB.
1538       CASE SAV_SPERI.
1539         WHEN CON_SPERI_SPTAG.
1540           IF PERIODENTAB-LOW IN SL_SPTAG.
1541             PE_DRIN = TRUE.
1542           ELSE.
1543             DELETE PERIODENTAB.
1544           ENDIF.
1545         WHEN CON_SPERI_SPMON.
1546           IF PERIODENTAB-LOW IN SL_SPMON.
1547             PE_DRIN = TRUE.
1548           ELSE.
1549             DELETE PERIODENTAB.
1550           ENDIF.
1551         WHEN CON_SPERI_SPWOC.
1552           IF PERIODENTAB-LOW IN SL_SPWOC.
1553             PE_DRIN = TRUE.
1554           ELSE.
1555             DELETE PERIODENTAB.
1556           ENDIF.
1557         WHEN CON_SPERI_SPBUP.
1558           IF PERIODENTAB-LOW IN SL_SPBUP.
1559             PE_DRIN = TRUE.
1560           ELSE.
1561             DELETE PERIODENTAB.
1562           ENDIF.
1563       ENDCASE.
1564       IF PE_DRIN <> TRUE.
1565         PERIODEN_RAUS = PERIODEN_RAUS + 1.
1566       ENDIF.
1567     ENDLOOP.
1568
1569     SORT PERIODENTAB BY LOW ASCENDING.
