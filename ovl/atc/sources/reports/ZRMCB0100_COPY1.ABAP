6      *---------------------------------------------------------------------*
7      *       FORM SELEKTIONSBILD_VORBEREITEN                               *
8      *---------------------------------------------------------------------*
9      *       - Nicht benötigte Select-Options für Periodizität ausblenden  *
10     *       - EWS: Parameter EXC_NO auf nicht eingabebereit setzen        *
11     *       - Selektionsversionen: SEL_NO und SL_WAERS nicht eingabebereit*
12     *---------------------------------------------------------------------*
13     FORM SELEKTIONSBILD_VORBEREITEN.
14       DATA: SV_SELECTOPTION_NAME(8). "Nicht auszublendende Select-option
15       DATA: SV_LINES TYPE I.         "Anzahl Zeilen in hsel_hierarchie_tab
16
17       PERFORM EXCL_FCODES_FUELLEN.
18       PERFORM PF_STATUS_SETZEN USING 'SELE0001'
19                                      TIT_CODE_SELEKTION
20                                      TITLEBAR_TEXT.
21     * Die Analysewährung der Variante überschreibt die Analysewährung der
22     * Selektionsversion, deshalb Analysewährung der Selektionsversion
23     * wiederherstellen                                        note 383864
24       IF NOT SLV_NO IS INITIAL.
25         IF MCRSV-SELVS IS INITIAL.
26           PERFORM SELVS_DATEN_INITIALISIEREN IN PROGRAM (LIS_PROGNAME)
27                                                              IF FOUND.
28         ENDIF.
29         SL_WAERS = MCRSV-WAERS.
30       ENDIF.
31
32       CASE SAV_SPERI.
33         WHEN CON_SPERI_SPTAG.
34           SV_SELECTOPTION_NAME = 'SL_SPTAG'.
35         WHEN CON_SPERI_SPWOC.
36           SV_SELECTOPTION_NAME = 'SL_SPWOC'.
37         WHEN CON_SPERI_SPMON.
38           SV_SELECTOPTION_NAME = 'SL_SPMON'.
39         WHEN CON_SPERI_SPBUP.
40           SV_SELECTOPTION_NAME = 'SL_SPBUP'.
41       ENDCASE.
42       DESCRIBE TABLE HSEL_HIERARCHIE_TAB LINES SV_LINES.
43       LOOP AT SCREEN.
44         IF SCREEN-GROUP1 = 'PER'.
45           IF NOT SCREEN-NAME CS SV_SELECTOPTION_NAME OR
46              SV_SELECTOPTION_NAME IS INITIAL         OR
47              MCRSV-XDYNPER = TRUE.
48     *       Periodenfeld <> Periodenfeld zur Periodizität der Info-Struktur
49     *       oder Dynamische Periodenberechnung bei Selektionsversion =>
50     *       Periodenfeld zur Periodizität muß ausgeblendet werden
51             SCREEN-ACTIVE    = OFF.
52             SCREEN-INVISIBLE = ON.
53           ELSE.        "
54     *       Hier.selektion: eventuell grau-blenden des Datums
55             if screen-group3 ne 'OPU'.
56               screen-input = on.
57               screen-active = on.
58             endif.
59             SEARCH SCREEN-NAME FOR SEL_HIER-SELOPT_NAME.
60             IF SY-SUBRC = 0.
61               SCREEN-INPUT = OFF.
62               SEARCH SCREEN-NAME FOR 'VALU_PUSH'.
63               IF SY-SUBRC = 0.
64                 SCREEN-ACTIVE = OFF.
65               ENDIF.
66             ENDIF.
67           ENDIF.
68           MODIFY SCREEN.
69         ELSEIF SCREEN-GROUP1 = 'VRS' AND VRSIO IS INITIAL.
70     *     Feld für Versionseingabe ausblenden
71           SCREEN-ACTIVE    = OFF.
72           SCREEN-INVISIBLE = ON.
73           MODIFY SCREEN.
74         ELSEIF SCREEN-GROUP1 = 'SLV'.
75           IF SLV_NO IS INITIAL.
76     *       Feld für Selektionsversion ausblenden
77             SCREEN-ACTIVE    = OFF.
78             SCREEN-INVISIBLE = ON.
79           ELSE.
80     *       Feld für Selektionsversion nur für Ausgabe
81             SCREEN-INPUT     = OFF.
82           ENDIF.
83           MODIFY SCREEN.
84     * Umschalten zwischen erweit. oder normalen Sel.bild
85         ELSEIF SCREEN-GROUP1 = 'HID'.
86           IF SCREEN-NAME = 'H_NAME'.
87             SCREEN-INPUT = OFF.
88           ENDIF.
89           IF SCREEN-NAME = 'BUT_HI3'.
90             IF H_NAME IS INITIAL.
91               SCREEN-INPUT = OFF.
92             ELSE.
93               if screen-group3 ne 'OPU'.
94                 screen-input = on.
95               endif.
96             ENDIF.
97           ENDIF.
98           IF FLG_ERWEIT_SELBILD = TRUE OR
99                 NOT SEL_HIER IS INITIAL.
100            SCREEN-ACTIVE = ON.
101          ELSE.
102            SCREEN-ACTIVE = OFF.
103    *        Clearen von sel_hier und h_name ? Sinnvoll ?
104          ENDIF.
105          IF SV_LINES = 0 .
106            SCREEN-INPUT = OFF.
107          ENDIF.
108          MODIFY SCREEN.
109    *  Ausblenden einer bestimmten Sel.Option
110        ELSEIF SCREEN-GROUP1 = 'SEL'.
111          if screen-group3 ne 'OPU'.
112            screen-input = on.
113            screen-active = on.
114          endif.
115          SEARCH SCREEN-NAME FOR SEL_HIER-SELOPT_NAME.
116          IF SY-SUBRC = 0.
117            SCREEN-INPUT = OFF.
118            SEARCH SCREEN-NAME FOR 'VALU_PUSH'.
119            IF SY-SUBRC = 0.
120              SCREEN-ACTIVE = OFF.
121            ENDIF.
122          ENDIF.
123          MODIFY SCREEN.
124        ELSEIF SCREEN-NAME = 'SL_WAERS' AND NOT SLV_NO IS INITIAL.
125    *     Feld für Anaylsewährung nur für Ausgabe bei Variantenpflege für
126    *     die Selektionsversionen
127          SCREEN-INPUT     = OFF.
128          MODIFY SCREEN.
129        ENDIF.
130      ENDLOOP.
131    ENDFORM.                               "SELEKTIONSBILD_VORBEREITEN
