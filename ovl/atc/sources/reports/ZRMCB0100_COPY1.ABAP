378      ENDIF.
379
380    * Gesamtbestand ermitteln, damit Durchschnittsbestand geb. werden kann
381    * Notwendig für Berechnung Kennzahl: Umschlagshäufigkeit
382      ADD ac_inttab-mbwbest TO ac_austab-s_mbwbest.
383      ADD ac_inttab-mbwbest TO ac_austab-s_gsbest.
384      ADD ac_inttab-mkobest TO ac_austab-s_mkobest.
385      ADD ac_inttab-mkobest TO ac_austab-s_gsbest.
386      ADD ac_inttab-wbwbest TO ac_austab-s_wbwbest.
387
388      IF akt_drilldown-fcode = con_fcode_aper OR
389        ( akt_drilldown-fcode(1) EQ 'H' AND
390          akt_hierarchie-merkmals_fcode EQ con_fcode_aper )
391       OR flg_excp EQ true.                " <=== note 118387
