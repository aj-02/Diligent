275    FORM ORIGINALBREITE_SETZEN USING OS_AKT_KENNZAHL LIKE AKT_KENNZAHLEN.
276
277      DATA: OS_REPTEXT_LENGTH   LIKE SY-FDPOS,
278            OS_SCRTEXT_S_LENGTH LIKE SY-FDPOS,
279            OS_MIN_LENGTH       LIKE SY-FDPOS,
280            OS_FELDNAME(30).
281      FIELD-SYMBOLS: <OS_FELD>.
282
283    * Bestimme die Ausgabelänge des Feldes
284      ASSIGN COMPONENT OS_AKT_KENNZAHL-FIELDNAME OF STRUCTURE AUS_S000
285        TO <OS_FELD>.
286      IF SY-SUBRC <> 0.
287    *   ASSIGN fehlgeschlagen => Probiere es mit Feldnamen mit führenden %
288        CONCATENATE '%' OS_AKT_KENNZAHL-FIELDNAME INTO OS_FELDNAME.
289        ASSIGN COMPONENT OS_FELDNAME OF STRUCTURE AUS_S000 TO <OS_FELD>.
290      ENDIF.
291      DESCRIBE FIELD <OS_FELD> OUTPUT-LENGTH OS_AKT_KENNZAHL-OUTPUTLEN.
292
293    * Spaltenbreitenoptimierung nur im LIS
294      CHECK FLG_LIS_REPORTING = TRUE.
295
296    * Bestimme die Länge des kürzesten Textes
297      OS_REPTEXT_LENGTH   = STRLEN( OS_AKT_KENNZAHL-REPTEXT ).
298      OS_SCRTEXT_S_LENGTH = STRLEN( OS_AKT_KENNZAHL-SCRTEXT_S ).
299      IF OS_REPTEXT_LENGTH > 0.
300        IF OS_REPTEXT_LENGTH < OS_SCRTEXT_S_LENGTH.
301          OS_MIN_LENGTH = OS_REPTEXT_LENGTH.
302        ELSE.
303          OS_MIN_LENGTH = OS_SCRTEXT_S_LENGTH.
304        ENDIF.
305      ELSE.
306        OS_MIN_LENGTH = OS_SCRTEXT_S_LENGTH.
307      ENDIF.
308
309    * Die Ausgabelänge soll minimal dem kürzesten Text entsprechen
310      IF OS_AKT_KENNZAHL-OUTPUTLEN < OS_MIN_LENGTH.
311        OS_AKT_KENNZAHL-OUTPUTLEN = OS_MIN_LENGTH.
312      ENDIF.
313
314    *  Für Zahlen soll eine Mindestausgabelänge von 8 Zeichen
315    *  eingehalten werden, damit auch bei proz. Darstellung eine
316    *  saubere Spaltendarstellung erfolgen kann
317      if os_akt_kennzahl-outputlen < 8 and               " <= TR 24.02.1999
318         os_akt_kennzahl-inttype ca con_inttype_zahl.    " <= TR 24.02.1999
319        os_akt_kennzahl-outputlen = 8.                   " <= TR 24.02.1999
320      endif.                                             " <= TR 24.02.1999
321
322    ENDFORM.                               "ORIGINALBREITE_SETZEN
