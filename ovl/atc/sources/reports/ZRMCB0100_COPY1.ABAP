2253   *       FORM PUFFERTAB_UMRECHNEN                                      *
2254   *---------------------------------------------------------------------*
2255   *       Puffertabelle in Analysewährung umrechnen und Ergebnis in     *
2256   *       Ausgabetabelle stellen. Ist die Analysewährung = SPACE, wird  *
2257   *       die Ausgabetabelle aus der Puffertabelle ohne Umrechnung      *
2258   *       gefüllt (dies wird beim rekursiven Aufruf verwendet)          *
2259   *---------------------------------------------------------------------*
2260   *  <->  PU_TAB: Ergebnistabelle der Umrechnung                        *
2261   *               (Z. Zt. sind dies die Tab.: AUSPRAEGUNGSTAB, AUS_S000)*
2262   *---------------------------------------------------------------------*
2263   FORM PUFFERTAB_UMRECHNEN TABLES PU_TAB STRUCTURE AUS_S000.
2264     DATA: PU_SAV_OBJEKT   LIKE AUSTAB_GLOBAL-OBJEKT,
2265           PU_RETURNCODE   LIKE SY-SUBRC,
2266           PU_FLG_KEIN_STANDARD TYPE C,
2267           PU_TABIX        LIKE SY-TABIX.
2268
2269     CLEAR:  HLP_SUMME,
2270             PU_TAB.
2271     REFRESH PU_TAB.
2272
2273     PERFORM SPEZIAL_PUFFERTAB_UMRECHNEN IN PROGRAM (LIS_PROGNAME)
2274                                         TABLES PU_TAB
2275                                         CHANGING PU_FLG_KEIN_STANDARD
2276                                         IF FOUND.
2277     CHECK PU_FLG_KEIN_STANDARD = FALSE.
2278
2279   * Startobjekt initialisieren
2280     READ TABLE PUFFERTAB INDEX 1.
2281     HLP_SUMME-XOBJEKT = PU_SAV_OBJEKT = <PUFFERTAB_GLOBAL>-OBJEKT.
2282
2283     IF ANALYSE_WAEHRUNG IS INITIAL.
2284   *   Ausgabe in Originalwährung
2285       LOOP AT PUFFERTAB.
2286         IF PU_SAV_OBJEKT = <PUFFERTAB_GLOBAL>-OBJEKT.
2287           IF SY-TABIX = 1.
2288   *         Erstes Objekt => Werte setzen
2289             HLP_SUMME = PUFFERTAB.
2290           ELSE.
2291   *         gleiches Objekt => Werte kumulieren
2292             ADD-CORRESPONDING PUFFERTAB TO HLP_SUMME.
2293             PERFORM NICHTSUM_AUS_NACH_SUMME IN PROGRAM (LIS_PROGNAME)
2294                                        USING    PUFFERTAB
2295                                        CHANGING HLP_SUMME IF FOUND.
2296             PERFORM SUMEINHEITEN_SETZEN USING    PUFFERTAB
2297                                         CHANGING HLP_SUMME.
2298   *         EWS-Farbinfo übertragen
2299             PERFORM COLOR_ID_SETZEN IN PROGRAM (LIS_PROGNAME)
2300                                     USING    <PUFFERTAB_GLOBAL>-COLOR_ID
2301                                              TRUE
2302                                     CHANGING HLP_SUMME-XCOLOR_ID
2303                                     IF FOUND.
2304           ENDIF.
2305         ELSE.
2306   *       Objektwechsel => Objekt in AUSTAB eintragen
2307           PU_TAB = HLP_SUMME.
2308           APPEND PU_TAB.
2309   *       Eintrag für neues Objekt setzen
2310           PU_SAV_OBJEKT = <PUFFERTAB_GLOBAL>-OBJEKT.
2311           HLP_SUMME     = PUFFERTAB.
2312         ENDIF.
2313       ENDLOOP.
2314     ELSE.
2315   *   Ausgabe in Analysewährung
2316       LOOP AT PUFFERTAB.
2317         PU_TABIX = SY-TABIX.
2318         PERFORM PUFFERTAB_EINTRAG_UMRECHNEN CHANGING PUFFERTAB
2319                                                      PU_RETURNCODE.
2320         IF PU_SAV_OBJEKT = <PUFFERTAB_GLOBAL>-OBJEKT.
2321           IF PU_TABIX = 1.
2322   *         Erstes Objekt => Werte setzen
2323             HLP_SUMME = PUFFERTAB.
2324           ELSE.
2325   *         gleiches Objekt => Werte kumulieren
2326             ADD-CORRESPONDING PUFFERTAB TO HLP_SUMME.
2327             PERFORM NICHTSUM_AUS_NACH_SUMME IN PROGRAM (LIS_PROGNAME)
2328                                        USING    PUFFERTAB
2329                                        CHANGING HLP_SUMME IF FOUND.
2330   *         EWS-Farbinfo übertragen
2331             PERFORM COLOR_ID_SETZEN IN PROGRAM (LIS_PROGNAME)
2332                                     USING    <PUFFERTAB_GLOBAL>-COLOR_ID
2333                                              TRUE
2334                                     CHANGING HLP_SUMME-XCOLOR_ID
2335                                     IF FOUND.
2336           ENDIF.
2337   *       Einheiten incl. Währung setzen
2338           PERFORM SUMEINHEITEN_SETZEN USING    PUFFERTAB
2339                                       CHANGING HLP_SUMME.
2340         ELSE.
2341   *       Objektwechsel => Objekt in AUSTAB eintragen
2342           PU_TAB = HLP_SUMME.
2343           APPEND PU_TAB.
2344   *       Eintrag für neues Objekt setzen
2345           PU_SAV_OBJEKT   = <PUFFERTAB_GLOBAL>-OBJEKT.
2346           HLP_SUMME       = PUFFERTAB.
2347           PERFORM SUMEINHEITEN_SETZEN USING    PUFFERTAB
2348                                       CHANGING HLP_SUMME.
2349         ENDIF.
2350         IF PU_RETURNCODE <> 0.
2351   *       Fehler bei Einheitenumrechnung
2352           EXIT.
2353         ENDIF.
2354       ENDLOOP.
2355     ENDIF.
2356     IF PU_RETURNCODE <> 0.
2357   *   Fehler bei Einheitenumrechnung => Ausgabe in gesicherter Währung
2358       ANALYSE_WAEHRUNG =  SAV_ANALYSE_WAEHRUNG.
2359       TYPE_OF_RATE     =  SAV_TYPE_OF_RATE.
2360       UMRECH_DATUM     =  SAV_UMRECH_DATUM.
2361       PERFORM PUFFERTAB_UMRECHNEN TABLES PU_TAB.
2362       EXIT.
2363     ENDIF.
2364     IF SY-SUBRC = 0.
2365   *   Letztes Objekt in AUSTAB eintragen
2366       PU_TAB = HLP_SUMME.
2367       APPEND PU_TAB.
2368     ENDIF.
2369   ENDFORM.                               "PUFFERTAB_UMRECHNEN
