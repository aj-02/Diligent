214    *       FORM CALL_TRANSACTION                                         *
215    *---------------------------------------------------------------------*
216    *                                                                     *
217    *       Prüft Berechtigung für Transaktion T_CODE und führt           *
218    *       die Transaktion bei vorhandener Berechtigung aus.             *
219    *                                                                     *
220    *---------------------------------------------------------------------*
221    FORM CALL_TRANSACTION using T_CODE like SY-TCODE
222                                SKIP type C.
223
224      CALL FUNCTION 'AUTHORITY_CHECK_TCODE'
225        EXPORTING
226          TCODE       = T_CODE
227        EXCEPTIONS
228          OK          = 0
229          NOT_OK      = 2
230          OTHERS      = 3
231              .
232      IF SY-SUBRC <> 0.
233        MESSAGE E172(00) WITH T_CODE.
234      ELSE.
235        IF SKIP EQ FALSE.
236          CALL TRANSACTION T_CODE.
237        ELSE.
238          CALL TRANSACTION T_CODE AND SKIP FIRST SCREEN.
239        ENDIF.
240      ENDIF.
241
242    ENDFORM.
