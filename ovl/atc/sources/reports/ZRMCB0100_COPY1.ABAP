2503     REFRESH vergangenheit.
2504     LOOP AT zeitreihe.
2505       vergangenheit-wert = zeitreihe-value + ct_kl_zahl.
2506       INSERT vergangenheit INDEX 1.
2507     ENDLOOP.
2508
2509     CASE trendtest.
2510       WHEN space.
2511   *--------- Berechnen Trend
2512         CLEAR pcom-modaw.
2513         CLEAR pcom-modav.
2514         pcom-kzini = true.
2515         pcom-anzpr = 1.
2516         pcom-prmod = 'T'.
2517       WHEN true.
2518   *--------- Test auf Trend
2519         pcom-modaw = 'T'.
2520         pcom-modav = '1'.
2521         pcom-kzini = true.
2522         pcom-anzpr = 1.
2523         pcom-prmod = 'J'.
2524     ENDCASE.
2525
2526     CALL FUNCTION 'PROGNOSE'
2527          EXPORTING
2528               prog_parameter = pcom
2529          IMPORTING
2530               prog_ergebnis  = pcom
2531          TABLES
2532               ablauf         = ablauf
2533               meldungen      = meldungen
2534               prognose       = prognose
2535               vergangenheit  = vergangenheit
2536          EXCEPTIONS
2537               gwert_null     = 01
2538               ne_past        = 02
2539               no_past        = 03.
2540
2541     IF sy-subrc <> 0.
2542       grundwert = 0.
2543       delta     = 0.
2544   *--------- Kein Trend feststellbar
2545       EXIT.
2546     ENDIF.
2547
2548   *--------- Wieder runterrechnen des Grundwertes
2549     pcom-gwert = pcom-gwert - ct_kl_zahl.
2550
2551     IF trendtest = true AND pcom-prmod <> 'T'.
2552       grundwert = pcom-gwert.
2553       delta     = 0.
2554       EXIT.
2555     ENDIF.
2556
2557     grundwert = pcom-gwert.
2558     delta     = pcom-twert.
2559     IF int_mcyc-trend = '+' AND pcom-twert > 0.
2560       kz_full = true.
2561     ENDIF.
2562     IF int_mcyc-trend = '-' AND pcom-twert < 0.
2563       kz_full = true.
2564     ENDIF.
2565
2566   ENDFORM.
