791      PERFORM excl_fcodes_fuellen.
792
793      ha_popup_length = ( sy-srows - 3 ) * '0.8'.
794      ha_start_col = ( sy-scols - ha_popup_width  ) DIV 2.
795      IF ha_start_col < 1.
796        ha_start_col = 1.
797      ENDIF.
798      ha_start_row = ( sy-srows - ha_popup_length ) DIV 2.
799      ha_end_col = ha_start_col + ha_popup_width.
800      ha_end_row = ha_start_row + ha_popup_length.
801
802      IF flg_objekttext_hier = con_objekttext_initial.
803        flg_objekttext_hier = flg_objekttext.
804      ELSEIF flg_objekttext_hier <> flg_objekttext. " andere Darstellungsart
805        flg_objekttext_hier = flg_objekttext.
806
807    *   Texte müssen gelöscht werden
808        CALL FUNCTION 'RS_TREE_GET_CURRENT_TREE'
809             TABLES
810                  nodeinfo = ha_nodetab
811             EXCEPTIONS
812                  OTHERS   = 1.
813        CLEAR ha_nodetab-text.
814        MODIFY ha_nodetab TRANSPORTING text WHERE text NE space.
815        CALL FUNCTION 'RS_TREE_CONSTRUCT'
816             TABLES
817                  nodetab            = ha_nodetab
818             EXCEPTIONS
819                  tree_failure       = 1
820                  id_not_found       = 2
821                  wrong_relationship = 3
822                  OTHERS             = 4.
823        CLEAR ha_nodetab.
824        REFRESH ha_nodetab.
825      ENDIF.
826
827      CLEAR hierarchy_node_id.
828
829      IF flg_hiertext_prefetch = false.
830    *   Prefetch wurde für die Blätter der Hier. noch nicht durchgeführt
831        PERFORM objekttext_prefetch TABLES auspraegungstab
832                                    USING  akt_hierarchie-domname
833                                           0.
834
835        flg_hiertext_prefetch = true.
836      ENDIF.
837
838    * Hierarchie retten
