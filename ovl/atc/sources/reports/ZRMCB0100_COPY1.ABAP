849    *---------------------------------------------------------------------*
850    *       FORM PLANTAB_AUSGEBEN                                         *
851    *---------------------------------------------------------------------*
852    *       Ausgabe der PLAN_TAB für die 3 unterschiedlichen Vergleiche   *
853    *---------------------------------------------------------------------*
854    * --> PA_FLG_POPUP: TRUE,  wenn Plantab aus VerglchsPopup gerufen wird*
855    *                   FALSE, wenn Plantab aus Liste gerufen wird        *
856    *---------------------------------------------------------------------*
857    FORM PLANTAB_AUSGEBEN USING PA_FLG_POPUP TYPE BOOLEAN.
858
859      DATA:  PA_POPUP_WIDTH             LIKE SY-CUCOL,
860             PA_POPUP_LENGTH            LIKE SY-CUCOL VALUE 30,
861             PA_START_COL               TYPE I,
862             PA_START_ROW               TYPE I VALUE 2,
863             PA_END_COL                 TYPE I,
864             PA_END_ROW                 TYPE I,
865             PA_MAX_ROWS                TYPE I,
866             PA_ANZ_PLANTAB_ROWS        LIKE SY-CUROW,
867             PA_CON_KEINE_PROZENTE(9)   VALUE '    -    ',
868             PA_CON_PROZENTE_NONSENS(9) VALUE '         ',
869             PA_SPALTE                  LIKE SY-CUCOL,
870             PA_EINH_AUSGLEN            LIKE MCS03-REFLEN,
871             PA_DIFF%(6)                TYPE P DECIMALS 2,
872             PA_CHECK_LOG               TYPE F,
873             PA_NUR TYPE I,
874             PA_NUR_HELP TYPE I,
875             PA_QUICKINFO(255)
876            .
877
878
879      STATICS: PA_SAV_START_COL           LIKE PA_START_COL,
880               PA_SAV_START_ROW           LIKE PA_START_ROW,
881               PA_SAV_END_COL             LIKE PA_END_COL,
882               PA_SAV_END_ROW             LIKE PA_END_ROW.
883      FIELD-SYMBOLS: <PA_OBJEKT>.
884
885      IF GF_ACC_INIT = FALSE.
886          CALL FUNCTION 'GET_ACCESSIBILITY_MODE'
887       IMPORTING
888         ACCESSIBILITY           = gf_acc_on
889       EXCEPTIONS
890         ITS_NOT_AVAILABLE       = 1
891         OTHERS                  = 2
892               .
893        gf_acc_init = true.
894      ENDIF.
895
896    * Einstellungen der aktuellen Aufrißliste sichern
897    **  perform ddown_einstellungen_sichern using drilldown_eintraege.
898
899      IF SY-LSIND ge 20.
900        MESSAGE E024(SY) WITH '20'.
901    *     Es sind nur maximal 20 Liststufen möglich.
902        EXIT.
903      ENDIF.
904
905    * Liste sortiert => PLAN_TAB entsprechend sortieren
906      IF SY-LSIND = MAINLIST_LSIND OR SAV_FCODE = 'AVER'.
907    *   nur beim 1. VergleichsPopUp
908        PERFORM VERGLEICH_SORTIEREN USING FLG_SORT_ABST TRUE.
909      ENDIF.
910
911    * übernehmen der Ausgabelänge für die Kennzahlen-Einheit
912      PA_EINH_AUSGLEN = KENNZAHL_SPALTE-REFLEN.
913    * Festsetzen der maximalen Ausgabelänge des Zusatz-Popups
914      PA_MAX_ROWS = SY-SROWS - 5.
915    * erforderliche Ausgabebreite des Zusatz-Popups errechnen
916    * Bedeutung der Berechnungskomponenten
917    * SPALTEN_ANFANG  = Breite der Merkmalsbezeichnung
918    * SPALTEN_BREITE  = über Menü eingestellte Ausgabebreite der Kennzahl
919    * PA_EINH_AUSGLEN = Ausgabbreite der Kennzahlen-Einheit
920    * + 12            = Ausgabebreite der proz. Differenz
921    * + 1             = Offset für Ungenauigkeiten
922      PA_POPUP_WIDTH = STRICH_ANFANG
923                       + 3 * ( VGL_SPALTEN_BREITE + PA_EINH_AUSGLEN )
924                       + 12 + 1.
925      IF NOT PA_EINH_AUSGLEN IS INITIAL.
926    *   je 1 Blank zwischen Zahl und Einheit pro Spalte hinzufügen
927        ADD 3 TO PA_POPUP_WIDTH.
928      ENDIF.
929    * Ausgabebreite für die PLAN_TAB setzen
930      VGL_POPUP_WIDTH = PA_POPUP_WIDTH.
931
932    * erforderliche Ausgabelänge des Zusatz-Popups errechnen
933      DESCRIBE TABLE PLAN_TAB LINES PA_ANZ_PLANTAB_ROWS.
934      PA_POPUP_LENGTH = PA_ANZ_PLANTAB_ROWS + tabindex DIV 2
935                                            + tabindex MOD 2 + 4.
936    * Höhe wird wegen unterschiedlicher Metrik Liste/Dynpro reduziert
937      PA_POPUP_LENGTH = ( PA_POPUP_LENGTH - 3 ) * '0.8'.
938      PA_MAX_ROWS     = ( PA_MAX_ROWS - 3 ) * '0.8'.
939
940    * vertikale Grösse (die Zahl PA_MAX_ROWS steht momentan für eine
941    * fixe Größe von SY-SROWS !!)
942      IF PA_POPUP_LENGTH >= PA_MAX_ROWS.
943    *   Übersteigt die berechntete Länge die Länge des Grundfensters,
944    *   so wird die Größe des Grundfensters übernommen
945        PA_POPUP_LENGTH = PA_MAX_ROWS.
946        PA_START_ROW    = 1.
947        PA_END_ROW = PA_START_ROW + PA_MAX_ROWS.
948      ELSE.
949        PA_START_ROW = ( PA_MAX_ROWS - PA_POPUP_LENGTH ) DIV 2.
950        IF PA_START_ROW < 1.
951          PA_START_ROW = 1.
952        ENDIF.
953        PA_END_ROW = ( PA_START_ROW + PA_POPUP_LENGTH ) + 4.
954      ENDIF.
955    * Start- und Endpunkte des Zusatzfensters in Abhängigkeit der
956    * Systemgegebenheiten bestimmen
957    * horizontale Grösse
958      IF PA_POPUP_WIDTH > SY-SCOLS.
959        PA_START_COL = ( SY-SCOLS - ( SY-SCOLS - 8 ) ) DIV 2.
960        IF PA_START_COL < 1.
961          PA_START_COL = 1.
962        ENDIF.
963        PA_END_COL = PA_START_COL + ( SY-SCOLS - 8 ).
964      ELSE.
965        PA_START_COL = ( SY-SCOLS - PA_POPUP_WIDTH ) DIV 2.
966        IF PA_START_COL < 1.
967          PA_START_COL = 2.
968        ENDIF.
969        PA_END_COL = PA_START_COL + PA_POPUP_WIDTH.
970      ENDIF.
971
972      IF FLG_DRUCKEN = FALSE.
