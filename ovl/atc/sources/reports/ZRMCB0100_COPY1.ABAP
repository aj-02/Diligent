128    *---------------------------------------------------------------------*
129    *       FORM ANZAHL_TAGE                                              *
130    *---------------------------------------------------------------------*
131    *       ermittelt Anzahl der Tage für übergebenen Monat               *
132    *---------------------------------------------------------------------*
133    *  -->  MONAT   Format: Datum, aber: Tag ist nicht gefüllt!           *
134    *  -->  TAGE                                                          *
135    *---------------------------------------------------------------------*
136    FORM anzahl_tage USING    monat TYPE d
137                     CHANGING tage  TYPE i.
138
139      DATA: at_monat(2) TYPE n,
140            at_dats     TYPE d.
141
142      at_monat = monat+4(2).
143
144      CASE at_monat.
145        WHEN '01' OR '03' OR '05' OR '07' OR '08' OR '10' OR '12'.
146          tage = 31.
147        WHEN '02'.
148          at_dats(4) = monat(4).
149          at_dats+4  = '0301'.
150          at_dats = at_dats - 1.
151          tage = at_dats+6.
152        WHEN OTHERS.
153          tage = 30.
154      ENDCASE.
155
156    ENDFORM.                               " ANZAHL_TAGE
