312    *---------------------------------------------------------------------*
313    *       FORM BUSG3_SPALTEN_ZUWEISEN                                   *
314    *---------------------------------------------------------------------*
315    * Ermittelt die Felder, in denen Spaltensummen (prozentuale Dar-      *
316    * stellung), Einheiten und Spaltenüberschriften stehen.               *
317    *---------------------------------------------------------------------*
318    FORM BUSG3_SPALTEN_ZUWEISEN.
319
320      DATA: BZ_SAV_TABIX LIKE SY-TABIX.
321
322      IF FLG_SUMTAB_TABELLE = TRUE.
323    *   Summenzeilen in Kopfzeile der Summentabelle verdichten
324        PERFORM SUMTAB_SUMMIEREN IN PROGRAM (LIS_PROGNAME) IF FOUND.
325      ENDIF.
326
327    * Die Feldsymbole werden initialisiert.
328      ASSIGN CON_F_NULL TO <BUSG3_KENNZ_1>.
329      ASSIGN CON_F_NULL TO <BUSG3_KENNZ_2>.
330      ASSIGN CON_F_NULL TO <BUSG3_KENNZ_3>.
331      ASSIGN CON_F_NULL TO <BUSG3_KENNZ_4>.
332      ASSIGN CON_F_NULL TO <BUSG3_KENNZ_5>.
333      ASSIGN CON_F_NULL TO <BUSG3_KENNZ_6>.
334      ASSIGN CON_F_NULL TO <BUSG3_SUMME_1>.
335      ASSIGN CON_F_NULL TO <BUSG3_SUMME_2>.
336      ASSIGN CON_F_NULL TO <BUSG3_SUMME_3>.
337      ASSIGN CON_F_NULL TO <BUSG3_SUMME_4>.
338      ASSIGN CON_F_NULL TO <BUSG3_SUMME_5>.
339      ASSIGN CON_F_NULL TO <BUSG3_SUMME_6>.
340      ASSIGN CON_F_NULL TO <BUSG3_UNIT>.
341
342      REFRESH BUSG3_EINHEITEN.
343      CLEAR   BUSG3_EINHEITEN.
344      CLEAR   BUSG3_INFO.
345      LOOP AT MARK_KENNZAHLEN.
346        BZ_SAV_TABIX = SY-TABIX.
347    *   Das Feld der Spalteneinheiten wird gesucht
348        _ASSIGN_X COMPONENT MARK_KENNZAHLEN-REFFIELD OF STRUCTURE SUM_S000
349                                                     TO <BUSG3_UNIT>.
350    *   Die verschiedenen Spalteneinheiten in BUSG3_EINHEITEN setzen
351        BUSG3_EINHEITEN-UNIT = <BUSG3_UNIT>.
352    *   IF NOT BUSG3_EINHEITEN-UNIT IS INITIAL.
353    *     SPACE ist keine Einheit
354        COLLECT BUSG3_EINHEITEN.
355    *   ENDIF.
356
357        DEFINE _WHEN_SET_BUSG3.
358          WHEN &1.
359            _ASSIGN_% COMPONENT MARK_KENNZAHLEN-FIELDNAME
360                                OF STRUCTURE AUS_S000 TO <BUSG3_KENNZ_&1>.
361            _ASSIGN_% COMPONENT MARK_KENNZAHLEN-FIELDNAME
362                                OF STRUCTURE SUM_S000 TO <BUSG3_SUMME_&1>.
363            BUSG3_INFO-DATATYPE&1 = MARK_KENNZAHLEN-DATATYPE.
364            BUSG3_INFO-EINHEIT&1  = <BUSG3_UNIT>.
365        END-OF-DEFINITION.
366
367        CASE BZ_SAV_TABIX.
368          _WHEN_SET_BUSG3 1.
369          _WHEN_SET_BUSG3 2.
370          _WHEN_SET_BUSG3 3.
371          _WHEN_SET_BUSG3 4.
372          _WHEN_SET_BUSG3 5.
373          _WHEN_SET_BUSG3 6.
374        ENDCASE.
375      ENDLOOP.
376    ENDFORM.                               "BUSG3_SPALTEN_ZUWEISEN
