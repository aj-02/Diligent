521    *&---------------------------------------------------------------------*
522    *&      Form  FILL_ARRAY_STACK
523    *&---------------------------------------------------------------------*
524    *       Fills array_stack with numerical key-figure data from Int_S000.
525    *       Considers also dynamically computed key-figures.
526    *----------------------------------------------------------------------*
527    *      -->ARRAY_STACK :    array_stack to fill
528    *      -->ROW_LABELS  :    of array
529    *      -->COL_LABELS  :    of array
530    *      -->num_key_figures: table of all numerical key-figures.
531    *      -->ROW_OBJECT, COL_OBJECT:
532    *----------------------------------------------------------------------*
533    FORM fill_array_stack TABLES
534                             array_stack   STRUCTURE array_f
535                             row_labels    STRUCTURE row_label_type
536                             col_labels    STRUCTURE col_label_type
537                             num_key_figures  STRUCTURE mcs05
538                             row_sum       STRUCTURE array_f
539                             col_sum       STRUCTURE array_f
540                          USING
541                             row_object  LIKE drilldown_fcodes-ddicfeld
542                             col_object  LIKE drilldown_fcodes-ddicfeld.
543
544      CONSTANTS: true  VALUE 'X',
545                 false VALUE ' '.
546
547      DATA: BEGIN OF array OCCURS 100,     "slice for array_stack
548                  f TYPE f,
549            END OF array.
550
551      DATA: data_line LIKE aus_s000,
552             sum_line LIKE aus_s000.
553
554      DATA: error_code, string(30),
555            row_index  LIKE sy-tabix,
556            col_index  LIKE sy-tabix,
557            array_stack_index LIKE sy-tabix,
558            no_of_cols  LIKE sy-tabix,
559            no_of_rows  LIKE sy-tabix,
560            key_figure_index LIKE sy-tabix,
561            row_sum_index LIKE sy-tabix,
562            col_sum_index LIKE sy-tabix,
563            slice_length TYPE i,        "number of elements per stack slice
564            slice_offset    LIKE sy-tabix,
565            slice_index     LIKE sy-tabix,
566            key_figure(20).
567
568      FIELD-SYMBOLS: <s000_row_field>, <s000_col_field>,
569                     <data_line_field>, <array_stack_entry>,
570                     <row_sum_f>, <col_sum_f>,
571                     <sum_line_field>, <total_sum>.
572
573    * Build array filled with zeros:
574      CLEAR array. REFRESH array.
575      LOOP AT row_labels.
576        LOOP AT col_labels.
577          APPEND array.
578        ENDLOOP.
579      ENDLOOP.
580
581    * Build array stack for all numerical key-figures.
582      LOOP AT num_key_figures.
583        APPEND LINES OF array TO array_stack.
584      ENDLOOP.
585
586    * Build tables for row and column sums:
587      CLEAR row_sum. REFRESH row_sum.
588      LOOP AT num_key_figures.
589        LOOP AT row_labels.
590          APPEND row_sum.
591        ENDLOOP.
592      ENDLOOP.
593      CLEAR col_sum. REFRESH col_sum.
594      LOOP AT num_key_figures.
595        LOOP AT col_labels.
596          APPEND col_sum.
597        ENDLOOP.
598      ENDLOOP.
599
600      DESCRIBE TABLE col_labels LINES no_of_cols.
601      DESCRIBE TABLE row_labels LINES no_of_rows.
602      slice_length = no_of_cols * no_of_rows.    "Length of one stack slice
603
604      PERFORM text_ermitteln USING    44
605    *                          'Daten werden verarbeitet...'
606                       CHANGING hlp_text1.
607      CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
608           EXPORTING
609                text = hlp_text1.
610
611      PERFORM dd_ranges_fuellen.           " <= note 190428
612
613      IF analyse_waehrung IS INITIAL.
614        PERFORM inttab_verd_2d_fast IN PROGRAM (lis_progname) IF FOUND
615                                   TABLES  row_labels  col_labels
616                                           num_key_figures
617                                           array_stack
618                                   USING   row_object  col_object.
619      ELSE.
620        PERFORM puffertab_fuellen_2d IN PROGRAM (lis_progname) IF FOUND
621                                   TABLES  row_labels  col_labels
622                                           num_key_figures
623                                           array_stack
624                                   USING   row_object  col_object.
625      ENDIF.
626
627
628    * Now compute row and column sums for all regular numerical key-figures:
629      key_figure_index = 0.
630      LOOP AT num_key_figures.             " for all numerical kfs
631        ADD 1 TO key_figure_index.
632        IF num_key_figures-tabname NS 'Z'. "regular key_figure?
633          slice_offset = ( key_figure_index - 1 ) * slice_length.
634          row_index = 0.
635          LOOP AT row_labels.              " loop at all rows
636            ADD 1 TO row_index .
637            row_sum_index = ( key_figure_index - 1 ) * no_of_rows
638                                                     + row_index.
639            CLEAR row_sum.
640            col_index = 0.
641            LOOP AT col_labels.            " loop at all cols
642              ADD 1 TO col_index.
643              array_stack_index = slice_offset +
644                               col_index + ( row_index - 1 ) * no_of_cols.
645              READ TABLE array_stack INDEX array_stack_index.
646              ADD array_stack-f TO row_sum-f.
647            ENDLOOP.
648            MODIFY row_sum INDEX row_sum_index.
649          ENDLOOP.
650    *     Now compute column sums and total sum for this slice:
651          num_key_figures-total_sum = 0.   "sum of column sums
652          col_index = 0.
653          LOOP AT col_labels.              "loop at all columns
654            ADD 1 TO col_index.
655            col_sum_index = ( key_figure_index - 1 ) * no_of_cols
656                                                     + col_index.
657            CLEAR col_sum.
658            row_index = 0.
659            LOOP AT row_labels.            " loop at all rows
660              ADD 1 TO row_index.
661              array_stack_index = slice_offset +
662                              col_index + ( row_index - 1 ) * no_of_cols.
663              READ TABLE array_stack INDEX array_stack_index.
664              ADD array_stack-f TO col_sum-f.
665            ENDLOOP.
666            MODIFY col_sum INDEX col_sum_index.
667            ADD col_sum-f TO num_key_figures-total_sum.
668          ENDLOOP.
669          num_key_figures-sum_mode = 'EXTERN'. "signal externally provided
670                                           "sums to LIST_ARRAY_STACK
671
672        ENDIF.                             "If regular key-figure
673        MODIFY num_key_figures.
674      ENDLOOP.                             " at num_key_figures.
675
676    *************************************************************
677    ** Now compute all dynamic key-figures.
678    *
679    ** loop at all matrix entries.
680    *  LOOP AT ROW_LABELS.
681    *    ROW_INDEX = SY-TABIX.
682    *    LOOP AT COL_LABELS.
683    *      COL_INDEX = SY-TABIX.
684    *      SLICE_INDEX = COL_INDEX + ( ROW_INDEX - 1 ) * NO_OF_COLS.
685    **     Transfer all key-figures for this array element into data_line
686    *      KEY_FIGURE_INDEX = 0.
687    *      CLEAR DATA_LINE.
688    *      LOOP AT NUM_KEY_FIGURES.
689    *        ADD 1 TO KEY_FIGURE_INDEX.
690    *        IF NUM_KEY_FIGURES-TABNAME NS 'Z'.       "regular key_figure?
691    *          KEY_FIGURE = NUM_KEY_FIGURES-FIELDNAME.
692    *          SLICE_OFFSET = ( KEY_FIGURE_INDEX - 1 ) * SLICE_LENGTH.
693    *                     " offset which points to the correct slice
694    *          CONCATENATE 'data_line-' KEY_FIGURE INTO STRING.
695    *          ASSIGN (STRING) TO <DATA_LINE_FIELD>.
696    *          ARRAY_STACK_INDEX = SLICE_OFFSET + SLICE_INDEX.
697    *          READ TABLE ARRAY_STACK INDEX ARRAY_STACK_INDEX.
698    *          MOVE ARRAY_STACK-F TO <DATA_LINE_FIELD>.
699    *        ENDIF.
700    *      ENDLOOP.
701    *
702    **     Now calculate dynamic key-figures
703    *      PERFORM ZUSATZKENNZAHLEN_BERECHNEN  IN PROGRAM (LIS_PROGNAME)
704    *                              CHANGING  DATA_LINE IF FOUND.
705    *
706    **     Now, transfer calculated key-figures back to array stack.
707    *      KEY_FIGURE_INDEX = 0.
708    *      LOOP AT NUM_KEY_FIGURES.
709    *        ADD 1 TO KEY_FIGURE_INDEX.
710    *        CHECK NUM_KEY_FIGURES-TABNAME CS 'Z'.    "dynamic key_figure?
711    *        KEY_FIGURE = NUM_KEY_FIGURES-FIELDNAME.
712    *        SLICE_OFFSET = ( KEY_FIGURE_INDEX - 1 ) * SLICE_LENGTH.
713    *                             " offset which points to the correct slice
714    *        ARRAY_STACK_INDEX = SLICE_OFFSET + SLICE_INDEX.
715    *        ASSIGN COMPONENT KEY_FIGURE OF STRUCTURE DATA_LINE
716    *                                 TO <ARRAY_STACK_ENTRY>.
717    *        ARRAY_STACK-F = <ARRAY_STACK_ENTRY>.
718    *        MODIFY ARRAY_STACK INDEX ARRAY_STACK_INDEX.
719    *      ENDLOOP.
720    *
721    *    ENDLOOP.   "at all
722    *  ENDLOOP.     "matrix indicees
723
724    ***************
725    * Now, compute row and column sums for all dynamic key-figures.
726      LOOP AT row_labels.                  "for all rows
727        row_index = sy-tabix.
728        key_figure_index = 0.
729        CLEAR data_line.
730    *   Fill key-figure structure.
731        LOOP AT num_key_figures.           "for all key-figures
732          ADD 1 TO key_figure_index.
733          CHECK num_key_figures-tabname NS 'Z'.       "regular key_figure?
734          key_figure = num_key_figures-fieldname.
735          row_sum_index  = ( key_figure_index - 1 ) * no_of_rows
736                                                    + row_index.
737          CONCATENATE 'data_line-' key_figure INTO string.
738          ASSIGN (string) TO <data_line_field>.
739          CHECK sy-subrc = 0.
740          READ TABLE row_sum INDEX row_sum_index.
741          MOVE row_sum-f TO <data_line_field>.
742        ENDLOOP.
743        PERFORM zusatzkennzahlen_berechnen  IN PROGRAM (lis_progname)
744                                      CHANGING data_line IF FOUND.
745
746    *  Transfer computed row sums back to row_sum table.
747        key_figure_index = 0.
748        LOOP AT num_key_figures.           "for all key-figures
749          ADD 1 TO key_figure_index.
750          CHECK num_key_figures-tabname CS 'Z'.       "dynamic key_figure?
751          key_figure = num_key_figures-fieldname.
752          row_sum_index  = ( key_figure_index - 1 ) * no_of_rows
753                                                    + row_index.
754          _assign_% component key_figure
755                    of structure data_line to <row_sum_f>.
756          CHECK sy-subrc = 0.
757          row_sum-f = <row_sum_f>.
758          MODIFY row_sum INDEX row_sum_index.
759        ENDLOOP.
760
761      ENDLOOP.                             "at row_labels
762
763    * Now compute column sums for all dynamic key-figures.
764      LOOP AT col_labels.                  "for all columns
765        col_index = sy-tabix.
766        key_figure_index = 0.
767        CLEAR data_line.
768    *   Fill data_line structure.
769        LOOP AT num_key_figures.           "for all key-figures
770          ADD 1 TO key_figure_index.
771          CHECK num_key_figures-tabname NS 'Z'.       "regular key_figure?
772          key_figure = num_key_figures-fieldname.
773          col_sum_index  = ( key_figure_index - 1 ) * no_of_cols
774                                                    + col_index.
775          CONCATENATE 'data_line-' key_figure INTO string.
776          ASSIGN (string) TO <data_line_field>.
777          CHECK sy-subrc = 0.
778          READ TABLE col_sum INDEX col_sum_index.
779          MOVE col_sum-f TO <data_line_field>.
780        ENDLOOP.
781        PERFORM zusatzkennzahlen_berechnen  IN PROGRAM (lis_progname)
782                                            CHANGING  data_line IF FOUND.
783
784    *  Transfer computed col sums back to col_sum table and total sums
785        key_figure_index = 0.
786        LOOP AT num_key_figures.           "for all key-figures
787          ADD 1 TO key_figure_index.
788          CHECK num_key_figures-tabname CS 'Z'.       "dynamic key_figure?
789          key_figure = num_key_figures-fieldname.
790          col_sum_index  = ( key_figure_index - 1 ) * no_of_cols
791                                                    + col_index.
792          _assign_% component key_figure
793                    of structure data_line to <col_sum_f>.
794          CHECK sy-subrc = 0.
795          col_sum-f = <col_sum_f>.
796          MODIFY col_sum INDEX col_sum_index.
797        ENDLOOP.
798
799      ENDLOOP.                             "at col_labels
800
801    ************************
802    * Compute the total sum entry for all dynamic key-figures and set its
803    * summation mode to 'EXTERN', so that sums are not computed internally
804    * in LIST_ARRAY_STACK.
805      key_figure_index = 0.
806      LOOP AT num_key_figures.
807        ADD 1 TO key_figure_index.
808        IF num_key_figures-tabname NS 'Z'. "regular key_figure?
809          key_figure = num_key_figures-fieldname.
810          CONCATENATE 'sum_line-' key_figure INTO string.
811          ASSIGN (string) TO <sum_line_field>.
812          CHECK sy-subrc = 0.
813          MOVE num_key_figures-total_sum TO <sum_line_field>.
814        ENDIF.
815      ENDLOOP.
816      PERFORM zusatzkennzahlen_berechnen  IN PROGRAM (lis_progname)
817                                          CHANGING  sum_line IF FOUND.
818
819    *  Transfer computed total sums back to num_key_figures
820      LOOP AT num_key_figures.             "for all key-figures
821        CHECK num_key_figures-tabname CS 'Z'.       "dynamic key_figure?
822        key_figure = num_key_figures-fieldname.
823        _assign_% component key_figure
824                  of structure sum_line to <total_sum>.
825        CHECK sy-subrc = 0.
826        num_key_figures-total_sum = <total_sum>.
827        num_key_figures-sum_mode = 'EXTERN'.
828        MODIFY num_key_figures.
829      ENDLOOP.
830
831    ENDFORM.                               " FILL_ARRAY_STACK
