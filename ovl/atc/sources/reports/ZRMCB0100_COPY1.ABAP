408      WRITE SY-VLINE NO-GAP.
409
410    * Farbinformation aus der Farbtabelle lesen für Exception-Farben
411      PERFORM COLOR_TAB_LESEN USING <AUSTAB_GLOBAL>-COLOR_ID.
412
413      IF NOT ANZ_MERKMALSKETTUNGEN IS INITIAL.
414    *-- Key zusammensetzen bei Merkmalskettung
415        ASSIGN L_ZEIT_OBJEKT TO <ZEIT_MERKMAL1>.
416        CASE ANZ_MERKMALSKETTUNGEN.
417          WHEN 1.
418            L_OFFSET_1 = OUTPUTLEN_ZEIT_OBJEKT_KETT1.
419          WHEN 2.
420            L_OFFSET_1 = OUTPUTLEN_ZEIT_OBJEKT_KETT1.
421            L_OFFSET_2 = L_OFFSET_1 + OUTPUTLEN_ZEIT_OBJEKT_KETT2.
422        ENDCASE.
423      ENDIF.
424
425      DARSTELLUNGSART = CON_DARST_EINZEL.
426
427      LOOP AT ZEIT_S000.
428        HIDE DARSTELLUNGSART.
429    *    ZA_INDEX = SY-TABIX.
430    *    PERFORM COLOR_TAB_LESEN USING ZEIT_S000-KENNZ-COLOR_ID.
431    *    SY-TABIX = ZA_INDEX.
432        CASE ANZ_MERKMALSKETTUNGEN.
433          WHEN 1.
434            L_ZEIT_OBJEKT              = <ZEIT_MERKMAL1_KETT1>.
435            L_ZEIT_OBJEKT+L_OFFSET_1   = <ZEIT_MERKMAL1_KETT2>.
436          WHEN 2.
437            L_ZEIT_OBJEKT              = <ZEIT_MERKMAL1_KETT1>.
438            L_ZEIT_OBJEKT+L_OFFSET_1   = <ZEIT_MERKMAL1_KETT2>.
439            L_ZEIT_OBJEKT+L_OFFSET_2   = <ZEIT_MERKMAL1_KETT3>.
440        ENDCASE.
441
442        IF ZA_SAV_MERKMAL1 <> <ZEIT_MERKMAL1> OR SY-TABIX = 1.
443    *     neues Merkmal oder erstes Merkmal
444          IF SY-TABIX <> 1 AND ZA_PERI_ZAEHLER <= ZA_LETZTE_SPALTE.
445    *       mögliche Leereinträge des letzten Eintrags füllen
446            ZA_HLP_ZAEHLER = ZA_LETZTE_SPALTE + 1 - ZA_PERI_ZAEHLER.
447            DO ZA_HLP_ZAEHLER TIMES.
448    *         entsprechend viele Leerspalten ausgeben
449              PERFORM PLANTAB_AUSGEBEN_KENNZ
450                USING SPACE
451                      SPACE
452                      ZA_SPALTE_MERKMAL2
453                      ZA_SPALTE_REFLEN
454                      KENNZAHL_SPALTE-DATATYPE
455                      KENNZAHL_SPALTE-REFFIELD
456                      KENNZAHL_SPALTE-FACTOR
457                      KENNZAHL_SPALTE-ODECIMALS.
458            ENDDO.
459          ENDIF.
460    *     neues Merkmal => Zaehler, Vergleichsmerkmal initialisieren
461          ZA_PERI_ZAEHLER = ZA_ZEITREIHEN_ERSTE_SPALTE.
462          ZA_SAV_MERKMAL1 = <ZEIT_MERKMAL1>.
463          IF SY-TABIX <> 1.
464            WRITE SY-VLINE NO-GAP.
465          ENDIF.
466    *     Text ermitteln
467          PERFORM OBJEKTTEXT_ERMITTELN
468                USING    AKT_DRILLDOWN-DOMNAME
469                         AKT_DRILLDOWN-ROLLNAME
470                         AKT_DRILLDOWN-CONVEXIT
471                         AKT_DRILLDOWN-OUTPUTLEN
472                         <ZEIT_MERKMAL1>
473                CHANGING ZA_OBJEKTTEXT.
474    *     neue Zeile => Merkmal ausgeben
475          WRITE / SY-VLINE NO-GAP.
476
477          IF GF_ACC_ON = FALSE.
478    * Modus is non accessible
479          WRITE AT (ZA_SPALTE_MERKMAL1) ZA_OBJEKTTEXT
480                               COLOR       = COLOR_TAB-COL_MERKMAL
481                               INTENSIFIED = COLOR_TAB-INT_MERKMAL
482                               INVERSE     = COLOR_TAB-INV_MERKMAL
483                               NO-GAP.
484
485    *     Farbformat für Kennzahlen setzen.
486          FORMAT COLOR       = COLOR_TAB-COL_KENNZAHL
487                 INTENSIFIED = COLOR_TAB-INT_KENNZAHL
488                 INVERSE     = COLOR_TAB-INV_KENNZAHL.
489          ELSE.
490    * Modus is accessible
491           ZA_NUR = COLOR_TAB-COL_MERKMAL.
492        IF ZA_NUR = 5.
493           ZA_NUR_HELP = 501.
494           SELECT SINGLE NTEXT FROM TMCRT INTO ZA_QUICKINFO
495                WHERE SPRAS = SY-LANGU AND TXTNR = ZA_NUR_HELP.
496           CLEAR ZA_NUR.
497           ZA_NUR = 4.
498        ELSEIF ZA_NUR = 3.
499           ZA_NUR_HELP = 502.
500           SELECT SINGLE NTEXT FROM TMCRT INTO ZA_QUICKINFO
501                WHERE SPRAS = SY-LANGU AND TXTNR = ZA_NUR_HELP.
502           CLEAR ZA_NUR.
503           ZA_NUR = 4.
504        ELSEIF ZA_NUR = 6.
505           ZA_NUR_HELP = 503.
506           SELECT SINGLE NTEXT FROM TMCRT INTO ZA_QUICKINFO
507                WHERE SPRAS = SY-LANGU AND TXTNR = ZA_NUR_HELP.
508           CLEAR ZA_NUR.
509           ZA_NUR = 4.
510        ELSE.
511           CLEAR ZA_NUR_HELP.
512           CLEAR ZA_QUICKINFO.
513        ENDIF.
514
515    * Accessibility modus
516
517           WRITE AT (ZA_SPALTE_MERKMAL1) ZA_OBJEKTTEXT
518                               COLOR       = ZA_NUR
519                               INTENSIFIED = COLOR_TAB-INT_MERKMAL
520                               INVERSE     = COLOR_TAB-INV_MERKMAL
521                               QUICKINFO ZA_QUICKINFO NO-GAP.
522
523    *     Farbformat für Kennzahlen setzen.
524          FORMAT COLOR       = 2
525                 INTENSIFIED = COLOR_TAB-INT_KENNZAHL
526                 INVERSE     = COLOR_TAB-INV_KENNZAHL.
527
528          ENDIF.
529        ENDIF.
530        READ TABLE ZEIT_PERIODEN WITH KEY <ZEIT_MERKMAL2>.
531        IF SY-TABIX >= ZA_ZEITREIHEN_ERSTE_SPALTE AND
532           SY-TABIX <= ZA_LETZTE_SPALTE.
533    *     nur Perioden aus dem anzeigbaren Intervall betrachten
534          ZA_HLP_ZAEHLER = SY-TABIX - ZA_PERI_ZAEHLER.
535          DO ZA_HLP_ZAEHLER TIMES.
536    *       entsprechend viele Leerspalten ausgeben
537            PERFORM PLANTAB_AUSGEBEN_KENNZ
538              USING SPACE
539                    SPACE
540                    ZA_SPALTE_MERKMAL2
541                    ZA_SPALTE_REFLEN
542                    KENNZAHL_SPALTE-DATATYPE
543                    KENNZAHL_SPALTE-REFFIELD
544                    KENNZAHL_SPALTE-FACTOR
545                    KENNZAHL_SPALTE-ODECIMALS.
546          ENDDO.
547          PERFORM PLANTAB_AUSGEBEN_KENNZ
548            USING <ZEIT_KENNZAHL>
549                  <ZEIT_KENNZAHL_EINH>
550                  ZA_SPALTE_MERKMAL2
551                  ZA_SPALTE_REFLEN
552                  KENNZAHL_SPALTE-DATATYPE
553                  KENNZAHL_SPALTE-REFFIELD
554                  KENNZAHL_SPALTE-FACTOR
555                  KENNZAHL_SPALTE-ODECIMALS.
556    *     Hilfszähler entsprechend weiterschalten
557          ZA_PERI_ZAEHLER = ZA_PERI_ZAEHLER + 1 + ZA_HLP_ZAEHLER.
558        ENDIF.
559      ENDLOOP.
560
561    * letzter Eintrag: noch fehlende Spalten ergänzen
562      HIDE DARSTELLUNGSART.
563      IF ZA_PERI_ZAEHLER <= ZA_LETZTE_SPALTE.
564    *   mögliche Leereinträge des letzten Eintrags füllen
565        ZA_HLP_ZAEHLER = ZA_LETZTE_SPALTE + 1 - ZA_PERI_ZAEHLER.
566        DO ZA_HLP_ZAEHLER TIMES.
567    *    entsprechend viele Leerspalten ausgeben
568          PERFORM PLANTAB_AUSGEBEN_KENNZ
569            USING SPACE
570                  SPACE
571                  ZA_SPALTE_MERKMAL2
572                  KENNZAHL_SPALTE-REFLEN
573                  KENNZAHL_SPALTE-DATATYPE
574                  KENNZAHL_SPALTE-REFFIELD
575                  KENNZAHL_SPALTE-FACTOR
576                  KENNZAHL_SPALTE-ODECIMALS.
577        ENDDO.
578      ENDIF.
579      WRITE SY-VLINE NO-GAP.
580
581    * Unterstrich ausgeben
582      NEW-LINE.
583      ULINE AT (ZEITREIHEN_POPUP_WIDTH).
584
585    ENDFORM.                               "ZEITREIHE_AUSGEBEN
