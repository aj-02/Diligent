717    *---------------------------------------------------------------------*
718    *       FORM HIERARCHIE_AKT_DDOWN_ANPASSEN                            *
719    *---------------------------------------------------------------------*
720    *       Einträge zum aktuellen Hierarchieaufriß in der Tabelle        *
721    *       AKT_DRILLDOWN ändern                                          *
722    *---------------------------------------------------------------------*
723    *  -->  HA_FLG_ALLES_BLAETTER: Flag, das angibt, ob im aktuellen      *
724    *                              Hierarchieaufriß nur Blätter vorkommen *
725    *  -->  HA_NACHF_ANZAHL      : Nachfolgeranzahl des aufgerissenen     *
726    *                              Hierarchieknotens                      *
727    *---------------------------------------------------------------------*
728    FORM hierarchie_akt_ddown_anpassen
729                                  USING ha_flg_alles_blaetter TYPE boolean
730                                        ha_nachf_anzahl       LIKE sy-tabix.
731
732      IF ha_flg_alles_blaetter = true.
733    *   Alle Nachf. sind Blätter => Hierarchie- durch Blattaufriß ersetzen
734        READ TABLE akt_drilldown INDEX drilldown_eintraege.
735    *   Merkmals-Fcode zum Hierarchieaufriß setzen
736        CLEAR akt_drilldown.
737        READ TABLE drilldown_fcodes
738          WITH KEY fcode = akt_hierarchie-merkmals_fcode BINARY SEARCH.
739        MOVE-CORRESPONDING drilldown_fcodes TO akt_drilldown.
740        MODIFY akt_drilldown INDEX drilldown_eintraege.
741        IF ha_nachf_anzahl = 0.
742    *     Aufzureißender Hierarchieknoten ist Blatt
743          PERFORM drilldown_fcode_bestimmen CHANGING sav_fcode.
744          IF NOT sav_fcode IS INITIAL.
745    *       Nächster Aufriß-Fcode konnte ermitteln werden
746            READ TABLE drilldown_fcodes WITH KEY fcode = sav_fcode
747                                             BINARY SEARCH.
748            MOVE-CORRESPONDING drilldown_fcodes TO akt_drilldown.
749            MODIFY akt_drilldown INDEX drilldown_eintraege.
750    *       AUSTAB durch 'normalen' Aufriß füllen
751            PERFORM austab_fuellen.
752          ENDIF.
753        ENDIF.
754        IF AKT_DRILLDOWN-KETT_AKT EQ TRUE.                 " <= note 173354
755          PERFORM MERKMALSKETTUNG_INTTAB                   " <= note 173354
756                  CHANGING ANZ_MERKMALSKETTUNGEN.          " <= note 173354
757        ENDIF.                                             " <= note 173354
758      ELSE.
759    *   Übernehme DD-Info zum Knotentyp des 1. Nachfolgerknotens des auf-
760    *   zureißenden Knotens (HA_KNOTEN_ID) in AKT_DRILLDOWN
761        READ TABLE succtab INDEX 1.
762        READ TABLE rsttyp_info WITH KEY type = succtab-type.
763        IF sy-subrc = 0.
764    *     Typinfo übertragen
765          READ TABLE akt_drilldown INDEX drilldown_eintraege.
766          MOVE-CORRESPONDING rsttyp_info TO akt_drilldown.
767          akt_drilldown-domname   = rsttyp_info-tdomnm.
768          akt_drilldown-rollname  = rsttyp_info-rolnm.
769          MODIFY akt_drilldown INDEX drilldown_eintraege.
770        ENDIF.
771      ENDIF.
772    ENDFORM.                               "HIERARCHIE_AKT_DDOWN_ANPASSEN
