4878   *---------------------------------------------------------------------*
4879   *       FORM ZUSATZKENNZAHLEN_BEWEGUNGEN                              *
4880   *---------------------------------------------------------------------*
4881   *       Es werden zusätzliche Kennzahlen zu den Materialbewegungen    *
4882   *       berechnet
4883   *---------------------------------------------------------------------*
4884   *  -->  KZ_EINTRAG                                                    *
4885   *---------------------------------------------------------------------*
4886   FORM zusatzkennzahlen_bewegungen CHANGING kz_eintrag STRUCTURE aus_s000.
4887
4888     IF kz_eintrag-azubb <> 0.
4889   *Mittlerer Zugang bewerteter Bestand
4890       kz_eintrag-dzubb = kz_eintrag-mzubb / kz_eintrag-azubb.
4891   *Wert mittlerer Zugang bewerteter Bestand
4892       kz_eintrag-dzwbb = kz_eintrag-wzubb / kz_eintrag-azubb.
4893     ENDIF.
4894     IF kz_eintrag-aagbb <> 0.
4895   *Mittlerer Abgang bewerter Bestand
4896       kz_eintrag-dagbb = kz_eintrag-magbb / kz_eintrag-aagbb.
4897   *Wert mittlerer Abgang bewerteter Bestand
4898       kz_eintrag-dawbb = kz_eintrag-wagbb / kz_eintrag-aagbb.
4899     ENDIF.
4900     IF kz_eintrag-azukb <> 0.
4901   *Mittlerer Zugang Konsi-Bestand
4902       kz_eintrag-dzukb = kz_eintrag-mzukb / kz_eintrag-azukb.
4903     ENDIF.
4904     IF kz_eintrag-aagkb <> 0.
4905   *Mittlerer Abgang Konsi-Bestand
4906       kz_eintrag-dagkb = kz_eintrag-magkb / kz_eintrag-aagkb.
4907     ENDIF.
4908     IF kz_eintrag-agvbr <> 0.
4909   *Mittlere Gesamtverbrauchsmenge
4910       kz_eintrag-dgvbr = kz_eintrag-mgvbr / kz_eintrag-agvbr.
4911   *Mittlerer Gesamtverbrauchswert
4912       kz_eintrag-dwgvbr = kz_eintrag-wgvbr / kz_eintrag-agvbr.
4913     ENDIF.
4914   * Mittlere Ungeplante Verbrauchsmenge
4915     IF kz_eintrag-auvbr <> 0.
4916       kz_eintrag-duvbr = kz_eintrag-muvbr / kz_eintrag-auvbr.
4917   * Mittlerer ungeplanter Verbrauchswert
4918       kz_eintrag-dwuvbr = kz_eintrag-wuvbr / kz_eintrag-auvbr.
4919     ENDIF.
4920
4921   ENDFORM.                               "zusatzkennzahlen_bewegungen
