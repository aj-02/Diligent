500    *---------------------------------------------------------------------*
501    *       FORM INITIAL_EWS_DATEN                                        *
502    *---------------------------------------------------------------------*
503    *       ........                                                      *
504    *---------------------------------------------------------------------*
505    FORM initial_ews_daten.
506      DATA: id_txtlen LIKE sy-fdpos.
507
508      IF sy-batch = true.
509        EXIT.
510      ENDIF.
511
512      IMPORT exc_mode FROM MEMORY ID 'EWS1'.
513      IF exc_mode = 'D' AND sy-slset <> space.
514      ELSE.
515        hlp_exc_mode = exc_mode.
516        CLEAR exc_mode.
517        EXPORT exc_mode TO MEMORY ID 'EWS1'.
518        exc_mode = hlp_exc_mode.
519      ENDIF.
520      IMPORT exc_no FROM MEMORY ID 'EWS2'.
521      hlp_exc_no = exc_no.
522      CLEAR exc_no.
523      EXPORT exc_no TO MEMORY ID 'EWS2'.
524      exc_no = hlp_exc_no.
525
526      IF exc_mode = 'A' OR
527         exc_mode = 'B' OR
528         exc_mode = 'C'.
529    *----------- Daten zur Exception
530        PERFORM lesen_daten_exception.
531        PERFORM fuellen_mcyb_alle.
532        PERFORM ranges_fuellen TABLES int_mcyb
533                            USING  'SL_'.
534      ENDIF.
535
536      IF exc_mode = 'A'.
537        PERFORM setzen_zeitr_select.
538    *   Texte für Titelzeile setzen
539        PERFORM text_ermitteln USING    303
540    *                                   "Exceptionanalyse"
541                               CHANGING hlp_text1.
542        titlebar_text     = hlp_text1(20).
543        analyse_text      = hlp_text1(20).
544        analysemenue_text = hlp_text1(20).
545        id_txtlen = strlen( titlebar_text ).
546        IF id_txtlen = 0.
547    *     TITLEBAR_TEXT ist initial, d. h. noch nicht übersetzt
548          id_txtlen = 1.
549        ENDIF.
550        ASSIGN analyse_text(id_txtlen) TO <analyse_name>.
551    *   if flg_selektion = true.
552    *     Sprung zu Selektionsversion anz. und Benutzereinst. ausblenden
553    *     perform excl_fcodes_fuellen.
554    *     "&: Selektion"
555    *     perform pf_status_setzen using 'SELE0001'
556    *                                    tit_code_selektion
557    *                                    titlebar_text.
558    *   endif.
559      ENDIF.
560
561    *----------- Bei Analysebereich anlegen, aendern etc.
562    *----------- Refresh auf Periodentabellen, Perioden werden bei
563    *----------- START_OF_SELECTION aus Exception gesetzt
564    *----------- 3.0C
565    *----------- 3.0D: 'D': BAPI, Perioden aus Selektion
566      IF exc_mode = 'B' OR
567         exc_mode = 'C' OR
568         exc_mode = 'D'.
569        REFRESH sl_sptag.
570        REFRESH sl_spwoc.
571        REFRESH sl_spmon.
572        REFRESH sl_spbup.
573      ENDIF.
574
575    ENDFORM.
