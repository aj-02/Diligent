316        as_struc-eisbe   = as_struc-eisbe   + as_austab-eisbe.
317    *   else.
318    *     as_struc-eisbe   = as_austab-eisbe.
319    *   endif.
320      ENDIF.
321
322      IF as_struc-%bklas NE as_austab-%bklas
323        AND NOT as_austab-%bklas IS INITIAL.
324        IF as_struc-%bklas IS INITIAL.
325          as_struc-%bklas = as_austab-%bklas.
326        ELSE.
327          as_struc-%bklas = con_kennzahlwert_ungueltig.
328        ENDIF.
