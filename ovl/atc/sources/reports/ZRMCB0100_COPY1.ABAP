575    *---------------------------------------------------------------------*
576    *       FORM KENNZAHLEN_LISTE_AUSGEBEN                                *
577    *---------------------------------------------------------------------*
578    *       Ausgabe einer Liste aller Kennzahlen zu einer Merkmalsauspräg.*
579    *---------------------------------------------------------------------*
580    FORM KENNZAHLEN_LISTE_AUSGEBEN.
581
582      DATA: KL_SAV_FLG_PROZENTWERT TYPE BOOLEAN,
583            KL_SAV_FLG_ZENTRIEREN  TYPE BOOLEAN,
584            KL_SAV_DARSTELLUNGSART TYPE BOOLEAN,
585            KL_FELDNAME(30),
586            KL_MAX_OUTPUTLEN       LIKE KENNZAHLEN_TAB-OUTPUTLEN,
587            KL_MAX_REFLEN          LIKE KENNZAHLEN_TAB-REFLEN,
588            KL_MAX_ZEILENLEN       LIKE KENNZAHLEN_TAB-OUTPUTLEN,
589            KL_RETURNCODE          LIKE SY-SUBRC,
590            KL_SUM_TABINDEX        LIKE SY-TABIX,
591            KL_FLG_FARBE           TYPE BOOLEAN,
592            KL_FLG_CUSTOMER_ACTIVATED TYPE BOOLEAN.
593
594      LOCAL DARSTELLUNGSART.
595      FIELD-SYMBOLS: <KL_KENNZAHL>,
596                     <KL_EINHEIT>.
597
598    * Flags sichern und ausschalten
599      KL_SAV_FLG_PROZENTWERT = FLG_PROZENTWERT.
600      KL_SAV_FLG_ZENTRIEREN  = FLG_ZENTRIEREN.
601      FLG_PROZENTWERT        = FALSE.
602      FLG_ZENTRIEREN         = FALSE.
603
604      LOOP AT KENNZAHLEN_TAB.
605        IF KL_MAX_OUTPUTLEN < KENNZAHLEN_TAB-OUTPUTLEN.
606          KL_MAX_OUTPUTLEN = KENNZAHLEN_TAB-OUTPUTLEN.
607        ENDIF.
608        IF KL_MAX_REFLEN < KENNZAHLEN_TAB-REFLEN.
609          KL_MAX_REFLEN = KENNZAHLEN_TAB-REFLEN.
610        ENDIF.
611      ENDLOOP.
612      KL_MAX_ZEILENLEN = 20 + 2 + KL_MAX_OUTPUTLEN + KL_MAX_REFLEN + 1.
613
614      IF FLG_LIS_REPORTING = TRUE.
615    * Aufruf des Customer-Exits zur Veränderung der aller Kennzahlen
616        CALL FUNCTION 'MC_KEY_FIGURES_CHANGE'
617             EXPORTING
618                  I_MCINF           = HLP_MCINF
619                  I_FLG_ALL_FIGURES = TRUE
620                  I_OBJECT          = AKT_OBJEKT
621             IMPORTING
622                  E_FLG_ACTIVATED   = KL_FLG_CUSTOMER_ACTIVATED
623             TABLES
624                  T_AUS_S000        = AUS_S000
625                  T_DRILLDOWN       = AKT_DRILLDOWN
626                  T_KEY_FIGURES     = KENNZAHLEN_TAB
627                  T_KEY_FIGURES_DEF = KENNZAHLEN_TAB
628             EXCEPTIONS
629                  OTHERS            = 1.
630
631        IF KL_FLG_CUSTOMER_ACTIVATED = TRUE.
632    *     Kennzahlentexte wurden verändert
633        ENDIF.
634      ENDIF.                               "if flg_lis_reporting = true.
635
636      IF DARSTELLUNGSART = CON_DARST_EINZEL.
637    *   Objekt ist näher spezifiziert => Kennzahlen zum Merkmal ausgeben
638        READ TABLE AUS_S000 INDEX AUSTAB_TABIX.
639    *   AKT_OBJEKT explizit für zeilenweises Blättern setzen
640        AKT_OBJEKT  = <AUSTAB_GLOBAL>-OBJEKT.
641      ELSE.
642    *   Objekt ist nicht näher spezifiziert => Kennzahlen zur Summe ausgeben
643        IF FLG_HEADER_PATH    = TRUE AND
644           FLG_SUMTAB_TABELLE = TRUE.
645          PERFORM SEITENNUMMER_ERMITTELN IN PROGRAM (LIS_PROGNAME) IF FOUND
646                                         CHANGING KL_SUM_TABINDEX.
647          READ TABLE SUM_S000 WITH KEY ('ID') = KL_SUM_TABINDEX.
648        ENDIF.
649      ENDIF.
650
651      KL_SAV_DARSTELLUNGSART = DARSTELLUNGSART.
652      LOOP AT KENNZAHLEN_TAB.
653        TABINDEX = SY-TABIX.
654        IF DARSTELLUNGSART = CON_DARST_EINZEL.
655          _ASSIGN_% COMPONENT KENNZAHLEN_TAB-FIELDNAME
656                              OF STRUCTURE AUS_S000 TO <KL_KENNZAHL>.
657          _ASSIGN_X COMPONENT KENNZAHLEN_TAB-REFFIELD
658                              OF STRUCTURE AUS_S000 TO <KL_EINHEIT>.
659        ELSE.
660          _ASSIGN_% COMPONENT KENNZAHLEN_TAB-FIELDNAME
661                              OF STRUCTURE SUM_S000 TO <KL_KENNZAHL>.
662          _ASSIGN_X COMPONENT KENNZAHLEN_TAB-REFFIELD
663                              OF STRUCTURE SUM_S000 TO <KL_EINHEIT>.
664        ENDIF.
665        IF KL_SAV_DARSTELLUNGSART = CON_DARST_EINZEL  AND
666           NOT EXCEPTION IS INITIAL                   AND
667           <AUSTAB_GLOBAL>-COLOR_ID <> CON_COLOR_EINZEL AND
668           KENNZAHLEN_TAB-FLG_EWS_RELEVANT = TRUE.
669    *     Kennzahlen ist für EWS relevant => farbige Ausgabe
670          KL_FLG_FARBE = TRUE.
671          PERFORM COLOR_TAB_LESEN USING <AUSTAB_GLOBAL>-COLOR_ID.
672          FORMAT COLOR       = COLOR_TAB-COL_KENNZAHL
673                 INTENSIFIED = COLOR_TAB-INT_KENNZAHL
674                 INVERSE     = COLOR_TAB-INV_KENNZAHL.
675          WRITE: /(20) KENNZAHLEN_TAB-SCRTEXT_L.
676
677        ELSE.
678          PERFORM SPEZIAL_KENNZAHLEN_LISTE_FARBE IN PROGRAM (SY-REPID)
679                                                 IF FOUND
680                                                 USING    KENNZAHLEN_TAB
681                                                          <KL_KENNZAHL>
682                                                 CHANGING KL_FLG_FARBE.
683          IF KL_FLG_FARBE = TRUE.
684    *       Ausgabe in spezieller Farbe
685            WRITE: /(20) KENNZAHLEN_TAB-SCRTEXT_L.
686
687          ELSE.
688    *       normale Ausgabe
689            WRITE: /(20) KENNZAHLEN_TAB-SCRTEXT_L COLOR COL_BACKGROUND
690                         INTENSIFIED.
691          ENDIF.
692        ENDIF.
693    *   read table kennzahlen_tab index sy-tabix.
694        IF FLG_ALLE_KENNZ_LINKS = FALSE.
695          KENNZAHLEN_TAB-OUTPUTLEN = KL_MAX_OUTPUTLEN.
696        ENDIF.
697        DARSTELLUNGSART = CON_DARST_KENNZAHL.
698        PERFORM KENNZAHL_AUSGEBEN USING    0 <KL_KENNZAHL> <KL_KENNZAHL>
699                                           <KL_EINHEIT>
700                                  CHANGING KL_RETURNCODE.
701        HIDE: DARSTELLUNGSART, TABINDEX.
702        DARSTELLUNGSART = KL_SAV_DARSTELLUNGSART.
703        IF KL_FLG_FARBE = TRUE.
704    *     Farbige Zeile => Zeilen mit Blanks auf gleiche Länge bringen
705          WHILE SY-COLNO < KL_MAX_ZEILENLEN.
706            WRITE ' '  NO-GAP.
707          ENDWHILE.
708          FORMAT RESET.
709          KL_FLG_FARBE = FALSE.
710        ENDIF.
711
712    *   darstellungsart = con_darst_kennzahl.
713    *   hide: darstellungsart, tabindex.
714    *   darstellungsart = kl_sav_darstellungsart.
715      ENDLOOP.
716
717    * Flags wieder herstellen
718      FLG_PROZENTWERT = KL_SAV_FLG_PROZENTWERT.
719      FLG_ZENTRIEREN  = KL_SAV_FLG_ZENTRIEREN.
720
721    ENDFORM.                               "KENNZAHLEN_LISTE_AUSGEBEN
722
723
724    *---------------------------------------------------------------------*
725    *       FORM KENNZAHLEN_MARKIEREN                                     *
726    *---------------------------------------------------------------------*
727    *       Aus den in der Liste angezeigten Kennzahlen werden welche     *
728    *       durch Markierung ausgewählt                                   *
729    *---------------------------------------------------------------------*
730    *  -->  KM_KENNZAHLEN    : Tabelle mit den auswählbaren Kennzahlen    *
731    *  -->  KM_MIN_KENNZAHLEN: minimale Anzahl                            *
732    *  -->  KM_MAX_KENNZAHLEN: maximale Anzahl                            *
733    *  -->  KM_FLG_MARKIERT  : Flag für Markierung der Kennzahlen         *
734    *                          = TRUE => alle Kennzahlen sind markiert    *
735    *  -->  KM_TITEL         : Textnr. für Titel im Markierungs-FB        *
736    *  -->  KM_TEXTZEILE     : Textzeile für Überschrift im Popup
737    *  <->  KM_FLG_MARK      : Flag, das gültige Markierung anzeigt       *
738    *                          = TRUE, wenn Felder markiert wurden        *
739    *                          = FALSE, wenn Markierung abgebrochen wurde *
740    *---------------------------------------------------------------------*
741    FORM KENNZAHLEN_MARKIEREN
742                   TABLES    KM_KENNZAHLEN       STRUCTURE AKT_KENNZAHLEN
743                   USING     KM_MIN_KENNZAHLEN   TYPE  I
744                             KM_MAX_KENNZAHLEN   TYPE  I
745                             KM_FLG_MARKIERT     TYPE  BOOLEAN
746                             KM_INTTYPE          TYPE  C
747                             KM_TITEL            LIKE  TMCRT-TXTNR
748                             KM_TEXTZEILE        TYPE  C
749                   CHANGING  KM_FLG_MARK         TYPE  BOOLEAN.
750
751      FIELD-SYMBOLS: <KM_HLP_KENNZ>.
752      DATA: BEGIN OF KM_MARK_FELDER OCCURS 6.
753              INCLUDE STRUCTURE MCS01.
754      DATA: END   OF KM_MARK_FELDER.
755
756      DATA: ZUSATZ_GSTRU LIKE TMC4-GSTRU.
757
758      REFRESH KENNZAHLEN_SSTAB.
759      LOOP AT KM_KENNZAHLEN.
760        CHECK KM_INTTYPE            IS INITIAL OR
761              KM_KENNZAHLEN-INTTYPE CA KM_INTTYPE.
762    *   Es werden nur Zahl-Kennzahlen berücksichtigt
763        MOVE-CORRESPONDING KM_KENNZAHLEN TO KENNZAHLEN_SSTAB.
764        APPEND KENNZAHLEN_SSTAB.
765      ENDLOOP.
766
767      DESCRIBE TABLE KENNZAHLEN_SSTAB LINES SY-TFILL.
768    * Prüfung, ob ausschl. merkmalsähnliche Kennzahlen in Grundliste
769
770      IF SY-TFILL > 0.
771    *   continue
772      PERFORM TEXT_ERMITTELN USING    006
773    *                        'Kennzahlen'
774                             CHANGING HLP_TEXT1.
775      PERFORM TEXT_ERMITTELN USING    005
776    *                        'Kennzahl'
777                             CHANGING HLP_TEXT2.
778      PERFORM TEXT_ERMITTELN USING    KM_TITEL
779                             CHANGING HLP_TEXT3.
780      CALL FUNCTION 'MC_POPUP_TO_MARK_FIELDS'
781           EXPORTING
782                I_FIELDS_MARKED        = KM_FLG_MARKIERT
783                I_FIELD_NUMBER_MAX     = KM_MAX_KENNZAHLEN
784                I_FIELD_NUMBER_MIN     = KM_MIN_KENNZAHLEN
785                I_OBJECT_NAME_PLURAL   = HLP_TEXT1
786                I_OBJECT_NAME_SINGULAR = HLP_TEXT2
787                I_POPUP_TITLE          = HLP_TEXT3
788                I_TEXTLINE             = KM_TEXTZEILE
789           IMPORTING
790                E_MARKED               = KM_FLG_MARK
791           TABLES
792                T_FIELDS               = KENNZAHLEN_SSTAB
793                T_MARKED_FIELDS        = KM_MARK_FELDER.
794           export km_mark_felder km_flg_mark to memory id 'PSINFOMARK'.
795      ELSE.
796    *   Es sind nur merkmalsähnliche Kennzahlen in der Grundliste vorhanden.
797        MESSAGE I172.
798      ENDIF.
799
800      IF KM_FLG_MARK = TRUE.
801    *   Kennzahlen wurden markiert
802        REFRESH MARK_KENNZAHLEN.
803        CLEAR MARK_KENNZAHLEN.
804
805    *   ZUSATZ_GSTRU wird verwendet, um zu prüfen, ob es sich bei der
806    *   Kennzahl um eine Zusatzkennzahl handelt - eine Zusatzkennzahl hat
807    *   ihren Ursprung in der Erweiterungsstruktur der jew. Applikation,
808    *   z.B. MCVKENNZ1 für den Vertrieb. Wird festgestellt, daß in Tabelle
809    *   km_mark_felder ein Eintrag auf eine Referenzstruktur verweist, wird
810    *   der Feldname in der ersten Stelle um '%' erweitert. An dieser
811    *   Bezeichnung wird die Zusatzkennzahl erkannt.
812
813        LOOP AT KENNZAHLEN_SSTAB
814                WHERE TABNAME BETWEEN 'S001' AND 'S999'.      "#EC PORTABLE
815          ZUSATZ_GSTRU = KENNZAHLEN_SSTAB-TABNAME.
816          EXIT.
817        ENDLOOP.
818
819        LOOP AT KM_MARK_FELDER.
820    *     Erklärung der IF-Abfrage: siehe letzten Kommentar
821          MOVE-CORRESPONDING KM_MARK_FELDER TO MARK_KENNZAHLEN.
822          IF NOT ZUSATZ_GSTRU IS INITIAL AND
823             ZUSATZ_GSTRU     <> KM_MARK_FELDER-TABNAME.
824            CLEAR MARK_KENNZAHLEN-FIELDNAME.
825            MARK_KENNZAHLEN-FIELDNAME   = '%'.
826            MARK_KENNZAHLEN-FIELDNAME+1 = KM_MARK_FELDER-FIELDNAME.
827          ENDIF.
828    *     Länge des Einheitenfeldes ermitteln
829          IF KM_MARK_FELDER-REFFIELD IS INITIAL.
830            CLEAR MARK_KENNZAHLEN-REFLEN.
831          ELSE.
832            READ TABLE UNIT_TAB WITH KEY KM_MARK_FELDER-REFFIELD
833                                         BINARY SEARCH.
834            MARK_KENNZAHLEN-REFLEN = UNIT_TAB-OUTPUTLEN.
835          ENDIF.
836    *     Kennzahlüberschrift in Abhängigkeit der Spaltenbreite ermitteln
837          PERFORM KENNZAHLENTEXT_ERMITTELN USING    MARK_KENNZAHLEN
838                                           CHANGING MARK_KENNZAHLEN-REPTEXT.
839    *     Gesamt-Kennzeichen der Kennzahl bestimmen
840          READ TABLE AKT_KENNZAHLEN
841                           WITH KEY TABNAME   = KM_MARK_FELDER-TABNAME
842                                    FIELDNAME = KM_MARK_FELDER-FIELDNAME.
843          MARK_KENNZAHLEN-GESAMTKZ = AKT_KENNZAHLEN-GESAMTKZ.
844    *     Name des Kennzahlausgabefeldes setzen
845          IF MARK_KENNZAHLEN-GESAMTKZ = TRUE OR FLG_LIS_REPORTING = FALSE.
846            CONCATENATE AUSTAB_NAME MARK_KENNZAHLEN-FIELDNAME
847                        INTO MARK_KENNZAHLEN-AUSTABFELD.
848          ELSE.
849            CLEAR %FIELDNAME.
850            _ASSIGN_% COMPONENT MARK_KENNZAHLEN-FIELDNAME
851                                OF STRUCTURE AUS_S000 TO <KM_HLP_KENNZ>.
852            IF %FIELDNAME IS INITIAL.
853    *         Nicht summierbare Kennzahl beginnt nicht mit '%' (vgl. Ausn.)
854              CONCATENATE AUSTAB_NAME MARK_KENNZAHLEN-FIELDNAME
855                          INTO MARK_KENNZAHLEN-AUSTABFELD.
856            ELSE.
857    *         Nicht summierbare Kennzahlen beginnen mit %
858    *         (bekannte Ausnahmen RMCE02TP: BSPRS, REPRS)
859              CONCATENATE AUSTAB_NAME %FIELDNAME
860                          INTO MARK_KENNZAHLEN-AUSTABFELD.
861            ENDIF.
862          ENDIF.
863
864          APPEND MARK_KENNZAHLEN.
865        ENDLOOP.
866      ENDIF.
867
868    ENDFORM.                               "KENNZAHLEN_MARKIEREN
