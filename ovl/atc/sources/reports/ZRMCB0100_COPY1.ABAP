2373       ct_anzperioden = 2.
2374     ENDIF.
2375
2376
2377   *-------- Anzahl Richtungsaenderungen
2378     ct_max_dif = ct_anzperioden - 1.
2379
2380   *-------- Pruefen streng monoton
2381     LOOP AT zeitreihe.
2382       IF sy-tabix > 1.
2383         hlp_f_2 = zeitreihe-value - hlp_f.
2384         IF hlp_f_2 > 0.
2385           ct_pos = ct_pos + 1.
2386         ENDIF.
2387         IF hlp_f_2 < 0.
2388           ct_neg = ct_neg + 1.
2389         ENDIF.
2390       ENDIF.
2391       hlp_f = zeitreihe-value.
2392     ENDLOOP.
2393
2394   *-------- Wenn Zeitreihe streng monoton in richtige Richtung: EXIT
2395   *-------- Wenn Zeitreihe streng monoton in falsche Richtung: EXIT
2396     IF int_mcyc-trend = '+'.
2397       IF ct_pos = ct_max_dif.
2398         kz_full = true.
2399         EXIT.
2400       ELSE.
2401         IF ct_pos = 0.
2402           EXIT.
2403         ENDIF.
2404       ENDIF.
2405     ELSE.
2406       IF ct_neg = ct_max_dif.
2407         kz_full = true.
