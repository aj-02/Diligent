6375   *---------------------------------------------------------------------*
6376   *       FORM SPEZIAL_SUM_BERECHNEN                                    *
6377   *---------------------------------------------------------------------*
6378   FORM spezial_sum_berechnen
6379     TABLES   aus_s000 STRUCTURE aus_s000
6380     CHANGING sum_tab  STRUCTURE sum_s000
6381              flg      TYPE c.
6382
6383     flg = true.
6384
6385   * Entsprechendes Jahr setzen bei Vorjahresvergleich
6386     IF flg_vergleich = con_vergleich_vorjahr.
6387       PERFORM akt_perio_zurueck.
6388     ENDIF.
6389
6390     LOOP AT aus_s000.
6391       PERFORM zusatzkennzahlen_berechnen CHANGING aus_s000.
6392       PERFORM add_aus_s000 USING    aus_s000
6393                            CHANGING sum_s000.
6394       PERFORM sumeinheiten_setzen USING    aus_s000
6395                                   CHANGING sum_s000.
6396       MODIFY aus_s000.
6397     ENDLOOP.
6398
6399     PERFORM akt_drilldown_lesen.                              "28.1.1997
6400
6401     IF flg_dd IS INITIAL.
6402   * Aufriß nach Periode erfolgt-->Berechnung Zusatzkennzahlen Achtung!!!
6403       sum_kz = true.
6404     ENDIF.
6405     PERFORM zusatzkennzahlen_berechnen CHANGING sum_s000.
6406     CLEAR anzahl_perioden.
6407     CLEAR sum_kz.
6408   * Für Neuberechnung Summenzeile
6409     IF flg_vergleich = con_vergleich_vorjahr.
6410       CASE sav_speri.
6411         WHEN con_speri_spmon.
6412           akt_mon(4) = akt_mon(4) + 1.
6413         WHEN con_speri_sptag.
6414           akt_tag(4) = akt_tag(4) + 1.
6415         WHEN con_speri_spwoc.
6416           akt_woc(4) = akt_woc(4) + 1.
6417         WHEN con_speri_spbup.
6418           akt_bup(4) = akt_bup(4) + 1.
6419       ENDCASE.
6420     ENDIF.
6421
6422   ENDFORM.                               "spezial_sum_berechnen
