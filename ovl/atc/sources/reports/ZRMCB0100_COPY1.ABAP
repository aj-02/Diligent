1790   *---------------------------------------------------------------------*
1791   *       FORM METHODE_PRUEFEN                                          *
1792   *---------------------------------------------------------------------*
1793   *       Prüft eine Datenanreicherungsroutine auf formale Fehler       *
1794   *---------------------------------------------------------------------*
1795   *  -->  MP_MCSRUMV     Methodenverwendung                             *
1796   *  -->  MP_MCSRUME     Methode                                        *
1797   *  <--  MP_MCSTPROG    Programm                                       *
1798   *  <--  MP_MCSTROUT    Formroutine                                    *
1799   *  <--  MP_SUBRC                                                      *
1800   *---------------------------------------------------------------------*
1801   FORM METHODE_PRUEFEN USING    MP_MCSRUMV   LIKE MCSMET-MCSRUMV
1802                                 MP_MCSRUME   LIKE MCSMET-MCSRUME
1803                        CHANGING MP_MCSTPROG  LIKE MCSMET-MCSTPROG
1804                                 MP_MCSTROUT  LIKE MCSMET-MCSTROUT
1805                                 MP_SUBRC     LIKE SY-SUBRC.
1806
1807     DATA: RC LIKE SY-SUBRC.              " Returncode
1808
1809     DATA: BEGIN OF SOURCE_TAB OCCURS 100,
1810             LINE(80),
1811           END OF SOURCE_TAB.
1812
1813     MP_SUBRC = 0.
1814     IF MP_MCSRUME IS INITIAL.
1815       MP_SUBRC = 4.
1816       EXIT.
1817     ENDIF.
1818     SAV_MCSRUMV = MP_MCSRUMV.
1819     IF SAV_MCSRUMV IS INITIAL.
1820   *   Noch alte Listenmethode => auf 'H' setzen
1821       SAV_MCSRUMV = CON_METHODE_LISTE.
1822     ENDIF.
1823     SELECT SINGLE * FROM MCSMET WHERE MCSRUMV = SAV_MCSRUMV
1824                                   AND MCSRUME = MP_MCSRUME
1825                                   AND GSTRUQ  = GSTRU.
1826     IF SY-SUBRC <> 0.
1827   *   Die Methode existiert nicht, prüfen, ob Formel existiert
1828       IF MP_MCSRUMV = CON_METHODE_LISTE.
1829         SELECT SINGLE * FROM MCSMET WHERE MCSRUMV = CON_METHODE_FORMEL
1830                                       AND MCSRUME = MP_MCSRUME
1831                                       AND GSTRUQ  = GSTRU.
1832       ENDIF.
1833       IF SY-SUBRC <> 0.
1834         CASE MP_MCSRUMV.
1835           WHEN CON_METHODE_BASIS.
1836   *         Es ist noch keine Basismethode & angelegt
1837             MESSAGE I101 WITH MP_MCSRUME.
1838             MP_SUBRC = 4.
1839           WHEN CON_METHODE_LISTE.
1840   *         Es ist noch keine Listenmethode & angelegt
1841             MESSAGE I103 WITH MP_MCSRUME.
1842             MP_SUBRC = 4.
1843         ENDCASE.
1844         EXIT.
1845       ELSE.
1846         SAV_MCSRUMV = MCSMET-MCSRUMV.
1847       ENDIF.
1848     ENDIF.
1849   * Die Methode existiert
1850     MP_MCSTPROG = MCSMET-MCSTPROG.
1851     MP_MCSTROUT = MCSMET-MCSTROUT.
1852     IF MCSMET-GSTRUQ <> GSTRU.
1853   *   Die Methode & ist nicht für Info-Struktur & anwendbar (F4)
1854       MESSAGE I102 WITH MP_MCSRUME HLP_MCINF.
1855       MP_SUBRC = 4.
1856     ELSE.
1857   *   Tabellensituation ist in Ordnung => Programm prüfen
1858       IF ( MCSMET-MCSTPROG(1) = 'Y'
1859         OR MCSMET-MCSTPROG(1) = 'Z' )
1860         AND SY-REPID <> MCSMET-MCSTPROG
1861         AND NOT SAV_MCSRUMV = CON_METHODE_FORMEL.
1862   *     Keine Prüfung, wenn Methode in SAP-Programm liegt
1863
1864   *     GENERATE REPORT MCSMET-MCSTPROG.
1865         CLEAR SOURCE_TAB. REFRESH SOURCE_TAB.
1866         READ REPORT MCSMET-MCSTPROG INTO SOURCE_TAB.
1867         IF SY-SUBRC = 0.
1868           CALL FUNCTION 'RS_SYNTAX_CHECK'
1869                EXPORTING
1870                     I_PROGRAM     = MCSMET-MCSTPROG
1871                IMPORTING
1872                     O_ERROR_SUBRC = RC
1873                TABLES
1874                     I_SOURCE      = SOURCE_TAB
1875                EXCEPTIONS
1876                     OTHERS        = 1.
1877           MOVE RC TO SY-SUBRC.
1878         ENDIF.
1879
1880         IF SY-SUBRC = 4.
1881   *       Das in der Methode & angegebene Programm & hat Syntaxfehler
1882           MESSAGE I104 WITH MCSMET-MCSRUME MCSMET-MCSTPROG.
1883           MP_SUBRC = 4.
1884         ENDIF.
1885       ENDIF.
1886     ENDIF.
1887     IF MP_SUBRC = 4.
1888   *   Es wurde ein Fehler gefunden
1889       CLEAR: MP_MCSTPROG, MP_MCSTROUT.
1890       CASE MP_MCSRUMV.
1891         WHEN CON_METHODE_BASIS.
1892   *       Die Basismethode wird nicht ausgeführt
1893           MESSAGE I105 WITH MP_MCSRUME.
1894           MP_SUBRC = 4.
1895         WHEN CON_METHODE_LISTE.
1896   *       Die Listenmethode wird nicht ausgeführt
1897           MESSAGE I106 WITH MP_MCSRUME.
1898           MP_SUBRC = 4.
1899       ENDCASE.
1900     ENDIF.
1901     IF SAV_MCSRUMV = CON_METHODE_FORMEL.
1902       SELECT * FROM MCCMFO INTO TABLE HLP_MCCMFO
1903         WHERE MCSRUMV = MCSMET-MCSRUMV
1904           AND MCSRUME = MCSMET-MCSRUME
1905           ORDER BY MCSRUME MCSRUMV STEPNR.
1906     ENDIF.
1907   ENDFORM.                               "METHODE_PRUEFEN
