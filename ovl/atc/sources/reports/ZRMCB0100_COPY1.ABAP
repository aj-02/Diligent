871    *---------------------------------------------------------------------*
872    *       FORM KENNZAHLENTEXT_ERMITTELN                                 *
873    *---------------------------------------------------------------------*
874    *       Ermitteln des Kennzahltextes, der am besten zur gewählten     *
875    *       Spaltenbreite passt                                           *
876    *---------------------------------------------------------------------*
877    *  -->  KE_KENNZAHL: Kennzahl                                         *
878    *  <--  KE_TEXT    : Ermittelter Text                                 *
879    *---------------------------------------------------------------------*
880    FORM KENNZAHLENTEXT_ERMITTELN USING KE_KENNZAHL STRUCTURE AKT_KENNZAHLEN
881                                  CHANGING KE_TEXT  TYPE      C.
882
883      DATA: KE_BREITE LIKE SPALTEN_BREITE,
884            KE_REPLEN LIKE SPALTEN_BREITE,
885            KE_SLEN   LIKE SPALTEN_BREITE.
886
887    * Spezialtextermittlung für Auftragsinfosystem
888      FLG_FOUND = FALSE.
889      PERFORM SPEZIAL_KENNZAHLENTEXT IN PROGRAM (LIS_PROGNAME)
890                                        USING    KE_KENNZAHL
891                                        CHANGING KE_TEXT
892                                                 FLG_FOUND IF FOUND.
893      CHECK FLG_FOUND = FALSE.
894
895    * Spaltenbreite ermitteln
896      IF NOT KE_KENNZAHL-REFLEN IS INITIAL AND
897         FLG_EINHEITENZEILE     =  FALSE   AND
898         FLG_ZENTRIEREN         =  TRUE.
899    *   Kennzahl mit Einheit
900        KE_BREITE = KE_KENNZAHL-OUTPUTLEN + KE_KENNZAHL-REFLEN + 1.
901      ELSE.
902    *   Kenzahl ohne Einheit
903        KE_BREITE = KE_KENNZAHL-OUTPUTLEN.
904      ENDIF.
905
906    * geeigneten Text ermitteln
907      KE_REPLEN = STRLEN( KE_KENNZAHL-REPTEXT ).
908      IF KE_REPLEN > 19 AND
909         KE_BREITE >= KE_REPLEN.
910        KE_TEXT = KE_KENNZAHL-REPTEXT.     "Spaltenüberschrift (lang)
911      ELSEIF KE_BREITE > 19.
912        KE_TEXT = KE_KENNZAHL-SCRTEXT_L.   "langes Schlüsselwort.
913      ELSEIF KE_BREITE > 14.
914        KE_TEXT = KE_KENNZAHL-SCRTEXT_M.   "mittleres Schlüsselwort
915      ELSEIF KE_BREITE > 9.
916        KE_TEXT = KE_KENNZAHL-SCRTEXT_S.   "kurzes Schlüsselwort
917      ELSE.
918        KE_SLEN = STRLEN( KE_KENNZAHL-SCRTEXT_S ).
919        IF KE_SLEN < KE_REPLEN OR KE_REPLEN = 0.
920    *     Spaltenüberschrift (kurz) ist nicht gefüllt oder Spaltenüber-
921    *     schrift ist länger als kurzes Schlüsselwort
922          KE_TEXT = KE_KENNZAHL-SCRTEXT_S. "kurzes Schlüsselwort
923        ELSE.
924          KE_TEXT = KE_KENNZAHL-REPTEXT.   "Spaltenüberschrift (kurz)
925        ENDIF.
926      ENDIF.
927
928    ENDFORM.                               "KENNZAHLENTEXT_ERMITTELN
