330    *---------------------------------------------------------------------*
331    *       FORM XXL_DATA_MERKMALE_BESTIMMEN                              *
332    *---------------------------------------------------------------------*
333    *       Der Benutzer wählt die Merkmale und damit die Verdichtungs-   *
334    *       stufe, die an XXL übergeben werden soll. Anschließend wird die*
335    *       an XXL zu übergebene Tabelle entsprechende verdichtet         *
336    *---------------------------------------------------------------------*
337    *       <--  XB_FLG_EXIT:       = TRUE, wenn XXL-Aufruf abgebrochen   *
338    *                                 werden soll                         *
339    *       <--  XB_FLG_XXL_INTTAB: = TRUE, wenn die Daten aus der Tabelle*
340    *                                       XXL_S000 übertragen werden    *
341    *---------------------------------------------------------------------*
342    FORM XXL_DATA_MERKMALE_BESTIMMEN
343                                    CHANGING XB_FLG_EXIT       TYPE BOOLEAN
344                                             XB_FLG_XXL_INTTAB TYPE BOOLEAN.
345
346      STATICS: XB_MERKMALS_TAB  LIKE MCS01 OCCURS 0 WITH HEADER LINE,
347               XB_HLP_TFILL     LIKE SY-TFILL.
348      DATA:    XB_MARK_MERKMALE LIKE MCS01 OCCURS 0 WITH HEADER LINE,
349               XB_FLG_MARK      TYPE BOOLEAN,
350               XB_SAV_TABIX     LIKE SY-TABIX.
351      DATA:    BEGIN OF XB_MERKMALE OCCURS 0.
352              INCLUDE STRUCTURE STD_DRILLDOWN.
353      DATA:    END OF XB_MERKMALE.
354      DATA:    xb_flg_kein_standard value FALSE.          " <= note 187336
355
356      DATA:    XB_TMERKMALSKETTUNG      TYPE T_MERKMALSKETTUNG,
357               XB_ANZ_MERKMALSKETTUNGEN LIKE ANZ_MERKMALSKETTUNGEN,
358               XB_MERKMALSKETTUNG       TYPE MERKMALSKETTUNG,
359               XB_SCRTEXT_L             LIKE DFIES-SCRTEXT_L
360                                        OCCURS 3 WITH HEADER LINE,
361               XB_WIEDERHOLUNG,
362               XB_TEXT1(40)             TYPE C,
363               XB_TEXT2(40)             TYPE C,
364               XB_TEXT3(40)             TYPE C,
365               XB_TEXT4(40)             TYPE C.
366
367      IF FLG_LIS_REPORTING = FALSE.
368    *   Keine Auswahl der Merkmale möglich
369        PERFORM XXL_FELDSYMBOLE_ZUWEISEN TABLES INT_S000.
370      ELSE.
371    *   Merkmale auswählen und ggf. danach verdichten
372        IF XB_HLP_TFILL = 0.
373    *     Tabelle ist noch leer => Tab. mit den möglichen Merkmalen in der
374    *     Dictionary-Reihenfolge füllen
375          LOOP AT XXL_DATA_MERKMALE.
376            XB_SAV_TABIX = SY-TABIX.
377            READ TABLE DRILLDOWN_FCODES
378               WITH KEY DDICFELD = XXL_DATA_MERKMALE-FIELDNAME.
379            CHECK SY-SUBRC = 0.
380            MOVE-CORRESPONDING DRILLDOWN_FCODES TO XB_MERKMALS_TAB.
381            XB_MERKMALS_TAB-FIELDNAME  = DRILLDOWN_FCODES-DDICFELD.
382            XB_MERKMALS_TAB-DISPL_ONLY = FALSE.
383            XB_MERKMALS_TAB-TABIX      = XB_SAV_TABIX.
384            APPEND XB_MERKMALS_TAB.
385          ENDLOOP.
386          SORT XB_MERKMALS_TAB BY SCRTEXT_L.
387          IF TMC4-SPZIS NE 'C'.                        " <= TR 28.10.1998
388    *       Typ-C-Infostrukturen haben keine Periode   " <= TR 28.10.1998
389    *       Periodenfeld am Ende der Liste anhängen
390            CASE TMC4-gstru.                                       "803676
391              WHEN 'S065'.                                         "803676
392    *           do nothing.....                                    "803676
393              WHEN OTHERS.                                         "803676
394                read table drilldown_fcodes with key fcode = con_fcode_aper
395                                      BINARY SEARCH.
396            CHECK SY-SUBRC = 0.
397            MOVE-CORRESPONDING DRILLDOWN_FCODES TO XB_MERKMALS_TAB.
398            XB_MERKMALS_TAB-FIELDNAME  = DRILLDOWN_FCODES-DDICFELD.
399            XB_MERKMALS_TAB-DISPL_ONLY = FALSE.
400            ADD 1 TO XB_SAV_TABIX.
401            XB_MERKMALS_TAB-TABIX      = XB_SAV_TABIX.
402            APPEND XB_MERKMALS_TAB.
403            ENDCASE.                                               "803676
404          endif.                                       " <= TR 28.10.1998
405          DESCRIBE TABLE XB_MERKMALS_TAB LINES XB_HLP_TFILL.
406        ENDIF.
407
408        PERFORM TEXT_ERMITTELN USING    50
409    *                                   'Merkmale'
410                               CHANGING HLP_TEXT1.
411        PERFORM TEXT_ERMITTELN USING    49
412    *                                   'Merkmal'
413                               CHANGING HLP_TEXT2.
414        PERFORM TEXT_ERMITTELN USING    62
415    *                                  'Übergabe an XXL'
416                               CHANGING HLP_TEXT3.
417        PERFORM TEXT_ERMITTELN USING    63
418    *                                  'Bitte wählen Sie die Merkmale aus:'
419                               CHANGING HLP_TEXT4.
420        DESCRIBE TABLE XB_MERKMALS_TAB LINES SY-TFILL.
421        CALL FUNCTION 'MC_POPUP_TO_MARK_FIELDS'
422             EXPORTING
423                  I_FIELDS_MARKED        = TRUE
424                  I_FIELD_NUMBER_MAX     = SY-TFILL
425                  I_FIELD_NUMBER_MIN     = 1
426                  I_OBJECT_NAME_PLURAL   = HLP_TEXT1
427                  I_OBJECT_NAME_SINGULAR = HLP_TEXT2
428                  I_POPUP_TITLE          = HLP_TEXT3
429                  I_TEXTLINE             = HLP_TEXT4
430    *             I_TEXT_LENGTH          = 80           "Msg 356219/1999
431             IMPORTING
432                  E_MARKED               = XB_FLG_MARK
433             TABLES
434                  T_FIELDS               = XB_MERKMALS_TAB
435                  T_MARKED_FIELDS        = XB_MARK_MERKMALE.
436
437        XB_WIEDERHOLUNG = TRUE.
438        WHILE XB_WIEDERHOLUNG EQ TRUE.
439          XB_WIEDERHOLUNG = FALSE.
440          REFRESH XB_SCRTEXT_L.
441          IF XB_FLG_MARK = TRUE.
442    *     Merkmalskettung überprüfen
443            LOOP AT XB_MARK_MERKMALE.
444              CLEAR   XB_ANZ_MERKMALSKETTUNGEN.
445              REFRESH XB_TMERKMALSKETTUNG.
446              PERFORM MERKMALSKETTUNG_KEY_FOLGE
447                IN PROGRAM (LIS_PROGNAME) IF FOUND
448                USING    XB_MARK_MERKMALE-ROLLNAME
449                CHANGING XB_TMERKMALSKETTUNG
450                         XB_ANZ_MERKMALSKETTUNGEN.
451              IF XB_ANZ_MERKMALSKETTUNGEN GE 1.
452                READ TABLE XB_TMERKMALSKETTUNG INDEX 1
453                  INTO XB_MERKMALSKETTUNG.
454                IF XB_MERKMALSKETTUNG-ROLLNAME EQ XB_MARK_MERKMALE-ROLLNAME.
455                  READ TABLE XB_TMERKMALSKETTUNG INDEX 2
456                    INTO XB_MERKMALSKETTUNG.
457                ENDIF.
458                READ TABLE XB_MARK_MERKMALE
459                  WITH KEY ROLLNAME = XB_MERKMALSKETTUNG-ROLLNAME.
460                IF SY-SUBRC NE 0.
461                  READ TABLE XB_MERKMALS_TAB
462                    WITH KEY ROLLNAME = XB_MERKMALSKETTUNG-ROLLNAME.
463                  IF SY-SUBRC EQ 0.
464                    XB_MARK_MERKMALE = XB_MERKMALS_TAB.
465                    APPEND XB_MARK_MERKMALE.
466                    XB_SCRTEXT_L = XB_MERKMALS_TAB-SCRTEXT_L.
467                    APPEND XB_SCRTEXT_L.
468                    XB_WIEDERHOLUNG = TRUE.
469                  ENDIF.
470                ENDIF.
471              ENDIF.
472              IF XB_ANZ_MERKMALSKETTUNGEN EQ 2.
473                READ TABLE XB_TMERKMALSKETTUNG INDEX 2
474                  INTO XB_MERKMALSKETTUNG.
475                READ TABLE XB_MARK_MERKMALE
476                  WITH KEY ROLLNAME = XB_MERKMALSKETTUNG-ROLLNAME.
477                IF SY-SUBRC NE 0.
478                  READ TABLE XB_MERKMALS_TAB
479                    WITH KEY ROLLNAME = XB_MERKMALSKETTUNG-ROLLNAME.
480                  IF SY-SUBRC EQ 0.
481                    XB_MARK_MERKMALE = XB_MERKMALS_TAB.
482                    APPEND XB_MARK_MERKMALE.
483                    XB_SCRTEXT_L = XB_MERKMALS_TAB-SCRTEXT_L.
484                    APPEND XB_SCRTEXT_L.
485                    XB_WIEDERHOLUNG = TRUE.
486                  ENDIF.
487                ENDIF.
488              ENDIF.
489            ENDLOOP.
490            IF XB_WIEDERHOLUNG EQ TRUE.
491    * Infomessage
492              CLEAR: XB_TEXT1, XB_TEXT2, XB_TEXT3, XB_TEXT4.
493              LOOP AT XB_SCRTEXT_L.
494                CASE SY-TABIX.
495                  WHEN 1. XB_TEXT1 = XB_SCRTEXT_L.
496                  WHEN 2. XB_TEXT2 = XB_SCRTEXT_L.
497                  WHEN 3. XB_TEXT3 = XB_SCRTEXT_L.
498                  WHEN 4. XB_TEXT4 = XB_SCRTEXT_L.
499                ENDCASE.
500              ENDLOOP.
501              MESSAGE I169 WITH XB_TEXT1 XB_TEXT2 XB_TEXT3 XB_TEXT4.
502              DESCRIBE TABLE XB_MERKMALS_TAB LINES SY-TFILL.
503              CALL FUNCTION 'MC_POPUP_TO_MARK_FIELDS'
504                   EXPORTING
505                        I_FIELD_NUMBER_MAX     = SY-TFILL
506                        I_FIELD_NUMBER_MIN     = 1
507                        I_MARK_BY_TABLE        = TRUE
508                        I_OBJECT_NAME_PLURAL   = HLP_TEXT1
509                        I_OBJECT_NAME_SINGULAR = HLP_TEXT2
510                        I_POPUP_TITLE          = HLP_TEXT3
511                        I_TEXTLINE             = HLP_TEXT4
512                        I_TEXT_LENGTH          = 80
513                   IMPORTING
514                        E_MARKED               = XB_FLG_MARK
515                   TABLES
516                        T_FIELDS               = XB_MERKMALS_TAB
517                        T_MARKED_FIELDS        = XB_MARK_MERKMALE.
518              CONTINUE.
519            ENDIF.
520
521    *     Vorinitialisierung: keine Periode gewählt
522            FLG_PERIODE_GEWAEHLT = FALSE.
523    *     Merkmale wurden ausgewählt => XXL_DATA_MERKMALE füllen und
524    *     XB_MERKMALE für die Verdichtung der INTTAB füllen
525            REFRESH XXL_DATA_MERKMALE.
526    *     Merkmale in der DDIC-Reihenfolge übernehmen
527            SORT XB_MARK_MERKMALE BY TABIX.
528            LOOP AT XB_MARK_MERKMALE.
529              IF XB_MARK_MERKMALE-FIELDNAME <> CON_FELD_SPTAG AND
530                 XB_MARK_MERKMALE-FIELDNAME <> CON_FELD_SPWOC AND
531                 XB_MARK_MERKMALE-FIELDNAME <> CON_FELD_SPMON AND
532                 XB_MARK_MERKMALE-FIELDNAME <> CON_FELD_SPBUP.
533    *         Periodenfeld nicht in XXL_DATA_MERKMALE übernehmen
534                MOVE-CORRESPONDING XB_MARK_MERKMALE TO XXL_DATA_MERKMALE.
535                APPEND XXL_DATA_MERKMALE.
536              ELSE.
537    *         Periode gewaehlt => flg_periode_gewaehlt = TRUE
538                FLG_PERIODE_GEWAEHLT = TRUE.
539              ENDIF.
540              XB_MERKMALE-FIELDNAME = XB_MARK_MERKMALE-FIELDNAME.
541              APPEND XB_MERKMALE.
542            ENDLOOP.
543    * notes 144524, 187336
544            PERFORM SPEZIAL_XXL_INTTAB_KOMPRI IN PROGRAM (lis_progname)
545                                             TABLES XXL_S000
546                                             XB_MERKMALE
547                                             CHANGING xb_flg_kein_standard
548                                             IF FOUND.
549            IF xb_flg_kein_standard EQ FALSE.
550              if not zusatz_tab is initial.
551                perform xxl_inttab_komprimieren tables xxl_s000
552                                                         xb_merkmale.
553              else.
554                perform inttab_komprimieren in program (lis_progname)
555                                           tables xxl_s000
556                                                  xb_merkmale if found.
557              endif.
558            ENDIF.
559            PERFORM XXL_FELDSYMBOLE_ZUWEISEN TABLES XXL_S000.
560            XB_FLG_XXL_INTTAB = TRUE.
561          ELSE.
562    *     Auswahl wurde abgebrochen => XXL-Aufruf abbrechen
563            XB_FLG_EXIT = TRUE.
564          ENDIF.
565        ENDWHILE.
566      ENDIF.
567    ENDFORM.                               "XXL_DATA_MERKMALE_BESTIMMEN
