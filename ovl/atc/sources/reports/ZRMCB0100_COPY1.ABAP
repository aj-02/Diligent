4581   *---------------------------------------------------------------------*
4582   *       FORM PERIODENTAB                                              *
4583   *---------------------------------------------------------------------*
4584   *       ok......                                                      *
4585   *---------------------------------------------------------------------*
4586   FORM periodentab.
4587
4588     DATA: pe_drin.
4589     DATA: pe_lines TYPE i.
4590
4591     flg_periotab = true.
4592
4593     PERFORM zeitr_maximum_bestimmen USING periodentab-high.
4594     READ TABLE i_zeitr INDEX 1.
4595     IF i_zeitr-low eq '000000'
4596       OR i_zeitr-low eq '00000000'
4597       OR periodentab-high eq '000000'
4598       OR periodentab-high eq '00000000'.
4599       perform int_s000_peri_min_max.
4600     ENDIF.
4601
4602     IF NOT i_zeitr-low IS INITIAL.
4603   *--------- Bestimmen Periotab-Low aus Rangestabelle ZEITR
4604       periodentab-low = i_zeitr-low.
4605       APPEND periodentab.
4606     ELSE.
4607       periodentab-low = sav_period_min.
4608       APPEND periodentab.
4609     ENDIF.
4610
4611
4612     IF periodentab-high eq '000000' OR periodentab-high eq '00000000'.
4613       periodentab-high = SAV_PERIOD_MAX.
4614     ENDIF.
4615
4616   *Aufnahme aller Perioden von periodentab-LOW bis periodentab-HIGH
4617     WHILE periodentab-low LT periodentab-high.
4618       CASE sav_speri.
4619         WHEN con_speri_sptag.
4620           periodentab-low = periodentab-low + 1.
4621         WHEN con_speri_spmon.
4622           periodentab-low+4(2) = periodentab-low+4(2) + 1.
4623           IF periodentab-low+4(2) = '13'.
4624             periodentab-low+4(2) = '01'.
4625             periodentab-low(4)   = periodentab-low(4) + 1.
4626           ENDIF.
4627         WHEN con_speri_spwoc.
4628           IF periodentab-low+4(2) LT '52'.
4629             periodentab-low+4(2) = periodentab-low+4(2) + 1.
4630           ELSEIF periodentab-low+4(2) = '52'.
4631             PERFORM kalenderwoche_ermitteln_exc USING periodentab-low.
4632           ELSEIF periodentab-low+4(2) = '53'.
4633             periodentab-low(4)   = periodentab-low(4) + 1.
4634             periodentab-low+4(2)   = '01'.
4635           ENDIF.
4636
4637         WHEN con_speri_spbup.
4638           PERFORM tabelle_t009_pruefen_exc USING periodentab-low.
4639       ENDCASE.
4640       APPEND periodentab.
4641     ENDWHILE.
4642
4643     SORT periodentab BY low DESCENDING.
4644
4645   *--------- Vom aktuellen Datum ausgehend nicht in PERIODENTAB gehoerende
4646   *--------- rauswerfen und mitzaehlen der Anzahl Perioden zwischen
4647   *--------- sy-datum - periode und erster Periode der Analyse fuer
4648   *--------- evtl. Prognose bei Plan/Ist-Vergleich
4649     perioden_raus = 0.
4650     CLEAR pe_drin.
4651     LOOP AT periodentab.
4652       CASE sav_speri.
4653         WHEN con_speri_sptag.
4654           IF periodentab-low IN sl_sptag.
4655             pe_drin = true.
4656           ELSE.
4657             DELETE periodentab.
4658           ENDIF.
4659         WHEN con_speri_spmon.
4660           IF periodentab-low IN sl_spmon.
4661             pe_drin = true.
4662           ELSE.
4663             DELETE periodentab.
4664           ENDIF.
4665         WHEN con_speri_spwoc.
4666           IF periodentab-low IN sl_spwoc.
4667             pe_drin = true.
4668           ELSE.
4669             DELETE periodentab.
4670           ENDIF.
4671         WHEN con_speri_spbup.
4672           IF periodentab-low IN sl_spbup.
4673             pe_drin = true.
4674           ELSE.
4675             DELETE periodentab.
4676           ENDIF.
4677       ENDCASE.
4678       IF pe_drin <> true.
4679         perioden_raus = perioden_raus + 1.
4680       ENDIF.
4681     ENDLOOP.
4682
4683     READ TABLE zeitr INDEX 1.
4684     IF zeitr-low eq '000000'
4685          OR zeitr-low eq '00000000'.
4686       periodentab-low = zeitr-low.
4687       append periodentab.
4688     ENDIF.
4689
4690     SORT periodentab BY low ASCENDING.
4691
4692
4693   ENDFORM.
