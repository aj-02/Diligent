3069   *---------------------------------------------------------------------*
3070   *       FORM PLANDATEN_LESEN                                          *
3071   *---------------------------------------------------------------------*
3072   *       Selektiert entsprechend dem aktuellen Drilldown und einer     *
3073   *       ausgewählten Planversion die Plandaten aus der S... und       *
3074   *       speichert sie in der internen Tabelle PLAN_S000.              *
3075   *---------------------------------------------------------------------*
3076   FORM plandaten_lesen.
3077
3078     DATA: l_anz_merkmalskettungen LIKE anz_merkmalskettungen.
3079     DATA: l_planobjekt            LIKE plan_s000-objekt.
3080     DATA: l_offset_1 TYPE i.
3081     DATA: l_offset_2 TYPE i.
3082
3083   * Abgleich der Drilldown-Ranges mit den Selektion-Ranges
3084     PERFORM pp_ranges_prepare.
3085
3086     IF flg_vergleich EQ con_vergleich_vorjahr.
3087   * Vorjahresvergleich: Daten kommen nicht aus S039: Bestands-u.Bewegungs-
3088   * daten komplett neu aufbauen aus S031 u. S032
3089       READ TABLE i_zeitr INDEX 1.
3090       IF sy-subrc = 0.
3091   * Zeitraum erweitern auf Vorjahr
3092         IF vjvg_flag = false.
3093           i_zeitr-low(4) = i_zeitr-low(4) - 1.
3094           MODIFY i_zeitr INDEX sy-tabix.
3095   * Tabelle I_Zeitr konvertieren.
3096           PERFORM i_zeitr_konvert_vjvg.
3097           vjvg_flag = true.
3098         ENDIF.
3099       ENDIF.
3100
3101   * Periodentabelle komplett neu aufbauen
3102       CLEAR periotab.
3103       REFRESH periotab.
3104       PERFORM periotab_fuellen.
3105   * Bestände und Bewegungen neu einlesen.
3106       PERFORM plan_s000_aufbauen.
3107     ELSE.
3108   * Daten aus S039 entsprechend aktuellem Drilldown lesen
3109       REFRESH plan_s000.
3110       CLEAR plan_s000.
3111       IF int_plan IS INITIAL.       " nur beim ersten Aufruf erforderlich
3112         SELECT * FROM s039 INTO CORRESPONDING FIELDS OF TABLE int_plan
3113           WHERE ssour =  space
3114             AND vrsio IN sl_vrsio
