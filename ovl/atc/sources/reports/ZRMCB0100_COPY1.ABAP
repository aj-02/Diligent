578    *---------------------------------------------------------------------*
579    *       FORM LESEN_DATEN_EXCEPTION                                    *
580    *---------------------------------------------------------------------*
581    *       ........                                                      *
582    *---------------------------------------------------------------------*
583    FORM lesen_daten_exception.
584
585    *--------- Anzeige Selektionsversion
586      IF flg_selektion = false.
587        exc_no = exception.
588      ENDIF.
589
590      SELECT SINGLE * FROM mcya WHERE excep = exc_no.
591      IF sy-subrc <> 0.
592        IF flg_selektion = false.
593          MESSAGE i127(mz) WITH exc_no.
594          CLEAR exception.
595          CLEAR exc_no.
596          EXIT.
597        ELSE.
598          MESSAGE e121(mz) WITH exc_no.
599          EXIT.
600        ENDIF.
601      ENDIF.
602
603      IF exc_mode = space.
604
605        CALL FUNCTION 'MC_CHECK_EXCEPTION_ANALYSIS'
606             EXPORTING
607                  excep = exc_no
608                  mcinf = hlp_mcinf
609                  appli = akt_tmc7-mcapp
610                  mcana = akt_tmc7-mcana.
611    *    EXCEPTIONS
612    *         NOT_EXIST           = 01
613    *         NOT_IN_APPLICATION  = 02
614    *         NOT_FOR_MCINF       = 03
615    *         NOT_ACTIVE          = 04
616    *         NO_MERKMALSBEZUG    = 05
617    *         NO_EXCEPTION        = 06
618    *         NO_AUTHORITY        = 07
619    *         NO_MEASURES         = 08
620    *         NOT_ALL_AUTHORITIES = 09.
621
622
623      ENDIF.
624
625      masterdata_mcya = mcya.
626    * IF MASTERDATA_MCYA-EXTYP = SPACE.
627    *   message EXXX.
628    *   EXIT.
629    * ENDIF.
630
631      masterdata_mcyat-mandt = sy-mandt.
632      masterdata_mcyat-spras = sy-langu.
633      masterdata_mcyat-excep = exc_no.
634      PERFORM kurztext_exception USING exc_no masterdata_mcyat-etext40.
635
636
637      CLEAR int_mcya.
638      REFRESH int_mcya.
639      CLEAR r_excep.
640      REFRESH r_excep.
641      r_excep-sign = 'I'.
642      r_excep-option = 'EQ'.
643    *--------- Lesen Attribute der Exception(s)
644      CASE masterdata_mcya-extyp.
645        WHEN 'N'.
646          anz_perioden = masterdata_mcya-mcper.
647          verkn_kopf   = 'O'.
648          r_excep-low  = exc_no.
649          r_excep-high = exc_no.
650          APPEND r_excep.
651          int_mcya = masterdata_mcya.
652          APPEND int_mcya.
653        WHEN 'G'.
654          anz_perioden = masterdata_mcya-mcper.
655          verkn_kopf   = masterdata_mcya-verkn.
656          SELECT * FROM mcyd INTO TABLE int_mcyd
657                             WHERE oexcep = exc_no.
658          LOOP AT int_mcyd.
659            r_excep-low  = int_mcyd-uexcep.
660            r_excep-high = int_mcyd-uexcep.
661            APPEND r_excep.
662          ENDLOOP.
663          IF sy-subrc <> 0.
664            MESSAGE e078(mz).
665            EXIT.
666          ENDIF.
667          SELECT * FROM mcya INTO TABLE int_mcya
668                             WHERE excep IN r_excep.
669          READ TABLE int_mcya INDEX 1.
670          IF sy-subrc <> 0.
671            MESSAGE e078(mz).
672            EXIT.
673          ENDIF.
674      ENDCASE.
675
676    *--------- Lesen aller Merkmale
677      SELECT * FROM mcyb INTO TABLE dab_mcyb
678                         WHERE excep IN r_excep
679                         ORDER BY PRIMARY KEY.
680      READ TABLE dab_mcyb INDEX 1.
681      IF sy-subrc <> 0.
682        MESSAGE e078(mz).
683        EXIT.
684      ENDIF.
685
686    *--------- Standard-Drilldown
687      PERFORM standard_drilldown.
688
689    *--------- Setzen des Kennzeichens fuer Periode in Merkmal
690      PERFORM setzen_ews_perio_kz.
691
692    *--------- Evtl. Auffuellen bei Exceptions ohne Merkmalsbezug
693      PERFORM dab_mcyb_auffuellen.
694
695    *--------- Lesen aller Bedingungen
696      SELECT * FROM mcyc INTO TABLE dab_mcyc
697                         WHERE excep IN r_excep.
698
699      SORT dab_mcyc DESCENDING BY kzpiv excep zaehl.
700
701      READ TABLE dab_mcyc INDEX 1.
702      IF sy-subrc <> 0.
703        MESSAGE e125(mz).
704        EXIT.
705      ENDIF.
706
707      DATA hlp_tabix LIKE sy-tabix.
708      LOOP AT dab_mcyc WHERE kzpiv   = 'X'.
709        LOOP AT int_mcya WHERE excep = dab_mcyc-excep.
710          MOVE sy-tabix    TO    hlp_tabix.
711          INSERT int_mcya  INDEX 1.
712          hlp_tabix = hlp_tabix + 1.
713          DELETE int_mcya  INDEX hlp_tabix.
714        ENDLOOP.
715      ENDLOOP.
716
717    *--------- Lesen der Felder der GSTRU + Zusatzstruktur
718      PERFORM fuellen_fieldtab.
719
720    *--------- User-Einstellungen ausser Standard-Drilldown
721      PERFORM fuellen_user_einst.
