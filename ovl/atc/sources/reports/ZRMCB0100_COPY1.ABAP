137      CLEAR POPUP_FIELDS.
138      POPUP_FIELDS-TABNAME    = 'RMCS0'.
139      POPUP_FIELDS-FIELDNAME  = 'ANZHL'.
140      POPUP_FIELDS-VALUE      = HITLISTEN_GROESSE.
