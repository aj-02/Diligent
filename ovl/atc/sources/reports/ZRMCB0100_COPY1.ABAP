1504   *       FORM STATUSZEILE_AUSGEBEN                                     *
1505   *---------------------------------------------------------------------*
1506   *       Statuszeile mit Ranglisten- bzw. Sortierinfo ausgeben         *
1507   *---------------------------------------------------------------------*
1508   FORM STATUSZEILE_AUSGEBEN.
1509
1510     LOCAL: FLG_SORT_ABST,
1511            DARSTELLUNGSART.
1512
1513     DATA: SA_HLP_ANZAHL(4),
1514           SA_ZEILE(150),
1515           SA_FELDNAME,
1516           SA_KENNZEICHENTEXT LIKE DFIES-SCRTEXT_L,
1517           SA_KRITERIUMTEXT(250),
1518           SA_MUSTER(2),                  "Ersetzungsmuster für TRANSLATE
1519           SA_EINTRAEGE(14),
1520           SA_ANGEZEIGTE_EINTRAEGE(6),
1521           SA_SCRTEXT_LENGTH LIKE SY-FDPOS,
1522           SA_HLP_COLNO      LIKE SY-COLNO VALUE 1.
1523     FIELD-SYMBOLS: <SA_SCRTEXT>.
1524
1525     IF GF_ACC_INIT = FALSE.
1526         CALL FUNCTION 'GET_ACCESSIBILITY_MODE'
1527      IMPORTING
1528        ACCESSIBILITY           = gf_acc_on
1529      EXCEPTIONS
1530        ITS_NOT_AVAILABLE       = 1
1531        OTHERS                  = 2
1532              .
1533       gf_acc_init = true.
