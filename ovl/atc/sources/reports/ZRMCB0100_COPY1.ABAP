620    *---------------------------------------------------------------------*
621    *       FORM XXL_HILFSTAB_FUELLEN                                     *
622    *---------------------------------------------------------------------*
623    *       XXL_DATA_MERKMALE und XXL_DATA_KENNZAHLEN füllen              *
624    *---------------------------------------------------------------------*
625    *  <--  XF_DFIES_TAB: Tabelle mit DFIES-Info                          *
626    *---------------------------------------------------------------------*
627    FORM XXL_HILFSTAB_FUELLEN TABLES XF_DFIES_TAB STRUCTURE DFIES.
628
629    * Achtung: Abarbeitung analag der Generierung der Standardanalysen,
630    *          d.h. Felder in folgender Reihenfolge:
631    *          Schlüsselfelder, Periodenfeld, Kennzahlenfelder
632
633      REFRESH XXL_DATA_MERKMALE.
634      REFRESH XXL_DATA_FELDER.
635
636    ENHANCEMENT-POINT RMCE0800_01 SPOTS ES_RMCE0800 .
637
638      loop at xf_dfies_tab.
639        IF NOT XF_DFIES_TAB-KEYFLAG IS INITIAL.
640    *     Feld ist Schlüsselfeld
641          IF XF_DFIES_TAB-FIELDNAME <> CON_FELD_MANDT AND
642             XF_DFIES_TAB-FIELDNAME <> CON_FELD_SSOUR AND
643             XF_DFIES_TAB-FIELDNAME <> CON_FELD_VRSIO AND
644             XF_DFIES_TAB-FIELDNAME <> CON_FELD_SPTAG AND
645             XF_DFIES_TAB-FIELDNAME <> CON_FELD_SPWOC AND
646             XF_DFIES_TAB-FIELDNAME <> CON_FELD_SPMON AND
647             XF_DFIES_TAB-FIELDNAME <> CON_FELD_SPBUP.
648            MOVE-CORRESPONDING XF_DFIES_TAB TO XXL_DATA_MERKMALE.
649            APPEND XXL_DATA_MERKMALE.
650            XXL_DATA_FELDER-FIELDNAME = XF_DFIES_TAB-FIELDNAME.
651            APPEND XXL_DATA_FELDER.
652          ENDIF.
653
654        ELSE.
655    *     Feld ist Datenfeld
656          IF xf_dfies_tab-datatype = 'CUKY' OR
657             xf_dfies_tab-datatype = 'UNIT'.
658    *     Fields of type CUKY or UNIT are excluded from XXL_DATA (see FORM
659    *     XXL_FIELDS in SAPLMCSA) so they should not occur here either.
660            CONTINUE.
661          ENDIF.
662          READ TABLE UNIT_TAB WITH KEY XF_DFIES_TAB-FIELDNAME BINARY SEARCH.
663          IF SY-SUBRC <> 0.
664    *       Feld ist keine Einheit => berücksichtigen
665            CASE XF_DFIES_TAB-FIELDNAME.
666              WHEN 'PERIV'.
667    *           XXL_DATA_FELDER enthält zusätzlich ein Periodenfeld, das
668    *           vor der ersten Kennzahl erscheinen soll
669                XXL_DATA_FELDER-FIELDNAME = CON_FELD_XXL_PERIO.
670                APPEND XXL_DATA_FELDER.
671              WHEN 'VWDAT'.
672              WHEN OTHERS.
673    *           Feld ist scalare Kennzahl, d.h. ohne Einheit
674                XXL_DATA_FELDER-FIELDNAME   = XF_DFIES_TAB-FIELDNAME.
675                APPEND XXL_DATA_FELDER.
676                IF NOT XF_DFIES_TAB-REFFIELD IS INITIAL.
677    *             Feld hat Einh. => EinhFeld in XXL_DATA_FELDER eintragen
678                  XXL_DATA_FELDER-FIELDNAME   = 'UNIT_'.
679                  XXL_DATA_FELDER-FIELDNAME+5 = XF_DFIES_TAB-FIELDNAME.
680                  APPEND XXL_DATA_FELDER.
681                ENDIF.
682            ENDCASE.
683          ENDIF.
684        ENDIF.
685      ENDLOOP.
686    ENDFORM.                               "XXL_HILFSTAB_FUELLEN
