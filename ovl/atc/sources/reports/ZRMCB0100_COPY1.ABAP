487          exporting
488            text = hlp_text1.
489      endif.
490    * Neue Selektionsversion
491      mcsi_key-mcapp = mi_mcapp.
492      mcsi_key-mcana = mi_mcana.
493      mcsi_key-uname = mi_uname.
494      mcsi_key-selvs = mi_selvs.
495    *==== begin of insertation note 108868 ====
