657    *---------------------------------------------------------------------*
658    *       FORM PLANIST_VERGLEICH                                        *
659    *---------------------------------------------------------------------*
660    *       Aufruf Plan/Ist-Vergleich für eine durch Cursor ausgewählte   *
661    *       Kennzahl.                                                     *
662    *---------------------------------------------------------------------*
663    * --> PV_FLG_POPUP = TRUE,  PLANIST_VERGLEICH ruft sich vom eigenen   *
664    *                           Vergleichsfenster auf                     *
665    *                  = FALSE, PLANIST_VERGLEICH wird aus Liste gerufen  *
666    *---------------------------------------------------------------------*
667    FORM PLANIST_VERGLEICH USING PV_FLG_POPUP TYPE BOOLEAN.
668
669      DATA: PV_RC(1).
670      DATA: PV_FLG_KEIN_STANDARD TYPE BOOLEAN VALUE FALSE.
671
672      PERFORM SPEZIAL_PLANIST_VGL IN PROGRAM (LIS_PROGNAME)
673                                  USING PV_FLG_POPUP
674                                  CHANGING PV_FLG_KEIN_STANDARD
675                                  IF FOUND.
676      CHECK PV_FLG_KEIN_STANDARD EQ FALSE.
677
678      IF PV_FLG_POPUP = FALSE.
679    *   Plan/Ist-Vergleich wurde von der Liste gerufen => Initialisierung
680        FLG_VERGLEICH = CON_VERGLEICH_PLANIST.             " <= note 197571
681    *   Kennzahl für Plan/Ist-Vergleich ermitteln
682        PERFORM KENNZAHLSPALTE_BESTIMMEN USING FALSE.
683    *   optimierte Breite für Kennzahl zur Ausgabe benutzen
684        VGL_SPALTEN_BREITE = KENNZAHL_SPALTE-OUTPUTLEN.
685        _ASSIGN_% COMPONENT KENNZAHL_SPALTE-FIELDNAME OF STRUCTURE AUS_S000
686                                                      TO <KENNZ_1>.
687
688    *   Name des Einheitenfeldes zur Kennzahl ermitteln
689        IF NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL.
690         _ASSIGN_X COMPONENT KENNZAHL_SPALTE-REFFIELD OF STRUCTURE AUS_S000
691                                                       TO <EINHEIT_KENNZ_1>.
692        ELSE.
693          ASSIGN SPACE TO <EINHEIT_KENNZ_1>.
694        ENDIF.
695
696    *   Name der Planzahl ermitteln
697       _ASSIGN_% COMPONENT KENNZAHL_SPALTE-FIELDNAME OF STRUCTURE PLAN_S000
698                                                        TO <KENNZ_2>.
699
700    *   Name des Einheitenfeldes zur Planzahl ermitteln
701        IF NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL.
702          _ASSIGN_X COMPONENT KENNZAHL_SPALTE-REFFIELD
703                                                      OF STRUCTURE PLAN_S000
704                                                      TO <EINHEIT_KENNZ_2>.
705        ELSE.
706          ASSIGN SPACE TO <EINHEIT_KENNZ_2>.
707        ENDIF.
708
709    *   Planversion für Plan/Ist-Vergleich bestimmen
710        REFRESH POPUP_FIELDS.
711
712    *   Name der gewählten Kennzahl (nicht eingabebereit)
713        CLEAR POPUP_FIELDS.
714        POPUP_FIELDS-TABNAME    = 'RMCS0'.
715        POPUP_FIELDS-FIELDNAME  = 'GKENN'.
716        PERFORM KENNZAHLENTEXT_ERMITTELN USING    KENNZAHL_SPALTE
717                                         CHANGING POPUP_FIELDS-VALUE.
718        POPUP_FIELDS-FIELD_ATTR = '02'.
719        APPEND POPUP_FIELDS.
720
721    *   Info-Struktur
722        CLEAR POPUP_FIELDS.
723        POPUP_FIELDS-TABNAME    = 'TMC4'.
724        POPUP_FIELDS-FIELDNAME  = 'MCINF'.
725        POPUP_FIELDS-VALUE      = PLAN_MCINF.
726        POPUP_FIELDS-FIELD_ATTR = '02'.
727        APPEND POPUP_FIELDS.
728
729    *   Planversion
730        CLEAR POPUP_FIELDS.
731        popup_fields-tabname    = gstru.
732        POPUP_FIELDS-FIELDNAME  = 'VRSIO'.
733        POPUP_FIELDS-VALUE      = PLAN_VRSIO.
734        POPUP_FIELDS-FIELD_OBL  = TRUE.
735        APPEND POPUP_FIELDS.
736        PERFORM TEXT_ERMITTELN USING    204
737    *                                 'Plan/Ist-Vergleich'
738                               CHANGING HLP_TEXT1.
739
740    *   Wichtig: Löschen der MARK_KENNZAHLEN, da diese aus anderem Vergleich
741    *   noch gesetzt sein können
742        REFRESH MARK_KENNZAHLEN.
743        CLEAR MARK_KENNZAHLEN.
744      ELSE.
745    *   Plan/Ist-Vergleich: Selbstaufruf
746        PERFORM TEXT_ERMITTELN USING    226
747    *                                   'Plan/Ist-Vergleich - Andere Version
748                               CHANGING HLP_TEXT1.
749      ENDIF.
750
751      CALL FUNCTION 'POPUP_GET_VALUES_USER_HELP'
752           EXPORTING
753                F4_FORMNAME     = 'HILFE_P44V_F4'
754                F4_PROGRAMNAME  = LIS_PROGNAME
755                FORMNAME        = 'PLANVERSION_PRUEFEN'
756                POPUP_TITLE     = HLP_TEXT1
757                PROGRAMNAME     = LIS_PROGNAME
758                START_COLUMN    = 28
759           IMPORTING
760                RETURNCODE      = PV_RC
761           TABLES
762                FIELDS          = POPUP_FIELDS
763           EXCEPTIONS
764                ERROR_IN_FIELDS = 01.
765      IF PV_RC = 'A'.
766    *   Anwender hat die Eingabe abgebrochen
767        IF  SAV_FCODE <> 'AVER'.
768          CLEAR FLG_VERGLEICH.                             " <= note 197571
769        ENDIF.
770      ELSE.
771    *   FLG_VERGLEICH = CON_VERGLEICH_PLANIST.             " <= note 197571
772        IF PV_FLG_POPUP = FALSE.
773    *     LSIND der Grund- bzw. Aufrißliste merken, nur wenn Aufruf von
774    *     Liste erfolgt
775          MAINLIST_LSIND = SY-LSIND.
776        ENDIF.
777    *   Parameter zur Liststufe aktualisieren
778        PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
779        IF SAV_FCODE <> 'AVER'.
780    *     Einstellungen der aktuellen Aufrißliste sichern nur wenn kein
781    *     Versionswechsel, da da keine Änderung des Drilldowns
782          PERFORM DDOWN_EINSTELLUNGEN_SICHERN USING DRILLDOWN_EINTRAEGE.
783    *     Hitlistenkriterium beibehalten                        note 184345
784          HITL_KRITERIUM = AKT_DRILLDOWN-HITL_KRITERIUM.
785        ENDIF.
786    *   Inhalt der Ausgabetabelle aktualisieren
787        PERFORM AUSTAB_AKTUALISIEREN.
788    *   Anwender hat eine gültige Planversion eingegeben
789        READ TABLE POPUP_FIELDS INDEX 3.
790        PLAN_VRSIO = POPUP_FIELDS-VALUE.
791    *   Planzahlen aus Info-Struktur nachlesen
792        IF SAV_SPZIS = 'D'.
793    *     Plandaten spezial für Bestandscontrolling
794          PERFORM PLANDATEN_INVCON_D IN PROGRAM (LIS_PROGNAME)
795                                                  IF FOUND.
796        ELSE.
797          PERFORM PLANDATEN_LESEN.
798        ENDIF.
799    *   Istzahlen und Planzahlen abgleichen
800        PERFORM PLANIST_ABGLEICH.
801    *   Plan/Ist-Vergleich im Fenster ausgeben
802        PERFORM PLANTAB_AUSGEBEN USING PV_FLG_POPUP.
803      ENDIF.
804    ENDFORM.                               "PLANIST_VERGLEICH
