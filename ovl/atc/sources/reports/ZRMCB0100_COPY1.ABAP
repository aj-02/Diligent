4741   *       FORM KALENDERWOCHE_ERMITTELN                                  *
4742   *---------------------------------------------------------------------*
4743   *       Hier wird ermittelt, ob auf die 52.Kalenderwoche noch eine    *
4744   *       53.Woche folgt oder nicht. Dabei wird wie folgt vorgegangen:  *
4745   *       Solange die 52.Woche nicht erreicht ist, kann zur Woche immer *
4746   *       eine Woche addiert werden, ohne daß es Probleme mit dem       *
4747   *       Jahreswechsel gibt. Ist die 52.Woche erreicht, wird geprüft,  *
4748   *       ob es eine 53.Woche gibt. Wenn ja, wird sie noch gesetzt.     *
4749   *       Wenn nein, folgt auf die 52.Woche die 1.Woche des neuen       *
4750   *       Jahres.
4751   * ok
4752   *---------------------------------------------------------------------*
4753   FORM kalenderwoche_ermitteln_exc USING week TYPE CLIKE.
4754   *    week nicht zu typisieren: kann NUMC6 oder DATS sein
4755
4756     DATA: ke_week LIKE s031-spwoc,
4757           ke_datum LIKE sy-datlo.
4758
4759     ke_week = week.
4760
4761     CALL FUNCTION 'WEEK_GET_FIRST_DAY'
4762          EXPORTING
4763               week = ke_week
4764          IMPORTING
4765               date = ke_datum.
4766
4767     ke_datum = ke_datum + 7.
4768     CLEAR ke_week.
4769
4770     CALL FUNCTION 'DATE_GET_WEEK'
4771          EXPORTING
4772               date = ke_datum
4773          IMPORTING
4774               week = ke_week.
4775
4776   * if ke_week+4(2) = '53'.
4777   * else.
4778   *   ke_week+4(2) = '01'.
4779   *   ke_week(4) = ke_week(4) + 1.
4780   * endif.
4781
4782     week = ke_week.
4783
4784   ENDFORM.
