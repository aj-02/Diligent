2568   *---------------------------------------------------------------------*
2569   FORM VGL_KENNZAHLENSPALTE_BESTIMMEN
2570                  CHANGING VK_SPALTE LIKE SY-TABIX.
2571
2572     DATA: VK_HLP_CUCOL LIKE SY-CUCOL,
2573           VK_AKT_CUCOL LIKE SY-CUCOL.
2574
2575     VK_SPALTE    = 1.
2576     VK_HLP_CUCOL = SPALTEN_ANFANG.
2577
2578     CHECK SY-CUCOL >= VK_HLP_CUCOL.
2579   * Cursor steht auf Merkmalsspalte => Form verlassen, Spalte = 1
2580
2581     VK_AKT_CUCOL = SY-CUCOL + SY-STACO - 1.
2582
2583     DO 3 TIMES.
2584       IF VK_AKT_CUCOL <= VK_HLP_CUCOL.
2585         EXIT.
2586       ENDIF.
2587       ADD 1 TO VK_SPALTE.
2588       VK_HLP_CUCOL = VK_HLP_CUCOL + VGL_SPALTEN_BREITE + 1.
2589       IF KENNZAHL_SPALTE-REFLEN > 0.
2590   *     Einheitenfeld vorhanden
2591         VK_HLP_CUCOL = VK_HLP_CUCOL + KENNZAHL_SPALTE-REFLEN + 1.
2592       ENDIF.
2593     ENDDO.
2594     IF VK_AKT_CUCOL > VK_HLP_CUCOL.
2595       ADD 1 TO VK_SPALTE.
2596     ENDIF.
