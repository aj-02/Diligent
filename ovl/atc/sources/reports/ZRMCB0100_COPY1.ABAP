7      *       FORM SPEZIAL_ADD_AUSTAB                                       *
8      *---------------------------------------------------------------------*
9      *       ersetzt add-corresponding im Bestandscontrolling              *
10     *       wird nur innerhalb der Hierarchieverarbeitung aufgerufen      *
11     *---------------------------------------------------------------------*
12     *  -->  AA_TAB                Struktur, die addiert werden soll       *
13     *  -->  AA_SUM                Flag, ob es Summenzeile addiert wird    *
14     *  -->  AA_ENDE               Flag, ob letzter Eintrag in LOOP erreicht
15     *  -->  AA_SUMME              Struktur, in die addiert werden soll    *
16     *  -->  AA_FLG_KEIN_STANDARD  Flag, das Abweichung vom Standard anzeigt
17     *---------------------------------------------------------------------*
18     FORM spezial_add_austab USING    aa_tab   STRUCTURE aus_s000
19                                      aa_sum   TYPE boolean
20                                      aa_ende  TYPE boolean
21                             CHANGING aa_summe STRUCTURE hlp_summe
22                                      aa_flg_kein_standard TYPE boolean.
23
24     * Hilfsvariablen zum Merken der aktuellen Einstellungen
25       DATA: aa_akt_tag LIKE akt_tag,
26             aa_akt_woc LIKE akt_woc,
27             aa_akt_mon LIKE akt_mon,
28             aa_akt_bup LIKE akt_bup,
29             aa_fcode   LIKE akt_drilldown-fcode.
30
31       aa_flg_kein_standard = true.
32
33       IF akt_hierarchie-merkmals_fcode EQ con_fcode_aper.
34     * Das aktuelle Datum wird temporär überschrieben, entweder mit 0, damit
35     * die Bestandskennzahlen nicht gezogen werden, oder mit dem Eintrag aus
36     * AA_TAB, damit die Bestandskennzahlen gesetzt werden
37         CASE sav_speri.
38           WHEN con_speri_sptag.
39             aa_akt_tag = akt_tag.
40             IF aa_ende EQ true.
41               akt_tag = aa_tab-objekt.
42             ELSE.
43               CLEAR akt_tag.
44             ENDIF.
45           WHEN con_speri_spwoc.
46             aa_akt_woc = akt_woc.
47             IF aa_ende EQ true.
48               akt_woc = aa_tab-objekt.
49             ELSE.
50               CLEAR akt_woc.
51             ENDIF.
52           WHEN con_speri_spmon.
53             aa_akt_mon = akt_mon.
54             IF aa_ende EQ true.
55               akt_mon = aa_tab-objekt.
56             ELSE.
57               CLEAR akt_mon.
58             ENDIF.
59           WHEN con_speri_spbup.
60             aa_akt_bup = akt_bup.
61             IF aa_ende EQ true.
62               akt_bup = aa_tab-objekt.
63             ELSE.
64               CLEAR akt_bup.
65             ENDIF.
66         ENDCASE.
67     * Anzahl Perioden zählen für Durschnittswerte
68         IF aa_summe-hwaer IS INITIAL AND aa_summe-basme IS INITIAL.
69     * erster Aufruf für Periodenabschnitt (Quartal, ...)
70           g_anz_perio = 1.
71         ELSE.
72           ADD 1 TO g_anz_perio.
73         ENDIF.
74       ENDIF.
75
76       aa_fcode = akt_drilldown-fcode.
77       akt_drilldown-fcode = akt_hierarchie-merkmals_fcode.
78
79       PERFORM add_aus_s000 USING    aa_tab
80                            CHANGING aa_summe.
81
82       akt_drilldown-fcode = aa_fcode.
83       IF akt_hierarchie-merkmals_fcode EQ con_fcode_aper.
84         akt_tag = aa_akt_tag.
85         akt_woc = aa_akt_woc.
86         akt_mon = aa_akt_mon.
87         akt_bup = aa_akt_bup.
88       ENDIF.
89
90     ENDFORM.                               " SPEZIAL_ADD_AUSTAB
