4502   *       FORM ZEITR_MINIMUM_BESTIMMEN                                  *
4503   *---------------------------------------------------------------------*
4504   *       ok......                                                      *
4505   *---------------------------------------------------------------------*
4506   FORM zeitr_minimum_bestimmen.
4507
4508     DATA: zb_start_datum LIKE sy-datum,
4509     zb_flg_zeitr,
4510     zb_anz_perio TYPE i.
4511
4512     SORT zeitr by low ascending.
4513     READ TABLE zeitr INDEX 1.
4514     IF sy-subrc = 0.
4515       if zeitr-low eq '000000'                    " >>>>>>  TR 29.03.1999
4516         or zeitr-low eq '00000000'.
4517         loop at zeitr where not
4518                         ( low eq '000000' OR low eq '00000000' ).
4519           exit.
4520         endloop.
4521       endif.                                      " <<<<<<  TR 29.03.1999
4522       i_zeitr-low = zeitr-low.
4523     ELSE.
4524       zb_start_datum = sy-datum.
4525       zb_start_datum(4) = zb_start_datum(4) - 1.
4526
4527       PERFORM periode_ermitteln(rmcs1000) USING  zb_start_datum
4528                                                  hlp_mcinf
4529                                                  bukrs
4530                                        CHANGING  perio_tag
4531                                                  perio_woc
4532                                                  perio_mon
4533                                                  perio_bup
4534                                                  periv.
4535       CASE sav_speri.
4536         WHEN con_speri_sptag.
4537           i_zeitr-low = perio_tag.
4538         WHEN con_speri_spwoc.
4539           i_zeitr-low = perio_woc.
4540         WHEN con_speri_spmon.
4541           i_zeitr-low = perio_mon.
4542         WHEN con_speri_spbup.
4543           i_zeitr-low = perio_bup.
4544       ENDCASE.
4545
4546       WHILE NOT i_zeitr-low IN zeitr.
4547         CASE  sav_speri.
4548           WHEN con_speri_sptag.
4549             i_zeitr-low = i_zeitr-low + 1.
4550           WHEN con_speri_spmon.
4551             i_zeitr-low+4(2) = i_zeitr-low+4(2) + 1.
4552             IF i_zeitr-low+4(2) = '13'.
4553               i_zeitr-low+4(2) = '01'.
4554               i_zeitr-low(4) = i_zeitr-low(4) + 1.
4555             ENDIF.
4556           WHEN con_speri_spwoc.
4557             IF i_zeitr-low+4(2) < '52'.
4558               i_zeitr-low+4(2) = i_zeitr-low+4(2) + 1.
4559             ENDIF.
4560             IF i_zeitr-low+4(2) = '52'.
4561               PERFORM kalenderwoche_ermitteln_exc USING i_zeitr-low.
4562             ENDIF.
4563           WHEN con_speri_spbup.
4564             zb_anz_perio = i_zeitr-low+4(2) + 1.
4565             IF zb_anz_perio LE 99.
4566               i_zeitr-low+4(2) = i_zeitr-low+4(2) + 1.
4567             ELSE.
4568               i_zeitr-low+4(2) = '01'.
4569               i_zeitr-low(4) = i_zeitr-low(4) + 1.
4570             ENDIF.
4571         ENDCASE.
4572       ENDWHILE.
4573     ENDIF.
4574     CLEAR i_zeitr-high.
4575     i_zeitr-option = 'GE'.
4576     i_zeitr-sign = 'I'.
4577     APPEND i_zeitr.
4578   ENDFORM.
