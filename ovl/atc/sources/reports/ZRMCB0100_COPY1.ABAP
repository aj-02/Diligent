364    *---------------------------------------------------------------------*
365    *       FORM SEITENKOPF_FAKTOREN_AUSGEBEN                             *
366    *---------------------------------------------------------------------*
367    *       Ausgabe der Ausgabefaktoren in eine Überschriftszeile         *
368    *---------------------------------------------------------------------*
369    *  -->  SA_KENNZAHLEN                                                 *
370    *---------------------------------------------------------------------*
371    FORM SEITENKOPF_FAKTOREN_AUSGEBEN
372                              TABLES SF_KENNZAHLEN STRUCTURE AKT_KENNZAHLEN.
373
374      STATICS: SF_FLG_FIRST_FACTOR VALUE TRUE.
375
376      DATA: SF_TEXT1(3),
377            SF_FACTOR       TYPE N,
378            SF_BREITE       LIKE SY-COLNO, "Breite der Spaltenüberschrift
379            SF_ZEILENLAENGE TYPE I.        "Länge der ausgegebenen Zeile
380
381      FIELD-SYMBOLS: <SF_FACTOR_TEXT> LIKE FACTOR_TEXTS-T1.
382
383      IF GF_ACC_INIT = FALSE.
384          CALL FUNCTION 'GET_ACCESSIBILITY_MODE'
385       IMPORTING
386         ACCESSIBILITY           = gf_acc_on
387       EXCEPTIONS
388         ITS_NOT_AVAILABLE       = 1
389         OTHERS                  = 2
390               .
391        gf_acc_init = true.
392      ENDIF.
393
394
395      IF SF_FLG_FIRST_FACTOR = TRUE.
396        PERFORM TEXT_ERMITTELN USING    401
397    *                                   'Tsd'
398                               CHANGING SF_TEXT1.
399        REPLACE 'TSD' WITH SF_TEXT1 INTO: FACTOR_TEXTS-T3,
400                                          FACTOR_TEXTS-T4,
401                                          FACTOR_TEXTS-T5.
402        PERFORM TEXT_ERMITTELN USING    402
403    *                                   'Mio'
404                               CHANGING SF_TEXT1.
405        REPLACE 'MIO' WITH SF_TEXT1 INTO: FACTOR_TEXTS-T6,
406                                          FACTOR_TEXTS-T7,
407                                          FACTOR_TEXTS-T8.
408        PERFORM TEXT_ERMITTELN USING    403
409    *                                   'Mrd'
410                               CHANGING SF_TEXT1.
411        REPLACE 'MRD' WITH SF_TEXT1 INTO: FACTOR_TEXTS-T9.
412        SF_FLG_FIRST_FACTOR = FALSE.
413      ENDIF.
414
415      CLEAR <AUSTAB_TEXT>.
416      PERFORM SPALTENANFANG_AUSGEBEN USING FALSE.
417      POSITION STRICH_ANFANG.
418      WRITE SY-VLINE NO-GAP.
419      CLEAR SF_ZEILENLAENGE.
420
421      LOOP AT SF_KENNZAHLEN.
422        IF SF_KENNZAHLEN-FACTOR CO '0 '.
423    *     keinen Ausgabefaktor ausgeben
424          CLEAR SF_KENNZAHLEN-HEADLINE_2.
425
426        ELSE.
427    *     Breite der Spaltenüberschrift bestimmen
428          IF NOT SF_KENNZAHLEN-REFLEN IS INITIAL AND
429             FLG_EINHEITENZEILE       =  FALSE.
430    *       Einheitenfeld vorhanden
431            SF_BREITE = SF_KENNZAHLEN-OUTPUTLEN + SF_KENNZAHLEN-REFLEN + 1.
432          ELSE.
433    *       keine Einheit
434            SF_BREITE = SF_KENNZAHLEN-OUTPUTLEN.
435          ENDIF.
436
437          SF_FACTOR = SF_KENNZAHLEN-FACTOR.
438    *     Ausgabe mit Text
439          ASSIGN COMPONENT SF_FACTOR OF STRUCTURE FACTOR_TEXTS
440                           TO <SF_FACTOR_TEXT>.
441          SY-TFILL = STRLEN( <SF_FACTOR_TEXT> ) - 1.
442          IF SY-TFILL > 3 AND             "10 oder 100 und Tsd oder Mio
443             SY-TFILL > SF_BREITE.
444    *       Ausgabe mit Exponent
445            ASSIGN COMPONENT SF_FACTOR OF STRUCTURE FACTOR_TEXTS2
446                             TO <SF_FACTOR_TEXT>.
447          ENDIF.
448          SY-TFILL = STRLEN( <SF_FACTOR_TEXT> ) + 2.
449          IF SY-TFILL > SF_BREITE.
450    *       Ausgabe ohne 'in'
451            SF_KENNZAHLEN-HEADLINE_2 = <SF_FACTOR_TEXT>+1.
452          ELSE.
453    *       Ausgabe mit 'in'
454            CONCATENATE HLP_TEXT_IN <SF_FACTOR_TEXT>
455                        INTO SF_KENNZAHLEN-HEADLINE_2.
456          ENDIF.
457        ENDIF.
458
459    *   Aufgabefaktor (eventuell SPACE) ausgeben
460        PERFORM SPALTENUEBERSCHRIFT_AUSGEBEN USING    SF_KENNZAHLEN
461                                                      TRUE TRUE
462                                             CHANGING SF_ZEILENLAENGE.
463      ENDLOOP.
464
465      HIDE DARSTELLUNGSART.
466
467    ENDFORM.                               "SEITENKOPF_FAKTOREN_AUSGEBEN
