17     *---------------------------------------------------------------------*
18     *       FORM KENNZAHL_AUSGEBEN                                        *
19     *---------------------------------------------------------------------*
20     *       Kennzahl ausgeben                                             *
21     *---------------------------------------------------------------------*
22     *  -->  KA_INDEX      : Index der Kennzahl: > 0 in AKT_KENNZAHLEN     *
23     *                                           < 0 in KENNZAHLEN_TAB     *
24     *  -->  KA_KENNZAHL   : Kennzahl                                      *
25     *  -->  KA_SUMME      : Kennzahlsumme                                 *
26     *  -->  KA_EINHEIT    : Einheit der Kennzahl                          *
27     *  <--  KA_RETURNCODE : Returncode                                    *
28     *---------------------------------------------------------------------*
29     FORM KENNZAHL_AUSGEBEN USING VALUE(KA_INDEX) LIKE SY-TABIX
30                                  VALUE(KA_KENNZAHL) TYPE SIMPLE
31                                  KA_SUMME           TYPE SIMPLE
32                                  KA_EINHEIT       TYPE C
33                            CHANGING KA_RETURNCODE LIKE SY-SUBRC.
34
35       LOCAL: SPALTEN_BREITE,
36              SPALTEN_BREITE_P.
37
38       STATICS: KA_FLG_FIRST             TYPE BOOLEAN VALUE TRUE,
39                KA_FLG_KENNZAHL_AUSGEBEN TYPE BOOLEAN VALUE TRUE,
40                KA_FLG_EXIST             TYPE BOOLEAN VALUE TRUE,
41                KA_DUMMYZEIT             TYPE T VALUE '111111',
42                KA_ZEITMASKE(8).
43
44       DATA: KA_BREITE          LIKE SPALTEN_BREITE,
45             KA_PROZENTZAHL     TYPE P DECIMALS 2,
46             KA_QUICKINFO(255),
47             KA_CONVEXIT(7)     VALUE '==     ',
48             KA_SPALTEN_HAELFTE LIKE SPALTEN_BREITE,
49             KA_FACTOR          TYPE N,
50             KA_FLTP_GUELTIG    TYPE BOOLEAN VALUE TRUE.
51
52       FIELD-SYMBOLS: <KA_FACTOR>    LIKE FACTORS-F1.
53     *                <KA_QUICKINFO> TYPE C.
54
55       IF KA_FLG_FIRST = TRUE.
56     *   Maske für Ausgabe der Uhrzeit ermitteln.
57         KA_FLG_FIRST = FALSE.
58         WRITE KA_DUMMYZEIT TO KA_ZEITMASKE.
59         TRANSLATE KA_ZEITMASKE USING '1_'.
60       ENDIF.
61
62       IF KENNZAHL_ANZAHL < KA_INDEX.
63     *   Kennzahlausgabe beendet => HIDE-Information ausgeben.
64         HIDE: <AUSTAB_GLOBAL>-OBJEKT, <AUSTAB_GLOBAL>-ID,
65               DARSTELLUNGSART, AUSTAB_TABIX, SUMTAB_TABIX.
66         KA_RETURNCODE = 1.
67         EXIT.
68       ENDIF.
69
70     * Kennzahleigenschaften ermitteln
71       IF KA_INDEX > 0.
72     *   Ausgabe einer aktuellen Kennzahl
73         READ TABLE AKT_KENNZAHLEN INDEX KA_INDEX.
74       ELSEIF KA_INDEX < 0.
75     *   Ausgabe einer Kennzahlen aus der KENNZAHLEN_TAB
76         KA_INDEX = - KA_INDEX.
77         READ TABLE KENNZAHLEN_TAB INDEX KA_INDEX.
78         CLEAR AKT_KENNZAHLEN.
79         MOVE-CORRESPONDING KENNZAHLEN_TAB TO AKT_KENNZAHLEN.
80       ELSE.
81     *   Einzelausgabe der Kennzahl (z.B. wie bei Fkt. 'Alle Kennzahlen')
82         MOVE-CORRESPONDING KENNZAHLEN_TAB TO AKT_KENNZAHLEN.
83       ENDIF.
84
85       SPALTEN_BREITE = AKT_KENNZAHLEN-OUTPUTLEN.
86       IF AKT_KENNZAHLEN-REFLEN IS INITIAL OR
87          FLG_EINHEITENZEILE    <> FALSE.
88     *   Feld hat keine Einheit
89         SPALTEN_BREITE_P = AKT_KENNZAHLEN-OUTPUTLEN - 1.
90       ELSE.
91     *   Feld hat Einheit
92         SPALTEN_BREITE_P = AKT_KENNZAHLEN-OUTPUTLEN + AKT_KENNZAHLEN-REFLEN.
93       ENDIF.
94
95     * Feldsymbol setzen für Prüfung, ob Quickinfo nötig ist
96     * (entfällt vorerst aus Performance-Gründen, außer bei TYP D, T, C
97     * ASSIGN KA_QUICKINFO(SPALTEN_BREITE) TO <KA_QUICKINFO>.
98
99     * prüfen, ob Kennzahl angezeigt werden soll
100      IF FLG_LIS_REPORTING       =  FALSE              AND
101         DARSTELLUNGSART         <> CON_DARST_EINZEL   AND
102         DARSTELLUNGSART         <> CON_DARST_KENNZAHL AND
103         AKT_KENNZAHLEN-GESAMTKZ =  FALSE.
104        KA_FLG_KENNZAHL_AUSGEBEN = FALSE.
105      ELSE.
106        KA_FLG_KENNZAHL_AUSGEBEN = TRUE.
107      ENDIF.
108      PERFORM SPEZIAL_CHECK_KENNZAHL_AUSGEBN
109                                  IN PROGRAM (LIS_PROGNAME) IF FOUND
110                                  CHANGING KA_FLG_KENNZAHL_AUSGEBEN.
111
112    * Kennzahl an Kennzahlzeile anhängen
113      IF KA_FLG_KENNZAHL_AUSGEBEN = FALSE.
114    *   Leerstring mit Breite der Kennzahl ausgeben
115        WRITE AT SY-COLNO(SPALTEN_BREITE) SPACE NO-GAP.
116        IF NOT AKT_KENNZAHLEN-REFLEN IS INITIAL AND
117           FLG_EINHEITENZEILE        = FALSE.
118    *     Einheitenfeld vorhanden => Blanks für Einheit ausgeben
119          WRITE: AT SY-COLNO ' ' NO-GAP,
120                 AT SY-COLNO(AKT_KENNZAHLEN-REFLEN) SPACE NO-GAP.
121        ENDIF.
122
123      ELSEIF FLG_PROZENTWERT         = TRUE AND
124             AKT_KENNZAHLEN-GESAMTKZ = TRUE AND
125             AKT_KENNZAHLEN-REFFIELD <> CON_FELD_UNIT_PERCENT.
126    *   Kennzahl in Prozent ausgeben
127        IF FLG_EINHEITENZEILE = TRUE.
128          ADD 1 TO SPALTEN_BREITE_P.
129        ENDIF.
130        IF NOT KA_SUMME IS INITIAL.
131          KA_PROZENTZAHL = KA_KENNZAHL / KA_SUMME * 100.
132          WRITE AT SY-COLNO(SPALTEN_BREITE_P) KA_PROZENTZAHL NO-GAP.
133        ELSE.
134          SUBTRACT 1 FROM SPALTEN_BREITE_P.
135          WRITE AT SY-COLNO(SPALTEN_BREITE_P) '-' RIGHT-JUSTIFIED.
136        ENDIF.
137    *   Blank zwischen Prozentzahl und '%' überflüssig, da davonausgegangen
138    *   wird, das die Prozentzahl positiv ist (Vorzeichen steht hinter Zahl)
139        IF FLG_EINHEITENZEILE = FALSE.
140          WRITE AT SY-COLNO '%' NO-GAP.
141        ENDIF.
142
143      ELSEIF AKT_KENNZAHLEN-INTTYPE = CON_INTTYPE_DATUM.
144        IF KA_KENNZAHL IS INITIAL.
145    *     Leerstring mit Breite der Kennzahl ausgeben
146          WRITE AT SY-COLNO(SPALTEN_BREITE) SPACE NO-GAP.
147        ELSE.
148    *     immer aufbereitetes Datum ausgeben
149          IF SPALTEN_BREITE > 9.
150            WRITE AT (SPALTEN_BREITE) KA_KENNZAHL NO-GAP.
151          ELSE.
152            WRITE KA_KENNZAHL TO KA_QUICKINFO.
153            CASE SPALTEN_BREITE.
154              WHEN 7 OR 4.
155                KA_BREITE = SPALTEN_BREITE - 2.
156                WRITE: AT SY-COLNO(KA_BREITE) KA_KENNZAHL DD/MM/YY
157                                              RIGHT-JUSTIFIED
158                                              QUICKINFO KA_QUICKINFO,
159                                              SPACE(1) NO-GAP.
160              WHEN 9 OR 6 OR 3.
161                KA_BREITE = SPALTEN_BREITE - 1.
162                WRITE AT SY-COLNO(KA_BREITE) KA_KENNZAHL DD/MM/YY
163                                             RIGHT-JUSTIFIED
164                                             QUICKINFO KA_QUICKINFO.
165              WHEN OTHERS.
166                WRITE AT (SPALTEN_BREITE) KA_KENNZAHL DD/MM/YY
167                                             RIGHT-JUSTIFIED NO-GAP
168                                             QUICKINFO KA_QUICKINFO.
169            ENDCASE.
170          ENDIF.
171        ENDIF.
172
173      ELSEIF AKT_KENNZAHLEN-INTTYPE = CON_INTTYPE_ZEIT.
174        IF KA_KENNZAHL IS INITIAL.
175    *     Leerstring mit Breite der Kennzahl ausgeben
176          WRITE AT SY-COLNO(SPALTEN_BREITE) SPACE NO-GAP.
177        ELSE.
178          IF SPALTEN_BREITE < 8.
179            WRITE KA_KENNZAHL TO KA_QUICKINFO.
180          ENDIF.
181          WRITE AT (SPALTEN_BREITE) KA_KENNZAHL
182                                    USING EDIT MASK KA_ZEITMASKE NO-GAP
183                                    QUICKINFO KA_QUICKINFO.
184        ENDIF.
185
186    * Blanks nur Ausgeben bei Datentype <> FLTP
187    * Floatwerte können durchaus auch mit Initialwert sinnvoll sein, z.B.
188    * ein Mittelwert = 0. Dieser soll naürlich auch ausgegeben werden
189    * und nicht durch ' ' dargestellt werden
190      ELSEIF NOT ( AKT_KENNZAHLEN-REFFIELD IS INITIAL ) AND
191             NOT ( AKT_KENNZAHLEN-DATATYPE EQ CON_DATATYPE_FLTP ) AND
192             ( ( KA_EINHEIT IS INITIAL AND KA_KENNZAHL IS INITIAL ) OR
193               ( KA_EINHEIT = CON_EINHEIT_UNGUELTIG AND
194                 FLG_LIS_REPORTING = FALSE ) ).
195    *   Leerstring mit Breite der Kennzahl ausgeben
196        WRITE AT SY-COLNO(SPALTEN_BREITE) SPACE NO-GAP.
197        IF FLG_EINHEITENZEILE = FALSE.
198    *     Einheitenfeld vorhanden => Blanks für Einheit ausgeben
199          WRITE: AT SY-COLNO ' ' NO-GAP.
200          IF FLG_EINHEIT_UNGUELTIG_SICHTBAR = TRUE AND
201             KA_EINHEIT                     = CON_EINHEIT_UNGUELTIG.
202            WRITE AT SY-COLNO(AKT_KENNZAHLEN-REFLEN)
203                     CON_EINHEIT_UNGUELTIG NO-GAP.
204          ELSE.
205            WRITE AT SY-COLNO(AKT_KENNZAHLEN-REFLEN) SPACE NO-GAP.
206          ENDIF.
207        ENDIF.
208
209      ELSEIF AKT_KENNZAHLEN-INTTYPE CA 'DTC' AND
210             KA_KENNZAHL = CON_KENNZAHLWERT_UNGUELTIG.
211    *   Kennzahlwert bei Charakter-Kennzahlen ist ungültig => direkte
212    *   Ausgabe ohne typgerechte Ausgabe bzw. Konvertierung
213        WRITE AT SY-COLNO(SPALTEN_BREITE) CON_KENNZAHLWERT_UNGUELTIG NO-GAP.
214
215      ELSE.
216    *   Kennzahl absolut ausgeben ggf. dazugehörige Einheit
217        IF AKT_KENNZAHLEN-INTTYPE CA CON_INTTYPE_ZAHL AND
218           NOT AKT_KENNZAHLEN-FACTOR CO '0 '.
219    *     Kennzahl mit einem Faktor multiplizieren
220          KA_FACTOR = AKT_KENNZAHLEN-FACTOR.
221          ASSIGN COMPONENT KA_FACTOR OF STRUCTURE FACTORS TO <KA_FACTOR>.
222          KA_KENNZAHL = KA_KENNZAHL * <KA_FACTOR>.
223        ENDIF.
224
225        IF AKT_KENNZAHLEN-CONVEXIT <> SPACE.
226          KA_CONVEXIT+2 = AKT_KENNZAHLEN-CONVEXIT.
227          DATA lv_keyfigure_cnv(60) TYPE c. " 60 = max length in LIS
228          lv_keyfigure_cnv = KA_KENNZAHL.
229          WRITE AT SY-COLNO(SPALTEN_BREITE) lv_keyfigure_cnv
230                   USING EDIT MASK KA_CONVEXIT NO-GAP.
231
232        ELSEIF AKT_KENNZAHLEN-DOMNAME = 'XFELD'.
233    *     Feld als Checkbox ausgeben
234          CASE SPALTEN_BREITE.
235            WHEN 1.
236              WRITE AT SY-COLNO KA_KENNZAHL AS CHECKBOX INPUT OFF NO-GAP.
237            WHEN 2.
238              WRITE AT SY-COLNO KA_KENNZAHL AS CHECKBOX INPUT OFF.
239            WHEN 3.
240              WRITE: AT SY-COLNO(1) SPACE NO-GAP,
241                     AT SY-COLNO KA_KENNZAHL AS CHECKBOX INPUT OFF.
242            WHEN OTHERS.
243              KA_SPALTEN_HAELFTE = SPALTEN_BREITE / 2 - 1.
244              WRITE: AT SY-COLNO(KA_SPALTEN_HAELFTE) SPACE NO-GAP,
245                     AT SY-COLNO KA_KENNZAHL AS CHECKBOX INPUT OFF NO-GAP.
246              KA_SPALTEN_HAELFTE = SPALTEN_BREITE - KA_SPALTEN_HAELFTE - 1.
247              WRITE AT SY-COLNO(KA_SPALTEN_HAELFTE) SPACE NO-GAP.
248          ENDCASE.
249
250        ELSEIF AKT_KENNZAHLEN-DATATYPE = CON_DATATYPE_CURR.
251    *     Einheit ist eine Währung
252          IF KA_EINHEIT = CON_EINHEIT_UNGUELTIG.
253    *       Währung ist Dummywährung
254            IF AKT_KENNZAHLEN-ODECIMALS IS INITIAL.
255    *         Nachkommastellen wie im Dictionary
256              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL NO-GAP.
257            ELSE.
258    *         Nachkommastellen sind explizit angegeben
259              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
260                    DECIMALS AKT_KENNZAHLEN-ODECIMALS NO-GAP.
261            ENDIF.
262
263          ELSEIF NOT KA_KENNZAHL IS INITIAL OR
264                 NOT KA_EINHEIT  IS INITIAL.
265    *       Währung ist keine Dummywährung
266            IF AKT_KENNZAHLEN-ODECIMALS IS INITIAL.
267    *         Nachkommastellen währungsgerecht
268              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
269                       CURRENCY KA_EINHEIT NO-GAP.
270            ELSE.
271    *         Nachkommastellen sind explizit angegeben
272              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
273                       DECIMALS AKT_KENNZAHLEN-ODECIMALS
274                       CURRENCY KA_EINHEIT NO-GAP.
275            ENDIF.
276          ENDIF.
277
278        ELSEIF AKT_KENNZAHLEN-DATATYPE = CON_DATATYPE_QUAN.
279    *     Einheit ist eine Mengeneinheit
280          IF AKT_KENNZAHLEN-ODECIMALS IS INITIAL.
281    *       Nachkommastellen einheitengerecht
282            if akt_kennzahlen-sign is initial.
283    *         Ausgabe des Vorzeichens bei vorzeichenlosen
284    *         Zahlen unterdrücken
285    *         NEU in 4.6C für QUAN und DEC
286    *         vgl. CSS-Meldung Nr. 133193/1999
287              write at sy-colno(spalten_breite) ka_kennzahl
288              unit ka_einheit no-sign no-gap.
289            else.
290              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
291                       UNIT KA_EINHEIT NO-GAP.
292            endif.
293          ELSE.
294    *       Nachkommastellen sind explizit angegeben
295            if akt_kennzahlen-sign is initial.
296              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
297                       DECIMALS AKT_KENNZAHLEN-ODECIMALS NO-SIGN NO-GAP.
298            else.
299              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
300                       DECIMALS AKT_KENNZAHLEN-ODECIMALS NO-GAP.
301            endif.
302          ENDIF.
303
304        ELSEIF AKT_KENNZAHLEN-DATATYPE = CON_DATATYPE_DEC.
305    *     Einheit ist eine Mengeneinheit
306          IF AKT_KENNZAHLEN-ODECIMALS IS INITIAL.
307    *       Nachkommastellen wie in Domäne definiert
308            if akt_kennzahlen-sign is initial.
309              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL NO-SIGN NO-GAP.
310            else.
311              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL NO-GAP.
312            endif.
313          ELSE.
314    *       Nachkommastellen sind explizit angegeben
315            if akt_kennzahlen-sign is initial.
316              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
317                       DECIMALS AKT_KENNZAHLEN-ODECIMALS NO-SIGN NO-GAP.
318            else.
319              WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
320                       DECIMALS AKT_KENNZAHLEN-ODECIMALS NO-GAP.
321            endif.
322          ENDIF.
323
324        ELSEIF AKT_KENNZAHLEN-DATATYPE = CON_DATATYPE_FLTP.
325          IF AKT_KENNZAHLEN-DDECIMALS EQ TRUE.
326            PERFORM SPEZIAL_DECIMALS_BESTIMMEN IN PROGRAM (LIS_PROGNAME)
327                    USING AKT_KENNZAHLEN-FIELDNAME
328                    CHANGING AKT_KENNZAHLEN-ODECIMALS
329                    IF FOUND.
330          ENDIF.
331          IF KA_FLG_EXIST EQ TRUE.
332            PERFORM SPEZIAL_FLTP_AUSGABE_GUELTIG IN PROGRAM (LIS_PROGNAME)
333                            IF FOUND
334                            USING    AKT_KENNZAHLEN-FIELDNAME
335                            CHANGING KA_FLTP_GUELTIG
336                                     KA_FLG_EXIST.
337    *                        TABLES   aus_s000
338    *                        .
339            IF KA_FLG_EXIST IS INITIAL.
340              KA_FLG_EXIST = TRUE.
341            ELSE.
342              KA_FLG_EXIST = FALSE.
343            ENDIF.
344          ENDIF.
345
346          IF KA_FLTP_GUELTIG EQ FALSE.
347    *     IF ka_kennzahl EQ con_fltp_ungueltig.
348            SUBTRACT 1 FROM SPALTEN_BREITE.
349            WRITE: AT SY-COLNO(SPALTEN_BREITE) CON_KENNZAHLWERT_UNGUELTIG
350                   RIGHT-JUSTIFIED NO-GAP,
351                   AT SY-COLNO ' ' NO-GAP.
352            ADD 1 TO SPALTEN_BREITE.
353          ELSE.
354    *       Ausgabe von Float-Feldern => Spaltenbreite dekrementieren, da
355    *       Vorzeichen vor der Zahl ausgegeben wird
356            SUBTRACT 1 FROM SPALTEN_BREITE.
357    *       Wenn Kennzahl ungültig, dann '***' ausgeben
358            IF AKT_KENNZAHLEN-ODECIMALS IS INITIAL.
359    *         immer drei Nachkommastellen
360              WRITE: AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
361                        EXPONENT 0 DECIMALS 3 NO-GAP,
362                     AT SY-COLNO ' ' NO-GAP.
363            ELSE.
364    *         Nachkommastellen sind explizit angegeben
365              WRITE: AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
366                        EXPONENT 0 DECIMALS AKT_KENNZAHLEN-ODECIMALS NO-GAP,
367                     AT SY-COLNO ' ' NO-GAP.
368            ENDIF.
369          ENDIF.
370
371        ELSEIF DARSTELLUNGSART   = CON_DARST_KENNZAHL AND
372               FLG_LIS_REPORTING = TRUE.
373    *     Sonderregeln für Popup 'Alle Kennzahlen': alle Kennzahlenwerte
374    *     rechtsbündig unter die letzte Ziffer ('-' am Ende beachten)
375          IF AKT_KENNZAHLEN-INTTYPE CA CON_INTTYPE_ZAHL.
376            IF AKT_KENNZAHLEN-INTTYPE = 'N'.
377    *         NUMC rechtsbündig
378              SUBTRACT 1 FROM SPALTEN_BREITE.
379            ENDIF.
380          ELSE.
381            SUBTRACT 1 FROM SPALTEN_BREITE.
382          ENDIF.
383          WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
384            RIGHT-JUSTIFIED NO-GAP.
385
386        ELSEIF AKT_KENNZAHLEN-INTTYPE = 'N'.
387    *     NUMC rechtsbündig
388          WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL
389                                            RIGHT-JUSTIFIED NO-GAP.
390
391        ELSE.
392    *     Normale Ausgabe
393          IF AKT_KENNZAHLEN-INTTYPE = 'C'.
394            SY-FDPOS = STRLEN( KA_KENNZAHL ).
395            IF SY-FDPOS > SPALTEN_BREITE.
396              KA_QUICKINFO = KA_KENNZAHL.
397            ENDIF.
398          ENDIF.
399          WRITE AT SY-COLNO(SPALTEN_BREITE) KA_KENNZAHL NO-GAP
400                                            QUICKINFO KA_QUICKINFO.
401        ENDIF.
402
403        IF NOT AKT_KENNZAHLEN-REFFIELD IS INITIAL AND
404           FLG_EINHEITENZEILE          =  FALSE.
405    *     Einheitenfeld vorhanden => Einheit ausgeben
406          WRITE AT SY-COLNO ' ' NO-GAP.
407          IF KA_EINHEIT = CON_EINHEIT_UNGUELTIG.
408            IF FLG_EINHEIT_UNGUELTIG_SICHTBAR = TRUE.
409              WRITE AT SY-COLNO(AKT_KENNZAHLEN-REFLEN)
410                       CON_EINHEIT_UNGUELTIG NO-GAP.
411            ELSE.
412              WRITE AT SY-COLNO(AKT_KENNZAHLEN-REFLEN) SPACE NO-GAP.
413            ENDIF.
414          ELSEIF AKT_KENNZAHLEN-DATATYPE = CON_DATATYPE_QUAN.
415            WRITE AT SY-COLNO(AKT_KENNZAHLEN-REFLEN)
416                  KA_EINHEIT USING EDIT MASK '==CUNIT' NO-GAP.
417          ELSE.
418            WRITE AT SY-COLNO(AKT_KENNZAHLEN-REFLEN) KA_EINHEIT NO-GAP.
419          ENDIF.
420        ENDIF.
421      ENDIF.
422
423    * Senkrechten Strich am Spaltenende ausgeben
424      IF KA_INDEX > 0.
425    *   Ausgabe der Kennzahle in Tabelle (keine Einzelausgabe)
426        WRITE AT SY-COLNO SY-VLINE NO-GAP.
427      ENDIF.
428    ENDFORM.                               "KENNZAHL_AUSGEBEN
