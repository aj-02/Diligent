992
993      AU_TEXTLAENGE = SPALTEN_ANFANG - MERKMALS_ANFANG.
994
995    * Textlänge auf die erlaubte Länge beschränken
996      IF AU_TEXTLAENGE < 1.
997        AU_TEXTLAENGE = 1.
998      ELSEIF AU_TEXTLAENGE > 60.
999        AU_TEXTLAENGE = 60.
1000     ENDIF.
1001     ASSIGN <AUSTAB_GLOBAL>-TEXT(AU_TEXTLAENGE) TO <AUSTAB_TEXT>.
1002
1003   * Position des Striches vor der 1. Kennzahl bestimmen
1004     STRICH_ANFANG = SPALTEN_ANFANG - 1.
