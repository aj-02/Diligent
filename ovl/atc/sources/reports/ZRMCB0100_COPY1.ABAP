209    *---------------------------------------------------------------------*
210    *       FORM DDOWN_EINSTELLUNGEN_SICHERN                              *
211    *---------------------------------------------------------------------*
212    *       Sichern der Einstellungen (Layout, Kennzahlen, Sortierung und *
213    *       Aufriß) der akuellen Aufrißstufe                              *
214    *---------------------------------------------------------------------*
215    *  -->  DS_INDEX: Tabellenindex zum Ändern von AKT_DRILLDOWN          *
216    *---------------------------------------------------------------------*
217    FORM DDOWN_EINSTELLUNGEN_SICHERN USING DS_INDEX LIKE SY-TABIX.
218
219      DELETE SAV_AKT_DRILLDOWN WHERE LSIND EQ SY-LSIND.
220                                                  " <= note 92494, ver. 04
221
222    *   Layouteinstellung übernehmen
223      READ TABLE AKT_DRILLDOWN INDEX DS_INDEX.
224      AKT_DRILLDOWN-WAEHRUNG        = ANALYSE_WAEHRUNG.
225      AKT_DRILLDOWN-FLG_TOPLISTE    = FLG_TOPLISTE.
226      AKT_DRILLDOWN-HITL_GROESSE    = HITLISTEN_GROESSE.
227      AKT_DRILLDOWN-HITL_KRITERIUM  = HITL_KRITERIUM.
228      AKT_DRILLDOWN-FLG_SORT_ABST   = FLG_SORT_ABST.
229      AKT_DRILLDOWN-FLG_HEADER_PATH = FLG_HEADER_PATH.
230      AKT_DRILLDOWN-FLG_OBJEKTTEXT  = FLG_OBJEKTTEXT.
231      AKT_DRILLDOWN-FLG_PROZENTWERT = FLG_PROZENTWERT.
232      AKT_DRILLDOWN-SPALTEN_ANFANG  = SPALTEN_ANFANG.
233      AKT_DRILLDOWN-SPALTEN_BREITE  = SPALTEN_BREITE.
234      MODIFY AKT_DRILLDOWN INDEX DS_INDEX.
235    * ausgewählte Kennzahlen sichern
236      LOOP AT AKT_KENNZAHLEN.
237        SAV_KENNZAHLEN       = AKT_KENNZAHLEN.
238        SAV_KENNZAHLEN-LSIND = SY-LSIND.
239        INSERT SAV_KENNZAHLEN INDEX 1.
240      ENDLOOP.
241    * ausgewählte Sortier- und Gruppierkriterien sichern
242      LOOP AT SORT_KENNZAHLEN.
243        SAV_SORT_KENNZAHLEN = SORT_KENNZAHLEN.
244        SAV_SORT_KENNZAHLEN-LSIND = SY-LSIND.
245        APPEND SAV_SORT_KENNZAHLEN.
246    *    INSERT SAV_SORT_KENNZAHLEN INDEX 1.
247      ENDLOOP.
248      CLEAR SORT_KENNZAHLEN.
249      REFRESH SORT_KENNZAHLEN.
250    * Drilldown für 'F4' sichern auf Merkmal sichern
251      LOOP AT AKT_DRILLDOWN.
252        SAV_AKT_DRILLDOWN       = AKT_DRILLDOWN.
253        SAV_AKT_DRILLDOWN-LSIND = SY-LSIND.
254        INSERT SAV_AKT_DRILLDOWN INDEX 1.
255      ENDLOOP.
256    * Kriterien für Rangliste und Sortierung zurücksetzen
257      CLEAR: HITL_KRITERIUM,
258             SORT_KRITERIUM,
259             ANZ_SORTKRIT.
260      IF FLG_VERGLEICH <> FALSE.
261    *   Sortierkriterium im Vergleich merken
262        PERFORM VGL_SORTIERUNG_MERKEN.
263      ENDIF.
264    ENDFORM.                               "DDOWN_EINSTELLUNGEN_SICHERN
