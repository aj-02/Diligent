658    *---------------------------------------------------------------------*
659    *       FORM AKTUELLE_PERIODE_FESTHALTEN                              *
660    *---------------------------------------------------------------------*
661    *    Fallunterscheidung:
662    * 1) Periode kommt im Aufriß vor ==> aktuelle Periode = Periode aus
663    *    DD_RANGES
664    * 2) Periode nicht im Aufriß ==> Aktuelle Periode wird aus PERIOTAB
665    *    bestimmt.
666    *---------------------------------------------------------------------*
667    FORM aktuelle_periode_festhalten USING af_flg TYPE c.
668
669    * data: af_flg.
670      CASE sav_speri.
671        WHEN con_speri_sptag.
672          READ TABLE dd_sptag INDEX 1.
673          IF sy-subrc = 0.
674            akt_tag = dd_sptag-low.
675            af_flg = true.
676          ENDIF.
677        WHEN con_speri_spwoc.
678          READ TABLE dd_spwoc INDEX 1.
679          IF sy-subrc = 0.
680            akt_woc = dd_spwoc-low.
681            af_flg = true.
682          ENDIF.
683        WHEN con_speri_spmon.
684          READ TABLE dd_spmon INDEX 1.
685          IF sy-subrc = 0.
686            akt_mon = dd_spmon-low.
687            af_flg = true.
688          ENDIF.
689        WHEN con_speri_spbup.
690          READ TABLE dd_spbup INDEX 1.
691          IF sy-subrc = 0.
692            akt_bup = dd_spbup-low.
693            af_flg = true.
694          ENDIF.
695      ENDCASE.
696      IF af_flg = false.
697    *Die PERIOTAB ist absteigend nach Perioden sortiert
698        CLEAR periotab.
699        LOOP AT periotab.
700          IF periotab-low IN zeitr.
701            CASE sav_speri.
702              WHEN con_speri_sptag.
703                akt_tag = periotab-low.
704              WHEN con_speri_spwoc.
705                akt_woc = periotab-low.
706              WHEN con_speri_spmon.
707                akt_mon = periotab-low.
708              WHEN con_speri_spbup.
709                akt_bup = periotab-low.
710            ENDCASE.
711            EXIT.
712          ENDIF.
713        ENDLOOP.
714      ENDIF.
715    ENDFORM.                               "aktuelle_periode_festhalten
