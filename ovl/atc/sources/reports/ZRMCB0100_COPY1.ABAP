5837           AND spmon IN pp_spmon
5838           AND sptag IN pp_sptag
5839           AND spwoc IN pp_spwoc
5840           AND spbup IN pp_spbup
5841           AND werks IN pp_werks
5842           AND matnr IN pp_matnr
5843           AND lgort IN pp_lgort
5844           AND dispo IN pp_dispo
