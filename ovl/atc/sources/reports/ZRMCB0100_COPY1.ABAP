1852   *       FORM INT_S0XX_FUELLEN                                         *
1853   *---------------------------------------------------------------------*
1854   * 1.    Füllen der Int_S031 mit Bewegungsdaten aus der S031           *
1855   * 2.    Füllen der Int_S032 mit Bestandsdaten  aus der S032           *
1856   *---------------------------------------------------------------------*
1857   FORM int_s0xx_fuellen.
1858
1859     DATA: if_maxfieldname LIKE mcs04-ddicfeld,
1860           if_hlp_lines TYPE i,
1861           if_matnr LIKE s032-matnr,
1862           lv_index.
1863
1864     RANGES: matinfo FOR s032-matnr.
1865     CLEAR:   int_s031, int_s032.
1866     REFRESH: int_s031, int_s032, gr_lgort.
1867   * Bei Bewertung Standard wird nicht über den Lagerort selektiert
1868   * Ebenfalls wird bei Bewertung Standard nicht über Bewertungsklasse
1869   * selektiert. Bei den anderen Bewertungen werden die Eingaben
1870   * berücksichtigt
1871     IF va EQ false.
1872       gr_lgort[] = sl_lgort[].
1873       gr_bklas[] = sl_bklas[].
1874     ENDIF.
1875
1876     PERFORM select_vorbereiten CHANGING if_maxfieldname.
1877   * Testen, ob merkmals_tab gefüllt ist. (Falls assign fehlschlägt)      *
1878     DESCRIBE TABLE merkmals_tab LINES if_hlp_lines.
1879     IF if_hlp_lines = 0.
1880       CLEAR if_maxfieldname.
1881     ENDIF.
1882   * Ranges für VRSIO füllen
1883     REFRESH sl_vrsio.
1884     sl_vrsio-low    = selektions_vrsio.
1885     sl_vrsio-high   = selektions_vrsio.
1886     sl_vrsio-option = 'EQ'.
1887     sl_vrsio-sign   = 'I'.
1888     APPEND sl_vrsio.
1889
1890   * Rangestabelle ZEITR füllen für Selektion in S031
1891     PERFORM zeitr_fuellen.
1892
1893   * Tabelle I_ZEITR fuellen für Initialisierung der PERIOTAB
1894     PERFORM i_zeitr_fuellen.
1895
1896   * Tabelle I_ZEITR konvertieren für Select auf Bestände/Bewegungen
1897     PERFORM i_zeitr_konvertieren.
1898
1899     CLEAR: subrc_bew, subrc_bst.
1900
1901     CASE if_maxfieldname.
1902       WHEN 'MATNR'.
1903         PERFORM inttab_matnr.
1904       WHEN 'WERKS'.
1905         PERFORM inttab_werks.
1906       WHEN 'LGORT'.
1907         PERFORM inttab_lgort.
1908       WHEN 'DISPO'.
1909         PERFORM inttab_dispo.
1910       WHEN 'GSBER'.
1911         PERFORM inttab_gsber.
1912       WHEN 'MATKL'.
1913         PERFORM inttab_matkl.
1914       WHEN 'SPART'.
1915         PERFORM inttab_spart.
1916       WHEN 'MTART'.
1917         PERFORM inttab_mtart.
1918       WHEN 'BKLAS'.
1919         PERFORM inttab_bklas.
1920       WHEN OTHERS.
1921         PERFORM inttab_general.
1922     ENDCASE.
1923     PERFORM sort_int_s031.
1924
1925     GET RUN TIME FIELD sav_duration.
1926     IF sav_duration GT 60000000.                              " 60 sec
1927       PERFORM check_index CHANGING lv_index.
1928       IF lv_index EQ false.
1929         MESSAGE s701(m5).
1930   * Technische Information: Datenbankindex sinnvoll
1931   * Index kann von SAP nicht ausgeliefert werden, da Aktivierung
1932   * zu lange dauern kann (siehe Hinweis 394956)
1933       ENDIF.
1934     ENDIF.
1935
1936     IF ak = true OR ml = true.
1937   * Bewertungskreisermittlung f. Bewertung auf Lagerortebene
1938       SORT int_s032 BY matnr.
1939       CLEAR werkinfo-high.
1940       werkinfo-option = 'EQ'.
1941       werkinfo-sign = 'I'.
1942       SELECT * FROM t001w WHERE werks IN sl_werks.
1943         werkinfo-low = t001w-bwkey.
1944         APPEND werkinfo.
1945       ENDSELECT.
1946
1947       CLEAR matinfo-high.
1948       matinfo-option = 'EQ'.
1949       matinfo-sign = 'I'.
1950       CLEAR if_matnr.
1951       LOOP AT int_s032.
1952         IF if_matnr <> int_s032-matnr.
1953           matinfo-low = int_s032-matnr.
1954           APPEND matinfo.
1955           if_matnr = matinfo-low.
1956         ENDIF.
1957       ENDLOOP.
1958   * Bewertungsdaten einlesen
1959       IF NOT matinfo[] IS INITIAL.
1960         SELECT * FROM mbew INTO TABLE xmbew FOR ALL ENTRIES IN matinfo
1961           WHERE matnr = matinfo-low
1962             AND bwkey IN werkinfo
1963             AND bwtar = space
1964             ORDER BY PRIMARY KEY.
1965       ENDIF.
1966     ENDIF.
1967
1968     IF subrc_bew = 4 AND subrc_bst = 4.
1969   * Selektion aller Bewegungen im Zeitraum Periotab-low bis Sy-Datum
1970   * Es müssen auch die Bewegungen selektiert werden, die nicht auf dem
1971   * Selektionsscreen erscheinen, aber zum Rückrechnen der Bestände be-
1972   * nötigt werden.
1973   * bei planversionen int_s000 aus s039 füllen
1974       SELECT * FROM s039 INTO CORRESPONDING FIELDS OF TABLE int_s000
1975         WHERE ssour =  space
1976           AND vrsio IN sl_vrsio
1977           AND spmon IN sl_spmon
1978           AND sptag IN sl_sptag
1979           AND spwoc IN sl_spwoc
1980           AND spbup IN sl_spbup
1981           AND werks IN sl_werks
1982           AND matnr IN sl_matnr
1983           AND lgort IN gr_lgort
1984           AND dispo IN sl_dispo
1985           AND gsber IN sl_gsber
1986           AND matkl IN sl_matkl
1987           AND dismm IN sl_dismm
1988           AND spart IN sl_spart
1989           AND mtart IN sl_mtart
1990           AND bklas IN gr_bklas
1991           ORDER BY PRIMARY KEY.
1992        IF sy-subrc EQ 0.
1993           message I178 with selektions_vrsio.
1994        ENDIF.
1995     ENDIF.
1996     SORT int_s032 BY werks matnr lgort.
1997   ENDFORM.                               "int_s0xx_fuellen
