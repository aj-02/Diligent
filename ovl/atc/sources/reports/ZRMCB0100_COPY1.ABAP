431    *---------------------------------------------------------------------*
432    *       FORM KENNZAHL_EINHEIT_SETZEN                                  *
433    *---------------------------------------------------------------------*
434    *       Einheit einer Kennzahlenspalte prüfen und in der Struktur     *
435    *       für die Funktionsbausteine der ABC-Analyse usw. setzen        *
436    *---------------------------------------------------------------------*
437    *  -->  KS_SPALTE  : Kennzahlspalte                                   *
438    *  <--  KS_KENNZAHL: Kennzahlspezifikation für Funktionsbausteine     *
439    *---------------------------------------------------------------------*
440    FORM KENNZAHL_EINHEIT_SETZEN
441                         USING     KS_SPALTE   STRUCTURE KENNZAHL_SPALTE
442                         CHANGING  KS_KENNZAHL STRUCTURE KENNZAHL.
443
444    * Die Spalteneinheit wird ermittelt und in <SUM_UNIT> gestellt
445      _ASSIGN_X COMPONENT KS_SPALTE-REFFIELD OF STRUCTURE SUM_S000
446                                             TO <SUM_UNIT>.
447
448      CASE KS_SPALTE-DATATYPE.
449        WHEN CON_DATATYPE_CURR.
450    *     Währung
451          IF <SUM_UNIT> = CON_EINHEIT_UNGUELTIG.
452    *       "Die Währungen sind verschieden. Bitte Analysewährung wählen."
453            MESSAGE E020.
454            CLEAR KS_KENNZAHL-WAERS.
455          ELSE.
456            KS_KENNZAHL-WAERS = <SUM_UNIT>.
457          ENDIF.
458        WHEN CON_DATATYPE_QUAN.
459    *     Mengeneinheit
460          IF <SUM_UNIT> = CON_EINHEIT_UNGUELTIG.
461    *       "Die Mengeneinh. sind verschieden - Fkt. wird ohne EinheitBe..."
462            MESSAGE I021.
463            CLEAR KS_KENNZAHL-MEINS.
464          ELSE.
465            KS_KENNZAHL-MEINS = <SUM_UNIT>.
466          ENDIF.
467        WHEN OTHERS.
468    *     Eine dimensionslose Größe liegt vor
469          KS_KENNZAHL-KOMMA = KS_SPALTE-DECIMALS.
470      ENDCASE.
471    ENDFORM.                               "KENNZAHL_EINHEIT_SETZEN
