462    *           eisbe_matnr = ac_inttab-matnr.
463    *         endif.
464            ENDIF.
465        ENDCASE.
466      ENDIF.
467
468      IF ac_austab-%bklas NE ac_inttab-bklas
469        AND NOT ac_inttab-bklas IS INITIAL.
470        IF ac_austab-%bklas IS INITIAL.
471          ac_austab-%bklas = ac_inttab-bklas.
