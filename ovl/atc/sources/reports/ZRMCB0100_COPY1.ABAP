983    *       FORM KENNZAHLSPALTE_BESTIMMEN                                 *
984    *---------------------------------------------------------------------*
985    *       Bestimmen der Kennzahlspalte auf der der Cursor steht. Die    *
986    *       Spalte wird in die Feldleiste KENNZAHL_SPALTE gestellt.       *
987    *       KENNZAHL_SPALTE gestellt. Ist dies die Merkmalsspalte wird    *
988    *       die Feldleiste mit dem Initialwert belegt                     *
989    *---------------------------------------------------------------------*
990    *  -->  KB_FLG_MERKMAL_ERLAUBT: Flag, das angibt ob die Positionie-   *
991    *                               auf der Merkmalsspalte erlaubt ist    *
992    *                               = TRUE : Positionierung erlaubt       *
993    *                               = FALSE: Positionierung nicht erlaubt *
994    *---------------------------------------------------------------------*
995    FORM KENNZAHLSPALTE_BESTIMMEN
996                       USING KB_FLG_MERKMAL_ERLAUBT TYPE  BOOLEAN.
997
998      DATA: SB_HLP_CUCOL    LIKE SY-CUCOL,
999            SB_AKT_CUROW    LIKE SY-CUCOL,
1000           SB_AKT_CUCOL    LIKE SY-CUCOL,
1001           e_item_selected like sy-tabix,
1002           SB_SPALTE       LIKE SY-TABIX.
1003     DATA: KB_FLG_KEIN_STANDARD TYPE BOOLEAN VALUE FALSE.
1004
1005     IF DARSTELLUNGSART <> CON_DARST_EINZEL      AND
1006        DARSTELLUNGSART <> CON_DARST_SUMME       AND
1007        DARSTELLUNGSART <> CON_DARST_RESTSUMME   AND
1008        DARSTELLUNGSART <> CON_DARST_VERDICHTUNG AND
1009        DARSTELLUNGSART <> CON_DARST_UEBERSCHRIFT.
1010       clear flg_vergleich.                      " <= note 314504, ver.02
1011   *   "Bitte Cursor auf eine Kennzahlenspalte positionieren"
1012       MESSAGE E009.
1013     ENDIF.
1014
1015     PERFORM SPEZIAL_KENNZAHLSPALTE_BEST IN PROGRAM (LIS_PROGNAME)
1016                                         USING KB_FLG_MERKMAL_ERLAUBT
1017                                         CHANGING KB_FLG_KEIN_STANDARD
1018                                         IF FOUND.
1019     CHECK KB_FLG_KEIN_STANDARD EQ FALSE.
1020
1021     SB_HLP_CUCOL = SPALTEN_ANFANG.
1022     GET CURSOR LINE SB_AKT_CUROW OFFSET SB_AKT_CUCOL.
1023     SB_AKT_CUCOL = SB_AKT_CUCOL + 2.
1024
1025     IF SB_AKT_CUCOL > SB_HLP_CUCOL.
1026       LOOP AT AKT_KENNZAHLEN.
1027         ADD 1 TO SB_SPALTE.
1028         SB_HLP_CUCOL = SB_HLP_CUCOL + AKT_KENNZAHLEN-OUTPUTLEN + 1.
1029         IF NOT AKT_KENNZAHLEN-REFLEN IS INITIAL AND
1030            FLG_EINHEITENZEILE        =  FALSE.
1031   *       Einheitenfeld vorhanden
1032           SB_HLP_CUCOL = SB_HLP_CUCOL + AKT_KENNZAHLEN-REFLEN + 1.
1033         ENDIF.
1034         IF SB_AKT_CUCOL <= SB_HLP_CUCOL.
1035           EXIT.
1036         ENDIF.
1037       ENDLOOP.
1038     ENDIF.
1039
1040     IF SB_SPALTE IS INITIAL.
1041       IF KB_FLG_MERKMAL_ERLAUBT = FALSE.
1042   *     "Bitte Cursor auf eine Kennzahlenspalte positionieren"
1043         clear flg_vergleich.                             " <= note 314504
1044         MESSAGE E009.
1045       ELSE.
1046   *     Cursor steht auf Merkmalsspalte
1047         CLEAR: KENNZAHL_SPALTE,
1048                SY-TABIX.
1049       ENDIF.
1050
1051     ELSE.
1052   *   Kennzahldaten zur ermittelten Spalte bestimmen
1053       READ TABLE AKT_KENNZAHLEN INDEX SB_SPALTE.
1054       IF NOT FLG_VERGLEICH IS INITIAL AND
1055          AKT_KENNZAHLEN-INTTYPE NA CON_INTTYPE_ZAHL.
1056   *     Vergleiche gehen nur auf numerischen Kennzahlen
1057   *     "Bitte Cursor auf numerische Spalte positionieren"
1058         CLEAR FLG_VERGLEICH.                             " <= note 197571
1059         MESSAGE E016.
1060       ENDIF.
1061       KENNZAHL_SPALTE = AKT_KENNZAHLEN.
1062     ENDIF.
1063
1064   ENDFORM.                               "KENNZAHLSPALTE_BESTIMMEN
