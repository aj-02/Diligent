2729   *---------------------------------------------------------------------*
2730   *       FORM PERIOLAENGE_BUPER                                        *
2731   *---------------------------------------------------------------------*
2732   *       Für die Kennzahlen Umschlagshäufigkeit und Reichweite wird    *
2733   *       der mittlere Gesamtverbrauch pro Tag benötigt.                *
2734   *       bei Periodizität Buchungsperiode hängt die Länge der Periode  *
2735   *       von der Gjahresvariante ab. Diese ist entweder voreingestellt *
2736   *       in Tab. TMC4 oder muß über das Werk bestimmt werden.          *
2737   *       Anschließend wird die Tab. T009 gelesen, um die Anzahl der    *
2738   *       perioden zu bestimmen. Die Periodenlaenge ergibt sich als     *
2739   *       Quotient aus 360 / Anzahl Perioden                            *
2740   *       Für die jahresbezogene Umschlagshäufigkeit wird zusätzlich    *
2741   *       noch die Variable JAHRESPERIODEN festgehalten                 *
2742   *---------------------------------------------------------------------*
2743   FORM periolaenge_buper.
2744     DATA: pb_lines LIKE sy-tabix,
2745           pb_anzperio LIKE sy-tabix.
2746
2747   * if perivar ne space.
2748   * select single * from t009 where periv = perivar.
2749     SELECT SINGLE * FROM t009 WHERE periv = sav_periv.
2750     IF sy-subrc = 0.
2751       pb_anzperio = t009-anzbp.
2752     ENDIF.
2753     IF pb_anzperio = 0.
2754   * else.
2755   *Erscheint Merkmal 'Werk' im Aufriß ?
2756       READ TABLE dd_werks INDEX 1.
2757       IF sy-subrc = 0.
2758   *Tabelle HLP_TAB2 enthält zu jedem Werk die Gjahresvariante
2759   *     read table hlp_tab2 index dd_werks-low.
2760         READ TABLE hlp_tab2 WITH KEY dd_werks-low BINARY SEARCH.
2761         IF sy-subrc = 0.
2762           SELECT SINGLE * FROM t009 WHERE periv = hlp_tab2-periv.
2763           IF sy-subrc = 0.
2764             pb_anzperio = t009-anzbp.
2765           ENDIF.
2766         ENDIF.
2767       ELSE.
2768   *Merkmal 'Werk' nicht im Drilldown: Prüfen, ob Anwender genau ein Werk
2769   *selektiert hat.
2770         DESCRIBE TABLE sl_werks LINES pb_lines.
2771         IF pb_lines = 1.
2772           READ TABLE sl_werks INDEX pb_lines.
2773           IF sl_werks-option = 'EQ' AND sl_werks-sign = 'I'.
2774   *         read table hlp_tab2 index sl_werks-low.
2775             READ TABLE hlp_tab2 WITH KEY sl_werks-low BINARY SEARCH.
2776             SELECT SINGLE * FROM t009 WHERE periv = hlp_tab2-periv.
2777             IF sy-subrc = 0.
2778               pb_anzperio = t009-anzbp.
2779             ENDIF.
2780           ENDIF.
2781         ENDIF.
2782       ENDIF.
2783     ENDIF.
2784   *Periodenlänge bestimmen
2785     IF pb_anzperio > 0.
2786       jahresperioden = pb_anzperio.
2787       periodenlaenge = 360 / pb_anzperio.
2788       CLEAR flg_monat.
2789       CLEAR anz_tage.
2790       CLEAR anzahl_perio.
2791       LOOP AT periotab.
2792         IF periotab-low IN zeitr.
2793           anzahl_perio = anzahl_perio + 1.
2794           anz_tage = anz_tage + periodenlaenge.
2795         ENDIF.
2796       ENDLOOP.
2797     ELSE.
2798   *Periode wird wie Monat behandelt
2799       periodenlaenge = 30.
2800       jahresperioden = 12.
2801       flg_monat = 'X'.
2802       CLEAR anz_tage.
2803       CLEAR anzahl_perio.
2804       LOOP AT periotab.
2805         IF periotab-low IN zeitr.
2806           anzahl_perio = anzahl_perio + 1.
2807           anz_tage = anz_tage + periodenlaenge.
2808         ENDIF.
2809       ENDLOOP.
2810     ENDIF.
2811   ENDFORM.                               "periolaenge_buper
2812
