2613   *---------------------------------------------------------------------*
2614   *       FORM PERIO_FUELLEN_AUS_SELZEITR                               *
2615   *---------------------------------------------------------------------*
2616   *       Tabelle PERIOTAB absteigend,                                  *
2617   *       1. Eintrag: Periode zu SY-DATUM                               *
2618   *       letzter Eintrag: aelteste zu beachtende Periode               *
2619   *---------------------------------------------------------------------*
2620   FORM perio_fuellen_aus_selzeitr.
2621
2622     DATA: ps_week LIKE s031-spwoc.
2623
2624     perio-option = 'BT'.
2625     perio-sign   = 'I'.
2626     LOOP AT periotab.
2627       IF periotab-low IN zeitr.
2628         CASE sav_speri.
2629           WHEN con_speri_sptag.
2630             perio-high = periotab-low.
2631           WHEN con_speri_spmon.
2632             perio-high+4(2) =  periotab-low+4(2).
2633             perio-high+4(2) = perio-high+4(2) + 1.
2634             IF perio-high+4(2) = '13'.
2635               perio-high+4(2) = '01'.
2636               perio-high(4) = periotab-low(4) + 1.
2637             ELSE.
2638               perio-high(4) = periotab-low(4).
2639             ENDIF.
2640             perio-high+6(2) = '01'.
2641             perio-high = perio-high - 1.
2642             IF perio-high GT sy-datlo.
2643               perio-high = sy-datlo.
2644             ENDIF.
2645           WHEN con_speri_spwoc.
2646   *Es soll der letzte Tag der letzten Woche mitgegeben werden
2647   *Umrechnung erfolgt für ersten Tag der Woche;auf dieses Datum
2648   *werden 6 Tage addiert.
2649             ps_week = periotab-low.
2650             CALL FUNCTION 'WEEK_GET_FIRST_DAY'
2651               EXPORTING
2652                 week = ps_week
2653               IMPORTING
2654                 date = perio-high.
2655             perio-high = perio-high + 6.
2656             IF perio-high GT sy-datlo.
2657               perio-high = sy-datlo.
2658             ENDIF.
2659           WHEN con_speri_spbup.
2660             IF perivar NE space.
2661   *Gjvariante eindeutig über TMC4 bzw. Spezifizierung eines Werkes
2662               flg_perio = true.
2663               PERFORM period_day_determine.
2664               perio-high = hlp_high.
2665               IF perio-high GT sy-datlo.
2666                 perio-high = sy-datlo.
2667               ENDIF.
2668             ELSE.
2669               MESSAGE e382.
2670             ENDIF.
2671         ENDCASE.
2672         EXIT.
2673       ENDIF.
2674     ENDLOOP.
2675
2676     DESCRIBE TABLE periotab LINES lines.
2677     READ TABLE periotab INDEX lines.
2678
2679     CASE sav_speri.
2680       WHEN con_speri_sptag.
2681         perio-low = periotab-low.
2682       WHEN con_speri_spmon.
2683         perio-low+4(2) = periotab-low+4(2).
2684         perio-low+6(2) = '01'.
2685         perio-low(4)  = periotab-low(4).
2686       WHEN con_speri_spwoc.
2687         ps_week = periotab-low.
2688         CALL FUNCTION 'WEEK_GET_FIRST_DAY'
2689           EXPORTING
2690             week = ps_week
2691           IMPORTING
2692             date = perio-low.
2693       WHEN con_speri_spbup.
2694         IF perivar NE space.
2695   *Gjvariante eindeutig über TMC4 bzw. Spezifizierung eines Werkes
2696           flg_perio = true.
2697           PERFORM period_day_determine.
2698           perio-low = hlp_low.
2699         ELSE.
2700           MESSAGE e382.
2701         ENDIF.
2702     ENDCASE.
2703
2704     APPEND perio.
2705     CLEAR perivar.
2706   ENDFORM.                               "perio_fuellen_aus_selzeitr
