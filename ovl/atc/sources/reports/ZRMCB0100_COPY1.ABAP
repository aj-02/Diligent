268                         LANGU = SY-LANGU AND ID = ICON_PATTERN_INCLUDE_RED.
269            WHEN 'NP'.
270            SELECT SINGLE SHORTTEXT INTO SA_QUICK_INFO FROM ICONT WHERE
271                         LANGU = SY-LANGU AND ID = ICON_PATTERN_EXCLUDE_RED.
272            WHEN OTHERS.
273              CLEAR SA_QUICK_INFO.
274          ENDCASE.
275        ENDIF.
276      ENDIF.
277
278      IF FLG_DRUCKEN = TRUE.
279        CASE SA_SIGN.
280          WHEN '_'.    WRITE ' '.
281          WHEN 'I'.    WRITE ' '.
282          WHEN OTHERS. WRITE SA_SIGN.
283        ENDCASE.
284        CASE SA_OPTION.
285          WHEN '_'.   WRITE '  '.
286          WHEN OTHERS. WRITE SA_OPTION.
287        ENDCASE.
288      ELSE.
289        IF SA_SIGN = 'I'.
290          CASE SA_OPTION.
