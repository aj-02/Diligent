2792   *---------------------------------------------------------------------*
2793   FORM bearbeiten_int_s000.
2794
2795   * if exc_merkmal_periode = true.
2796   *  clear merkmale.
2797   *  case sav_speri.
2798   *    when con_speri_spbup.
2799   *      merkmale-fieldname = con_feld_spbup.
2800   * when con_speri_spmon.
2801   *      merkmale-fieldname = con_feld_spmon.
2802   *
2803   *      merkmale-fieldname = con_feld_spwoc.
2804   *n con_speri_sptag.
2805   *       merkmale-fieldname = con_feld_sptag.
2806   *   endcase.
2807   *   merkmale-kz_excep = true.
2808   *   insert merkmale index 1.
2809   * endif.
2810
2811     anz_fsymbols = 0.
2812     LOOP AT merkmale WHERE kz_excep = space.
2813       anz_fsymbols = anz_fsymbols + 1.
2814       CASE anz_fsymbols.
2815         WHEN 1.
2816           ASSIGN COMPONENT merkmale-fieldname
2817                  OF STRUCTURE key_merkmale_farbe TO <key1>.
2818         WHEN 2.
2819           ASSIGN COMPONENT merkmale-fieldname
2820                  OF STRUCTURE key_merkmale_farbe TO <key2>.
2821         WHEN 3.
2822           ASSIGN COMPONENT merkmale-fieldname
2823                  OF STRUCTURE key_merkmale_farbe TO <key3>.
2824         WHEN 4.
2825           ASSIGN COMPONENT merkmale-fieldname
2826                  OF STRUCTURE key_merkmale_farbe TO <key4>.
2827         WHEN 5.
2828           ASSIGN COMPONENT merkmale-fieldname
2829                  OF STRUCTURE key_merkmale_farbe TO <key5>.
2830         WHEN 6.
2831           ASSIGN COMPONENT merkmale-fieldname
2832                  OF STRUCTURE key_merkmale_farbe TO <key6>.
2833         WHEN 7.
2834           ASSIGN COMPONENT merkmale-fieldname
2835                  OF STRUCTURE key_merkmale_farbe TO <key7>.
2836         WHEN 8.
2837           ASSIGN COMPONENT merkmale-fieldname
2838                  OF STRUCTURE key_merkmale_farbe TO <key8>.
2839         WHEN 9.
2840           ASSIGN COMPONENT merkmale-fieldname
2841                  OF STRUCTURE key_merkmale_farbe TO <key9>.
2842       ENDCASE.
2843     ENDLOOP.
2844
2845     LOOP AT int_s000.
2846       MOVE-CORRESPONDING int_s000 TO key_merkmale_farbe.
2847   *Clearen der Felder, die bei Exception nicht genannt sind
2848       vi_zaehler = 0.
2849       DO anz_fsymbols TIMES.
2850         vi_zaehler = vi_zaehler + 1.
2851         CASE vi_zaehler.
2852           WHEN 1.
2853             CLEAR <key1>.
2854           WHEN 2.
2855             CLEAR <key2>.
2856           WHEN 3.
2857             CLEAR <key3>.
2858           WHEN 4.
2859             CLEAR <key4>.
2860           WHEN 5.
2861             CLEAR <key5>.
2862           WHEN 6.
2863             CLEAR <key6>.
2864           WHEN 7.
2865             CLEAR <key7>.
2866           WHEN 8.
2867             CLEAR <key8>.
2868           WHEN 9.
2869             CLEAR <key9>.
2870         ENDCASE.
2871       ENDDO.
2872
2873   *-------- Periode clearen wenn Periode nicht in Merkmale
2874       IF exc_merkmal_periode <> true
2875       AND exc_check_periode  <> true.
2876         CLEAR key_merkmale_farbe-spbup.
2877         CLEAR key_merkmale_farbe-spmon.
2878         CLEAR key_merkmale_farbe-spwoc.
2879         CLEAR key_merkmale_farbe-sptag.
2880       ENDIF.
2881
2882   *-- Die int_s000 wird komplett, unabhängig davon auf welcher Ebene die
2883   *   Exception definiert ist, eingefärbt. => Die Farbinformation macht
2884   *   nur im Zusammenhang mit der Exceptiondefinition Sinn.
2885   *   d.h. in der Int_s000 sind eventuell Zeilen eingefärbt, für die
2886   *   keine Exception erfüllt ist
2887   *-- Das Einfärben der AUS_S000 anhand der MERKMALE_FARBE wäre
2888   *   transparenter
2889
2890       READ TABLE merkmale_farbe WITH KEY key_merkmale_farbe
2891                                                     BINARY SEARCH.
2892       IF sy-subrc <> 0.
2893         CLEAR merkmale_farbe.
2894       ENDIF.
2895       CASE exc_mode.
2896         WHEN space.
2897   *-------- Standardanalyse natur
2898           IF merkmale_farbe-ges_farbe = space AND
2899              merkmale_farbe-kz_plan_ohne_ist = true.
2900   *-------- INT_S000-Eintrag erfolgte lediglich weil Plan ohne Ist
2901             DELETE int_s000.
2902           ELSE.
2903             int_s000-farbe = merkmale_farbe-ges_farbe.
2904             MODIFY int_s000.
2905           ENDIF.
2906         WHEN 'A'.
2907   *-------- Exceptionanalyse
2908           IF merkmale_farbe-ges_farbe = space.
2909             DELETE int_s000.
2910           ELSE.
2911             int_s000-farbe = merkmale_farbe-ges_farbe.
2912             MODIFY int_s000.
2913           ENDIF.
2914       ENDCASE.
2915     ENDLOOP.
2916
2917   ENDFORM.
