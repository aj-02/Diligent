1232                 i_sel      = hier_zusatzinfo
1233                 op_mode    = '0'
1234                 requester  = con_requester_sa
1235   *             sellevel   = ' '
1236                 selmode    = '2'
1237   *             with_texts = ' '
1238             TABLES
1239                 i_rsthie   = rsthie_tab
1240   *             i_rstint   =
1241                 i_rsttyp   = hl_rsttyp_tab.
