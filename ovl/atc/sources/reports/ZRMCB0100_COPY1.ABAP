307    *&---------------------------------------------------------------------*
308    *&      Form  BUILD_LABEL_TAB,    KK.
309    *&---------------------------------------------------------------------*
310    *       Creates table of row or column labels for key-figure matrix
311    * 4.0C: Build label tab completely for temporal characteristics.
312    *       For others, loop through data to determine present labels.
313    *       Put KALWOC and UHZEIT to 'others' in CASE statement.
314    *----------------------------------------------------------------------*
315    *      -->OBJECT  Field name of characteristic
316    *      -->LABELS  result table with values of object
317    *      -->VIS_LABELS  names of object values (for display)
318    *----------------------------------------------------------------------*
319
320    FORM build_label_tab TABLES labels        STRUCTURE row_label_type
321                                vis_labels    STRUCTURE row_label_type
322                         USING  object        LIKE drilldown_fcodes-ddicfeld
323                                BUILDING_COLS      TYPE BOOLEAN
324                         CHANGING component_cnt    TYPE i
325                                  comp_output_len  TYPE i
326                                  error_code       LIKE sy-subrc.
327
328      TABLES tmcww.                        " Customizing Tageszeitklassen
329
330      DATA: dd07v_tab LIKE TABLE OF dd07v WITH HEADER LINE.
331                                           "Domänenfestwerte
332      DATA: index LIKE sy-index,
333            current TYPE i, nloop TYPE i,
334            wochtg TYPE mcw_wochtg,
335            vkstd(2) TYPE n,
336            kmonat TYPE mcw_monat,
337            quartal TYPE mcw_quartl,
338            string(con_label_len),
339            hlp_objekt  like austab_global-objekt,
340            hlp_text    like austab_global-text,
341            label_pos  TYPE I.
342
343      FIELD-SYMBOLS: <label_entry>.
344
345      CLEAR error_code.
346      CLEAR labels. REFRESH labels.
347      CLEAR vis_labels. REFRESH vis_labels.
348      CLEAR hlp_objekt.
349      CLEAR hlp_text.
350
351    * Objects with related customizing tables must be treated separately!
352    * if loop at int_s000 should be avoided.
353
354      CASE object.
355        WHEN 'TGZTKL'.
356          SELECT * FROM tmcww.             "Customizingtab. Tageszeitklassen
357            APPEND tmcww-tgztkl TO labels.
358            READ TABLE drilldown_fcodes WITH KEY ddicfeld = object.
359            hlp_objekt = tmcww-tgztkl.
360            PERFORM objekttext_ermitteln USING drilldown_fcodes-domname
361                                               drilldown_fcodes-rollname
362                                               drilldown_fcodes-convexit
363                                               drilldown_fcodes-outputlen
364                                               hlp_objekt
365                                      CHANGING hlp_text.
366            APPEND hlp_text(con_label_len) TO vis_labels.
367          ENDSELECT.
368          error_code = sy-subrc.           "Return possible error
369        WHEN 'WOCHTG'.
370          DO 7 TIMES.
371            wochtg = sy-index.
372            APPEND wochtg TO labels.
373            READ TABLE drilldown_fcodes WITH KEY ddicfeld = object.
374            hlp_objekt = wochtg.
375            PERFORM objekttext_ermitteln USING drilldown_fcodes-domname
376                                               drilldown_fcodes-rollname
377                                               drilldown_fcodes-convexit
378                                               drilldown_fcodes-outputlen
379                                               hlp_objekt
380                                      CHANGING hlp_text.
381            APPEND hlp_text(con_label_len) TO vis_labels.
382          ENDDO.
383        WHEN 'VKSTD'.
384          DO 24 TIMES.
385            vkstd = sy-index - 1.
386            APPEND vkstd TO labels.
387            APPEND vkstd TO vis_labels.
388          ENDDO.
389        WHEN 'KMONAT'.
390          DO 12 TIMES.
391            kmonat = sy-index.
392            APPEND kmonat TO labels.
393            READ TABLE drilldown_fcodes WITH KEY ddicfeld = object.
394            hlp_objekt = kmonat.
395            PERFORM objekttext_ermitteln USING drilldown_fcodes-domname
396                                               drilldown_fcodes-rollname
397                                               drilldown_fcodes-convexit
398                                               drilldown_fcodes-outputlen
399                                               hlp_objekt
400                                      CHANGING hlp_text.
401            APPEND hlp_text(con_label_len) TO vis_labels.
402          ENDDO.
403        WHEN 'QUARTAL'.
404          DO 4 TIMES.
405            quartal = sy-index.
406            APPEND quartal TO labels.
407            READ TABLE drilldown_fcodes WITH KEY ddicfeld = object.
408            hlp_objekt = quartal.
409            PERFORM objekttext_ermitteln USING drilldown_fcodes-domname
410                                               drilldown_fcodes-rollname
411                                               drilldown_fcodes-convexit
412                                               drilldown_fcodes-outputlen
413                                               hlp_objekt
414                                      CHANGING hlp_text.
415            APPEND hlp_text(con_label_len) TO vis_labels.
416          ENDDO.
417        WHEN 'AFLAG'.
418          READ TABLE drilldown_fcodes WITH KEY ddicfeld = object.
419          CALL FUNCTION 'DDUT_DOMVALUES_GET'
420               EXPORTING
421                    name          = drilldown_fcodes-domname
422                    langu         = sy-langu
423    *               TEXTS_ONLY    = ' '
424               TABLES
425                    dd07v_tab     = dd07v_tab
426               EXCEPTIONS
427                    illegal_input = 1
428                    OTHERS        = 2.
429          LOOP AT dd07v_tab.
430            APPEND dd07v_tab-domvalue_l TO labels.
431            APPEND dd07v_tab-ddtext TO vis_labels.
432          ENDLOOP.
433        WHEN OTHERS.
434    *     Now determine existing values for object from int_s000.
435          IF BUILDING_COLS EQ TRUE.
436            PERFORM MERKMALSKETTUNG_KFM_COL
437                                    USING     object
438                                    CHANGING  col_component_cnt
439                                              col_comp_output_len.
440            CASE col_component_cnt.
441            WHEN 0.
442              LOOP AT int_s000.
443                ASSIGN COMPONENT object OF STRUCTURE int_s000
444                TO <label_entry>.
445                labels = <label_entry>.
446                COLLECT labels.                    "Create unique entries
447              ENDLOOP.
448            WHEN 1.
449              LOOP AT int_s000.
450                labels = <col_objekt_kett1>.
451                labels+outputlen_col_objekt_kett1 = <col_objekt_kett2>.
452                COLLECT labels.
453              ENDLOOP.
454              drilldown_fcodes-outputlen = col_comp_output_len.
455            WHEN 2.
456              label_pos = outputlen_col_objekt_kett1 +
457                          outputlen_col_objekt_kett2.
458              LOOP AT int_s000.
459                labels = <col_objekt_kett1>.
460                labels+outputlen_col_objekt_kett1 = <col_objekt_kett2>.
461                labels+label_pos                  = <col_objekt_kett3>.
462                COLLECT labels.
463              ENDLOOP.
464              drilldown_fcodes-outputlen = col_comp_output_len.
465            ENDCASE.
466          ELSE.
467            PERFORM MERKMALSKETTUNG_KFM_ROW
468                                    USING     object
469                                    CHANGING  row_component_cnt
470                                              row_comp_output_len.
471            CASE row_component_cnt.
472            WHEN 0.
473              LOOP AT int_s000.
474                ASSIGN COMPONENT object OF STRUCTURE int_s000
475                TO <label_entry>.
476                labels = <label_entry>.
477                COLLECT labels.
478              ENDLOOP.
479            WHEN 1.
480              LOOP AT int_s000.
481                labels = <row_objekt_kett1>.
482                labels+outputlen_row_objekt_kett1 = <row_objekt_kett2>.
483                COLLECT labels.
484              ENDLOOP.
485              drilldown_fcodes-outputlen = row_comp_output_len.
486           WHEN 2.
487              label_pos = outputlen_row_objekt_kett1 +
488                          outputlen_row_objekt_kett2.
489              LOOP AT int_s000.
490                labels = <row_objekt_kett1>.
491                labels+outputlen_row_objekt_kett1 = <row_objekt_kett2>.
492                labels+label_pos                  = <row_objekt_kett3>.
493                COLLECT labels.
494              ENDLOOP.
495              drilldown_fcodes-outputlen = row_comp_output_len.
496            ENDCASE.
497          ENDIF.
498          SORT labels.
499    *     Determine visible labels.
500          IF object EQ 'KALWOC'.
501            APPEND LINES OF labels TO vis_labels.
502          ELSE.
503            LOOP AT labels.
504              akt_drilldown-kett_akt = drilldown_fcodes-kett_akt.
505              hlp_objekt = labels.       "Assign header line of labels
506              PERFORM objekttext_ermitteln USING drilldown_fcodes-domname
507                                               drilldown_fcodes-rollname
508                                               drilldown_fcodes-convexit
509                                               drilldown_fcodes-outputlen
510                                               hlp_objekt
511                                      CHANGING hlp_text.
512              APPEND hlp_text(con_label_len) TO vis_labels.
513            ENDLOOP.
514          ENDIF.
515      ENDCASE.
516
517
518    ENDFORM.
