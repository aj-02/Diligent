8256   *&---------------------------------------------------------------------*
8257   *&      Form  KORREKTUR_BESTANDSWERT
8258   *&---------------------------------------------------------------------*
8259   * Bestandswerte werden von Lagerort blank auf andere Lagerorte         *
8260   * konsistent verteilt
8261   * Vorgehensweise:
8262   * In Korrekturtabelle wird über Lagerort aggregiert. Daraus wird ein
8263   * einheitlicher Preis berechnet
8264   * Bestandswert = Bestandsmenge * Preis
8265   * Zugangs- und Abgangswert werden konsistent berechnet: Wenn keine
8266   * Preisänderung stattgefunden hat, einfach Menge * Preis, ansonsten
8267   * wird Zugangsmenge bei Preiserhöhung bzw. Abgangsmenge bei Preis-
8268   * minderung so geändert, dass Bestandswert = Bestandswert vorherige
8269   * Periode + Zugangswert - Abgangswert
8270   *----------------------------------------------------------------------*
8271   FORM korrektur_bestandswert TABLES inttab STRUCTURE int_s000.
8272
8273     DATA: BEGIN OF l_korr_tab OCCURS 0,
8274             matnr   LIKE s039-matnr,
8275             werks   LIKE s039-werks,
8276             spmon   LIKE s039-spmon,
8277             sptag   LIKE s039-sptag,
8278             spwoc   LIKE s039-spwoc,
8279             spbup   LIKE s039-spbup,
8280             mbwbest LIKE s039-mbwbest,
8281             wbwbest LIKE s039-wbwbest,
8282             wzubb   LIKE s039-wzubb,
8283             wzubb0  LIKE s039-wzubb,     " Zugang ohne Menge
8284             wagbb   LIKE s039-wagbb,
8285             wagbb0  LIKE s039-wagbb,     " Abgang ohne Menge
8286             mzubb   LIKE s039-mzubb,
8287             magbb   LIKE s039-magbb,
8288             mgvbr   LIKE s039-mgvbr,
8289             wgvbr   LIKE s039-wgvbr,
8290             wuvbr   LIKE s039-wuvbr,
8291             muvbr   LIKE s039-muvbr,
8292             anz     TYPE i,
8293             flg_mbwbest,
8294             index_mbwbest TYPE i,
8295           END   OF l_korr_tab.
8296
8297     DATA: l_preis       TYPE f,
8298           l_preis_old   TYPE f,
8299           l_preis_vbr   TYPE f,
8300           l_int_s000    LIKE int_s000,
8301           l_tabix       LIKE sy-tabix,
8302           l_tabix_mbew  LIKE sy-tabix,
8303           l_mbwbest_old LIKE s039-mbwbest,
8304           l_mbwbest_lg  LIKE s039-mbwbest,
8305           l_delta_1     LIKE s039-wzubb,
8306           l_delta_2     LIKE l_delta_1,
8307           l_sum         LIKE s039-wbwbest,
8308           l_anz         TYPE i.
8309
8310     CHECK va EQ true.
8311
8312   * Lagerort space soll erster Eintrag sein, damit auf diesen keine
8313   * Rundungsdifferenz gebucht wird.
8314     CASE sav_speri.
8315       WHEN con_speri_spmon.
8316         SORT inttab BY matnr werks spmon lgort.
8317       WHEN con_speri_sptag.
8318         SORT inttab BY matnr werks sptag lgort.
8319       WHEN con_speri_spwoc.
8320         SORT inttab BY matnr werks spwoc lgort.
8321       WHEN con_speri_spbup.
8322         SORT inttab BY matnr werks spbup lgort.
8323     ENDCASE.
8324
8325
8326     LOOP AT inttab ASSIGNING <int_s000>.
8327       IF NOT l_int_s000 IS INITIAL AND
8328         ( l_int_s000-matnr NE <int_s000>-matnr OR
8329           l_int_s000-werks NE <int_s000>-werks OR
8330           l_int_s000-spmon NE <int_s000>-spmon OR
8331           l_int_s000-sptag NE <int_s000>-sptag OR
8332           l_int_s000-spwoc NE <int_s000>-spwoc OR
8333           l_int_s000-spbup NE <int_s000>-spbup ).
8334         APPEND l_korr_tab.
8335         CLEAR  l_korr_tab.
8336       ENDIF.
8337       IF l_korr_tab IS INITIAL.
8338         MOVE-CORRESPONDING <int_s000> TO l_korr_tab.
8339         l_korr_tab-anz = 1.
8340       ELSE.
8341         ADD <int_s000>-mbwbest TO l_korr_tab-mbwbest.
8342         ADD <int_s000>-wbwbest TO l_korr_tab-wbwbest.
8343         ADD <int_s000>-wzubb   TO l_korr_tab-wzubb.
8344         ADD <int_s000>-wagbb   TO l_korr_tab-wagbb.
8345         ADD <int_s000>-mzubb   TO l_korr_tab-mzubb.
8346         ADD <int_s000>-magbb   TO l_korr_tab-magbb.
8347         ADD <int_s000>-mgvbr   TO l_korr_tab-mgvbr.
8348         ADD <int_s000>-wgvbr   TO l_korr_tab-wgvbr.
8349         ADD <int_s000>-muvbr   TO l_korr_tab-muvbr.
8350         ADD <int_s000>-wuvbr   TO l_korr_tab-wuvbr.
8351         ADD 1                  TO l_korr_tab-anz.
8352       ENDIF.
8353       IF NOT <int_s000>-mbwbest IS INITIAL.
8354         l_korr_tab-flg_mbwbest = true.
8355         MOVE l_korr_tab-anz TO l_korr_tab-index_mbwbest.
8356       ENDIF.
8357
8358       l_int_s000 = <int_s000>.
8359     ENDLOOP.
8360
8361     IF NOT l_korr_tab IS INITIAL.
8362       APPEND l_korr_tab.
8363     ENDIF.
8364
8365     CLEAR l_korr_tab.
8366     CLEAR l_tabix.
8367     LOOP AT inttab ASSIGNING <int_s000>.
8368       sy-subrc = 0.
8369   * Korrektureintrag, Preis und alten Preis ermitteln
8370       WHILE sy-subrc EQ 0 AND
8371           ( l_korr_tab-matnr NE <int_s000>-matnr OR
8372             l_korr_tab-werks NE <int_s000>-werks OR
8373             l_korr_tab-spmon NE <int_s000>-spmon OR
8374             l_korr_tab-sptag NE <int_s000>-sptag OR
8375             l_korr_tab-spwoc NE <int_s000>-spwoc OR
8376             l_korr_tab-spbup NE <int_s000>-spbup ).
8377         ADD 1 TO l_tabix.
8378         READ TABLE l_korr_tab INDEX l_tabix.
8379         IF sy-subrc NE 0.
8380   * Sollte nicht vorkommen können
8381           EXIT.
8382         ENDIF.
8383         CLEAR l_sum.
8384         CLEAR l_anz.
8385   * Preis für Merkmalskombination ermitteln
8386   * Ist das überhaupt notwendig?
8387         IF l_korr_tab-mbwbest IS INITIAL AND
8388            l_korr_tab-mzubb   IS INITIAL AND
8389            l_korr_tab-magbb   IS INITIAL AND
8390            l_korr_tab-mgvbr   IS INITIAL AND
8391            l_korr_tab-muvbr   IS INITIAL AND
8392            l_korr_tab-flg_mbwbest NE true.
8393           CLEAR l_preis.
8394           CLEAR l_preis_old.
8395   * 1. Versuch: Wert Bestand / Menge Bestand
8396         ELSEIF l_korr_tab-mbwbest NE 0.
8397           l_preis = l_korr_tab-wbwbest / l_korr_tab-mbwbest.
8398         ELSE.
8399   * 2. Versuch: Berechne Bestand der Vorperiode, um aus diesem
8400   * den Preis zu ermitteln
8401           l_mbwbest_old = l_korr_tab-mbwbest - l_korr_tab-mzubb +
8402                           l_korr_tab-magbb.
8403           IF NOT l_mbwbest_old IS INITIAL.
8404   * Vorperiode hatte Bestand
8405             l_preis = ( l_korr_tab-wbwbest - l_korr_tab-wzubb -
8406                         l_korr_tab-wzubb0  + l_korr_tab-wagbb +
8407                         l_korr_tab-wagbb0 ) / l_mbwbest_old.
8408           ELSE.
8409   * Vorperiode hatte keinen Bestand
8410   * 3. Versuch: verwende Verbrauchswerte und -mengen als Basis
8411             IF NOT l_korr_tab-mgvbr IS INITIAL AND
8412                NOT l_korr_tab-wgvbr IS INITIAL.
8413               l_preis = l_korr_tab-wgvbr / l_korr_tab-mgvbr.
8414             ELSEIF NOT l_korr_tab-muvbr IS INITIAL AND
8415                    NOT l_korr_tab-wuvbr IS INITIAL.
8416   * 4. Versuch: verwende ungeplante Verbräuche
8417               l_preis = l_korr_tab-wuvbr / l_korr_tab-muvbr.
8418             ELSE.
8419   * Letzter Versuch: verwende Standardpreis
8420               READ TABLE xmbew WITH KEY matnr = l_korr_tab-matnr
8421                                         bwkey = l_korr_tab-werks
8422                                         bwtar = space
8423                                         BINARY SEARCH.
8424               l_tabix_mbew = sy-tabix.
8425               IF sy-subrc NE 0.
8426                 SELECT SINGLE * FROM mbew
8427                   WHERE matnr = l_korr_tab-matnr
8428                     AND bwkey = l_korr_tab-werks
8429                     AND bwtar = space.
8430                 IF sy-subrc NE 0.
8431                   CLEAR l_preis.
8432                   CLEAR xmbew.
8433                 ELSE.
8434   * sortiert einfügen
8435                   INSERT mbew INTO xmbew INDEX l_tabix_mbew.
8436                   xmbew = mbew.
8437                 ENDIF.
8438               ENDIF.                     " subrc nach READ TABLE
8439               IF NOT xmbew IS INITIAL.
8440                 IF xmbew-lbkum NE 0.
8441                   l_preis   = xmbew-salk3 / xmbew-lbkum.
8442                 ELSE.
8443                   IF xmbew-vprsv = 'S'.
8444                     l_preis = xmbew-stprs / xmbew-peinh.
8445                   ELSE.
8446                     l_preis = xmbew-verpr / xmbew-peinh.
8447                   ENDIF.
8448                 ENDIF.
8449               ENDIF.                     " xmbew gefüllt
8450             ENDIF.                       " letzter Versuch
8451           ENDIF. " Bestand Vorperiode (nicht) vorhanden
8452         ENDIF.                           " 1. Versuch
8453
8454         IF l_korr_tab-wzubb0 IS INITIAL AND
8455          l_korr_tab-wagbb0 IS INITIAL.
8456   * prüfen, ob wirklich keine verteilung notwendig
8457           l_delta_1 = ( l_korr_tab-mzubb - l_korr_tab-magbb ) * l_preis.
8458           l_delta_2 = l_korr_tab-wzubb - l_korr_tab-wagbb.
8459           IF l_delta_1 NE l_delta_2.
8460             l_korr_tab-wzubb = l_korr_tab-mzubb * l_preis.
8461             l_korr_tab-wagbb = l_korr_tab-magbb * l_preis.
8462             IF l_delta_1 LT l_delta_2.
8463               l_korr_tab-wzubb0 = l_delta_2 - l_delta_1.
8464             ELSE.
8465               l_korr_tab-wagbb0 = l_delta_1 - l_delta_2.
8466             ENDIF.
8467           ENDIF.
8468         ENDIF.
8469
8470   * Noch alten Preis berechnen, falls Verteilung notwendig
8471         IF NOT l_korr_tab-wzubb0 IS INITIAL OR
8472            NOT l_korr_tab-wagbb0 IS INITIAL.
8473           l_mbwbest_old = l_korr_tab-mbwbest - l_korr_tab-mzubb +
8474                           l_korr_tab-magbb.
8475           IF NOT l_mbwbest_old IS INITIAL.
8476   * alter Preis: alter wbwbest / alter mbwbest
8477             l_preis_old = ( l_korr_tab-wbwbest - l_korr_tab-wzubb -
8478                             l_korr_tab-wzubb0  + l_korr_tab-wagbb +
8479                             l_korr_tab-wagbb0 ) / l_mbwbest_old.
8480           ELSE.
8481             l_preis_old = l_preis.
