1624   *---------------------------------------------------------------------*
1625   *       FORM SEITENKOPF_DRILLDOWN_AUSGEBEN                            *
1626   *---------------------------------------------------------------------*
1627   *       Ausgabe des aktuellen Aufrißpfades (für Seitenkopf)           *
1628   *---------------------------------------------------------------------*
1629   *  -->  SA_AKT_DDOWN                                                  *
1630   *---------------------------------------------------------------------*
1631   FORM SEITENKOPF_DRILLDOWN_AUSGEBEN
1632                               TABLES SA_AKT_DDOWN STRUCTURE AKT_DRILLDOWN.
1633
1634     DATA: SA_ZEILEN       LIKE SY-TABIX, "Anzahl Zeilen von SA_AKT_DDOWN
1635           SA_REST         LIKE SY-TABIX,
1636           SA_OBJEKT       LIKE AUSTAB_GLOBAL-TEXT,
1637           SA_TEXT         LIKE DFIES-SCRTEXT_L,
1638           SA_TXT_POS      LIKE SY-FDPOS,
1639           SA_TXT_LEN      LIKE SY-FDPOS,
1640           HELP_QUICKINFO(30) TYPE C, " 'Merkmalswert im Aufriß wechseln'.
1641           SA_HELP_ID      LIKE ICON-ID.
1642
1643     LOCAL: DARSTELLUNGSART,
1644            SPALTEN_ANFANG.
1645     FIELD-SYMBOLS: <SA_TEXT_NR> TYPE C.
1646
1647
1648   * Überprüfen, ob Aufrißpfad ausgegeben werden soll
1649     CHECK FLG_HEADER_PATH = TRUE.
1650
1651   *****************
1652   * Globalen Drilldown aus Info-Struktur-Sprung ausgeben
1653     PERFORM SEITENKOPF_GLBL_DDOWN_AUSGEBEN TABLES GLOBAL_DRILLDOWN.
1654   *****************
1655   *ICON Quickinfo erstellen
1656
1657   SA_HELP_ID = ICON_SYSTEM_POSSIBLE_ENTRIES.
1658
1659   SELECT SINGLE SHORTTEXT INTO HELP_QUICKINFO FROM ICONT WHERE
1660     LANGU = SY-LANGU AND ID = SA_HELP_ID.
1661
1662     DARSTELLUNGSART = CON_DARST_AUFRISS.
1663   * Es soll immer das mittlere Schlüsselwort für das Aufrißprotokoll ver-
1664   * wendet werden => Spaltenanfang = 18 entspricht Schlüsselwortlänge 15
1665     SPALTEN_ANFANG = 18.
1666     DESCRIBE TABLE SA_AKT_DDOWN LINES SA_ZEILEN.
1667     SA_ZEILEN = SA_ZEILEN - 1.
1668     LOOP AT SA_AKT_DDOWN TO SA_ZEILEN.
1669       TABINDEX = SY-TABIX.
1670       PERFORM DRILLDOWNTEXT_ERMITTELN USING    SA_AKT_DDOWN
1671                                       CHANGING SA_TEXT.
1672   *   Objekttexte besorgen
1673       PERFORM OBJEKTTEXT_ERMITTELN USING    SA_AKT_DDOWN-DOMNAME
1674                                             SA_AKT_DDOWN-ROLLNAME
1675                                             SA_AKT_DDOWN-CONVEXIT
1676                                             SA_AKT_DDOWN-OUTPUTLEN
1677                                             SA_AKT_DDOWN-OBJEKT
1678                                    CHANGING SA_OBJEKT.
1679       IF FLG_OBJEKTTEXT = CON_OBJEKTTEXT_NR_TEXT AND
1680          SA_AKT_DDOWN-OUTPUTLEN > 0.
1681   *     Überflüssige Blanks zwischen Schlüssel und Bezeichnung löschen
1682         ASSIGN SA_OBJEKT(SA_AKT_DDOWN-OUTPUTLEN) TO <SA_TEXT_NR>.
1683         SA_TXT_POS = STRLEN( <SA_TEXT_NR> ) + 1.
1684         DESCRIBE FIELD SA_OBJEKT LENGTH SA_TXT_LEN IN CHARACTER MODE.
1685         SA_TXT_LEN = SA_TXT_LEN - SA_TXT_POS.
1686         ASSIGN SA_OBJEKT+SA_TXT_POS(SA_TXT_LEN) TO <SA_TEXT_NR>.
1687         SHIFT <SA_TEXT_NR> LEFT DELETING LEADING SPACE.
1688       ENDIF.
1689   *   Text und Objekt ausgeben
1690       SA_REST = TABINDEX MOD 2.
1691       READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
1692       IF SA_REST = 1.
1693         NEW-LINE NO-SCROLLING.
1694         IF FLG_DRUCKEN = FALSE AND FLG_VERGLEICH = FALSE AND
1695            FLG_ZEITREIHE = FALSE.
1696   *       Icon 'F4' nur bei Listausgabe und nicht im Vgl. und bei
1697   *       Zeitreihe ausgeben
1698   *        WRITE:    (15) SA_TEXT COLOR COL_BACKGROUND INTENSIFIED,
1699   *                17(21) SA_OBJEKT NO-GAP.
1700           FORMAT COLOR col_background INTENSIFIED.
1701           PERFORM write_at USING sy-colno 15 sa_text ' ' false.
1702           FORMAT RESET.
1703           PERFORM write_at USING 17 21 sa_objekt ' ' true.
1704           IF ANZ_HIERARCHIE_AUFRISSE = 0   AND
1705              AKT_DRILLDOWN-FCODE(1) <> 'H' AND
1706              MERKMALSKETTUNG_AKT NE TRUE.
1707   *         kein Hierarchieaufriß
1708             WRITE ICON_SYSTEM_POSSIBLE_ENTRIES AS ICON HOTSPOT
1709                   QUICKINFO HELP_QUICKINFO.
1710           ENDIF.
1711         ELSE.
1712   *       beim Drucken, im Vgl.-PopUp und im ZeitreihenPopUp 2 Zeichen
1713   *       pro Merkmalswert mehr
1714   *        WRITE:    (15) SA_TEXT COLOR COL_BACKGROUND INTENSIFIED,
1715   *                17(23) SA_OBJEKT NO-GAP.
1716           FORMAT COLOR col_background INTENSIFIED.
1717           PERFORM write_at USING sy-colno 15 sa_text ' ' false.
1718           FORMAT RESET.
1719           PERFORM write_at USING 17 23 sa_objekt ' ' true.
1720         ENDIF.
1721         HIDE TABINDEX.
1722       ELSE.
1723         IF FLG_DRUCKEN = FALSE AND FLG_VERGLEICH = FALSE AND
1724            FLG_ZEITREIHE = FALSE.
1725   *       Icon 'F4' nur bei Listausgabe und nicht im Vgl. und bei
1726   *       Zeitreihe ausgeben
1727   *        WRITE: 42(15)  SA_TEXT COLOR COL_BACKGROUND INTENSIFIED,
1728   *               58(21)  SA_OBJEKT NO-GAP.
1729           FORMAT COLOR col_background INTENSIFIED.
1730           PERFORM write_at USING 42 15 sa_text ' ' false.
1731           FORMAT RESET.
1732           PERFORM write_at USING 58 21 sa_objekt ' ' true.
1733           IF ANZ_HIERARCHIE_AUFRISSE = 0   AND
1734              AKT_DRILLDOWN-FCODE(1) <> 'H' AND
1735              MERKMALSKETTUNG_AKT NE TRUE.
1736   *         kein Hierarchieaufriß
1737             WRITE ICON_SYSTEM_POSSIBLE_ENTRIES AS ICON HOTSPOT
1738                   QUICKINFO HELP_QUICKINFO.
1739           ENDIF.
1740         ELSE.
1741   *       beim Drucken, im Vgl.-PopUp und im ZeitreihenPopUp 2 Zeichen
1742   *       pro Merkmalswert mehr
1743   *        WRITE:  42(15) SA_TEXT COLOR COL_BACKGROUND INTENSIFIED,
1744   *                58(23) SA_OBJEKT NO-GAP.
1745           FORMAT COLOR col_background INTENSIFIED.
1746           PERFORM write_at USING 42 15 sa_text ' ' false.
1747           FORMAT RESET.
1748           PERFORM write_at USING 58 23 sa_objekt ' ' true.
1749         ENDIF.
1750       ENDIF.
1751       HIDE DARSTELLUNGSART.
1752     ENDLOOP.
1753     IF FLG_DRUCKEN = FALSE.
1754   *   Zusätzlichen Zeilen für Drilldown-Pfad und Status reservieren
1755       SA_REST = TABINDEX DIV 2 + TABINDEX MOD 2 + 2.
1756       SKIP TO LINE SA_REST.
1757       NEW-LINE NO-SCROLLING.
1758     ELSE.
1759       SKIP.
1760       NEW-LINE NO-SCROLLING.
1761     ENDIF.
1762   ENDFORM.                               "SEITENKOPF_DRILLDOWN_AUSGEBEN
