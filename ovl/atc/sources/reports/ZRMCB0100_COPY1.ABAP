9      *       Umrechungsfaktor für die aktuelle Umrechnung ermitteln        *
10     *---------------------------------------------------------------------*
11     *  -->  UB_VON_WAEHRUNG : Quellwährung (Originalwährung)              *
12     *  -->  UB_NACH_WAEHRUNG: Zielwährung  (Analysewährung)               *
13     *  <--  UB_UMRECH_FAKTOR: ermittelter Faktor für die Umrechnung       *
14     *  <--  UB_RETURNCODE   : Returncode für Umrechnung                   *
15     *---------------------------------------------------------------------*
16     FORM UMRECHNUNGSFAKTOR_BESTIMMEN
17                           USING    UB_VON_WAEHRUNG   TYPE WAERS
18                                    UB_NACH_WAEHRUNG  TYPE WAERS
19                           CHANGING UB_UMRECH_FAKTOR  TYPE F
20                                    UB_RETURNCODE     LIKE SY-SUBRC.
21
22       DATA: UB_LOCAL_AMOUNT(16) TYPE P,    "Betrag in UB_NACH_WAEHRUNG
23             UB_FOREIGN_AMOUNT   TYPE P,    "Betrag in UB_VON_WAEHRUNG
24             UB_CHAR_DATUM(10).             "Datum im Ausgabeformat
25
26     * Hilfwert für UB_LOCAL_AMOUNT setzen
27       UB_FOREIGN_AMOUNT = '1000000000000'.
28
29       CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
30            EXPORTING
31                 DATE             = UMRECH_DATUM
32                 FOREIGN_CURRENCY = UB_VON_WAEHRUNG
33                 FOREIGN_AMOUNT   = UB_FOREIGN_AMOUNT
34                 LOCAL_CURRENCY   = UB_NACH_WAEHRUNG
35                 TYPE_OF_RATE     = TYPE_OF_RATE
36            IMPORTING
37                 LOCAL_AMOUNT     = UB_LOCAL_AMOUNT
38            EXCEPTIONS
39                 NO_RATE_FOUND    = 01.
40       UB_RETURNCODE = SY-SUBRC.
41
42       CASE SY-SUBRC.
43         WHEN 0.
44     *     Umrechnungsfaktor ermitteln
45           UB_UMRECH_FAKTOR = UB_LOCAL_AMOUNT / UB_FOREIGN_AMOUNT.
46         WHEN 1.
47     *     Fehler bei Einheitenumrechnung
48           WRITE UMRECH_DATUM TO UB_CHAR_DATUM.
49
50           IF FLG_UMRECH_FEHLER = FALSE.
51     *       Normalfall => I-Message
52     *       "Umrechnung von &2 in &1 zum Kurstyp &3 zum &4 nicht möglich"
53             MESSAGE I022 WITH UB_NACH_WAEHRUNG UB_VON_WAEHRUNG
54                               TYPE_OF_RATE     UB_CHAR_DATUM.
55           ELSE.
56     *       Sonderfall (EWS, XXL, Selektionsversionen) => E- bzw. A-Message
57             IF SY-BATCH = TRUE.
58     *         Im Hintergrund: A-Message, da E-Message COMMIT WORK erzeugt
59     *         "Umrechnung von &2 in &1 zum Kurstyp &3 zum &4 nicht möglich"
60               MESSAGE A022 WITH UB_NACH_WAEHRUNG UB_VON_WAEHRUNG
61                                 TYPE_OF_RATE     UB_CHAR_DATUM.
62             ELSE.
63     *         "Umrechnung von &2 in &1 zum Kurstyp &3 zum &4 nicht möglich"
64               MESSAGE E022 WITH UB_NACH_WAEHRUNG UB_VON_WAEHRUNG
65                                 TYPE_OF_RATE     UB_CHAR_DATUM.
66             ENDIF.
67           ENDIF.
68       ENDCASE.
69
70     ENDFORM.                               "UMRECHNUNGSFAKTOR_BESTIMMEN
