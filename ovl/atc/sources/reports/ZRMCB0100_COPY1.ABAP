474    *---------------------------------------------------------------------*
475    *       FORM KENNZAHLEN_ABGLEICH                                      *
476    *---------------------------------------------------------------------*
477    *       PLAN_TAB für Kennzahlenvergleich füllen                       *
478    *---------------------------------------------------------------------*
479    FORM KENNZAHLEN_ABGLEICH.
480
481      FIELD-SYMBOLS: <PA_SUM>,
482                     <PA_EINHEIT_SUM>.
483
484      DATA: KA_CHECK_LOG  TYPE F.
485
486      REFRESH PLAN_TAB.
487      CLEAR   PLAN_TAB.
488    * PLAN_TAB füllen
489      LOOP AT AUS_S000.
490        CHECK <AUSTAB_GLOBAL>-FLG_AUSBLENDEN = FALSE.
491        PLAN_TAB-INDEX     = SY-TABIX.
492        PLAN_TAB-OBJEKT    = <AUSTAB_GLOBAL>-TEXT.
493        PLAN_TAB-OBJEKT_NR = <AUSTAB_GLOBAL>-OBJEKT.
494        PLAN_TAB-PLAN      = <KENNZ_1>.
495        PLAN_TAB-EINH_P    = <EINHEIT_KENNZ_1>.
496        PLAN_TAB-IST       = <KENNZ_2>.
497        PLAN_TAB-EINH_I    = <EINHEIT_KENNZ_2>.
498        PLAN_TAB-DIFF      = PLAN_TAB-IST - PLAN_TAB-PLAN.
499        PLAN_TAB-COLOR_ID  = <AUSTAB_GLOBAL>-COLOR_ID.
500        IF NOT ( PLAN_TAB-EINH_I = SPACE AND PLAN_TAB-EINH_P = SPACE ).
501    *     Einheit zur Differenz der Einzelwerte nur ermitteln, wenn die
502    *     Einzelwerte beide einheitenbehaftet sind
503          PLAN_TAB-EINH_D = PLAN_TAB-EINH_I.
504          PERFORM SUMEINHEIT_BESTIMMEN
505            USING    PLAN_TAB-EINH_P
506            CHANGING PLAN_TAB-EINH_D.
507        ELSE.
508    *     sonst Einheit wieder initialisieren
509          CLEAR PLAN_TAB-EINH_D.
510        ENDIF.
511    *   Differenz prozentual nur berechnen, wenn Planwert > 0
512        IF PLAN_TAB-DIFF <> 0 AND PLAN_TAB-PLAN <> 0.
513          KA_CHECK_LOG = log10( abs( PLAN_TAB-DIFF ) )
514                         - log10( abs( PLAN_TAB-PLAN ) ).
515        ELSE.
516          KA_CHECK_LOG = 0.
517        ENDIF.
518        IF KA_CHECK_LOG < 7 AND PLAN_TAB-PLAN NE 0.
519    *     prozentuale Differenz berechnen macht keinen Sinn bei unter-
520    *     schiedlichen Einheiten der zu vergleichenden Werte
521    *     wenn Einheit der Differenz = '***'
522          IF PLAN_TAB-EINH_D <> CON_EINHEIT_UNGUELTIG.
523            PLAN_TAB-DIFF_PROZ = 100 * PLAN_TAB-DIFF / ABS( PLAN_TAB-PLAN ).
524          ENDIF.
525        ENDIF.
526        APPEND PLAN_TAB.
527      ENDLOOP.
528
529      IF NOT HITL_KRITERIUM IS INITIAL.                 " ==>>> note 184345
530    *  Wenn Hitliste aktiv, dann Restsumme der Planwerte bestimmen
531        Clear Plan_rest_sum.
532    *  Restsumme 1. Spalte ("Plan")
533        _ASSIGN_% COMPONENT KENNZAHL_SPALTE-FIELDNAME
534                                    OF STRUCTURE SUM_REST TO <PA_SUM>.
535        PLAN_REST_SUM-PLAN = <PA_SUM>.
536        IF NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL.
537        _ASSIGN_X COMPONENT KENNZAHL_SPALTE-REFFIELD
538                             OF STRUCTURE SUM_REST TO <PA_EINHEIT_SUM>.
539        ENDIF.
540        PLAN_REST_SUM-EINH_P = <PA_EINHEIT_SUM>.
541    *  Restsumme 2. Spalte ("Ist")
542        _ASSIGN_% COMPONENT MARK_KENNZAHLEN-FIELDNAME
543                                    OF STRUCTURE SUM_REST TO <PA_SUM>.
544        PLAN_REST_SUM-IST = <PA_SUM>.
545        IF NOT MARK_KENNZAHLEN-REFFIELD IS INITIAL.
546        _ASSIGN_X COMPONENT MARK_KENNZAHLEN-REFFIELD
547                             OF STRUCTURE SUM_REST TO <PA_EINHEIT_SUM>.
548        ENDIF.
549        PLAN_REST_SUM-EINH_I = <PA_EINHEIT_SUM>.
550    *  Absolute Differenz berechnen und Einheit setzen
551        PLAN_REST_SUM-DIFF = PLAN_REST_SUM-IST - PLAN_REST_SUM-PLAN.
552        IF NOT KENNZAHL_SPALTE-REFFIELD IS INITIAL.
553            PLAN_REST_SUM-EINH_D = PLAN_REST_SUM-EINH_I.
554            PERFORM SUMEINHEIT_BESTIMMEN USING    PLAN_REST_SUM-EINH_P
555                                         CHANGING PLAN_REST_SUM-EINH_D.
556        ENDIF.
557    *  Prozentuale Differenz berechnen
558        IF PLAN_REST_SUM-DIFF <> 0 AND PLAN_REST_SUM-PLAN <> 0.
559          KA_CHECK_LOG = log10( abs( PLAN_REST_SUM-DIFF ) )
560                         - log10( abs( PLAN_REST_SUM-PLAN ) ).
561        ELSE.
562          KA_CHECK_LOG = 0.
563        ENDIF.
564        IF KA_CHECK_LOG < 7 AND PLAN_REST_SUM-PLAN NE 0.
565          IF PLAN_REST_SUM-EINH_D <> CON_EINHEIT_UNGUELTIG.
566            PLAN_REST_SUM-DIFF_PROZ  = 100 * PLAN_REST_SUM-DIFF /
567                                             ABS( PLAN_REST_SUM-PLAN ).
568          ENDIF.
569        ENDIF.
570      ENDIF.                                           " <<<=== note 184345
571
572    ENDFORM.                               "KENNZAHLEN_ABGLEICH
