748    *---------------------------------------------------------------------*
749    *       FORM DRILLDOWN_PROTOKOLL_AUSGEBEN                             *
750    *---------------------------------------------------------------------*
751    *       Ausgabe des aktuellen Aufrißpfades                            *
752    *---------------------------------------------------------------------*
753    FORM DRILLDOWN_PROTOKOLL_AUSGEBEN
754    * Routine erweitert fürs Versenden von Analysen per MAIL durch Umleiten
755    * der Ausgabe auf Drucker/Bildschirm oder Buffer-Variable
756         TABLES DA_DRILLPROT_CONT STRUCTURE MS_MAILOBJECT_CONT
757         USING  DA_OUTPUT_DEVICE.
758
759      DATA: DA_OBJTEXT       LIKE AUSTAB_GLOBAL-TEXT,
760            DA_HLP_POS1      LIKE SY-COLNO VALUE 22,
761            DA_HLP_POS2      LIKE SY-COLNO,
762            DA_HLP_LEN       LIKE SY-TABIX,
763            DA_WINX1         LIKE SY-TABIX VALUE 5,  " o.l. Ecke Listfenst.
764            DA_WINY1         LIKE SY-TABIX VALUE 7,  " o.l. Ecke Listfenst.
765            DA_WINX2         LIKE SY-TABIX," u.r. Ecke Listfenst.
766            DA_WINY2         LIKE SY-TABIX," u.r. Ecke Listfenst.
767            DA_LINE_SIZE     LIKE SY-TABIX VALUE 61, " Zeilenlänge Listfens.
768            DA_MAX_OUTPUTLEN LIKE AKT_DRILLDOWN-OUTPUTLEN,
769            DA_HLP_TEXT(61),
770            DA_HLP_TEXT1(61),
771            DA_HLP_TEXT2(61),
772            DA_HLP_EINTRAEGE(20),
773            da_output_len TYPE i.
774      FIELD-SYMBOLS: <DA_TEXT>.
775
776      PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
777
778    * Drillprotokoll ausgeben
779    *   *** Fürs Mailsenden umleiten des Protokolls in den Container
780    *   *** da_drillprot_cont.
781      PERFORM TEXT_ERMITTELN USING    150
782    *                                   'Aufrißprotokoll'
783                             CHANGING HLP_TEXT1.
784
785      IF DA_OUTPUT_DEVICE = CON_OUTP_TO_BUFFER_VAR.
786    *   *** Zunächst Objektinformationen besetzten
787        ADD 1 TO DA_DRILLPROT_CONT-OBJNR.
788        MOVE CON_MS_OBJ_IS_ATTACHM
789          TO DA_DRILLPROT_CONT-OBJLEVEL.
790        MOVE CON_MS_OBJTYPE_RAW
791          TO DA_DRILLPROT_CONT-OBJTYPE.
792        MOVE HLP_TEXT1
793          TO DA_DRILLPROT_CONT-OBJNAM.
794        MOVE HLP_TEXT1
795          TO DA_DRILLPROT_CONT-OBJDES.
796        DA_HLP_POS2 = ( 72 - STRLEN( HLP_TEXT1 ) ) / 2.
797        WRITE HLP_TEXT1 TO DA_DRILLPROT_CONT-OBJLINE+DA_HLP_POS2.
798        APPEND DA_DRILLPROT_CONT.
799        CLEAR DA_DRILLPROT_CONT-OBJLINE.
800        APPEND DA_DRILLPROT_CONT.
801      ELSE.
802        IF FLG_DRUCKEN = FALSE.
803    *   Bildschirmausgabe
804    *   *** auf die Positionsangaben einen Offset von 2 addieren wegen
805    *   *** Scroll-Leiste
806          DA_WINX2 = ( DA_WINX1 + 2 ) + DA_LINE_SIZE.
807          DA_WINY2 = ( DA_WINY1 + 2 ) + DRILLDOWN_EINTRAEGE.
808    *       IF SY-LSIND = 1.
809    *         ADD 1 TO DA_WINY2.
810    *       ENDIF.
811          PERFORM PF_STATUS_SETZEN
812                      USING
813                         SPACE
814                         '000'
815                         HLP_TEXT1.
816          WINDOW STARTING AT DA_WINX1 DA_WINY1
817                 ENDING   AT DA_WINX2 DA_WINY2.
818          NEW-PAGE LINE-SIZE DA_LINE_SIZE.
819    *   Kopfinformation
820          WRITE: / DA_HLP_TEXT CENTERED COLOR COL_BACKGROUND INTENSIFIED.
821          SKIP.
822    *   Ausgabe 'Kein Aufriß durchgeführt' bei Grundliste auf Bildschirm
823          IF SY-LSIND = 1.
824            PERFORM TEXT_ERMITTELN USING    130
825    *                                     'Kein Aufriß durchgeführt'
826                                   CHANGING DA_HLP_TEXT2.
827    *        WRITE: / DA_HLP_TEXT2.
828            NEW-LINE.
829            PERFORM write_at USING 1 DA_LINE_SIZE DA_HLP_TEXT2 ' ' false.
830          ENDIF.
831        ENDIF.                             " von IF FLG_DRUCKEN
832      ENDIF.                               " von IF DA_OUTPUT_DEVICE
833
834    * Ausgabetext bei Druckausgabe des Aufrißprotokolls auf Grundliste
835    * Liststufe = 1
836      IF FLG_DRUCKEN = TRUE AND DRILLDOWN_EINTRAEGE = 1.
837        PERFORM TEXT_ERMITTELN USING    130
838    *                                   'Kein Aufriß durchgeführt'
839                               CHANGING DA_HLP_TEXT2.
840        IF DA_OUTPUT_DEVICE = CON_OUTP_TO_BUFFER_VAR.
841          WRITE DA_HLP_TEXT2
842             TO DA_DRILLPROT_CONT-OBJLINE.
843          APPEND DA_DRILLPROT_CONT.
844          CLEAR DA_DRILLPROT_CONT-OBJLINE.
845        ELSE.
846    *      WRITE: / DA_HLP_TEXT2.
847          NEW-LINE.
848          PERFORM write_at USING 1 DA_LINE_SIZE DA_HLP_TEXT2 ' ' false.
849        ENDIF.
850      ENDIF.
851    * Wenn Liststufe > 1, wurde ein Aufriß durchgeführt.
852      IF SY-LSIND > 1.
853    *   Aufriß wurde durchgeführt
854        IF FLG_OBJEKTTEXT = CON_OBJEKTTEXT_NR_TEXT.
855    *     Ausgabe von Nr&Text => max. Ausgabelänge berechnen
856          LOOP AT AKT_DRILLDOWN.
857            CHECK SY-TABIX < DRILLDOWN_EINTRAEGE.
858            IF AKT_DRILLDOWN-OUTPUTLEN > DA_MAX_OUTPUTLEN.
859    *   *** bestimme die größte, im Drilldown vorkommende Ausgabelänge des
860    *   *** Schlüssels
861              DA_MAX_OUTPUTLEN = AKT_DRILLDOWN-OUTPUTLEN.
862            ENDIF.
863          ENDLOOP.
864        ENDIF.
865    *   *** Schleife über die Drilldown-Tabelle
866        LOOP AT AKT_DRILLDOWN.
867          CHECK SY-TABIX < DRILLDOWN_EINTRAEGE.
868          PERFORM OBJEKTTEXT_ERMITTELN USING    AKT_DRILLDOWN-DOMNAME
869                                                AKT_DRILLDOWN-ROLLNAME
870                                                AKT_DRILLDOWN-CONVEXIT
871                                                AKT_DRILLDOWN-OUTPUTLEN
872                                                AKT_DRILLDOWN-OBJEKT
873    *   *** DA-Objtext ist der Text zum Drilldown-Objekt. Enthält entweder
874    *   *** Schlüssel, Schlüssel und Bezeichnung oder Bezeichnung
875                                       CHANGING DA_OBJTEXT.
876
877          IF DA_OUTPUT_DEVICE = CON_OUTP_TO_BUFFER_VAR.
878    *   *** Ausgabe umleiten in Containertabelle
879            WRITE AKT_DRILLDOWN-SCRTEXT_L
880               TO DA_DRILLPROT_CONT-OBJLINE.
881          ELSE.
882    *        WRITE: /(20) AKT_DRILLDOWN-SCRTEXT_L
883    *                     COLOR COL_BACKGROUND
884    *                     INTENSIFIED.
885            NEW-LINE.
886            FORMAT COLOR col_background INTENSIFIED.
887            PERFORM write_at USING 1 20 akt_drilldown-scrtext_l ' ' false.
888            FORMAT RESET.
889          ENDIF.
890          IF FLG_OBJEKTTEXT = CON_OBJEKTTEXT_NR_TEXT.
891    *       Ausgabe von Nr&Text => Nr und Text separiert ausgeben
892            IF DA_OUTPUT_DEVICE = CON_OUTP_TO_BUFFER_VAR.
893              MOVE AKT_DRILLDOWN-OUTPUTLEN TO DA_HLP_LEN.
894              WRITE DA_OBJTEXT
895                 TO DA_DRILLPROT_CONT-OBJLINE+DA_HLP_POS1(DA_HLP_LEN).
896            ELSE.
897    *          POSITION DA_HLP_POS1.
898    *          WRITE: AT (AKT_DRILLDOWN-OUTPUTLEN) DA_OBJTEXT NO-GAP.
899              da_output_len = akt_drilldown-outputlen.
900              PERFORM write_at USING da_hlp_pos1 da_output_len
901                                     da_objtext ' ' true.
902            ENDIF.
903    *   *** Zuweisen des Bezeichnungsteils des Objektes zu Feldsymbol, um
904    *   *** getrennt positionieren zu können
905            ASSIGN DA_OBJTEXT+AKT_DRILLDOWN-OUTPUTLEN(*) TO <DA_TEXT>.
906    *        DA_HLP_POS2 = DA_HLP_POS1 + ( AKT_DRILLDOWN-OUTPUTLEN + 1 ).
907            DA_HLP_POS2 = DA_HLP_POS1 + ( DA_MAX_OUTPUTLEN + 1 ).
908            IF DA_OUTPUT_DEVICE = CON_OUTP_TO_BUFFER_VAR.
909    *   *** Ausgabe umleiten in Containertabelle
910              MOVE <DA_TEXT> TO DA_HLP_TEXT.
911              WRITE DA_HLP_TEXT
912                 TO DA_DRILLPROT_CONT-OBJLINE+DA_HLP_POS2.
913              APPEND DA_DRILLPROT_CONT.
914              CLEAR DA_DRILLPROT_CONT-OBJLINE.
915            ELSE.
916    *          POSITION DA_HLP_POS2.
917    *          WRITE <DA_TEXT>.
918              da_output_len = da_line_size - da_hlp_pos2 + 1.
919              PERFORM write_at USING da_hlp_pos2 da_output_len
920                                     <DA_TEXT> ' ' false.
921            ENDIF.
922          ELSE.                            " von IF FLG_OBJEKTTEXT
923            IF DA_OUTPUT_DEVICE = CON_OUTP_TO_BUFFER_VAR.
924    *   *** Ausgabe umleiten in Containertabelle
925              WRITE DA_OBJTEXT
926                 TO DA_DRILLPROT_CONT-OBJLINE+DA_HLP_POS1.
927              APPEND DA_DRILLPROT_CONT.
928              CLEAR DA_DRILLPROT_CONT-OBJLINE.
929            ELSE.
930    *          POSITION DA_HLP_POS1.
931    *          WRITE DA_OBJTEXT.
932              da_output_len = da_line_size - da_hlp_pos1 + 1.
933              PERFORM write_at USING da_hlp_pos1 da_output_len
934                                     DA_OBJTEXT ' ' false.
935            ENDIF.
936          ENDIF.
937        ENDLOOP.
938      ENDIF.
939
940    * Ausgabe der Anzahl der Merkmalsausprägungen auf Liste
941      PERFORM AUSTAB_AKTUALISIEREN.
942      DA_HLP_EINTRAEGE = AUSTAB_EINTRAEGE.
943      CONDENSE DA_HLP_EINTRAEGE NO-GAPS.
944      PERFORM TEXT_ERMITTELN USING    100
945    *                                 'Anzahl &'
946                             CHANGING DA_HLP_TEXT1.
947      REPLACE '&' WITH AKT_DRILLDOWN-SCRTEXT_S INTO DA_HLP_TEXT1.
948      IF DA_OUTPUT_DEVICE = CON_OUTP_TO_BUFFER_VAR.
949    *   *** Ausgabe umleiten in Containertabelle
950        CLEAR DA_DRILLPROT_CONT-OBJLINE.
951        APPEND DA_DRILLPROT_CONT.
952        WRITE DA_HLP_TEXT1
953           TO DA_DRILLPROT_CONT-OBJLINE.
954        WRITE DA_HLP_EINTRAEGE
955           TO DA_DRILLPROT_CONT-OBJLINE+DA_HLP_POS1.
956        APPEND DA_DRILLPROT_CONT.
957        CLEAR DA_DRILLPROT_CONT-OBJLINE.
958      ELSE.
959        SKIP.
960    *    WRITE: /(20) DA_HLP_TEXT1 COLOR COL_BACKGROUND INTENSIFIED.
961        NEW-LINE.
962        FORMAT COLOR col_background INTENSIFIED.
963        PERFORM write_at USING 1 20 da_hlp_text1 ' ' false.
964        FORMAT RESET.
965    *    POSITION DA_HLP_POS1.
966    *    WRITE:       DA_HLP_EINTRAEGE.
967        da_output_len = da_line_size - da_hlp_pos1 + 1.
968        PERFORM write_at USING DA_HLP_POS1 da_output_len
969                               DA_HLP_EINTRAEGE ' ' false.
970      ENDIF.
971    ENDFORM.                               "DRILLDOWN_PROTOKOLL_AUSGEBEN
