5275             sl_spmon-low+4(2) = '01'.
5276             sl_spmon-low(4)   = sl_spmon-low(4) + 1.
5277           ENDIF.
5278           APPEND sl_spmon.
5279         WHEN con_speri_spbup.
5280           PERFORM tabelle_t009_pruefen_exc USING sl_spbup-low.
5281           APPEND sl_spbup.
5282       ENDCASE.
5283     ENDDO.
