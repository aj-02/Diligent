1574   *       FORM ZEITR_MAXIMUM_BESTIMMEN                                  *
1575   *---------------------------------------------------------------------*
1576   *       Ermittelt die höchste in "zeitr" vorkommende Perioden-        *
1577   *       obergrenze, keine Obergrenze = '00.0000'                      *
1578   *       UNICODE-fähige Version (Rel. 4.7)                             *
1579   *---------------------------------------------------------------------*
1580   FORM ZEITR_MAXIMUM_BESTIMMEN CHANGING MAX LIKE PERIODENTAB-HIGH.
1581
1582   DATA:   BUFFER LIKE PERIODENTAB-HIGH,
1583           ANZ_PER LIKE T009-ANZBP.
1584
1585    CLEAR MAX.
1586
1587     LOOP AT ZEITR WHERE SIGN EQ 'I'.
1588
1589       CASE ZEITR-OPTION.
1590         WHEN 'BT'.
1591           IF ZEITR-HIGH > MAX.
1592             MAX = ZEITR-HIGH.
1593           ENDIF.
1594         WHEN 'EQ'.
1595           IF ZEITR-LOW > MAX.
1596             MAX = ZEITR-LOW.
1597           ENDIF.
1598         WHEN 'LE'.
1599           IF  ZEITR-LOW > MAX.
1600             MAX = ZEITR-LOW.
1601           ENDIF.
1602         WHEN 'LT'.
1603   *       wenn Buchungsperiode = Buchungsperiode - 1 > max
1604   *       dann max = Buchungsperiode - 1
1605           CASE  SAV_SPERI.
1606             WHEN CON_SPERI_SPTAG.
1607               BUFFER = ZEITR-LOW - 1.
1608               IF  BUFFER > MAX.
1609                 MAX = BUFFER.
1610               ENDIF.
1611             WHEN CON_SPERI_SPMON.
1612               BUFFER = ZEITR-LOW.
1613               BUFFER+4(2) = BUFFER+4(2) - 1.
1614               IF BUFFER+4(2) = '00'.
1615                 BUFFER+4(2) = '12'.
1616                 BUFFER(4) = BUFFER(4) - 1.
1617               ENDIF.
1618               IF  BUFFER > MAX.
1619                 MAX = BUFFER.
1620               ENDIF.
1621             WHEN CON_SPERI_SPWOC.
1622               BUFFER = ZEITR-LOW.
1623               BUFFER+4(2) = BUFFER+4(2) - 1.
1624               IF BUFFER+4(2) = '00'.
1625                 BUFFER+4(2) = '52'.
1626                 BUFFER(4) = BUFFER(4) - 1.
1627                 PERFORM KALENDERWOCHE_ERMITTELN_EXC USING BUFFER.
1628               ENDIF.
1629               IF  BUFFER > MAX.
1630                 MAX = BUFFER.
1631               ENDIF.
1632            WHEN CON_SPERI_SPBUP.
1633               BUFFER = ZEITR-LOW.
1634               BUFFER+4(2) = BUFFER+4(2) - 1.
1635               IF BUFFER+4(2) = '00'.
1636   *            max_bup holen.
1637                 SELECT SINGLE * FROM T009 WHERE PERIV = PERIV.
1638                 ANZ_PER = T009-ANZBP.
1639                 IF ANZ_PER GT 99.
1640                   ANZ_PER = 99.
1641                 ENDIF.
1642                 IF ANZ_PER IS INITIAL.
1643   *            kein Buchungsperiode in t009 => Behandlung wie Monat
1644                   BUFFER+4(2) = '12'.
1645                 ELSE.
1646                   BUFFER+4(2) = ANZ_PER.
1647                 ENDIF.
1648                 BUFFER(4) = BUFFER(4) - 1.
1649               ENDIF.
1650               IF  BUFFER > MAX.
1651                 MAX = BUFFER.
1652               ENDIF.
1653           ENDCASE.
1654       ENDCASE.
1655     ENDLOOP.
1656
1657   ENDFORM.                                   "zeitr_maximum_bestimmen
