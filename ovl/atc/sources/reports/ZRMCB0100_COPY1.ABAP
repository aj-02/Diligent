3901                                   USING    puffertab-color_id
3902                                            true
3903                                   CHANGING hlp_summe-xcolor_id
3904                                   IF FOUND.
3905
3906           IF hlp_summe-basme <> puffertab-xbasme.
3907             hlp_summe-basme = con_einheit_ungueltig.
3908           ENDIF.
3909         ELSE.
3910   *       Objektwechsel => Objekt in AUSTAB eintragen
3911   *       aus_s000 = hlp_summe.
3912           pu_tab   = hlp_summe.
3913           PERFORM hlp_summe_korrigieren.
3914   *Zusatzkennzahlen berechnen
3915           PERFORM akt_drilldown_lesen.
3916           CLEAR sum_kz.
3917   *       perform zusatzkennzahlen_berechnen changing aus_s000.
3918           PERFORM zusatzkennzahlen_berechnen CHANGING pu_tab.
3919   *       append aus_s000.
3920           APPEND pu_tab.
3921   *       HLP_SUMME zur Summenzeile addieren und Mengeneinheit bestimmen
3922           PERFORM add_hlp_summe_auf_sum_s000.
3923           IF sum_s000-xbasme <> hlp_summe-basme.
3924             sum_s000-xbasme = con_einheit_ungueltig.
3925           ENDIF.
3926   *       Eintrag für neues Objekt umrechnen
3927           pu_sav_objekt   = puffertab-objekt.
3928           hlp_summe-xobjekt = puffertab-objekt.
3929           PERFORM puffertab_eintrag_umrechnen CHANGING puffertab
3930                                                        pu_returncode.
3931           hlp_summe       = puffertab.
3932           hlp_summe-hwaer = analyse_waehrung.
3933           CLEAR:   hlp_letztzug,         " =>  note 367459
3934                    hlp_letztabg,
3935                    hlp_letztver,
3936                    hlp_letztbew.         " <=  note 367459
3937         ENDIF.
3938         .
3939         IF pu_returncode <> 0.
3940   *       Fehler bei Einheitenumrechnung
3941           EXIT.
3942         ENDIF.
3943       ENDLOOP.
3944     ENDIF.
3945     IF pu_returncode <> 0.
3946   *   Fehler bei Einheitenumrechnung => Ausgabe in gesicherter Währung
3947
3948   *   Die Währung, die nicht in die gewählte Analysewährung umgerechnet
3949   *   werden konnte, steht in der PUFFERTAB-Kopfzeile
3950   *   "Umrechnung in $ nicht möglich"
3951   *   MESSAGE I022 WITH ANALYSE_WAEHRUNG PUFFERTAB-XHWAER.
3952
3953   *   Umrechnung von &2 in &1 zum Kurstyp &3 nicht möglich
3954   *   message i022 with analyse_waehrung puffertab-xhwaer type_of_rate.
3955       IF NOT sav_analyse_waehrung IS INITIAL.
3956         CLEAR sav_analyse_waehrung.
3957       ENDIF.
3958       analyse_waehrung = sav_analyse_waehrung.
3959       PERFORM spezial_puffertab_umrechnen TABLES pu_tab
3960                                           CHANGING pu_flg_kein_standard.
3961       EXIT.
3962     ENDIF.
3963     IF sy-subrc = 0.
3964   *   Letztes Objekt in AUSTAB eintragen
3965       hlp_summe-xobjekt = puffertab-objekt.
3966   *   aus_s000 = hlp_summe.
3967       pu_tab   = hlp_summe.
3968       PERFORM hlp_summe_korrigieren.
3969   *Zusatzkennzahlen berechnen
3970       PERFORM akt_drilldown_lesen.
3971       CLEAR sum_kz.
3972   *   perform zusatzkennzahlen_berechnen changing aus_s000.
3973       PERFORM zusatzkennzahlen_berechnen CHANGING pu_tab.
3974   *   append aus_s000.
3975       APPEND pu_tab.
3976   *   HLP_SUMME zur Summenzeile addieren und Einheiten bestimmen
3977       PERFORM add_hlp_summe_auf_sum_s000.
3978     ENDIF.
3979   * if flg_dd is initial.
3980   *   sum_kz = true.
3981   * endif.
3982     PERFORM zusatzkennzahlen_berechnen CHANGING sum_s000.
3983   * PERFORM AUSTAB_KORRIGIEREN.
3984
3985   ENDFORM.                               "SPEZIAL_PUFFERTAB_UMRECHNEN
