1297                 langu         = sy-langu
1298                 roll_name     = hl_rsttyp_tab-rolnm "KLASSE nicht mehr vh.
1299   *             roll_name     = akt_hierarchie-hcrolnm
1300                 withtext      = true
1301            IMPORTING
1302                 dd01l_wa      = hl_dd01l_wa
1303                 dd04l_wa_a    = hl_dd04l_wa_a
1304            TABLES
1305                 dd04t_tab_a   = hl_dd04t_tab_a
1306            EXCEPTIONS
1307                 illegal_value = 01.
