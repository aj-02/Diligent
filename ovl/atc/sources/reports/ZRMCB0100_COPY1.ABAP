3522   **   Lese Benutzereinstellungen zum Dezimalpunktformat.
3523   *    SELECT SINGLE * FROM usr01 WHERE bname EQ sy-uname.
3524   *    IF usr01-dcpfm IS INITIAL OR sy-subrc NE 0.
3525   **     Default-Format:
3526   *      dec_separator = ','.             "Dezimaltrennzeichen
3527   *      pot_translate = '. '.            "Tausenderersetzung
3528   *    ELSEIF usr01-dcpfm EQ 'X'.
3529   *      dec_separator = '.'.
3530   *      pot_translate = ', '.
3531   *    ELSEIF usr01-dcpfm EQ 'Y'.
3532   *      dec_separator = ','.
3533   *      pot_translate = '  '.
3534   *    ELSE.
3535   **     Versuche Default-Werte
3536   *      dec_separator = ','.             "Dezimaltrennzeichen
3537   *     pot_translate = '. '.         "Ersetzung für Tausendertrennzeichen
3538   *    ENDIF.
3539   *
3540   ***---------- Kennzahlen (Ausprägungen)
3541   *    IF masterdata_mcya-workf_ind EQ true.
3542   **   Determine LIS-Name of Key-Figure
3543   *   read table kennzahlen_tab with key scrtext_l = sammler_exc-kennzahl.
3544   *    read table int_mcyc with key FNAME = kennzahlen_tab-fieldname.
3545   *    current_key_figure = int_mcyc-fname.
3546   **   Determine name of key-figure using workflow conventions
3547   *    CALL FUNCTION 'SWC_ELEMENT_CREATE_NAME'
3548   *           EXPORTING
3549   *                fieldname = current_key_figure
3550   *                tabname   = masterdata_mcya-gstru  "info structure
3551   *           IMPORTING
3552   *                element   = key_figure_name.
3553   *
3554   **     Einzelsatzübergabe,
3555   **     Decompose into key figure's unit and value.
3556   *      string = sammler_exc-value.
3557   *      SHIFT string LEFT DELETING LEADING space.
3558   *      SPLIT string AT ' ' INTO key_figure_string
3559   *                              struc_key_figure-unit.
3560   **     Entferne Tausendertrennzeichen
3561   *      TRANSLATE key_figure_string USING pot_translate.
3562   *      CONDENSE key_figure_string NO-GAPS.
3563   **     Wenn Dezimaltrennzeichen = ',', dann '.' einsetzen.
3564   *      IF dec_separator EQ ','.
3565   *        TRANSLATE key_figure_string USING dec_translate.
3566   *      ENDIF.
3567   **     Konvertiere auf Typ P
3568   *      MOVE key_figure_string TO struc_key_figure-value.
3569   *      swc_set_element ews_container key_figure_name
3570   *                                   struc_key_figure-value.
3571   *    ELSE.
3572   **     Massenübergabe
3573   **     Aufsatzpunkt in Sammler_exc setzen
3574   *      sammler_index = 1.
3575   *      READ TABLE sammler_exc INDEX sammler_index.
3576   *      table_subrc = sy-subrc.
3577   *      REFRESH table_auspr.
3578   *      WHILE table_subrc EQ 0.
3579   **       Determine LIS-Name of Key-Figure
3580   *        read table kennzahlen_tab
3581   *                             with key scrtext_l = sammler_exc-kennzahl.
3582   *        read table int_mcyc
3583   *                        with key FNAME = kennzahlen_tab-fieldname.
3584   *        current_key_figure = int_mcyc-fname.
3585   **       Determine name of key-figure using workflow conventions
3586   *        CALL FUNCTION 'SWC_ELEMENT_CREATE_NAME'
3587   *           EXPORTING
3588   *                fieldname = current_key_figure
3589   *                tabname   = masterdata_mcya-gstru  "info structure
3590   *           IMPORTING
3591   *                element   = key_figure_name.
3592   **       Decompose into key figure's unit and value.
3593   *        string = sammler_exc-value.
3594   *        SHIFT string LEFT DELETING LEADING space.
3595   *        SPLIT string AT ' ' INTO key_figure_string
3596   *                                struc_key_figure-unit.
3597   **       Entferne Tausendertrennzeichen
3598   *        TRANSLATE key_figure_string USING pot_translate.
3599   *        CONDENSE key_figure_string NO-GAPS.
3600   **       Wenn Dezimaltrennzeichen = ',', dann '.' einsetzen.
3601   *        IF dec_separator EQ ','.
3602   *          TRANSLATE key_figure_string USING dec_translate.
3603   *        ENDIF.
3604   **       Konvertiere auf Typ P
3605   *        MOVE key_figure_string TO struc_key_figure-value.
3606   *        table_auspr-auspr = struc_key_figure-value.
3607   *        APPEND table_auspr.
3608   **       Nächster Datensatz
3609   *        ADD 1 TO sammler_index.
3610   *        READ TABLE sammler_exc INDEX sammler_index.
3611   *        table_subrc = sy-subrc.
3612   *      ENDWHILE.
3613   *      swc_set_table  ews_container  key_figure_name  table_auspr.
3614   *    ENDIF.
3615   *
3616   ***   Kennzahleneinheiten
3617   *    IF masterdata_mcya-workf_ind EQ true.
3618   **     Einzelsatzübergabe
3619   **     Determine LIS-Name of Key-Figure
3620   *      read table kennzahlen_tab
3621   *                            with key scrtext_l = sammler_exc-kennzahl.
3622   *      read table int_mcyc
3623   *                      with key FNAME = kennzahlen_tab-fieldname.
3624   *      current_key_figure = int_mcyc-fname.
3625   **     Determine name of key-figure using workflow conventions
3626   *      CALL FUNCTION 'SWC_ELEMENT_CREATE_NAME'
3627   *           EXPORTING
3628   *                fieldname = current_key_figure
3629   *                tabname   = masterdata_mcya-gstru  "info structure
3630   *           IMPORTING
3631   *                element   = key_figure_name.
3632   *
3633   *      CONCATENATE 'U_' key_figure_name         "#EC NOTEXT
3634   *                     INTO key_figure_name.
3635   **     Decompose into key figure's unit and value.
3636   *      string = sammler_exc-value.
3637   *      SHIFT string LEFT DELETING LEADING space.
3638   *      SPLIT string AT ' ' INTO key_figure_string
3639   *                              struc_key_figure-unit.
3640   *      swc_set_element ews_container key_figure_name
3641   *                                    struc_key_figure-unit.
3642   **     Nächste Kennzahl aus Sammler_Exc
3643   *      ADD 1 TO sammler_index.
3644   *      READ TABLE sammler_exc INDEX sammler_index.
3645   *      table_subrc = sy-subrc.
3646   *    ELSE.
3647   **     Massenübergabe
3648   **     Aufsatzpunkt in Sammler_exc setzen
3649   *      sammler_index = 1.
3650   *      READ TABLE sammler_exc INDEX sammler_index.
3651   *      table_subrc = sy-subrc.
3652   *      REFRESH table_auspr.
3653   *      WHILE table_subrc EQ 0.
3654   **       Determine LIS-Name of Key-Figure
3655   *        read table kennzahlen_tab
3656   *                             with key scrtext_l = sammler_exc-kennzahl.
