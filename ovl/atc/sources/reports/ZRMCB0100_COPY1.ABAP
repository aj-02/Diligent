286          CHECK <AUSTAB_GLOBAL>-FLG_AUSBLENDEN = FALSE.
287          IF <busg3_summe_1> NE '0'.
288            busg3_data-wert1 = <busg3_kennz_1> / <busg3_summe_1> * 100.
289          ENDIF.
290          IF <busg3_summe_2> NE '0'.
291            busg3_data-wert2 = <busg3_kennz_2> / <busg3_summe_2> * 100.
292          ENDIF.
293          IF <busg3_summe_3> NE '0'.
294            busg3_data-wert3 = <busg3_kennz_3> / <busg3_summe_3> * 100.
295          ENDIF.
296          IF <busg3_summe_4> NE '0'.
297            busg3_data-wert4 = <busg3_kennz_4> / <busg3_summe_4> * 100.
298          ENDIF.
299          IF <busg3_summe_5> NE '0'.
300            busg3_data-wert5 = <busg3_kennz_5> / <busg3_summe_5> * 100.
301          ENDIF.
302          IF <busg3_summe_6> NE '0'.
303            busg3_data-wert6 = <busg3_kennz_6> / <busg3_summe_6> * 100.
304          ENDIF.
305          busg3_data-text  = <austab_text>.
306          APPEND busg3_data.
307        ENDLOOP.
308      ENDIF.
309    ENDFORM.                    "busg3_data_aufbauen
