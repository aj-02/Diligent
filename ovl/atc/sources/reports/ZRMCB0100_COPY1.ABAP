2629   *---------------------------------------------------------------------*
2630   *       FORM PROG_IN_INT_EX_KENNZ_PLAN_SUB                            *
2631   *---------------------------------------------------------------------*
2632   *       Prognostizierte Daten aus Tab ZEITREIHE werden in Tab.        *
2633   *       INT_EX_KENNZ_SUB uebertragen, jedoch nur fuer die ein Kennzahl*
2634   *       In INT_EX_KENNZ_SUB stehen also historische Daten fuer andere *
2635   *       Kennzahlen + Prognose fuer diese eine Kennzahl.               *
2636   *       Anzahl Zeilen wird von Anzahl fuer Historie veraendert auf    *
2637   *       Anzahl Prognoseperioden.                                      *
2638   *       INT_EX_KENNZ_SUB dient also als reines technisches Traeger-   *
2639   *       medium, andere Daten als Prognose der Kennzahl sind nicht     *
2640   *       aussagekräftig                                                *
2641   *       Anschliessend uebertragen in INT_EX_KENNZ_PLAN_SUB und        *
2642   *       PLAN_COUNTER = 1.                                             *
2643   *---------------------------------------------------------------------*
2644   FORM prog_in_int_ex_kennz_plan_sub.
2645
2646     DATA: pi_lines TYPE i.
2647     DATA: pi_lines_prog TYPE i.
2648
2649     CLEAR int_ex_kennz_plan_sub.
2650     REFRESH int_ex_kennz_plan_sub.
2651   *--------- Anpassen Anzahl Zeilen
2652     IF anz_perioden > int_mcyc-anzper.
2653       pi_lines = anz_perioden - int_mcyc-anzper.
2654       DO pi_lines TIMES.
2655         DELETE int_ex_kennz_sub INDEX 1.
2656       ENDDO.
2657     ENDIF.
2658     IF anz_perioden < int_mcyc-anzper.
2659       pi_lines = int_mcyc-anzper - anz_perioden.
2660       READ TABLE int_ex_kennz_sub INDEX 1.
2661   *-- Zeile wird vervielfältig. Falls die Zeile nicht leer ist
2662   *   das FLG_MARK gesetzt und wird in die neue Zeile übernommen
2663       DO pi_lines TIMES.
2664         APPEND int_ex_kennz_sub.
2665       ENDDO.
2666     ENDIF.
2667
2668     LOOP AT zeitreihe.
2669       READ TABLE int_ex_kennz_sub INDEX sy-tabix.
2670       MOVE-CORRESPONDING int_ex_kennz_sub TO int_ex_kennz_plan_sub.
2671       <hlp_kennzahl> = zeitreihe-value.
2672       int_ex_kennz_plan_sub-plan_counter = 1.
2673       APPEND int_ex_kennz_plan_sub.
2674     ENDLOOP.
2675
2676   ENDFORM.
