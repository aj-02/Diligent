5218   FORM perioden_umsetzen.
5219
5220     PERFORM perioden_umsetzen_teil1.
5221
5222   * Ermitteln des Wertes PERIOTAB-HIGH = SY-DATUM
5223     PERFORM periode_ermitteln(rmcs1000) USING  sy-datlo
5224                                                con_mcinf
5225                                                bukrs
5226                                      CHANGING  perio_tag
5227                                                perio_woc
5228                                                perio_mon
5229                                                perio_bup
5230                                                periv.
5231     CASE sav_speri.
5232       WHEN con_speri_sptag.
5233         sl_sptag-sign = 'I'.
5234         sl_sptag-option = 'EQ'.
5235         sl_sptag-low = perio_tag.
5236       WHEN con_speri_spwoc.
5237         sl_spwoc-sign = 'I'.
5238         sl_spwoc-option = 'EQ'.
5239         sl_spwoc-low = perio_woc.
5240       WHEN con_speri_spmon.
5241         sl_spmon-sign = 'I'.
5242         sl_spmon-option = 'EQ'.
5243         sl_spmon-low = perio_mon.
5244       WHEN con_speri_spbup.
5245         sl_spbup-sign = 'I'.
5246         sl_spbup-option = 'EQ'.
5247         sl_spbup-low = perio_bup.
5248         IF periv <> space.
5249           SELECT SINGLE * FROM t009 WHERE periv = periv.
5250           IF sy-subrc <> 0.
5251             CLEAR t009-anzbp.
5252           ENDIF.
5253         ELSE.
5254           CLEAR t009-anzbp.
