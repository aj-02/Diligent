1268   *---------------------------------------------------------------------*
1269   *       MACRO _ASSIGN_%                                               *
1270   *---------------------------------------------------------------------*
1271   *       Feldsymbol zuweisen                                           *
1272   *       (wenn nicht erfolgreich, dem Namen '%' voranstellen)          *
1273   *---------------------------------------------------------------------*
1274   *  -->  &1   COMPONENT                                                *
1275   *  -->  &2   Feldname                                                 *
1276   *  -->  &3   OF                                                       *
1277   *  -->  &4   STRUCTURE                                                *
1278   *  -->  &5   Struktur                                                 *
1279   *  -->  &6   TO                                                       *
1280   *  -->  &7   Feldsymbol                                               *
1281   *---------------------------------------------------------------------*
1282   DEFINE _assign_%.
1283     assign &1 &2 &3 &4 &5 &6 &7.
1284     if not sy-subrc is initial.
1285       %fieldname = &2.
1286       if %fieldname(1) = '%'.
1287   *     ASSIGN fehlgeschlagen=> Probiere es mit Feldnamen ohne führendes %
1288   *     (Dies ist bei summierbaren Feldern notwendig)
1289         shift %fieldname left by 1 places.
1290       else.
1291   *     ASSIGN fehlgeschlagen => Probiere es mit Feldnamen mit führenden %
1292   *     (Dies ist bei nicht summierbaren Feldern notwendig)
1293         concatenate '%' &2 into %fieldname.
1294       endif.
1295       assign component %fieldname &3 &4 &5 &6 &7.
1296     endif.
1297   END-OF-DEFINITION.                     "_ASSIGN_%
1298
