4793   *---------------------------------------------------------------------*
4794   *       FORM ZUSATZKENNZAHLEN_BESTAENDE                               *
4795   *---------------------------------------------------------------------*
4796   *       Es werden zusätzliche Kennzahlen zu den Bestaenden bzw.       *
4797   *       Bestandswerten berechnet.
4798   *       Berechnung Durchschnittsbestand:
4799   *       Anfangsbestand + n Endbestände / n + 1.
4800   *---------------------------------------------------------------------*
4801   *  -->  KZ_EINTRAG                                                    *
4802   *---------------------------------------------------------------------*
4803   FORM zusatzkennzahlen_bestaende CHANGING kz_eintrag STRUCTURE aus_s000.
4804
4805     DATA: anfangsbestand_bw LIKE s032-mbwbest,
4806           anfangsbestand_ko LIKE s032-mkobest,
4807           anfangsbestand_we LIKE s032-wbwbest,
4808           anfangsbestand_gs LIKE s032-mbwbest.
4809
4810     IF akt_hierarchie-merkmals_fcode EQ con_fcode_aper AND
4811        NOT kz_eintrag-objekt         IS INITIAL        AND
4812        NOT kz_eintrag-id             IS INITIAL.
4813   * Aufwendigere Abfrage, damit für Summe anzahl_perio verwendet wird
4814       anzahl_perioden = g_anz_perio + 1.
4815     ELSE.
4816       anzahl_perioden = anzahl_perio + 1.
4817     ENDIF.
4818
4819     PERFORM akt_drilldown_lesen.
4820   *  auch beim Aufruf aus der Exceptionanalyse mit Prüfung
4821   *  der Einzelperiode "einfacher" Mittelwert               note 169137
4822     IF akt_drilldown[] IS INITIAL AND int_mcyc-singl EQ true.
4823       flg_dd = true.
4824     ELSE.
4825   *  dsgl. wenn Periode im XXL-Export
4826       LOOP AT dab_mcyb WHERE fname = 'SPTAG' OR
4827                              fname = 'SPWOC' OR
4828                              fname = 'SPMON' OR
4829                              fname = 'SPBUP'.
4830         EXIT.
4831       ENDLOOP.
4832       IF sy-subrc = 0.
4833         flg_dd = true.
4834       ENDIF.
4835     ENDIF.
4836
4837   *Gesamtbestand
4838     kz_eintrag-gsbest = kz_eintrag-mbwbest + kz_eintrag-mkobest.
4839
4840     IF ( akt_drilldown-fcode = con_fcode_aper OR flg_dd = true ) AND
4841        sum_kz NE true.
4842   *   Periodenaufriß erfolgt oder Periode war bereits im Aufriß
4843   *Mittlerer Bestand bewertet
4844       kz_eintrag-dbwbest =
4845      kz_eintrag-mbwbest - ( ( kz_eintrag-mzubb - kz_eintrag-magbb ) / 2 ).
4846   *Mittlerer Bestand Konsi
4847       kz_eintrag-dkobest =
4848      kz_eintrag-mkobest - ( ( kz_eintrag-mzukb - kz_eintrag-magkb ) / 2 ).
4849   *Mittlerer Bestand Gesamt
4850       kz_eintrag-dgsbest = kz_eintrag-dbwbest + kz_eintrag-dkobest.
4851   *Mittlerer Bestandswert bewerteter Bestand
4852       kz_eintrag-dwbwbest =
4853     kz_eintrag-wbwbest - ( ( kz_eintrag-wzubb - kz_eintrag-wagbb ) / 2 ).
4854
4855     ELSE.
4856   *  kein Periodenaufriß oder Durchschnitt für Summenzeile
4857       anfangsbestand_bw =
4858                 kz_eintrag-mbwbest - kz_eintrag-mzubb + kz_eintrag-magbb.
4859       anfangsbestand_ko =
4860                 kz_eintrag-mkobest - kz_eintrag-mzukb + kz_eintrag-magkb.
4861       anfangsbestand_we =
4862                 kz_eintrag-wbwbest - kz_eintrag-wzubb + kz_eintrag-wagbb.
4863       anfangsbestand_gs = anfangsbestand_bw + anfangsbestand_ko.
4864
4865       kz_eintrag-dbwbest = ( kz_eintrag-s_mbwbest  + anfangsbestand_bw )
4866                           / anzahl_perioden.
4867       kz_eintrag-dkobest = ( kz_eintrag-s_mkobest  + anfangsbestand_ko )
4868                           / anzahl_perioden.
4869       kz_eintrag-dgsbest =  kz_eintrag-dbwbest + kz_eintrag-dkobest.
4870
4871       kz_eintrag-dwbwbest = ( kz_eintrag-s_wbwbest + anfangsbestand_we )
4872                           / anzahl_perioden.
4873     ENDIF.
4874
4875   ENDFORM.                               "zusatzkennzahlen_bestaende
4876
