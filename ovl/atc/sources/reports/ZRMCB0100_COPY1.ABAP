4203   *       FORM TABELLE_T009_PRUEFEN                                     *
4204   *---------------------------------------------------------------------*
4205   *       ........                                                      *
4206   *---------------------------------------------------------------------*
4207   FORM tabelle_t009_pruefen.
4208
4209   DATA: XT009B LIKE T009B OCCURS 0 WITH HEADER LINE,
4210         LV_GJAHR LIKE T009B-BDATJ,
4211         LV_POPER LIKE T009B-POPER.
4212
4213   DATA: T_POPER LIKE T009B-POPER.
4214
4215   STATICS: BEGIN OF XT009B_NEW OCCURS 0,
4216              PERIV LIKE T009B-PERIV,
4217              BDATJ LIKE T009B-BDATJ,
4218              POPER LIKE T009B-POPER,
4219              RELJR LIKE T009B-RELJR,
4220              GJAHR LIKE T009B-BDATJ,
4221            END OF   XT009B_NEW.
4222
4223     Clear T_POPER.
4224     Move PERIOTAB-LOW+4(2) to T_POPER.
4225
4226     ANZ_PER = T009-ANZBP.
4227
4228     IF ANZ_PER GT 99.
4229       ANZ_PER = 99.
4230     ENDIF.
4231
4232     SELECT SINGLE  * FROM T009B WHERE
4233                            PERIV = T009-PERIV AND NOT reljr = '0'.
4234
4235     IF sy-subrc = 0.
4236   ************non-calendar fiscal year**********************************
4237      IF NOT XT009B_NEW IS INITIAL.
4238       READ TABLE XT009B_NEW INDEX 1.
4239       IF Xt009B_NEW-PERIV NE T009-PERIV.
4240        CLEAR XT009B_NEW.
4241        REFRESH xt009B_NEW.
4242       ENDIF.
4243      ENDIF.
4244
4245      IF XT009B_NEW[] IS INITIAL.
4246   " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 06.06.2026  FOR ATC
4247   *    SELECT * FROM T009B INTO CORRESPONDING FIELDS OF TABLE XT009B_NEW
4248   *      WHERE PERIV = T009-PERIV.
4249       SELECT * FROM T009B INTO CORRESPONDING FIELDS OF TABLE XT009B_NEW
4250   WHERE PERIV = T009-PERIV
4251         ORDER BY PRIMARY KEY.
4252   " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 06.06.2026 FOR ATC
4253       IF sy-subrc = 0.
4254        LOOP AT XT009B_NEW.
4255         IF xt009b_new-reljr = '+1'.
4256            xt009b_new-GJAHR = xt009B_new-bdatj + 1.
4257         ELSEIF xt009b_new-reljr = '-1'.
4258            xt009b_new-GJAHR = xt009B_new-bdatj - 1.
4259         ELSE.
4260           xt009b_new-GJAHR = xt009B_new-bdatj.
4261         ENDIF.
4262         MODIFY xt009B_new.
4263        ENDLOOP.
4264        SORT xt009B_NEW BY PERIV GJAHR POPER DESCENDING.
4265       ENDIF.
4266      ENDIF.
4267      CLEAR: LV_GJAHR, LV_POPER.
4268      LOOP AT xt009B_new WHERE GJAHR = PERIOTAB-LOW(4).
4269       IF xt009b_new-GJAHR NE LV_GJAHR OR
4270          LV_GJAHR IS INITIAL.
4271        CLEAR: LV_GJAHR, LV_POPER.
4272        LV_GJAHR = xt009b_new-GJAHR.
4273        IF LV_POPER IS INITIAL OR
4274         xt009b_new-poper GT LV_POPER.
4275         LV_POPER = xt009b_new-poper.
4276        ENDIF.
4277       ENDIF.
4278      ENDLOOP.
4279      IF LV_POPER LT ANZ_PER.
4280       ANZ_PER = LV_POPER.
4281      ENDIF.
4282
4283   ELSE.
4284   ****************************normal fiscal year**************************
4285
4286   " Code Remediation changes S4 2025_1_A Conversion **BEGIN OF CHANGE BY SAP_ABAP 06.06.2026  FOR ATC
4287   * SELECT * FROM T009B INTO TABLE XT009B WHERE
4288   *                          PERIV = T009-PERIV AND
4289   *                          BDATJ = PERIOTAB-LOW(4).
4290    SELECT * FROM T009B INTO TABLE XT009B WHERE
4291                             PERIV = T009-PERIV AND
4292   BDATJ = PERIOTAB-LOW(4)
4293         ORDER BY PRIMARY KEY.
4294   " Code Remediation changes S4 2025_1_A Conversion * *END OF CHANGE BY SAP_ABAP 06.06.2026 FOR ATC
4295     SORT XT009B BY PERIV BDATJ POPER DESCENDING.
4296     READ TABLE XT009B INDEX 1.
4297     IF XT009B-POPER LT ANZ_PER.
4298       ANZ_PER = XT009B-POPER.
4299     ENDIF.
4300     ENDIF.
4301
4302     IF anz_per IS INITIAL.
4303   *T009 nicht gepflegt ==> Behandlung Buchungsperiode wie Kalenderjahr
4304       periotab-low+4(2) = periotab-low+4(2) + 1.
4305       IF periotab-low+4(2) = '13'.
4306         periotab-low+4(2) = '01'.
4307         periotab-low(4) = periotab-low(4) + 1.
4308       ENDIF.
4309     ELSE.
4310       periotab-low+4(2) = periotab-low+4(2) + 1.
4311       IF periotab-low+4(2) GT anz_per+1(2).
4312         periotab-low+4(2) = '01'.
4313         periotab-low(4) = periotab-low(4) + 1.
4314       ENDIF.
4315     ENDIF.
4316   ENDFORM.                               "tabelle_t009_pruefen
