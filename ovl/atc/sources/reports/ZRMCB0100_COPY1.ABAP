588    *---------------------------------------------------------------------*
589    *       FORM ZEITREIHE_AUSGEBEN_VORBEREITEN                           *
590    *---------------------------------------------------------------------*
591    *       Vorbereitung der Ausgabe der Zeitreihe im PopUp-Fenster       *
592    *---------------------------------------------------------------------*
593    *  -->  ZA_FLG_POPUP: FALSE, wenn Zeitreihe aus Liste gerufen wird    *
594    *                     TRUE,  wenn Zeitreihe geblättert werden muß     *
595    *---------------------------------------------------------------------*
596    FORM ZEITREIHE_AUSGEBEN_VORBEREITEN USING ZA_FLG_POPUP TYPE BOOLEAN.
597
598      CONSTANTS: L_ROW_HEIGHT(2)          TYPE P  VALUE '0.8' DECIMALS 1.
599      DATA: ZA_ANZ_PERIODEN               TYPE I,
600            ZA_HLP_ZAEHLER                TYPE I,
601            ZA_SPALTE_MERKMAL2            TYPE I,
602            ZA_SPALTE_REFLEN              TYPE I,
603            ZA_START_COL                  LIKE SY-CUCOL,
604            ZA_START_ROW                  LIKE SY-CUROW,
605            ZA_END_COL                    TYPE I,
606            ZA_END_ROW                    TYPE I,
607            ZA_MAX_ROWS                   TYPE I,
608            ZA_POPUP_LENGTH               TYPE I,
609            ZA_POPUP_WIDTH                TYPE I,
610            ZA_POPUP_ROWS                 TYPE I,
611            ZA_SAV_MERKMAL1(30)
612            .
613      DATA: L_ZEIT_OBJEKT                 LIKE AUS_S000-OBJEKT.
614      DATA: L_OFFSET_1 TYPE I.
615      DATA: L_OFFSET_2 TYPE I.
616
617    * Anzahl der Perioden bestimmen
618      DESCRIBE TABLE ZEIT_PERIODEN LINES ZA_ANZ_PERIODEN.
619
620    * Festsetzen der maximalen Ausgabelänge des Zusatz-Popups
621      ZA_MAX_ROWS        = SY-SROWS - 5.
622    * Höhe wird wegen unterschiedlicher Metrik Liste/Dynpro reduziert
623      ZA_MAX_ROWS     = ( ZA_MAX_ROWS - 3 ) * L_ROW_HEIGHT.
624
625    * Berechnen der Breite der Periodenspalten als Maximum aus Kennzahlbrei-
626    * te + Einheit und Ausgabelänge der Periodenüberschrift
627      ZEITREIHEN_SPALTEN_BREITE = ZEITREIHEN_KENNZAHL_BREITE.
628      ZA_SPALTE_MERKMAL2        = ZEITREIHEN_KENNZAHL_BREITE.
629      IF KENNZAHL_SPALTE-REFLEN <> 0.
630        ZEITREIHEN_SPALTEN_BREITE = ZEITREIHEN_SPALTEN_BREITE +
631                                    KENNZAHL_SPALTE-REFLEN + 1.
632        ZA_SPALTE_REFLEN          = KENNZAHL_SPALTE-REFLEN.
633      ENDIF.
634      IF ZEITREIHEN_SPALTEN_BREITE < DRILLDOWN_FCODES-OUTPUTLEN.
635    *   Kennzahlspalte ist schmaler als Periode
636        ZEITREIHEN_SPALTEN_BREITE = DRILLDOWN_FCODES-OUTPUTLEN.
637        ZA_SPALTE_MERKMAL2        = DRILLDOWN_FCODES-OUTPUTLEN.
638        IF ZA_SPALTE_REFLEN <> 0.
639    *     entsprechende Breite für Einheitenfeld subtrahieren
640          ZA_SPALTE_MERKMAL2 = ZA_SPALTE_MERKMAL2 - ZA_SPALTE_REFLEN - 1.
641        ENDIF.
642      ENDIF.
643      ZEITREIHEN_KENNZAHL_BREITE = ZA_SPALTE_MERKMAL2.
644
645    *-- Falls zusammengesetzte Keys im Spiel sind muß das Zeitmerkmal
646    *   zusammengebaut werden.
647      IF NOT ANZ_MERKMALSKETTUNGEN IS INITIAL.
648    *-- Key zusammensetzen bei Merkmalskettung
649        ASSIGN L_ZEIT_OBJEKT TO <ZEIT_MERKMAL1>.
650        CASE ANZ_MERKMALSKETTUNGEN.
651          WHEN 1.
652            L_OFFSET_1 = OUTPUTLEN_ZEIT_OBJEKT_KETT1.
653          WHEN 2.
654            L_OFFSET_1 = OUTPUTLEN_ZEIT_OBJEKT_KETT1.
655            L_OFFSET_2 = L_OFFSET_1 + OUTPUTLEN_ZEIT_OBJEKT_KETT2.
656        ENDCASE.
657      ENDIF.
658    * zählen der Zeilen der Ausgabetabelle für PopUp-Höhe
659      LOOP AT ZEIT_S000.
660        CASE ANZ_MERKMALSKETTUNGEN.
661          WHEN 1.
662            L_ZEIT_OBJEKT              = <ZEIT_MERKMAL1_KETT1>.
663            L_ZEIT_OBJEKT+L_OFFSET_1   = <ZEIT_MERKMAL1_KETT2>.
664          WHEN 2.
665            L_ZEIT_OBJEKT              = <ZEIT_MERKMAL1_KETT1>.
666            L_ZEIT_OBJEKT+L_OFFSET_1   = <ZEIT_MERKMAL1_KETT2>.
667            L_ZEIT_OBJEKT+L_OFFSET_2   = <ZEIT_MERKMAL1_KETT3>.
668        ENDCASE.
669        IF ZA_SAV_MERKMAL1 <> <ZEIT_MERKMAL1> OR SY-TABIX = 1.
670    *     neues Merkmal
671          ZA_SAV_MERKMAL1 = <ZEIT_MERKMAL1>.
672          ADD 1 TO ZA_POPUP_LENGTH.
673    * Höhe wird wegen unterschiedlicher Metrik Liste/Dynpro reduziert
674          ZA_POPUP_ROWS   = ( ZA_POPUP_LENGTH - 3 + 7 ) * L_ROW_HEIGHT.
675          IF ZA_POPUP_ROWS  >= ZA_MAX_ROWS.
676    *--     Performance !
677            EXIT.
678          ENDIF.
679        ENDIF.
680      ENDLOOP.
681    *+  za_popup_length = za_popup_length + 7.
682
683      IF ZA_POPUP_ROWS  >= ZA_MAX_ROWS.
684    *   Übersteigt die berechntete Länge die Länge des Grundfensters,
685    *   so wird die Größe des Grundfensters übernommen
686        ZA_POPUP_ROWS   =  ZA_MAX_ROWS.
687        ZA_START_ROW    = 1.
688        ZA_END_ROW      = ZA_START_ROW + ZA_MAX_ROWS - 1.
689      ELSE.
690        ZA_START_ROW = ( ZA_MAX_ROWS - ZA_POPUP_ROWS ) DIV 2.
691        IF ZA_START_ROW < 1.
692          ZA_START_ROW = 1.
693        ENDIF.
694        ZA_END_ROW = ( ZA_START_ROW + ZA_POPUP_ROWS ) + 4.
695      ENDIF.
696
697    * Breite des PopUps berechnen
698    * Bedeutung der Berechnungskomponenten
699    * STRICH_ANFANG             = Breite der Merkmalsbezeichnung
700    * ZEITREIHEN_ANZ_SPALTEN    = Anzahl der Perioden, die auf den Bild-
701    *                             schirm passen
702    * ZEITREIHEN_SPALTEN_BREITE = Breite der Periodenspalten
703    * + 1                       = Strichbreite
704      ZEITREIHEN_ANZ_SPALTEN = ( 1023 - STRICH_ANFANG ) DIV
705                               ( ZEITREIHEN_SPALTEN_BREITE + 1 ).
706
707      IF ZEITREIHEN_ANZ_SPALTEN > ZA_ANZ_PERIODEN.
708    *   mehr Spalten anzeigbar als nötig
709        ZEITREIHEN_ANZ_SPALTEN = ZA_ANZ_PERIODEN.
710      ENDIF.
711    * Fensterbreite kann so nicht mehr überschritten werden !
712      ZA_POPUP_WIDTH         = STRICH_ANFANG + ZEITREIHEN_ANZ_SPALTEN *
713                               ( ZEITREIHEN_SPALTEN_BREITE + 1 ).
714
715      ZEITREIHEN_POPUP_WIDTH = ZA_POPUP_WIDTH.
716      IF ZA_POPUP_WIDTH < 80.
717    *   Mindestbreite des Fensters für Aufrißprotokoll im Seitenkopf
718        ZA_POPUP_WIDTH = 80.
719      ENDIF.
720
721    * Start- und Endpunkte des Zusatzfensters in Abhängigkeit der
722    * Systemgegebenheiten bestimmen
723      IF ZA_POPUP_WIDTH > SY-SCOLS.
724        ZA_START_COL = ( SY-SCOLS - ( SY-SCOLS - 8 ) ) DIV 2.
725        IF ZA_START_COL < 1.
726          ZA_START_COL = 1.
727        ENDIF.
728        ZA_END_COL = ZA_START_COL + ( SY-SCOLS - 8 ).
729      ELSE.
730        ZA_START_COL = ( SY-SCOLS - ZA_POPUP_WIDTH ) DIV 2.
731        IF ZA_START_COL < 1.
732          ZA_START_COL = 2.
733        ENDIF.
734        ZA_END_COL = ZA_START_COL + ZA_POPUP_WIDTH.
735      ENDIF.
736
737      IF ZA_FLG_POPUP = FALSE.
738    *   neues Fenster erzeugen, wenn Zeitreihe aus Liste gerufen wird
739        PERFORM TEXT_ERMITTELN USING    65
740    *                                   'Zeitreihe'
741                               CHANGING HLP_TEXT1.
742
743        PERFORM PF_STATUS_SETZEN USING 'WIND0006'
744                                       '000'
745                                       HLP_TEXT1.
746        WINDOW STARTING AT ZA_START_COL ZA_START_ROW
747               ENDING   AT ZA_END_COL   ZA_END_ROW.
748      ELSE.
749    *   Spaltenweises Blättern erfordert Neuaufbau der Liste
750        SY-LSIND = SY-LSIND - 1.
751      ENDIF.
752
753    ENDFORM.                               "ZEITREIHE_AUSGEBEN_VORBEREITEN
754
