1554       SA_HLP_COLNO = cl_abap_list_utilities=>dynamic_output_length(
1555         SA_ZEILE ) + 1.
1556       SA_ZEILE+SA_HLP_COLNO = SELEKTIONS_VRSIO.
1557       SA_SCRTEXT_LENGTH = cl_abap_list_utilities=>dynamic_output_length(
1558         SA_ZEILE ).
