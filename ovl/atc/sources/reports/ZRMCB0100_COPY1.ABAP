194    *---------------------------------------------------------------------*
195    *       FORM WRITE_AT                                                 *
196    *---------------------------------------------------------------------*
197    *       Like WRITE AT, but considers truncation of unicode chars      *
198    *---------------------------------------------------------------------*
199    *        >P_POS     column position of the text                       *
200    *        >P_LEN     length of the "window" for the output             *
201    *        >P_STRING  text                                              *
202    *        >P_JUSTIFY ' '/'L'/'R' not/left-/right-justified output      *
203    *        >P_NOGAP   flag: output with NO-GAP                          *
204    *---------------------------------------------------------------------*
205    FORM write_at  USING    VALUE(p_pos) TYPE i
206                            VALUE(p_len) TYPE i
207                            p_string TYPE clike
208                            p_justify TYPE c
209                            p_nogap TYPE c.
210
211      DATA: lf_mem_off TYPE i,
212            lf_rc TYPE i,
213            lf_string(500) TYPE c.
214
215      CALL METHOD CL_ABAP_LIST_UTILITIES=>MEMORY_OFFSET
216        EXPORTING
217          FIELD                      = p_string
218          DISPLAY_OFFSET             = p_len
219        IMPORTING
220          MEMORY_OFFSET              = lf_mem_off
221          RC                         = lf_rc.
222      IF lf_rc > 2.
223        lf_mem_off = p_len.
224      ENDIF.
225
226      lf_string = p_string.
227      IF p_nogap IS INITIAL.
228        CASE p_justify.
229          WHEN ' '.
230            WRITE AT p_pos(p_len) lf_string(lf_mem_off).
231          WHEN 'L'.
232            WRITE AT p_pos(p_len) lf_string(lf_mem_off) LEFT-JUSTIFIED.
233          WHEN 'R'.
234            WRITE AT p_pos(p_len) lf_string(lf_mem_off) RIGHT-JUSTIFIED.
235        ENDCASE.
236      ELSE.
237        CASE p_justify.
238          WHEN ' '.
239            WRITE AT p_pos(p_len) lf_string(lf_mem_off) NO-GAP.
240          WHEN 'L'.
241            WRITE AT p_pos(p_len) lf_string(lf_mem_off)
242              NO-GAP LEFT-JUSTIFIED.
243          WHEN 'R'.
244            WRITE AT p_pos(p_len) lf_string(lf_mem_off)
245              NO-GAP RIGHT-JUSTIFIED.
246        ENDCASE.
247      ENDIF.
248
249    ENDFORM.                    " write_at
