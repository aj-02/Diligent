6800           LOOP AT hlp_kennz_plan_sub.
6801             CLEAR int_ex_kennz_plan_sub.
6802             REFRESH int_ex_kennz_plan_sub.
6803             int_ex_kennz_plan_sub = hlp_kennz_plan_sub.
