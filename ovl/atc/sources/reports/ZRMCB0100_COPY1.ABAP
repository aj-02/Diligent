177    *---------------------------------------------------------------------*
178    *       FORM CURSORPOS_AUFRISSPROTOKOLL                               *
179    *---------------------------------------------------------------------*
180    *       Cursorposition im Aufrißprotokoll ermitteln                   *
181    *---------------------------------------------------------------------*
182    *  <--  CA_TABIX: Tabellenindex in AKT_DRILLDOWN zur Cursorposition   *
183    *                 = 0 bei ungültiger Position                         *
184    *---------------------------------------------------------------------*
185    FORM CURSORPOS_AUFRISSPROTOKOLL CHANGING CA_TABIX LIKE SY-TABIX.
186      DATA: CA_FELD(30),
187            CA_LINE         LIKE SY-CUROW,
188            CA_CURSOROFFSET LIKE SY-CUCOL.
189
190      CLEAR CA_TABIX.
191      IF DARSTELLUNGSART = CON_DARST_AUFRISS.
192    *   Cursor steht auf Aufrißprotokoll im Seitenkopf
193        GET CURSOR FIELD CA_FELD.
194        IF SY-SUBRC = 0.
195    *     Cursor steht auf gültigem Feld
196          CA_TABIX = TABINDEX.
197          GET CURSOR LINE CA_LINE OFFSET CA_CURSOROFFSET.
198          ADD 1 TO CA_CURSOROFFSET.
199          IF CA_CURSOROFFSET >= 42.
200    *       TABINDEX korrigieren, da Cusror in der 2. Spalte des Aufriß-
201    *       protokolls steht
202            ADD 1 TO CA_TABIX.
203          ENDIF.
204        ENDIF.
205      ENDIF.
206    ENDFORM.                               "CURSORPOS_AUFRISSPROTOKOLL
