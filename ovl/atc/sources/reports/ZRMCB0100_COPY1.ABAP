267    *---------------------------------------------------------------------*
268    *       FORM DD_RANGES_FUELLEN                                        *
269    *---------------------------------------------------------------------*
270    *       Füllen der Ranges für den durchzuführenden Aufriß             *
271    *---------------------------------------------------------------------*
272    FORM DD_RANGES_FUELLEN.
273
274      DATA: DF_KNOTEN_ID LIKE AUSTAB_GLOBAL-ID,
275            DF_FELDNAME(30).
276      FIELD-SYMBOLS: <DF_RANGES>,
277                     <DF_RANGES_TAB> TYPE TABLE,
278                     <DF_RANGES_FELD>.
279      DATA: LT_MERKMALSKETTUNG          TYPE T_MERKMALSKETTUNG.
280      DATA: L_MERKMALSKETTUNG           TYPE MERKMALSKETTUNG.
281      DATA: L_ANZ_MERKMALSKETTUNG       LIKE ANZ_MERKMALSKETTUNGEN.
282      DATA: L_OFFSET                    LIKE SY-FDPOS.
283      DATA: L_LENGTH                    TYPE I.            " <= note 173354
284      DATA: FLG_FILL_DD.                                   " TR 05.11.1999
285
286
287    * Ranges-Tabellen löschen
288      LOOP AT DRILLDOWN_FCODES.
289        CONCATENATE 'DD_' DRILLDOWN_FCODES-RANGES_SUF '[]'
290                    INTO DF_FELDNAME.
291        ASSIGN (DF_FELDNAME) TO <DF_RANGES_TAB>.
292        REFRESH <DF_RANGES_TAB>.
293      ENDLOOP.
294
295      CLEAR ANZ_HIERARCHIE_AUFRISSE.
296      CLEAR MERKMALSKETTUNG_AKT.
297    * Aufriß-Objekt in Ranges-Tabelle eintragen
298      LOOP AT AKT_DRILLDOWN.
299        IF SY-TABIX = DRILLDOWN_EINTRAEGE.
300    *     Für letzten Aufriß werden die Ranges nicht gefüllt
301          EXIT.
302        ENDIF.
303        IF AKT_DRILLDOWN-FCODE(1) = 'H'.
304    *     Hierarchieaufriß
305          ADD 1 TO ANZ_HIERARCHIE_AUFRISSE.
306          DF_KNOTEN_ID = AKT_DRILLDOWN-ID.
307
308          FLG_FILL_DD = FALSE.                       " ===>>> TR 05.11.1999
309          READ TABLE RSTHIE_TAB WITH KEY
310                                     ID = AKT_DRILLDOWN-ID BINARY SEARCH.
311          IF SY-SUBRC = 0.
312            READ TABLE RSTTYP_INFO WITH KEY TYPE = RSTHIE_TAB-TYPE.
313            IF SY-SUBRC = 0.
314              MOVE-CORRESPONDING RSTTYP_INFO TO AKT_DRILLDOWN.
315              AKT_DRILLDOWN-DOMNAME   = RSTTYP_INFO-TDOMNM.
316              AKT_DRILLDOWN-ROLLNAME  = RSTTYP_INFO-ROLNM.
317              READ TABLE DRILLDOWN_FCODES WITH KEY ROLLNAME =
318                                              RSTTYP_INFO-ROLNM.
319              IF SY-SUBRC eq 0.
320                MOVE-CORRESPONDING drilldown_fcodes TO akt_drilldown.
321                FLG_FILL_DD = TRUE.
322              endif.
323            ENDIF.
324          ENDIF.
325        ELSE.
326          FLG_FILL_DD = TRUE.
327        ENDIF.
328        IF FLG_FILL_DD eq TRUE.                      " <=== TR 05.11.1999
329    *--   Falls im Drilldown gekettete Merkmale vorkommen, müssen diese
330    *     für den Aufriß wieder in die Einzelbestandteile zerlegt werden
331          IF AKT_DRILLDOWN-KETT_AKT IS INITIAL.
332    *     Aufriß nach Merkmal oder Periode
333            CONCATENATE 'DD_' AKT_DRILLDOWN-RANGES_SUF INTO DF_FELDNAME.
334            ASSIGN (DF_FELDNAME) TO <DF_RANGES>.
335            CONCATENATE DF_FELDNAME '[]' INTO DF_FELDNAME.
336            ASSIGN (DF_FELDNAME) TO <DF_RANGES_TAB>.
337    *     <DF_RANGES>-SIGN setzen
338            ASSIGN COMPONENT 1 OF STRUCTURE <DF_RANGES> TO <DF_RANGES_FELD>.
339            <DF_RANGES_FELD> = 'I'.
340    *     <DF_RANGES>-OPTION setzen
341            ASSIGN COMPONENT 2 OF STRUCTURE <DF_RANGES> TO <DF_RANGES_FELD>.
342            <DF_RANGES_FELD> = 'EQ'.
343    *     <DF_RANGES>-LOW setzen
344            ASSIGN COMPONENT 3 OF STRUCTURE <DF_RANGES> TO <DF_RANGES_FELD>.
345            <DF_RANGES_FELD> = AKT_DRILLDOWN-OBJEKT.
346            APPEND <DF_RANGES> TO <DF_RANGES_TAB>.
347          ELSE.
348    *--   Objekt in Einzelbestandteile zerlegen
349    *--     Reihenfolge der Schlüsselfelder ermitteln
350            MERKMALSKETTUNG_AKT = TRUE.
351            PERFORM MERKMALSKETTUNG_KEY_FOLGE
352                    USING    AKT_DRILLDOWN-ROLLNAME01
353                    CHANGING LT_MERKMALSKETTUNG
354                             L_ANZ_MERKMALSKETTUNG.
355            CLEAR: L_OFFSET.
356            LOOP AT LT_MERKMALSKETTUNG INTO L_MERKMALSKETTUNG.
357              READ TABLE DRILLDOWN_FCODES
358                         WITH KEY DDICFELD = L_MERKMALSKETTUNG-DDICFELD.
359              CONCATENATE 'DD_' DRILLDOWN_FCODES-RANGES_SUF
360                          INTO DF_FELDNAME.
361              ASSIGN (DF_FELDNAME) TO <DF_RANGES>.
362              CONCATENATE DF_FELDNAME '[]' INTO DF_FELDNAME.
363              ASSIGN (DF_FELDNAME) TO <DF_RANGES_TAB>.
364    *        <DF_RANGES>-SIGN setzen
365              ASSIGN COMPONENT 1 OF STRUCTURE <DF_RANGES>
366                     TO <DF_RANGES_FELD>.
367              <DF_RANGES_FELD> = 'I'.
368    *        <DF_RANGES>-OPTION setzen
369              ASSIGN COMPONENT 2 OF STRUCTURE <DF_RANGES>
370                     TO <DF_RANGES_FELD>.
371              <DF_RANGES_FELD> = 'EQ'.
372    *        <DF_RANGES>-LOW setzen
373              ASSIGN COMPONENT 3 OF STRUCTURE <DF_RANGES>
374                     TO <DF_RANGES_FELD>.
375              <DF_RANGES_FELD> =
376                AKT_DRILLDOWN-OBJEKT+L_OFFSET(L_MERKMALSKETTUNG-OUTPUTLEN).
377              L_OFFSET = L_OFFSET + L_MERKMALSKETTUNG-OUTPUTLEN.
378              APPEND <DF_RANGES> TO <DF_RANGES_TAB>.
379
380            ENDLOOP.
381          ENDIF.
382        ENDIF.
383      ENDLOOP.
384
385      IF AKT_DRILLDOWN-FCODE(1) <> 'H' AND NOT DF_KNOTEN_ID IS INITIAL.
386    *   Letzter Aufriß-Fcode ist kein Hierarchieaufriß, aber im aktuellen
387    *   Aufrißpfad wurde Aufriß nach Hierarchie durchgeführt => Überprüfen,
388    *   ob Ranges-Tabelle zum Blatt schon Einträge enthält
389        CONCATENATE 'DD_' AKT_HIERARCHIE-MERKMALS_RANGES_SUF
390                    INTO DF_FELDNAME.
391        ASSIGN (DF_FELDNAME) TO <DF_RANGES>.
392        CONCATENATE DF_FELDNAME '[]' INTO DF_FELDNAME.
393        ASSIGN (DF_FELDNAME) TO <DF_RANGES_TAB>.
394        DESCRIBE TABLE <DF_RANGES_TAB> LINES SY-TFILL.
395        IF SY-TFILL IS INITIAL.
396    *     Ranges-Tab für Blatt ist leer, d.h. es wurde noch kein Aufriß nach
397    *     dem Blatt(merkmal) durchgeführt => ermittle alle Knoten u. Blätter
398    *     bzw. nur die Blätter zum letzten Hierarchieknoten und fülle die
399    *     Ranges-Tabelle damit
400          IF AKT_HIERARCHIE-HPOST = FALSE.
401    *       Hierarchie nicht bebuchbar => ermittle alle Blätter zum Nachf.
402            CALL FUNCTION 'RSTH_LEAFS_COMPUTE'
403                 EXPORTING
404                      NODE_ID  = DF_KNOTEN_ID
405                 TABLES
406                      I_RSTHIE = RSTHIE_TAB
407                      E_LEAFS  = LEAFTAB.
408          ELSE.
409    *       Hierarchie bebuchbar => erm. alle Knoten und Blätter zum Nachf.
410            CALL FUNCTION 'RSTH_NODES_COMPUTE'
411                 EXPORTING
412                      NODE_ID  = DF_KNOTEN_ID
413                 TABLES
414                      I_RSTHIE = RSTHIE_TAB
415                      E_NODES  = LEAFTAB.
416          ENDIF.
417    *     <DF_RANGES>-SIGN setzen
418          ASSIGN COMPONENT 1 OF STRUCTURE <DF_RANGES> TO <DF_RANGES_FELD>.
419          <DF_RANGES_FELD> = 'I'.
420    *     <DF_RANGES>-OPTION setzen
421          ASSIGN COMPONENT 2 OF STRUCTURE <DF_RANGES> TO <DF_RANGES_FELD>.
422          <DF_RANGES_FELD> = 'EQ'.
423    *     <DF_RANGES>-LOW setzen
424          ASSIGN COMPONENT 3 OF STRUCTURE <DF_RANGES> TO <DF_RANGES_FELD>.
425    *     Ranges-Tabelle zum Blatt(merkmal) füllen
426    * ===>>> note 173354
427          L_OFFSET = 0.
428          L_LENGTH = 0.
429    *     Falls gekettete Merkmale: Offset+Länge für Leaftab bestimmen
430          if not akt_hierarchie-kett_akt is initial.       " <= note 306489
431            PERFORM MERKMALSKETTUNG_INTTAB
432                    CHANGING ANZ_MERKMALSKETTUNGEN.
433            CASE ANZ_MERKMALSKETTUNGEN.
434            WHEN 1.
435              L_OFFSET = OUTPUTLEN_INTTAB_OBJEKT_KETT1.
436              L_LENGTH = OUTPUTLEN_INTTAB_OBJEKT_KETT2.
437            WHEN 2.
438              L_OFFSET = OUTPUTLEN_INTTAB_OBJEKT_KETT1 +
439                             OUTPUTLEN_INTTAB_OBJEKT_KETT2.
440              L_LENGTH = OUTPUTLEN_INTTAB_OBJEKT_KETT3.
441            ENDCASE.
442          ENDIF.
443          IF L_LENGTH > 0.
444            LOOP AT LEAFTAB.
445              <DF_RANGES_FELD> = LEAFTAB-NAME+L_OFFSET(L_LENGTH).
446               APPEND <DF_RANGES> TO <DF_RANGES_TAB>.
447            ENDLOOP.
448          ELSE.
449    * <<<=== note 173354
450            LOOP AT LEAFTAB.
451              <DF_RANGES_FELD> = LEAFTAB-NAME.
452              APPEND <DF_RANGES> TO <DF_RANGES_TAB>.
453            ENDLOOP.
454          ENDIF.                                           " <= note 173354
455        ENDIF.
456      ENDIF.
457
458    * Ranges-Tabellen verändern, für zusammengesetzen Schlüssel (QM-IS)
459      PERFORM SPEZIAL_DD_RANGES_AENDERN IN PROGRAM (LIS_PROGNAME) IF FOUND.
460    ENDFORM.                               "DD_RANGES_FUELLEN
461
462
463    *---------------------------------------------------------------------*
464    *       FORM DRILLDOWN_DURCHFUEHREN                                   *
465    *---------------------------------------------------------------------*
466    *       Drilldown für das übergegebende Merkmal durchführen           *
467    *---------------------------------------------------------------------*
468    *  -->  DD_OBJEKT      : Nr. des Merkmals, auf dem der Cursor steht   *
469    *  -->  VALUE(DD_FCODE): Drilldown-Funktionscode                      *
470    *---------------------------------------------------------------------*
471    FORM DRILLDOWN_DURCHFUEHREN
472                       USING DD_OBJEKT       LIKE AKT_DRILLDOWN-OBJEKT
473                             VALUE(DD_FCODE) LIKE AKT_DRILLDOWN-FCODE.
474      DATA: DD_FCODE_PRAEFIX,
475            DD_FLG_ABBRECHEN TYPE BOOLEAN.
476
477
478      IF SY-LSIND = 0.
479    *   Grundliste ausgeben
480        IF DD_FCODE IS INITIAL.
481    *     FCode ist noch nicht gesetzt => FCode ermitteln
482          READ TABLE STD_DRILLDOWN INDEX 1.
483          IF SY-SUBRC = 0.
484    *       Standard-Drilldown vorhanden
485            DD_FCODE = STD_DRILLDOWN-FCODE.
486          ELSE.
487    *       Standard-Drilldown für Analyse nicht vorhanden
488            DD_FCODE = ERSTER_DRILLDOWN.
489          ENDIF.
490        ENDIF.
491      ELSE.
492    *   Drilldown z. Zt. nur auf Einzelsatz durchführbar
493        IF DARSTELLUNGSART <> CON_DARST_EINZEL.
494    *     "Aufriß nur auf Merkmalswert möglich"
495          MESSAGE I005.
496          EXIT.
497        ENDIF.
498        IF SY-LSIND ge 20.
499          MESSAGE E024(SY) WITH '20'.
500    *     Es sind nur maximal 20 Liststufen möglich.
501          EXIT.
502        ENDIF.
503      ENDIF.
504
505    * Drilldown-Tabelle gemäß der aktuellen Liststufe aktualisieren
506      PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
507
508      DD_FCODE_PRAEFIX = DD_FCODE(1).
509      IF DD_FCODE_PRAEFIX = 'H'.
510    *   Hierarchieaufriß
511        IF AKT_HIERARCHIE-HPOST = TRUE.
512    *     Hierarchieaufriß auf bebuchbarer Hierarchie => Überprüfen, ob
513    *     aufzureißender Knoten schon einmal aufgerissen wurden
514          READ TABLE AKT_DRILLDOWN WITH KEY FCODE  = DD_FCODE
515                                            OBJEKT = DD_OBJEKT.
516          IF SY-SUBRC = 0.
517    *       Nach akt. Objekt wurde schon ein Hierarchieaufriß durchgeführt
518    *      'Aufriß nicht mögl., da dieser Hierarchieknoten bereits aufger...
519            MESSAGE I099.
520            EXIT.
521          ENDIF.
522        ENDIF.
523        READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
524        IF ANZ_HIERARCHIE_AUFRISSE = 0 AND AKT_DRILLDOWN-FCODE(1) <> 'H'.
525    *     Es wurde noch kein Hierarchieaufriß durchgeführt => Hierarchie-
526    *     zusatzinfo bestimmen.
527          IF DD_FCODE <> 'HALL'.
528    *       Info zum Hierarchie-FCode muß noch gelesen werden
529            READ TABLE HIERARCHIE_FCODES WITH KEY FCODE = DD_FCODE
530                                         BINARY SEARCH.
531            AKT_HIERARCHIE = HIERARCHIE_FCODES.
532          ENDIF.
533          PERFORM HIER_ZUSATZINFO_BESTIMMEN IN PROGRAM (LIS_PROGNAME)
534                                            IF FOUND
535                                            CHANGING HIER_ZUSATZINFO
536                                                     DD_FLG_ABBRECHEN.
537    *     Zusatzinfo-Ermittlung wurde nicht abgebrochen
538          CHECK DD_FLG_ABBRECHEN = FALSE.
539        ENDIF.
540      ENDIF.
541
542      IF SY-LSIND > 0.
543    *   Liste vorhanden => aktuelles Aufriß-Objekt eintragen
544        READ TABLE AKT_DRILLDOWN INDEX SY-LSIND.
545        AKT_DRILLDOWN-OBJEKT = DD_OBJEKT.
546        AKT_DRILLDOWN-ID     = AKT_ID.
547        IF AKT_DRILLDOWN-FCODE(1) = 'H'.
548    *     Hierarchieinfo => Typinfo des Hierarchieknotens aktualisieren
549          READ TABLE RSTHIE_TAB WITH KEY ID = AKT_ID BINARY SEARCH.
550          READ TABLE RSTTYP_INFO WITH KEY TYPE = RSTHIE_TAB-TYPE.
551          IF SY-SUBRC = 0.
552            MOVE-CORRESPONDING RSTTYP_INFO TO AKT_DRILLDOWN.
553            AKT_DRILLDOWN-DOMNAME   = RSTTYP_INFO-TDOMNM.
554            AKT_DRILLDOWN-ROLLNAME  = RSTTYP_INFO-ROLNM.
555          ENDIF.
556        ENDIF.
557        MODIFY AKT_DRILLDOWN INDEX SY-LSIND.
558    *   Einstellungen der aktuellen Liststufe sichern
559        PERFORM DDOWN_EINSTELLUNGEN_SICHERN USING SY-LSIND.
560      ENDIF.
561
562    * Durchzuführenden Drilldown-Fcode mit Information aus DRILLDOWN_FCODES
563    * bzw. HIERARCHIE_FCODES an die Drilldown-Tabelle anhängen
564      CLEAR AKT_DRILLDOWN.
565      IF DD_FCODE_PRAEFIX = 'H'.
566    *   Hierarchieaufriß
567        MOVE-CORRESPONDING AKT_HIERARCHIE TO AKT_DRILLDOWN.
568      ELSE.
569    *   Normaler Aufriß
570        READ TABLE DRILLDOWN_FCODES WITH KEY FCODE = DD_FCODE BINARY SEARCH.
571        MOVE-CORRESPONDING DRILLDOWN_FCODES TO AKT_DRILLDOWN.
572      ENDIF.
573      APPEND AKT_DRILLDOWN.
574      ADD 1 TO DRILLDOWN_EINTRAEGE.
575
576    * Gleichheit vom aktuellen Aufriß- und Standardaufrißpfad überprüfen
577      PERFORM STD_DRILLDOWN_PRUEFEN CHANGING FLG_STD_DRILLDOWN.
578
579    * Ausgabetabelle auf nicht aktuell setzen und Tab. füllen und ausgeben
580      FLG_AUSTAB_AKTUELL = FALSE.
581      IF SY-BATCH = FALSE OR FLG_LIS_REPORTING = FALSE.
582    *   Ausführung im Online => Liste ausgeben
583        PERFORM AUSTAB_AKTUALISIEREN.
584        PERFORM AUSTAB_AUSGEBEN.
585    *   Horizontale Blätterposition beibehalten
586        SCROLL LIST INDEX SY-LSIND TO COLUMN SY-STACO.
587      ELSEIF SLV_NO IS INITIAL.
588    *   Ausführung im Hintergrund => Selektionsversion 'BGxxx' sichern
589        PERFORM BATCHVERSION_SICHERN.
590      ELSE.
591    *   Abarbeitung einer Selektionsversion im Hintergrund
592        PERFORM AUSTAB_AKTUALISIEREN.
593        PERFORM MCSA_AUSTAB_EXPORT USING SLV_NO
594                                         AKT_DRILLDOWN-DDICFELD.
595      ENDIF.
596    ENDFORM.                               "DRILLDOWN_DURCHFUEHREN
597
598
599    *---------------------------------------------------------------------*
600    *       FORM DRILLDOWN_FCODE_BESTIMMEN                                *
601    *---------------------------------------------------------------------*
602    *       Es wird der Drilldown-Fcode bestimmt, der nach der Standard-  *
603    *       einstellung auf den aktuellen Drilldown folgt                 *
604    *---------------------------------------------------------------------*
605    *  <--  DB_NXT_FCODE                                                  *
606    *---------------------------------------------------------------------*
607    FORM DRILLDOWN_FCODE_BESTIMMEN
608                         CHANGING DB_NXT_FCODE LIKE DRILLDOWN_FCODES-FCODE.
609
610      DATA: DB_AKT_FCODE LIKE AKT_DRILLDOWN-FCODE,
611            DB_INDEX LIKE SY-TABIX.        "Index des nächsten FCODEs
612
613    * Aktuellen Drilldown-Fcode bestimmen
614      READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
615      DB_AKT_FCODE = AKT_DRILLDOWN-FCODE.
616
617      CLEAR DB_NXT_FCODE.
618
619      IF DB_AKT_FCODE(1) = 'H'.
620    *   Aktueller Aufriß ist Hierarchieaufriß => nächster Aufriß ist
621    *   gleicher Hierarchieaufriß (Konvention: Hierarchieaufriß-Fcode
622    *   beginnt mit 'H')
623        DB_NXT_FCODE = DB_AKT_FCODE.
624        EXIT.
625      ENDIF.
626
627      READ TABLE STD_DRILLDOWN WITH KEY DB_AKT_FCODE.
628      IF SY-SUBRC <> 0.
629    *   "Standardaufriß nicht möglich"
630        MESSAGE I001.
631      ELSE.
632        DB_INDEX = SY-TABIX + 1.
633        READ TABLE STD_DRILLDOWN INDEX DB_INDEX.
634        IF SY-SUBRC <> 0.
635    *     "Ende des Standardaufrisses erreicht"
636          MESSAGE I002.
637        ELSE.
638    *     Überprüfen, ob nächster Drill-Down schon durchgeführt wurde
639          READ TABLE AKT_DRILLDOWN WITH KEY STD_DRILLDOWN-FCODE.
640          IF SY-SUBRC = 0.
641    *       "Aufriß & wurde schon durchgeführt"
642            MESSAGE I003 WITH AKT_DRILLDOWN-SCRTEXT_L.
643          ELSE.
644    *       Drilldown-Fcode setzen
645            DB_NXT_FCODE = STD_DRILLDOWN-FCODE.
646          ENDIF.
647        ENDIF.
648      ENDIF.
649    ENDFORM.                               "DRILLDOWN_FCODE_BESTIMMEN
