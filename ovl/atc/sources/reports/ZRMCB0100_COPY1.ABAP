271            PERFORM SPALTENUEBERSCHRIFT_AUSGEBEN USING    SA_KENNZAHLEN
272                                                          TRUE FALSE
273                                                 CHANGING SA_ZEILENLAENGE.
274          ENDLOOP.
275          HIDE DARSTELLUNGSART.
276        ENDIF.
277
278        IF FLG_EINHEITENZEILE = TRUE.
279    *     Einheiten als Überschriftenzeile ausgeben
280          CLEAR <AUSTAB_TEXT>.
281          PERFORM SPALTENANFANG_AUSGEBEN USING FALSE.
282          POSITION STRICH_ANFANG.
283          WRITE SY-VLINE NO-GAP.
284          CLEAR SA_ZEILENLAENGE.
285          LOOP AT SA_KENNZAHLEN.
286            IF SA_KENNZAHLEN-REFFIELD IS INITIAL.
287              CLEAR SA_KENNZAHLEN-HEADLINE_2.
288            ELSEIF SA_KENNZAHLEN-GESAMTKZ = TRUE AND
289                   FLG_PROZENTWERT        = TRUE.
290              SA_KENNZAHLEN-HEADLINE_2 = '%'.
291            ELSE.
292              IF SY-CPROG(3) = 'RCN'.
293                IF SA_KENNZAHLEN-REFFIELD = 'EDAUEH' OR
294                   SA_KENNZAHLEN-REFFIELD = 'IDAUEH' OR
295                   SA_KENNZAHLEN-REFFIELD = 'PDAUEH' OR
296                   SA_KENNZAHLEN-REFFIELD = 'RDAUEH' OR
297                   SA_KENNZAHLEN-REFFIELD = 'VDAUEH'.
298                   IMPORT CHECK_UNITS_2 FROM MEMORY ID 'CN41_CHECK_UNITS'.
299                   ASSIGN COMPONENT SA_KENNZAHLEN-REFFIELD
300                             OF STRUCTURE CHECK_UNITS_2 TO <SA_EINHEIT>.
301                 ELSE.
302                 _ASSIGN_X COMPONENT SA_KENNZAHLEN-REFFIELD
303                                    OF STRUCTURE SUM_S000 TO <SA_EINHEIT>.
304                 ENDIF.
305              ELSE.
306              _ASSIGN_X COMPONENT SA_KENNZAHLEN-REFFIELD
307                                  OF STRUCTURE SUM_S000 TO <SA_EINHEIT>.
308              ENDIF.
309              IF <SA_EINHEIT> = CON_EINHEIT_UNGUELTIG.
310                SA_KENNZAHLEN-HEADLINE_2 = CON_EINHEIT_UNGUELTIG.
311              ELSE.
312                WRITE <SA_EINHEIT> TO SA_KENNZAHLEN-HEADLINE_2.
313              ENDIF.
314            ENDIF.
315            PERFORM SPALTENUEBERSCHRIFT_AUSGEBEN USING    SA_KENNZAHLEN
316                                                          TRUE FALSE
317                                                 CHANGING SA_ZEILENLAENGE.
318          ENDLOOP.
319          HIDE DARSTELLUNGSART.
320        ENDIF.
321
322        LOOP AT SA_KENNZAHLEN TRANSPORTING NO FIELDS
323                              WHERE NOT FACTOR CO '0 '.
324          EXIT.
325        ENDLOOP.
326        IF SY-SUBRC IS INITIAL.
327    *     mindestens ein Ausgabefaktor ist vorhanden => ausgeben
328          PERFORM SEITENKOPF_FAKTOREN_AUSGEBEN TABLES SA_KENNZAHLEN.
329        ENDIF.
330
331        FORMAT COLOR OFF INTENSIFIED OFF.
332        IF FLG_UEBERSCHRIFT_ALS_HOTSPOT = TRUE.
333    *     nächste Zeilen wieder normal ausgeben
334          FORMAT HOTSPOT OFF.
335        ENDIF.
336
337    *   Unterstrich ausgeben
338        PERFORM WRITE_UNTERSTRICH.
339      ENDIF.                           "flg_printing_selprot TR 17.12.1998
340
341
342      IF GF_ACC_ON = FALSE.
343        IF NOT SORT_KRITERIUM IS INITIAL.
344    *     Icon für auf-/absteigend sortiert im Spaltenkopf ausgeben
345          PERFORM SEITENKOPF_SORT_ICON_AUSGEBEN TABLES SA_KENNZAHLEN
346                                                USING  SORT_KRITERIUM.
347        ENDIF.
348
349        LOOP AT SORT_KENNZAHLEN WHERE FLG_GRUPPE IS INITIAL
350                                AND   FIELDNAME  <> SORT_KRITERIUM.
351          PERFORM SEITENKOPF_SORT_ICON_AUSGEBEN
352                                         TABLES SA_KENNZAHLEN
353                                         USING  SORT_KENNZAHLEN-AUSTABFELD.
354        ENDLOOP.
355      ENDIF.
356
357      ENDIF.
358
359      FLG_PRINTING_HEADLINE = FALSE.                     "<== TR 29.01.1999
360
361    ENDFORM.                               "SEITENKOPF_AUSGEBEN
362
