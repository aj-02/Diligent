938    *---------------------------------------------------------------------*
939    *       FORM ZEITREIHE_FELDSYMBOLE_ZUWEISEN                           *
940    *---------------------------------------------------------------------*
941    *       Feldsymbole für die Kennzahl und die Merkmale zuweisen.       *
942    *---------------------------------------------------------------------*
943    FORM ZEITREIHE_FELDSYMBOLE_ZUWEISEN.
944
945      DATA: LT_MERKMALSKETTUNG          TYPE T_MERKMALSKETTUNG.
946      DATA: L_MERKMALSKETTUNG           TYPE MERKMALSKETTUNG.
947      DATA: L_OUTPUTLEN_MERKMALSKETTUNG TYPE I.
948
949
950      CLEAR: ANZ_MERKMALSKETTUNGEN.
951    * Merkmal 1
952      READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
953      IF AKT_DRILLDOWN-ROLLNAME01 IS INITIAL.
954        ASSIGN COMPONENT AKT_DRILLDOWN-DDICFELD
955                         OF STRUCTURE ZEIT_S000-KEY TO <ZEIT_MERKMAL1>.
956      ELSE.
957    *-- Merkmalskettung
958    *-- Reihenfolge der Schlüsselfelder ermitteln
959        PERFORM MERKMALSKETTUNG_KEY_FOLGE
960                USING    AKT_DRILLDOWN-ROLLNAME01
961                CHANGING LT_MERKMALSKETTUNG
962                         ANZ_MERKMALSKETTUNGEN.
963
964
965        LOOP AT LT_MERKMALSKETTUNG INTO L_MERKMALSKETTUNG.
966          CASE SY-TABIX.
967            WHEN 1.
968              ASSIGN COMPONENT L_MERKMALSKETTUNG-DDICFELD OF STRUCTURE
969                               ZEIT_S000-KEY TO <ZEIT_MERKMAL1_KETT1>.
970              OUTPUTLEN_ZEIT_OBJEKT_KETT1 = L_MERKMALSKETTUNG-OUTPUTLEN.
971            WHEN 2.
972              ASSIGN COMPONENT L_MERKMALSKETTUNG-DDICFELD OF STRUCTURE
973                               ZEIT_S000-KEY TO <ZEIT_MERKMAL1_KETT2>.
974              OUTPUTLEN_ZEIT_OBJEKT_KETT2 = L_MERKMALSKETTUNG-OUTPUTLEN.
975            WHEN 3.
976              ASSIGN COMPONENT L_MERKMALSKETTUNG-DDICFELD OF STRUCTURE
977                               ZEIT_S000-KEY TO <ZEIT_MERKMAL1_KETT3>.
978              OUTPUTLEN_ZEIT_OBJEKT_KETT3 = L_MERKMALSKETTUNG-OUTPUTLEN.
979            WHEN OTHERS.
980              MESSAGE E303.
981          ENDCASE.
982          L_OUTPUTLEN_MERKMALSKETTUNG = L_OUTPUTLEN_MERKMALSKETTUNG
983                                      + L_MERKMALSKETTUNG-OUTPUTLEN.
984        ENDLOOP.
985    *-- Geänderte Ausgabelänge in Akt_drilldown zurückschreiben
986        AKT_DRILLDOWN-OUTPUTLEN = L_OUTPUTLEN_MERKMALSKETTUNG.
987        MODIFY AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE.
988      ENDIF.
989    * Merkmal 2: Periode
990      READ TABLE DRILLDOWN_FCODES WITH KEY FCODE = CON_FCODE_APER
991                                  BINARY SEARCH.
992      ASSIGN COMPONENT DRILLDOWN_FCODES-DDICFELD
993                       OF STRUCTURE ZEIT_S000-KEY TO <ZEIT_MERKMAL2>.
994
995    * Kennzahl + Einheit auf ZEIT_S000-KENNZ-
996      _ASSIGN_% COMPONENT KENNZAHL_SPALTE-FIELDNAME
997                          OF STRUCTURE ZEIT_S000-KENNZ TO <ZEIT_KENNZAHL>.
998      _ASSIGN_X COMPONENT KENNZAHL_SPALTE-REFFIELD
999                          OF STRUCTURE ZEIT_S000-KENNZ
1000                         TO <ZEIT_KENNZAHL_EINH>.
1001
1002   * Kennzahl + Einheit auf ZEIT_SUM_S000-
1003     _ASSIGN_% COMPONENT KENNZAHL_SPALTE-FIELDNAME
1004                         OF STRUCTURE ZEIT_SUM_S000 TO <ZEIT_SUM_KENNZAHL>.
1005     _ASSIGN_X COMPONENT KENNZAHL_SPALTE-REFFIELD
1006                         OF STRUCTURE ZEIT_SUM_S000
1007                         TO <ZEIT_SUM_KENNZAHL_EINH>.
1008
1009   ENDFORM.                               "ZEITREIHE_FELDSYMBOLE_ZUWEISEN
