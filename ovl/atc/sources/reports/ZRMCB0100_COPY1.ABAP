1266   *---------------------------------------------------------------------*
1267   *       FORM LISTE_DRUCKEN                                            *
1268   *---------------------------------------------------------------------*
1269   *       Die aktuelle Liste wird auf den Drucker ausgegeben            *
1270   *---------------------------------------------------------------------*
1271   *  -->  LD_FCODE: Aktueller Druck-Funktionscode                       *
1272   *---------------------------------------------------------------------*
1273   FORM LISTE_DRUCKEN USING VALUE(LD_FCODE) type clike.
1274     DATA: LD_MAX_LAENGE   LIKE SY-LINSZ, "maximale Zeilenlänge
1275           LD_VALID,                      "Flag, ob gedruckt werden soll
1276           LD_AUSGABEROUTINE(30),
1277           LD_RETURNCODE(1),  "Antwort des Anwenders Popup Selektprotokoll
1278           LD_SAV_TITLE(60),              "Retten des Fenstertitels
1279           LD_HLP_TEXT(255),
1280           LD_MAX_OUTPUTLEN LIKE KENNZAHLEN_TAB-OUTPUTLEN,
1281           LD_MAX_REFLEN    LIKE KENNZAHLEN_TAB-REFLEN,
1282   *       Druckparameter
1283           LD_PARAMS        LIKE PRI_PARAMS,
1284           LD_ARPARAMS      LIKE ARC_PARAMS.
1285
1286     FIELD-SYMBOLS: <LD_HLP_TEXT> TYPE ANY.
1287
1288     CLEAR FLG_DDN_PRINTED.               " <=== note 132011
1289
1290   * Ausgaberoutine bestimmen
1291     IF LD_FCODE = 'PRIN' OR LD_FCODE = 'PRNW'.
1292   *   Drucken mit Selektionsprotokollabfrage
1293       CALL FUNCTION 'MC_POPUP_PRINT_SELECTION'
1294            IMPORTING
1295                 E_RETURNCODE = LD_RETURNCODE.
1296       CHECK LD_RETURNCODE <> 'A'.
1297     ENDIF.
1298   * Benutzer hat Druckauswahl nicht abgebrochen
1299     CASE LD_FCODE.
1300       WHEN 'PRNW'.
1301   *     Drucken aus Popup (Vergleich, Alle Kennzahlen oder Zeitreihe)
1302         IF FLG_VERGLEICH <> FALSE.
1303   *       Vergleich drucken
1304   *       PLAN_TAB nachlesen und entsprechend wieder sortieren
1305           PERFORM VERGLEICH_SORTIEREN USING FALSE TRUE.
1306           LD_AUSGABEROUTINE = 'PLANTAB_AUSGEBEN'.
1307           LD_MAX_LAENGE = STRICH_ANFANG  - 2 + 3 *
1308                           ( VGL_SPALTEN_BREITE + KENNZAHL_SPALTE-REFLEN )
1309                           + 3 + 12.
1310           IF NOT KENNZAHL_SPALTE-REFLEN IS INITIAL.
1311   *         je 1 Blank zwischen Zahl und Einheit pro Spalte hinzufügen
1312             ADD 3 TO LD_MAX_LAENGE.
1313           ENDIF.
1314   *       Ausgabebreite für die PLAN_TAB setzen
1315           VGL_POPUP_WIDTH = LD_MAX_LAENGE.
1316         ELSEIF FLG_ZEITREIHE = TRUE.
1317   *       Zeitreihe ausdrucken
1318           LD_AUSGABEROUTINE = 'ZEITREIHE_DRUCKEN'.
1319           LD_MAX_LAENGE = STRICH_ANFANG + ZEITREIHEN_ANZ_SPALTEN *
1320                          ( ZEITREIHEN_SPALTEN_BREITE + 1 ).
1321           IF LD_MAX_LAENGE < 80.
1322   *         mindestens 80 Zeichen wegen Aufrißprotokoll
1323             LD_MAX_LAENGE = 80.
1324           ENDIF.
1325         ELSE.
1326   *       Alle Kennzahlen drucken
1327           LD_AUSGABEROUTINE = 'ALLE_KENNZAHLEN_AUSGEBEN'.
1328   *       Alte Darstellungsart wiederherstellen
1329           DARSTELLUNGSART = SAV_DARSTELLUNGSART.
1330   *       Breite des Dialogfenster ermitteln
1331           LOOP AT KENNZAHLEN_TAB.
1332             IF LD_MAX_OUTPUTLEN < KENNZAHLEN_TAB-OUTPUTLEN.
1333               LD_MAX_OUTPUTLEN = KENNZAHLEN_TAB-OUTPUTLEN.
1334             ENDIF.
1335             IF LD_MAX_REFLEN < KENNZAHLEN_TAB-REFLEN.
1336               LD_MAX_REFLEN = KENNZAHLEN_TAB-REFLEN.
1337             ENDIF.
1338           ENDLOOP.
1339           LD_MAX_LAENGE = LD_MAX_OUTPUTLEN + LD_MAX_REFLEN + 22.
1340         ENDIF.
1341       WHEN 'PRIN'.
1342   *     Kennzahlliste (Grund-, Aufriß- oder Rangliste) =>
1343   *     Drilldown-Tabelle und AUSTAB müssen ggf. aktualisiert werden
1344         PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
1345         PERFORM AUSTAB_AKTUALISIEREN.
1346         LD_AUSGABEROUTINE = 'AUSTAB_AUSGEBEN'.
1347         LD_MAX_LAENGE = STRICH_LAENGE.
1348       WHEN 'PRNT'.
1349   *     Liste drucken (Projektsystem)
1350         LD_AUSGABEROUTINE = 'AUSTAB_AUSGEBEN'.
1351         LD_MAX_LAENGE = STRICH_LAENGE.
1352       WHEN 'PRSP'.
1353   *     Selektionsprotokoll drucken => Nur Selektionsprotokoll drucken
1354         LD_RETURNCODE = '1'.
1355         LD_MAX_LAENGE = 72.
1356     ENDCASE.
1357
1358     IF LD_FCODE = 'PRIN' OR LD_FCODE = 'PRNW'.
1359       IF LD_RETURNCODE = '1'.
1360   *     Drucken mit Selektionsprotokoll
1361         IF LD_MAX_LAENGE < 72.
1362   *       Listbreite min. so breit wie Selektionsprotokoll
1363           LD_MAX_LAENGE = 72.
1364         ENDIF.
1365         IF LD_RETURNCODE = '2'.
1366   *       Drucken ohne Selektionsprotokoll
1367           LD_MAX_LAENGE = LD_MAX_LAENGE.
1368         ENDIF.
1369       ENDIF.
1370     ENDIF.
1371
1372   * Druckparameter setzen
1373     CALL FUNCTION 'GET_PRINT_PARAMETERS'
1374          EXPORTING
1375               LINE_SIZE              = LD_MAX_LAENGE
1376          IMPORTING
1377               OUT_PARAMETERS         = LD_PARAMS
1378               OUT_ARCHIVE_PARAMETERS = LD_ARPARAMS
1379               VALID                  = LD_VALID.
1380     CHECK LD_VALID = TRUE.
1381
1382     FLG_DRUCKEN = TRUE.
1383     NEW-PAGE PRINT ON PARAMETERS LD_PARAMS
1384                       ARCHIVE PARAMETERS LD_ARPARAMS
1385                       NEW-SECTION NO DIALOG.
1386     FORMAT INTENSIFIED OFF.
1387
1388     IF LD_RETURNCODE = '1'.
1389   *   Drucken mit Selektionsprotokoll
1390
1391   *   SY-TITLE sichern, da Selektionsprotokoll mit globaler Variable
1392   *   HLP_TEXT1 arbeitet, die evtl. schon zum Setzen des aktuellen Titels
1393   *   verwendet wird
1394       LD_SAV_TITLE = SY-TITLE.
1395       FLG_PRINTING_SELPROT = TRUE.
1396       PERFORM SELEKTIONSPROTOKOLL_AUSGEBEN
1397               TABLES MS_MAILOBJECT_CONT
1398               USING  CON_OUTP_TO_PHYSICAL_DEVICE.
1399       FLG_PRINTING_SELPROT = FALSE.
1400       SKIP 2.
1401       SY-TITLE = LD_SAV_TITLE.
1402     ELSEIF LD_RETURNCODE = '2'.
1403        IF LD_MAX_LAENGE > 255.
1404           LD_MAX_LAENGE = 255.
1405        ENDIF.
1406   *   Analysebezeichnung beim Drucken ohne Selektionsprotokoll ausgeben
1407       ASSIGN LD_HLP_TEXT(LD_MAX_LAENGE) TO <LD_HLP_TEXT>.
1408       WRITE ANALYSE_TEXT CENTERED TO <LD_HLP_TEXT>.
1409       WRITE: / <LD_HLP_TEXT> COLOR COL_BACKGROUND INTENSIFIED.
1410       SKIP.
1411     ENDIF.
1412
1413   * Ausgabe des entsprechenden Seitenkopfes
1414     IF LD_RETURNCODE = '1' OR LD_RETURNCODE = '2'.
1415   *   Seitenkopf immer ausgeben (mit oder ohne Selektprotokoll)
1416       CASE LD_FCODE.
1417         WHEN 'PRNW'.
1418           IF FLG_VERGLEICH <> FALSE.
1419   *         Vergleich drucken
1420             PERFORM SEITENKOPF_VERGLEICH_AUSGEBEN.
1421           ELSEIF FLG_ZEITREIHE = TRUE.
1422   *         Zeitreihe drucken
1423   **         Hier darf nicht der komplette Seitenkopf ausgegeben, sondern
1424   **         nur Aufriß und Kennzahl nicht die Spaltenüberschriften, da
1425   **         die Spalten immer auf einer neuen Seite beginnen.
1426   *         perform seitenkopf_zeitreihe_ausgeben
1427   *                 in program (lis_progname) if found.
1428           ELSE.
1429   *         'Alle Kennzahlen' drucken
1430             PERFORM SEITENKOPF_KGES_AUSGEBEN.
1431           ENDIF.
1432         WHEN 'PRSP'.
1433   *       Selektionsprotokoll direkt aus dem Dialogfenster drucken
1434   *       => kein Seitenkopf
1435         WHEN OTHERS.
1436   *       Kennzahlliste (Grund-, Aufriß- oder Rangliste)
1437           PERFORM SEITENKOPF_AUSGEBEN TABLES AKT_DRILLDOWN
1438                                              AKT_KENNZAHLEN.
1439       ENDCASE.
1440     ENDIF.
1441
1442   * Liste ausgeben
1443     CASE LD_AUSGABEROUTINE.
1444       WHEN 'ALLE_KENNZAHLEN_AUSGEBEN'.
1445         PERFORM ALLE_KENNZAHLEN_AUSGEBEN IN PROGRAM (LIS_PROGNAME)
1446           USING FALSE.
1447       WHEN 'PLANTAB_AUSGEBEN'.
1448         PERFORM PLANTAB_AUSGEBEN IN PROGRAM (LIS_PROGNAME)
1449           USING FALSE.
1450       WHEN OTHERS.
1451         IF NOT LD_AUSGABEROUTINE IS INITIAL.
1452           PERFORM (LD_AUSGABEROUTINE) IN PROGRAM (LIS_PROGNAME) IF FOUND.
1453         ENDIF.
1454     ENDCASE.
1455     IF LD_FCODE = 'PRNT'.
1456   *   Liste drucken (Projektsystem)
1457       PERFORM SPEZIAL_LISTE_DRUCKEN IN PROGRAM (LIS_PROGNAME) IF FOUND.
1458       LD_MAX_LAENGE = STRICH_LAENGE.
1459     ENDIF.
1460     NEW-PAGE PRINT OFF.
1461     FLG_DRUCKEN = FALSE.
1462   * "Spool-Auftrag (Nummer &) erstellt"
1463     if ld_params-primm is initial.
1464       message s355(sy) with sy-spono.
1465     else.
1466       message s374(sy) with sy-spono sy-pdest.
1467     endif.
1468   ENDFORM.                               "LISTE_DRUCKEN
