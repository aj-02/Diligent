322      IF FLG_OBJEKTTEXT = CON_OBJEKTTEXT_TEXT OR
323         FLG_OBJEKTTEXT = CON_OBJEKTTEXT_NR_TEXT.
324    * akt_drilldown aus Puffer füllen
