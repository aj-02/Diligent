861    *---------------------------------------------------------------------*
862    *       FORM SPALTENBREITE_AENDERN                                    *
863    *---------------------------------------------------------------------*
864    *       ........                                                      *
865    *---------------------------------------------------------------------*
866    *  -->  SA_WAHL: welche Spaltenbreite(n) geändert werden soll(en)     *
867    *---------------------------------------------------------------------*
868    FORM SPALTENBREITE_AENDERN USING SA_WAHL TYPE I.
869
870      DATA: SA_RETURNCODE(1) TYPE C,
871            SA_INTEGER       TYPE I,
872            SA_KENNZ_INDEX   TYPE I,
873            SA_KENNZ_TEXT1   LIKE AKT_KENNZAHLEN-SCRTEXT_L,
874            SA_KENNZ_TEXT2   LIKE AKT_KENNZAHLEN-SCRTEXT_L,
875            SA_KENNZ_TEXT3   LIKE AKT_KENNZAHLEN-SCRTEXT_L,
876            SA_KENNZ_TEXT4   LIKE AKT_KENNZAHLEN-SCRTEXT_L.
877
878      PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
879
880      REFRESH POPUP_FIELDS.
881      CLEAR POPUP_FIELDS.
882      SAV_WAHL = SA_WAHL.
883      CASE SA_WAHL.
884        WHEN CON_MERKMAL.
885    *     Spaltenbreite des Merkmals ändern
886          POPUP_FIELDS-VALUE = SPALTEN_ANFANG - MERKMALS_ANFANG.
887          SPALTENBREITE_MIN  = CON_MERKMAL_SPALTENBREITE_MIN.
888          SPALTENBREITE_MAX  = CON_MERKMAL_SPALTENBREITE_MAX.
889          IF LIS_PROGNAME(3) = 'RCN'.      "Projektinformationssystem
890            POPUP_FIELDS-FIELDNAME  = 'WRT_OBJ'.
891          ELSE.                            "sonst
892            POPUP_FIELDS-FIELDNAME  = 'MMSPB'.
893          ENDIF.
894        WHEN CON_SPALTE.
895    *     eine beliebige Spaltenbreite ändern
896          PERFORM KENNZAHLSPALTE_BESTIMMEN USING TRUE.
897          IF KENNZAHL_SPALTE-FIELDNAME IS INITIAL.
898    *       Spaltenbreite des Merkmals ändern
899            POPUP_FIELDS-VALUE = SPALTEN_ANFANG - MERKMALS_ANFANG.
900            SPALTENBREITE_MIN = CON_MERKMAL_SPALTENBREITE_MIN.
901            SPALTENBREITE_MAX = CON_MERKMAL_SPALTENBREITE_MAX.
902            IF LIS_PROGNAME(3) = 'RCN'.    "Projektinformationssystem
903              POPUP_FIELDS-FIELDNAME  = 'WRT_OBJ'.
904            ELSE.                          "sonst
905              POPUP_FIELDS-FIELDNAME  = 'MMSPB'.
906            ENDIF.
907          ELSE.
908    *       Spaltenbreite einer Kennzahl ändern
909            SA_INTEGER            = KENNZAHL_SPALTE-OUTPUTLEN.
910            POPUP_FIELDS-VALUE = SA_INTEGER.
911            SPALTENBREITE_MIN  = CON_KENNZAHL_SPALTENBREITE_MIN.
912            SPALTENBREITE_MAX  = CON_KENNZAHL_SPALTENBREITE_MAX.
913            IF LIS_PROGNAME(3) = 'RCN'.    "Projektinformationssystem
914              POPUP_FIELDS-FIELDNAME  = 'WRT_FLD'.
915            ELSE.                          "sonst
916              POPUP_FIELDS-FIELDNAME  = 'KZSPB'.
917            ENDIF.
918          ENDIF.
919        WHEN CON_KENNZAHLEN.
920    *     Spaltenbreite aller Kennzahlen ändern
921          IF FLG_ZEITREIHE <> FALSE.
922    *       im Zeitreihenpopup
923            POPUP_FIELDS-VALUE = ZEITREIHEN_KENNZAHL_BREITE.
924          ELSE.
925            POPUP_FIELDS-VALUE = SPALTEN_BREITE.
926          ENDIF.
927          SPALTENBREITE_MIN  = CON_KENNZAHL_SPALTENBREITE_MIN.
928          SPALTENBREITE_MAX  = CON_KENNZAHL_SPALTENBREITE_MAX.
929          IF LIS_PROGNAME(3) = 'RCN'.      "Projektinformationssystem
930    *       Projektinformationssystem
931            POPUP_FIELDS-FIELDNAME  = 'WRT_FLD'.
932          ELSE.
933    *       sonstiges Reporting
934            POPUP_FIELDS-FIELDNAME  = 'KZSPB'.
935          ENDIF.
936      ENDCASE.
937
938      IF LIS_PROGNAME(3) = 'RCN'.          "Projektinformationssystem
939        POPUP_FIELDS-TABNAME    = 'TCND'.
940      ELSE.                                "sonst
941        POPUP_FIELDS-TABNAME    = 'RMCS0'.
942      ENDIF.
943      CONDENSE POPUP_FIELDS-VALUE NO-GAPS.
944      IF FLG_LIS_REPORTING = TRUE.
945        POPUP_FIELDS-FIELD_OBL  = TRUE.
946      ENDIF.
947      POPUP_FIELDS-NOVALUEHLP = TRUE.
948      APPEND POPUP_FIELDS.
949      IF FLG_LIS_REPORTING = FALSE.
950    *   Kennzeichen für Originalspaltenbreite nicht bei LIS-Reporting
951        CLEAR POPUP_FIELDS.
952        POPUP_FIELDS-TABNAME    = 'TCND'.
953        POPUP_FIELDS-FIELDNAME  = 'FLG_ORG'.
954        APPEND POPUP_FIELDS.
955      ENDIF.
956
957      CASE SA_WAHL.
958        WHEN CON_MERKMAL.
959          PERFORM TEXT_ERMITTELN USING    004
960    *                           'Spaltenbreite - Merkmal'
961                                 CHANGING HLP_TEXT1.
962        WHEN OTHERS.
963          PERFORM TEXT_ERMITTELN USING    003
964    *                           'Spaltenbreite - Kennzahlen'
965                                CHANGING HLP_TEXT1.
966      ENDCASE.
967      CALL FUNCTION 'POPUP_GET_VALUES_USER_CHECKED'
968           EXPORTING
969                POPUP_TITLE  = HLP_TEXT1
970                PROGRAMNAME  = LIS_PROGNAME
971                FORMNAME     = 'SPALTENBREITE_PRUEFEN'
972                START_COLUMN = 28
973           IMPORTING
974                RETURNCODE   = SA_RETURNCODE
975           TABLES
976                FIELDS       = POPUP_FIELDS.
977
978    * hat Anwender die Eingabe abgebrochen ?
979      CHECK SA_RETURNCODE <> 'A'.
980
981      IF FLG_ZEITREIHE <> FALSE.
982    *   PopUp Zeitreihendarstellung ausgeben und EXIT!
983        IF KENNZAHL_SPALTE-OUTPUTLEN < ZEITREIHEN_KENNZAHL_BREITE.
984    *     'Spaltenbreite wurde an Ausgabelänge angepaßt'
985          MESSAGE I049 WITH KENNZAHL_SPALTE-SCRTEXT_L FALSE FALSE FALSE.
986          ZEITREIHEN_KENNZAHL_BREITE = KENNZAHL_SPALTE-OUTPUTLEN.
987        ENDIF.
988        PERFORM ZEITREIHE_AUSGEBEN_VORBEREITEN IN PROGRAM (LIS_PROGNAME)
989                IF FOUND USING TRUE.
990        PERFORM ZEITREIHE_AUSGEBEN IN PROGRAM (LIS_PROGNAME) IF FOUND
991                USING ZEITREIHEN_ERSTE_SPALTE
992                      ZEITREIHEN_ANZ_SPALTEN.
993        EXIT.
994      ENDIF.
995
996      IF SA_WAHL = CON_KENNZAHLEN.
997    *   Spaltenbreite aller Kennzahlen ändern
998        LOOP AT AKT_KENNZAHLEN.
999          IF AKT_KENNZAHLEN-OUTPUTLEN < SPALTEN_BREITE.
1000   *        keine sichtbare Änderung der Spaltenbreite
1001           CASE SA_KENNZ_INDEX.
1002             WHEN 0.
1003               SA_KENNZ_TEXT1 = AKT_KENNZAHLEN-SCRTEXT_L.
1004             WHEN 1.
1005               SA_KENNZ_TEXT2 = AKT_KENNZAHLEN-SCRTEXT_L.
1006             WHEN 2.
1007               SA_KENNZ_TEXT3 = AKT_KENNZAHLEN-SCRTEXT_L.
1008             WHEN 3.
1009               SA_KENNZ_TEXT4 = AKT_KENNZAHLEN-SCRTEXT_L.
1010           ENDCASE.
1011           ADD 1 TO SA_KENNZ_INDEX.
1012         ENDIF.
1013       ENDLOOP.
1014       IF NOT SA_KENNZ_TEXT1 IS INITIAL.
1015   *     'Spaltenbreite wurde an Ausgabelänge angepaßt'
1016         MESSAGE I049 WITH SA_KENNZ_TEXT1 SA_KENNZ_TEXT2 SA_KENNZ_TEXT3
1017                           SA_KENNZ_TEXT4.
1018       ENDIF.
1019     ENDIF.
1020
1021     PERFORM AUSTAB_TEXT_ZUWEISEN.
1022
1023   * Aktuelle Liste durch Liste mit geänderter Spaltenbreite ersetzen
1024     PERFORM LISTE_ERSETZEN USING TRUE TRUE.
1025
1026   ENDFORM.                               "SPALTENBREITE_AENDERN
