482    *---------------------------------------------------------------------*
483    *       Füllen der Summenzeile SUM_S000                               *
484    *---------------------------------------------------------------------*
485    FORM add_hlp_summe_auf_sum_s000.
486
487      ADD hlp_summe-mzubb TO sum_s000-mzubb.
488      ADD hlp_summe-wzubb TO sum_s000-wzubb.
489      ADD hlp_summe-azubb TO sum_s000-azubb.
490      ADD hlp_summe-mzukb TO sum_s000-mzukb.
491      ADD hlp_summe-azukb TO sum_s000-azukb.
492      ADD hlp_summe-magbb TO sum_s000-magbb.
493      ADD hlp_summe-wagbb TO sum_s000-wagbb.
494      ADD hlp_summe-aagbb TO sum_s000-aagbb.
495      ADD hlp_summe-magkb TO sum_s000-magkb.
496      ADD hlp_summe-aagkb TO sum_s000-aagkb.
497      ADD hlp_summe-ambwg TO sum_s000-ambwg.
498      ADD hlp_summe-mgvbr TO sum_s000-mgvbr.
499      ADD hlp_summe-wgvbr TO sum_s000-wgvbr.
500      ADD hlp_summe-agvbr TO sum_s000-agvbr.
501      ADD hlp_summe-muvbr TO sum_s000-muvbr.
502      ADD hlp_summe-wuvbr TO sum_s000-wuvbr.
503      ADD hlp_summe-auvbr TO sum_s000-auvbr.
504      ADD hlp_summe-astor TO sum_s000-astor.
505      ADD hlp_summe-bbnull TO sum_s000-bbnull.
506      ADD hlp_summe-kbnull TO sum_s000-kbnull.
507      ADD hlp_summe-gbnull TO sum_s000-gbnull.
508
509    * Gesamtbestand ermitteln, damit Durchschnittsbestand geb. werden kann
510    * Notwendig für Berechnung Kennzahl: Umschlagshäufigkeit
511      ADD hlp_summe-s_mbwbest TO sum_s000-s_mbwbest.
512      ADD hlp_summe-s_mkobest TO sum_s000-s_mkobest.
513      ADD hlp_summe-s_gsbest TO sum_s000-s_gsbest.
514      ADD hlp_summe-s_wbwbest TO sum_s000-s_wbwbest.
515
516    * Währungs- und Mengeneinheiten können nicht addiert werden
517
518    *     Währung der Summe setzen
519      IF sum_s000-xhwaer IS INITIAL.
520        sum_s000-xhwaer = hlp_summe-hwaer.
521      ELSEIF sum_s000-xhwaer <> hlp_summe-hwaer.
522        PERFORM sumeinheit_bestimmen USING    hlp_summe-hwaer
523                                     CHANGING sum_s000-xhwaer.
524      ENDIF.
525
526    *     Mengeneinheit der Summe setzen
527      IF sum_s000-xbasme IS INITIAL.
528        sum_s000-xbasme = hlp_summe-basme.
529      ELSEIF  sum_s000-xbasme <> hlp_summe-basme.
530        sum_s000-xbasme = con_einheit_ungueltig.
531      ENDIF.
532
533      IF akt_drilldown-fcode NE con_fcode_aper.
534    * Bestände können problemlos addiert werden.
535        sum_s000-mbwbest = sum_s000-mbwbest + hlp_summe-mbwbest.
536        sum_s000-mkobest = sum_s000-mkobest + hlp_summe-mkobest.
537        sum_s000-wbwbest = sum_s000-wbwbest + hlp_summe-wbwbest.
538        sum_s000-beszug  = sum_s000-beszug  + hlp_summe-beszug.
539        sum_s000-wbeszug = sum_s000-wbeszug + hlp_summe-wbeszug.
540        sum_s000-eisbe   = sum_s000-eisbe   + hlp_summe-eisbe.
541      ELSE.
542    *Es kann nur der aktuelle Bestand in die Summenzeile geschrieben werden
543        CASE sav_speri.
544          WHEN con_speri_sptag.
545            IF hlp_summe-xobjekt = akt_tag.
546              sum_s000-mbwbest = sum_s000-mbwbest + hlp_summe-mbwbest.
547              sum_s000-mkobest = sum_s000-mkobest + hlp_summe-mkobest.
548              sum_s000-wbwbest = sum_s000-wbwbest + hlp_summe-wbwbest.
549              sum_s000-beszug  = sum_s000-beszug  + hlp_summe-beszug.
550              sum_s000-wbeszug = sum_s000-wbeszug + hlp_summe-wbeszug.
551              sum_s000-eisbe   = sum_s000-eisbe   + hlp_summe-eisbe.
552            ENDIF.
553          WHEN con_speri_spwoc.
554            IF hlp_summe-xobjekt = akt_woc.
555              sum_s000-mbwbest = sum_s000-mbwbest + hlp_summe-mbwbest.
556              sum_s000-mkobest = sum_s000-mkobest + hlp_summe-mkobest.
557              sum_s000-wbwbest = sum_s000-wbwbest + hlp_summe-wbwbest.
558              sum_s000-beszug  = sum_s000-beszug  + hlp_summe-beszug.
559              sum_s000-wbeszug = sum_s000-wbeszug + hlp_summe-wbeszug.
560              sum_s000-eisbe   = sum_s000-eisbe   + hlp_summe-eisbe.
561            ENDIF.
562          WHEN con_speri_spmon.
563            IF hlp_summe-xobjekt = akt_mon.
564              sum_s000-mbwbest = sum_s000-mbwbest + hlp_summe-mbwbest.
565              sum_s000-mkobest = sum_s000-mkobest + hlp_summe-mkobest.
566              sum_s000-wbwbest = sum_s000-wbwbest + hlp_summe-wbwbest.
567              sum_s000-beszug  = sum_s000-beszug  + hlp_summe-beszug.
568              sum_s000-wbeszug = sum_s000-wbeszug + hlp_summe-wbeszug.
569              sum_s000-eisbe   = sum_s000-eisbe   + hlp_summe-eisbe.
570            ENDIF.
571          WHEN con_speri_spbup.
572            IF hlp_summe-xobjekt = akt_bup.
573              sum_s000-mbwbest = sum_s000-mbwbest + hlp_summe-mbwbest.
574              sum_s000-mkobest = sum_s000-mkobest + hlp_summe-mkobest.
575              sum_s000-wbwbest = sum_s000-wbwbest + hlp_summe-wbwbest.
576              sum_s000-beszug  = sum_s000-beszug  + hlp_summe-beszug.
577              sum_s000-wbeszug = sum_s000-wbeszug + hlp_summe-wbeszug.
578              sum_s000-eisbe   = sum_s000-eisbe   + hlp_summe-eisbe.
579            ENDIF.
580        ENDCASE.
581      ENDIF.
582
583    ENDFORM.                               "add_hlp_summe_auf_sum_s000
