235                      fieldname = akt_kennzahlen-fieldname.
236        IF sy-subrc EQ 0.                  "if found, then
237          num_key_figures-not_visible = false.    "key-figure is visible
238          MODIFY num_key_figures INDEX sy-tabix.
239        ENDIF.
240      ENDLOOP.
241
242    * Now, build information for list header. Here, this is the current
243    * drilldown status.
244      REFRESH dd_info. CLEAR dd_info.
245      DESCRIBE TABLE akt_drilldown LINES line.
246      line = line - 1.        "Do not consider last characteristic in drilld
247      IF line GT 0.
248        pos = 1.
249        LOOP AT akt_drilldown TO line.   "For all characteristics in drilld.
250          string = akt_drilldown-scrtext_l."Name of characteristics
251    *     Get value for characteristic.
252          PERFORM objekttext_ermitteln USING  akt_drilldown-domname
253                                            akt_drilldown-rollname
254                                            akt_drilldown-convexit
255                                            akt_drilldown-outputlen
256                                            akt_drilldown-objekt
257                                   CHANGING string1.
258          CONCATENATE string '=' string1 INTO string SEPARATED BY blank.
259          dd_info-text+pos = string.
260          IF pos EQ 1.
261    ***KK46C
262            pos = 60.
263    ***
264          ELSE.
265            pos = 1. APPEND dd_info.
266          ENDIF.
267        ENDLOOP.
268    ***KK46C
269        IF pos EQ 60.
270          APPEND dd_info.
271        ENDIF.                             "final append if necessary.
272    ***
273      ENDIF.
274
275    * Check whether cursor is positioned on key-figure column and determine
276    * the key-figure if so.
277      PERFORM check_kf_column  CHANGING  kf_object.
278
279    * Determine the DDIC fields of row and column object.
280      READ TABLE drilldown_fcodes WITH KEY ddicfeld = row_object.
281      row_field = drilldown_fcodes-tabfeld.
282      READ TABLE drilldown_fcodes WITH KEY ddicfeld = col_object.
283      col_field = drilldown_fcodes-tabfeld.
284
285    * Display list and graphics.
286      CALL FUNCTION 'LIST_ARRAY_STACK'
287           EXPORTING
288                row_title        = row_title
289                col_title        = col_title
290                row_ddic_field   = row_field
291                col_ddic_field   = col_field
292                first_key_figure = kf_object
293           TABLES
294                array_stack      = array_stack
295                row_values       = row_labels
296                col_values       = col_labels
297                row_labels       = row_labels_visible
298                col_labels       = col_labels_visible
299                key_figures      = num_key_figures
300                row_sum          = row_sum
301                col_sum          = col_sum
302                subtitles        = dd_info.
303
304
305    ENDFORM.                               " KEY_FIGURE_MATRIX
