1274                                'I'   TO dd_gsber-sign,
1275                                'EQ'  TO dd_gsber-option.
1276           APPEND dd_gsber.
1277
1278         WHEN con_fcode_awgp.
1279           MOVE: akt_drilldown-objekt TO dd_matkl-low,
1280                                'I'   TO dd_matkl-sign,
1281                                'EQ'  TO dd_matkl-option.
1282           APPEND dd_matkl.
1283
1284         WHEN con_fcode_amta.
1285           MOVE: akt_drilldown-objekt TO dd_mtart-low,
1286                                'I'   TO dd_mtart-sign,
1287                                'EQ'  TO dd_mtart-option.
1288           APPEND dd_mtart.
1289
1290         WHEN con_fcode_aspa.
1291           MOVE: akt_drilldown-objekt TO dd_spart-low,
1292                                'I'   TO dd_spart-sign,
1293                                'EQ'  TO dd_spart-option.
1294           APPEND dd_spart.
1295
1296         WHEN con_fcode_admm.
1297           MOVE: akt_drilldown-objekt TO dd_dismm-low,
1298                                'I'   TO dd_dismm-sign,
1299                                'EQ'  TO dd_dismm-option.
1300           APPEND dd_dismm.
1301
