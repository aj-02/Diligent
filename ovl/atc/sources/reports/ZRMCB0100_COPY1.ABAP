292    *---------------------------------------------------------------------*
293    *       FORM ALLE_KENNZAHLEN_AUSGEBEN                                 *
294    *---------------------------------------------------------------------*
295    *       Alle Kennzahlen zum selektierten Objekt werden ausgegeben     *
296    *---------------------------------------------------------------------*
297    * --> AA_FLG_POPUP: Aufruf vom Kennzahlenfenster                      *
298    *                   = TRUE:  Aufruf von Kennzahlenfenster             *
299    *                   = FALSE: Aufruf von Grund- oder Aufrißliste       *
300    *---------------------------------------------------------------------*
301    FORM ALLE_KENNZAHLEN_AUSGEBEN USING AA_FLG_POPUP TYPE BOOLEAN.
302      DATA: AA_MAX_OUTPUTLEN LIKE SY-CUCOL,
303            AA_MAX_REFLEN    LIKE SY-CUCOL,
304            AA_POPUP_LENGTH  LIKE SY-CUROW,
305            AA_START_COL     LIKE SY-CUCOL,
306            AA_START_ROW     LIKE SY-CUROW,
307            AA_END_COL       LIKE SY-CUCOL,
308            AA_END_ROW       LIKE SY-CUROW,
309            AA_FLG_KEIN_STANDARD   TYPE BOOLEAN VALUE FALSE,  "187336,v.14
310            AA_SEITENNUMMER  LIKE SY-CPAGE.
311
312      STATICS: AA_POPUP_WIDTH   LIKE SY-CUCOL.
313
314      PERFORM SPEZIAL_ALLE_KENNZ_AUSG IN PROGRAM (LIS_PROGNAME) IF FOUND
315                                   using    AA_FLG_POPUP
316                                   changing aa_flg_kein_standard.
317      CHECK AA_FLG_KEIN_STANDARD EQ FALSE.
318
319      IF AA_FLG_POPUP = TRUE.
320    *   Aufruf vom Kennzahlenfenster => notwendige Variablen setzen
321        DARSTELLUNGSART = CON_DARST_EINZEL."???
322        SAV_FCODE       = 'KGES'.
323        SY-LSIND        = SY-LSIND - 1.
324      ELSE.
325    *   Aufruf von Grund- oder Aufrißliste
326        IF DARSTELLUNGSART <> CON_DARST_EINZEL AND
327           DARSTELLUNGSART <> CON_DARST_SUMME.
328    *     Alle Kennzahlen nur auf Merkmals- oder Summenzeile
329    *     "Funktion 'Alle Kennzahlen' nur auf Wertzeile möglich"
330          MESSAGE I091.
331          EXIT.
332        ENDIF.
333        PERFORM AKT_DRILLDOWN_AKTUALISIEREN.
334        PERFORM AUSTAB_AKTUALISIEREN.
335
336    *   Richtige Summenzeile zur aktuellen Gruppe ermitteln
337        IF FLG_HEADER_PATH    = TRUE AND
338           FLG_SUMTAB_TABELLE = TRUE.
339    *     Seitennummer aus HIDE-Bereich des Seitenkopfes lesen und
340    *     Summenzeile setzen
341          PERFORM SEITENNUMMER_ERMITTELN IN PROGRAM (LIS_PROGNAME) IF FOUND
342                                         CHANGING AA_SEITENNUMMER.
343          READ TABLE SUM_S000 WITH KEY ('ID') = SEITENNUMMER.
344        ENDIF.
345
346        IF FLG_DRUCKEN = FALSE.
347    *     Bildschirmausgabe
348
349    *     Höhe des Fensters ermitteln
350          DESCRIBE TABLE KENNZAHLEN_TAB LINES AA_POPUP_LENGTH.
351          AA_POPUP_LENGTH = AA_POPUP_LENGTH + 3 + 2 + DRILLDOWN_EINTRAEGE.
352          IF DARSTELLUNGSART = CON_DARST_SUMME.
353            SUBTRACT 1 FROM AA_POPUP_LENGTH.
354          ENDIF.
355          IF AA_POPUP_LENGTH > SY-SROWS.
356            AA_POPUP_LENGTH = SY-SROWS.
357          ENDIF.
358    *     Höhe wird wegen unterschiedlicher Metrik Liste/Dynpro reduziert
359          AA_POPUP_LENGTH = ( AA_POPUP_LENGTH - 3 ) * '0.8'.
360
361    *     Breite des Fensters ermitteln
362          LOOP AT KENNZAHLEN_TAB.
363            IF AA_MAX_OUTPUTLEN < KENNZAHLEN_TAB-OUTPUTLEN.
364              AA_MAX_OUTPUTLEN = KENNZAHLEN_TAB-OUTPUTLEN.
365            ENDIF.
366            IF AA_MAX_REFLEN < KENNZAHLEN_TAB-REFLEN.
367              AA_MAX_REFLEN = KENNZAHLEN_TAB-REFLEN.
368            ENDIF.
369          ENDLOOP.
370          AA_POPUP_WIDTH = AA_MAX_OUTPUTLEN + AA_MAX_REFLEN + 22.
371
372    *     Startpunkte des Fensters ermitteln
373          AA_START_COL = ( SY-SCOLS - AA_POPUP_WIDTH ) DIV 2.
374          IF AA_START_COL < 1.
375            AA_START_COL = 1.
376          ENDIF.
377          AA_START_ROW  = ( SY-SROWS - AA_POPUP_LENGTH ) DIV 2.
