8216         ENDCASE.
8217   *Sichern der Bewegungen zur Bestandsrückrechnung
8218         mzubb = int_s031-mzubb.
8219         magbb = int_s031-magbb.
8220         mzukb = int_s031-mzukb.
8221         magkb = int_s031-magkb.
8222   *Bewerteter Bestand
8223         bw_bestand_neu   = bw_bestand_neu - mzubb  + magbb.
8224   *Konsignationsbestand
8225         ko_bestand_neu   = ko_bestand_neu - mzukb + magkb.
8226   *Gesamtbestand der aktuellen gelesenen Periode in der Periotab
8227         gesamtbestand = bw_bestand_neu + ko_bestand_neu.
8228   *       Periode und Jahr
8229         READ TABLE int_s031 WITH KEY feldleiste BINARY SEARCH.
8230         IF sy-subrc <> 0.
8231           CLEAR int_s031.
8232           IF ( gesamtbestand  <> 0
8233                OR NOT  int_s032-letztbew  IS INITIAL
8234                OR NOT  int_s032-letztver  IS INITIAL
