1945   *---------------------------------------------------------------------*
1946   *       FORM STD_DRILLDOWN_LESEN                                      *
1947   *---------------------------------------------------------------------*
1948   *       Voreingestellten Drill-Down für den Benutzer SY-UNAME in Ab-  *
1949   *       hängigkeit der Applikation und Analyse ermitteln              *
1950   *---------------------------------------------------------------------*
1951   FORM STD_DRILLDOWN_LESEN.
1952
1953   *            Dummy-Feldname für Periodenaufriß
1954     CONSTANTS: SL_CON_FELD_PERIO LIKE DFIES-FIELDNAME VALUE 'PERIO'.
1955   * Tabelle um ins Memory geschriebenen Drilldown zu holen
1956     DATA: BEGIN OF SL_DDOWN_MEMORY OCCURS 20.
1957             INCLUDE STRUCTURE MCDDOWN.
1958     DATA: END OF SL_DDOWN_MEMORY.
1959     DATA: SL_UNAME     LIKE SY-UNAME,
1960           SL_HLP_COUNT LIKE SY-TFILL,
1961           SL_DEL_DDOWN LIKE GLOBAL_DRILLDOWN OCCURS 0 WITH HEADER LINE.
1962
1963     REFRESH STD_DRILLDOWN.
1964     CLEAR   STD_DRILLDOWN.
1965
1966   * Globale Drilldown-Info aus dem Memory lesen
1967     IMPORT GLOBAL_DRILLDOWN FROM MEMORY ID 'GLOBAL_DRILLDOWN'.
1968     EXPORT GLOBAL_DRILLDOWN FROM SL_DEL_DDOWN
1969       TO MEMORY ID 'GLOBAL_DRILLDOWN'.
1970   * Position der Statuszeile anpassen
1971     DESCRIBE TABLE GLOBAL_DRILLDOWN LINES SY-TFILL.
1972     SL_HLP_COUNT = SY-TFILL DIV 2.
1973     SL_HLP_COUNT = SL_HLP_COUNT + SY-TFILL MOD 2.
1974     POSITION_STATUSZEILE = POSITION_STATUSZEILE + SL_HLP_COUNT.
1975
1976   * Über das Memory mitgegebenen Standarddrilldown lesen und vor den
1977   * eigentlichen Drilldown stellen
1978     IMPORT MCDDOWN TO SL_DDOWN_MEMORY FROM MEMORY ID 'MC_DDOWN'.
1979     READ TABLE SL_DDOWN_MEMORY INDEX 1.
1980     IF SY-SUBRC = 0.
1981       LOOP AT SL_DDOWN_MEMORY.
1982         PERFORM STD_DRILLDOWN_ABMISCHEN USING SL_DDOWN_MEMORY-DDICFELD
1983                                               SL_DDOWN_MEMORY-ROLLNAME
1984                                               SL_DDOWN_MEMORY-DOMNAME
1985                                      CHANGING STD_DRILLDOWN-FIELDNAME
1986                                               STD_DRILLDOWN-FCODE.
1987         CHECK NOT STD_DRILLDOWN-FCODE IS INITIAL.
1988         APPEND STD_DRILLDOWN.
1989       ENDLOOP.
1990     ENDIF.
1991   * Benutzerabhängige Voreinstellung lesen. Falls diese nicht vorhanden
1992   * ist, wird im 2. Schleifendurchlauf die Standardeinstellung gelesen
1993     SL_UNAME = SY-UNAME.
1994     DO 2 TIMES.
1995       SELECT        * FROM  TMC9
1996              WHERE  UNAME       = SL_UNAME
1997              AND    MCAPP       = AKT_TMC7-MCAPP
1998              AND    MCANA       = AKT_TMC7-MCANA.
1999
2000   *     Falls bereits ein Eintrag zum Feldnamen existiert (aus Memory),
2001   *     ignorieren
2002         READ TABLE STD_DRILLDOWN WITH KEY FIELDNAME = TMC9-FIELDNAME.
2003         CHECK SY-SUBRC <> 0.
2004         STD_DRILLDOWN-FIELDNAME = TMC9-FIELDNAME.
2005   *     FCODE zum Feldnamen ermitteln
2006         IF STD_DRILLDOWN-FIELDNAME = SL_CON_FELD_PERIO.
2007   *       Periodenaufriß
2008   *       Falls bereits ein Eintrag zum Feldnamen existiert (aus Memory),
2009   *       ignorieren
2010           READ TABLE STD_DRILLDOWN WITH KEY FCODE = CON_FCODE_APER.
2011           IF SY-SUBRC <> 0.
2012   *         Es gibt noch keinen Periodenaufriß
2013             STD_DRILLDOWN-FCODE = CON_FCODE_APER.
2014             APPEND STD_DRILLDOWN.
2015           ENDIF.
2016         ELSE.
2017   *       Merkmalsaufriß
2018           READ TABLE DRILLDOWN_FCODES WITH KEY
2019                                      DDICFELD = STD_DRILLDOWN-FIELDNAME.
2020           IF SY-SUBRC = 0.
2021             STD_DRILLDOWN-FCODE = DRILLDOWN_FCODES-FCODE.
2022             APPEND STD_DRILLDOWN.
2023           ENDIF.
2024         ENDIF.
2025       ENDSELECT.
2026       IF SY-SUBRC = 0.
2027   *     Benutzerabhängige Voreinstellung vorhanden
2028         EXIT.
2029       ELSE.
2030   *     Standardeinstellung lesen, da keine Benutzereinst. vorhanden ist
2031         IF SL_UNAME = SY-UNAME.
2032           SL_UNAME = CON_STD_UNAME.
2033         ELSE.
2034   *       Es existiert keine Standardeinstellung => temporär aufbauen
2035           select * from tmc1k where gstru = gstru.
2036   *        Falls bereits ein Eintrag zum Feldnamen existiert (aus Memory),
2037   *        ignorieren
2038             READ TABLE STD_DRILLDOWN WITH KEY FIELDNAME = TMC1K-STFNA.
2039             CHECK SY-SUBRC <> 0.
2040             READ TABLE DRILLDOWN_FCODES WITH KEY DDICFELD = TMC1K-STFNA.
2041             IF SY-SUBRC = 0.
2042               STD_DRILLDOWN-FIELDNAME = DRILLDOWN_FCODES-DDICFELD.
2043               STD_DRILLDOWN-FCODE     = DRILLDOWN_FCODES-FCODE.
2044               APPEND STD_DRILLDOWN.
2045             ENDIF.
2046           ENDSELECT.
2047   *       Falls bereits ein Eintrag zum FCODE existiert (aus Memory),
2048   *       ignorieren
2049           READ TABLE STD_DRILLDOWN WITH KEY FCODE = CON_FCODE_APER.
2050           CHECK SY-SUBRC <> 0.
2051   *       Periodenfeld als letztes Aufrißkriterium anhängen
2052           READ TABLE DRILLDOWN_FCODES WITH KEY FCODE = CON_FCODE_APER.
2053           IF SY-SUBRC = 0.
2054             STD_DRILLDOWN-FIELDNAME = DRILLDOWN_FCODES-DDICFELD.
2055             STD_DRILLDOWN-FCODE     = CON_FCODE_APER.
2056             APPEND STD_DRILLDOWN.
2057           ENDIF.
2058         ENDIF.
2059       ENDIF.
2060     ENDDO.
2061   ENDFORM.                               "STD_DRILLDOWN_LESEN
2062
