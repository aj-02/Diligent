892    *&---------------------------------------------------------------------*
893    *&      Form  COMBINE_SLICES
894    *&---------------------------------------------------------------------*
895    *       Combines two slices from array_stack identified by
896    *       key_figure1 and key_figure2 by the operation given in
897    *       calculation_type. The result slice is identified within
898    *       array_stack by slice_offset.
899    *       Row and column sum-entries are returned in row_sum and col_sum
900    *----------------------------------------------------------------------*
901    *FORM COMBINE_SLICES TABLES  ROW_LABELS COL_LABELS
902    *                            NUM_KEY_FIGURES STRUCTURE MCS05
903    *                            ARRAY_STACK STRUCTURE ARRAY_F
904    *                            ROW_SUM STRUCTURE ARRAY_F
905    *                            COL_SUM STRUCTURE ARRAY_F
906    *                   USING    KEY_FIGURE
907    *                            KEY_FIGURE1 KEY_FIGURE2
908    *                            CALCULATION_TYPE.
909    *
910    *  DATA: W_ARRAY1 TYPE F,
911    *        W_ARRAY2 TYPE F.
912    *
913    *  DATA: KEY_FIGURE_INDEX LIKE SY-TABIX,
914    *        SLICE_INDEX  LIKE SY-TABIX,
915    *        SLICE1_INDEX LIKE SY-TABIX,
916    *        SLICE2_INDEX LIKE SY-TABIX,
917    *        SLICE_OFFSET LIKE SY-TABIX,
918    *        SLICE_LENGTH LIKE SY-TABIX,
919    *        NO_OF_COLS   LIKE SY-TABIX,
920    *        NO_OF_ROWS   LIKE SY-TABIX,
921    *        SLICE1_OFFSET LIKE SY-TABIX,
922    *        SLICE2_OFFSET LIKE SY-TABIX,
923    *        COL_INDEX LIKE SY-TABIX,
924    *        ROW_INDEX LIKE SY-TABIX,
925    *        TOTAL_ROW_INDEX LIKE SY-TABIX,
926    *        TOTAL_COL_INDEX LIKE SY-TABIX,
927    *        SUM_OFFSET1 LIKE SY-TABIX,
928    *        SUM_OFFSET2 LIKE SY-TABIX,
929    *        SUM_OFFSET3 LIKE SY-TABIX,
930    *        TOTAL1 LIKE MCS05-TOTAL_SUM,
931    *        TOTAL2 LIKE MCS05-TOTAL_SUM,
932    *        FIRST TYPE F, SECOND TYPE F, RESULT TYPE F,
933    *        CTYPE(40).
934    *
935    *  CTYPE = CALCULATION_TYPE.
936    *  TRANSLATE CTYPE TO UPPER CASE.
937    *
938    *  DESCRIBE TABLE ROW_LABELS LINES NO_OF_ROWS.
939    *  DESCRIBE TABLE COL_LABELS LINES NO_OF_COLS.
940    *  SLICE_LENGTH = NO_OF_COLS * NO_OF_ROWS.    "Length of one stack slice
941    *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE.
942    *  SLICE_OFFSET = ( SY-TABIX - 1 ) * SLICE_LENGTH.
943    *  KEY_FIGURE_INDEX = SY-TABIX.
944    *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE1.
945    *  SLICE1_OFFSET = ( SY-TABIX - 1 ) * SLICE_LENGTH.
946    *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE2.
947    *  SLICE2_OFFSET = ( SY-TABIX - 1 ) * SLICE_LENGTH.
948    *
949    ** loop at result slice.
950    *  ROW_INDEX = 0.
951    *  LOOP AT ROW_LABELS.
952    *    ADD 1 TO ROW_INDEX.
953    *    COL_INDEX = 0.
954    *    LOOP AT COL_LABELS.
955    *      ADD 1 TO COL_INDEX .
956    *      SLICE_INDEX  = SLICE_OFFSET +
957    *                     COL_INDEX + ( ROW_INDEX - 1 ) * NO_OF_COLS.
958    *      SLICE1_INDEX = SLICE1_OFFSET +
959    *                     COL_INDEX + ( ROW_INDEX - 1 ) * NO_OF_COLS.
960    *      SLICE2_INDEX = SLICE2_OFFSET +
961    *                     COL_INDEX + ( ROW_INDEX - 1 ) * NO_OF_COLS.
962    *      READ TABLE ARRAY_STACK INDEX SLICE1_INDEX.
963    *      W_ARRAY1 = ARRAY_STACK-F.
964    *      READ TABLE ARRAY_STACK INDEX SLICE2_INDEX.
965    *      W_ARRAY2 = ARRAY_STACK-F.
966    *      CASE CTYPE.
967    *        WHEN 'DURCHSCHNITT'.
968    *          PERFORM DURCHSCHNITT_BERECHNEN USING  W_ARRAY1  W_ARRAY2
969    *                                      CHANGING  ARRAY_STACK-F.
970    *        WHEN 'POS_QUOTE'.
971    *          PERFORM POS_QUOTE_BERECHNEN USING  W_ARRAY1  W_ARRAY2
972    *                                   CHANGING  ARRAY_STACK-F.
973    *        WHEN 'PROZPRNL'.
974    *          PERFORM PROZPRNL_BERECHNEN USING  W_ARRAY1  W_ARRAY2
975    *                                  CHANGING  ARRAY_STACK-F.
976    *      ENDCASE.
977    *      MODIFY ARRAY_STACK INDEX SLICE_INDEX.
978    *    ENDLOOP.
979    *  ENDLOOP.
980    *
981    ** Determine row-sum and column-sum entries.
982    *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE1.
983    *  SUM_OFFSET1 = ( SY-TABIX - 1 ) * NO_OF_ROWS.
984    *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE2.
985    *  SUM_OFFSET2 = ( SY-TABIX - 1 ) * NO_OF_ROWS.
986    *  SUM_OFFSET3 = ( KEY_FIGURE_INDEX - 1 ) * NO_OF_ROWS.
987    *  ROW_INDEX = 0.
988    *  LOOP AT ROW_LABELS.
989    *    ADD 1 TO ROW_INDEX.
990    *    TOTAL_ROW_INDEX = SUM_OFFSET1 + ROW_INDEX.
991    *    READ TABLE ROW_SUM INDEX TOTAL_ROW_INDEX.
992    *    FIRST = ROW_SUM-F.
993    *    TOTAL_ROW_INDEX = SUM_OFFSET2 + ROW_INDEX.
994    *    READ TABLE ROW_SUM INDEX TOTAL_ROW_INDEX.
995    *    SECOND = ROW_SUM-F.
996    *      CASE CTYPE.
997    *        WHEN 'DURCHSCHNITT'.
998    *          PERFORM DURCHSCHNITT_BERECHNEN USING  FIRST  SECOND
999    *                                      CHANGING  ROW_SUM-F.
1000   *        WHEN 'POS_QUOTE'.
1001   *          PERFORM POS_QUOTE_BERECHNEN USING  FIRST  SECOND
1002   *                                   CHANGING  ROW_SUM-F.
1003   *        WHEN 'PROZPRNL'.
1004   *          PERFORM PROZPRNL_BERECHNEN USING  FIRST   SECOND
1005   *                                  CHANGING  ROW_SUM-F.
1006   *      ENDCASE.
1007   *    TOTAL_ROW_INDEX = SUM_OFFSET3 + ROW_INDEX.
1008   *    MODIFY ROW_SUM INDEX TOTAL_ROW_INDEX.
1009   *  ENDLOOP.
1010   *
1011   *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE1.
1012   *  SUM_OFFSET1 = ( SY-TABIX - 1 ) * NO_OF_COLS.
1013   *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE2.
1014   *  SUM_OFFSET2 = ( SY-TABIX - 1 ) * NO_OF_COLS.
1015   *  SUM_OFFSET3 = ( KEY_FIGURE_INDEX - 1 ) * NO_OF_COLS.
1016   *  COL_INDEX = 0.
1017   *  LOOP AT COL_LABELS.
1018   *    ADD 1 TO COL_INDEX.
1019   *    TOTAL_COL_INDEX = SUM_OFFSET1 + COL_INDEX.
1020   *    READ TABLE COL_SUM INDEX TOTAL_COL_INDEX.
1021   *    FIRST = COL_SUM-F.
1022   *    TOTAL_COL_INDEX = SUM_OFFSET2 + COL_INDEX.
1023   *    READ TABLE COL_SUM INDEX TOTAL_COL_INDEX.
1024   *    SECOND = COL_SUM-F.
1025   *      CASE CTYPE.
1026   *        WHEN 'DURCHSCHNITT'.
1027   *          PERFORM DURCHSCHNITT_BERECHNEN USING  FIRST  SECOND
1028   *                                      CHANGING  COL_SUM-F.
1029   *        WHEN 'POS_QUOTE'.
1030   *          PERFORM POS_QUOTE_BERECHNEN USING  FIRST  SECOND
1031   *                                   CHANGING  COL_SUM-F.
1032   *        WHEN 'PROZPRNL'.
1033   *          PERFORM PROZPRNL_BERECHNEN USING  FIRST   SECOND
1034   *                                  CHANGING  COL_SUM-F.
1035   *      ENDCASE.
1036   *    TOTAL_COL_INDEX = SUM_OFFSET3 + COL_INDEX.
1037   *    MODIFY COL_SUM INDEX TOTAL_COL_INDEX.
1038   *  ENDLOOP.
1039   *
1040   ** Determine the field num_key_figures-total_sum
1041   *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE1.
1042   *  TOTAL1 = NUM_KEY_FIGURES-TOTAL_SUM.
1043   *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE2.
1044   *  TOTAL2 = NUM_KEY_FIGURES-TOTAL_SUM.
1045   *  READ TABLE NUM_KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE.
1046   *  CASE CTYPE.
1047   *    WHEN 'DURCHSCHNITT'.
1048   *      PERFORM DURCHSCHNITT_BERECHNEN USING  TOTAL1  TOTAL2
1049   *                                  CHANGING NUM_KEY_FIGURES-TOTAL_SUM .
1050   *    WHEN 'POS_QUOTE'.
1051   *      PERFORM POS_QUOTE_BERECHNEN USING  TOTAL1 TOTAL2
1052   *                                  CHANGING  NUM_KEY_FIGURES-TOTAL_SUM .
1053   *    WHEN 'PROZPRNL'.
1054   *      PERFORM PROZPRNL_BERECHNEN USING  TOTAL1  TOTAL2
1055   *                                  CHANGING  NUM_KEY_FIGURES-TOTAL_SUM .
1056   *  ENDCASE.
1057   *  NUM_KEY_FIGURES-SUM_MODE = 'EXTERN'.
1058   *  MODIFY NUM_KEY_FIGURES INDEX KEY_FIGURE_INDEX
1059   *                       TRANSPORTING TOTAL_SUM SUM_MODE.
1060   *
1061   *ENDFORM.                    " COMBINE_SLICES
1062   *&---------------------------------------------------------------------*
1063   *&      Form  EXTRACT_SLICE
1064   *&---------------------------------------------------------------------*
1065   *       Extracts a slice from an array stack.
1066   *----------------------------------------------------------------------*
1067   *      -->ARRAY_STACK
1068   *      -->ARRAY       : result array
1069   *      -->ROW_LABELS  text
1070   *      -->COL_LABELS  text
1071   *      -->slice_index : number of slice to extract.
1072   *----------------------------------------------------------------------*
1073   *FORM EXTRACT_SLICE TABLES   ARRAY_STACK STRUCTURE ARRAY_F
1074   *                            ARRAY STRUCTURE ARRAY_F
1075   *                            ROW_LABELS   COL_LABELS
1076   *                   USING    SLICE_INDEX.
1077   *
1078   *  DATA: NO_OF_COLS LIKE SY-TABIX,
1079   *        NO_OF_ROWS LIKE SY-TABIX,
1080   *        SLICE_LENGTH LIKE SY-TABIX,
1081   *        SLICE_OFFSET LIKE SY-TABIX,
1082   *        COL_INDEX LIKE SY-TABIX,
1083   *        ROW_INDEX LIKE SY-TABIX,
1084   *        ARRAY_INDEX LIKE SY-TABIX,
1085   *        ARRAY_STACK_INDEX LIKE SY-TABIX.
1086   *
1087   *  DESCRIBE TABLE ROW_LABELS LINES NO_OF_ROWS.
1088   *  DESCRIBE TABLE COL_LABELS LINES NO_OF_COLS.
1089   *  SLICE_LENGTH = NO_OF_ROWS * NO_OF_COLS.
1090   *  SLICE_OFFSET = ( SLICE_INDEX - 1 ) * SLICE_LENGTH.
1091   *
1092   *  CLEAR ARRAY. REFRESH ARRAY.
1093   *  LOOP AT ROW_LABELS.
1094   *    ROW_INDEX = SY-TABIX.
1095   *    LOOP AT COL_LABELS.
1096   *      COL_INDEX = SY-TABIX.
1097   *      ARRAY_INDEX = COL_INDEX + ( ROW_INDEX - 1 ) * NO_OF_COLS.
1098   *      ARRAY_STACK_INDEX = SLICE_OFFSET + ARRAY_INDEX.
1099   *      READ TABLE ARRAY_STACK INDEX ARRAY_STACK_INDEX.
1100   *      APPEND ARRAY_STACK TO ARRAY.
1101   *    ENDLOOP.
1102   *  ENDLOOP.
1103   *
1104   *ENDFORM.                    " EXTRACT_SLICE
1105   *&---------------------------------------------------------------------*
1106   *&      Form  SET_RATIO_UNITS
1107   *&---------------------------------------------------------------------*
1108   *       Determines units for dynamical key-figures definied by ratios
1109   *----------------------------------------------------------------------*
1110   * -->KEY_FIGURES  characterics of key-figures
1111   * -->KEY_FIGURE1, KEY_FIGURE2: key-figures
1112   * -->KEY_FIGURE_INDEX : Index of dynamic key-figure in table KEY_FIGURES
1113   *----------------------------------------------------------------------*
1114   *FORM SET_RATIO_UNITS    TABLES   KEY_FIGURES STRUCTURE MCS05
1115   *                        USING    KEY_FIGURE1 KEY_FIGURE2
1116   *                                 KEY_FIGURE_INDEX.
1117   *
1118   *  DATA: UNIT1(12), UNIT2(12), COMBINED_UNIT(12).
1119   *
1120   *  READ TABLE KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE1.
1121   *  UNIT1 = KEY_FIGURES-UNIT.                     "get first unit
1122   *  READ TABLE KEY_FIGURES WITH KEY FIELDNAME = KEY_FIGURE2.
1123   *  UNIT2 = KEY_FIGURES-UNIT.                     "get second unit
1124   *  IF UNIT2 IS INITIAL.
1125   *    IF UNIT1 IS INITIAL.
1126   *        KEY_FIGURES-UNIT = ' '.
1127   *    ELSE.
1128   *        KEY_FIGURES-UNIT = UNIT1.
1129   *    ENDIF.
1130   *  ELSE.
1131   *    CONCATENATE UNIT1 '/' UNIT2 INTO KEY_FIGURES-UNIT.
1132   *  ENDIF.
1133   *  MODIFY KEY_FIGURES INDEX KEY_FIGURE_INDEX
1134   *                     TRANSPORTING UNIT.
1135   *
1136   *ENDFORM.                    " SET_RATIO_UNITS
1137
1138   *&---------------------------------------------------------------------*
1139   *&      Form  INTTAB_VERDICHTEN_2D
1140   *&---------------------------------------------------------------------*
1141   *  Aggregation of data in int_s000 for key-figure matrix
1142   *  (2D-Drilldown). 4.0C
1143   *  !This Form must be generated for each infostructure!
1144   *----------------------------------------------------------------------*
1145   *      -->ROW_LABELS  : Values of row object
1146   *      -->COL_LABELS  : Values of column object
1147   *      -->NUM_KEY_FIGURES : Control table for numerical key-figures
1148   *      -->ARRAY_STACK : Main data
1149   *      -->ROW_OBJECT  : row characteristics
1150   *      -->COL_OBJECT  : column characteristics
1151   *----------------------------------------------------------------------*
1152   *FORM INTTAB_VERDICHTEN_2D TABLES   ROW_LABELS
1153   *                                   COL_LABELS
1154   *                                   NUM_KEY_FIGURES STRUCTURE MCS05
1155   *                                   ARRAY_STACK STRUCTURE ARRAY_F
1156   *                          USING    ROW_OBJECT
1157   *                                   COL_OBJECT.
1158   *
1159   *  DATA  DATA_LINE LIKE AUS_S000.
1160   *
1161   *  DATA: STRING(30),
1162   *        ROW_INDEX LIKE SY-TABIX,
1163   *        COL_INDEX LIKE SY-TABIX,
1164   *        ARRAY_STACK_INDEX LIKE SY-TABIX,
1165   *        NO_OF_COLS TYPE I,
1166   *        NO_OF_ROWS TYPE I,
1167   *        KEY_FIGURE_INDEX LIKE SY-TABIX,
1168   *        KEY_FIGURE(20),
1169   *        SLICE_LENGTH TYPE I,        "number of elements per stack slice
1170   *        SLICE_OFFSET LIKE SY-TABIX,
1171   *        NEW_CURRENCY_VALUE LIKE S119-UMSATZ,
1172   *        OLD_WAERK LIKE INT_S000-WAERK,
1173   *        OLD_BASME LIKE INT_S000-BASME,
1174   *        OLD_VRKME LIKE INT_S000-VRKME.
1175   *
1176   *  FIELD-SYMBOLS: <S000_ROW_FIELD>, <S000_COL_FIELD>,
1177   *                 <KF_VALUE>.
1178   *
1179   *
1180   ** Assign relevant int_s000 fields.
1181   *  CONCATENATE 'int_s000-' ROW_OBJECT INTO STRING.
1182   *  ASSIGN (STRING) TO <S000_ROW_FIELD>.
1183   *  CONCATENATE 'int_s000-' COL_OBJECT INTO STRING.
1184   *  ASSIGN (STRING) TO <S000_COL_FIELD>.
1185   *
1186   *  DESCRIBE TABLE COL_LABELS LINES NO_OF_COLS.
1187   *  DESCRIBE TABLE ROW_LABELS LINES NO_OF_ROWS.
1188   *  SLICE_LENGTH = NO_OF_COLS * NO_OF_ROWS.    "Length of one stack slice
1189   *
1190   *
1191   *  CLEAR OLD_WAERK. CLEAR OLD_BASME. CLEAR OLD_VRKME.
1192   **     Get data from Int_S000:
1193   *  LOOP AT INT_S000 WHERE SPTAG  IN DD_SPTAG     AND
1194   *                         BONNR  IN DD_0001      AND
1195   *                         WERKS  IN DD_0002      AND
1196   *                         AFLAG  IN DD_0003      AND
1197   *                         KALWOC IN DD_0004      AND
1198   *                         WOCHTG IN DD_0005      AND
1199   *                         TGZTKL IN DD_0006      AND
1200   *                         VKSTD  IN DD_0007      AND
1201   *                         KUNDK  IN DD_0008      AND
1202   *                         KUNNR  IN DD_0009      AND
1203   *                         CCNUM  IN DD_0010      AND
1204   *                         UHZEIT IN DD_0011      AND
1205   *                         KMONAT IN DD_0012      AND
1206   *                       QUARTAL IN  DD_0013      AND
1207   *                         JAHR   IN DD_0014.
1208   *
1209   **   Find the corresponding indicees of the key-figure matrix   .
1210   *    LOOP AT ROW_LABELS.
1211   *      IF <S000_ROW_FIELD> EQ ROW_LABELS.
1212   *        ROW_INDEX = SY-TABIX. EXIT.
1213   *      ENDIF.
1214   *    ENDLOOP.
1215   *    LOOP AT COL_LABELS.
1216   *      IF <S000_COL_FIELD> EQ COL_LABELS.
1217   *        COL_INDEX = SY-TABIX. EXIT.
1218   *      ENDIF.
1219   *    ENDLOOP.
1220   *
1221   **   Now go through all regular numerical key-figures.
1222   *    KEY_FIGURE_INDEX = 0.
1223   *    LOOP AT NUM_KEY_FIGURES.
1224   *      ADD 1 TO KEY_FIGURE_INDEX.
1225   *     CHECK NUM_KEY_FIGURES-TABNAME NS 'Z'. "next if not regular key-fig
1226   *      SLICE_OFFSET = ( KEY_FIGURE_INDEX - 1 ) * SLICE_LENGTH.
1227   *      KEY_FIGURE = NUM_KEY_FIGURES-FIELDNAME.
1228   *      ASSIGN COMPONENT KEY_FIGURE OF STRUCTURE INT_S000 TO <KF_VALUE>.
1229   *
1230   **     First, care about units.
1231   *      IF NUM_KEY_FIGURES-REFFIELD = 'WAERK'.         "currency?
1232   *        IF NOT ANALYSE_WAEHRUNG IS INITIAL.          "
1233   *          NUM_KEY_FIGURES-UNIT = ANALYSE_WAEHRUNG.
1234   *          CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
1235   *                EXPORTING
1236   *                     DATE              =  UMRECH_DATUM
1237   *                     FOREIGN_AMOUNT    =  <KF_VALUE>
1238   *                     FOREIGN_CURRENCY  =  INT_S000-WAERK
1239   *                     LOCAL_CURRENCY    =  ANALYSE_WAEHRUNG
1240   *                     TYPE_OF_RATE      =  TYPE_OF_RATE
1241   *                IMPORTING
1242   *                     LOCAL_AMOUNT      =  NEW_CURRENCY_VALUE
1243   *                EXCEPTIONS
1244   *                     NO_RATE_FOUND     = 1
1245   *                     OVERFLOW          = 2
1246   *                     NO_FACTORS_FOUND  = 3
1247   *                     NO_SPREAD_FOUND   = 4
1248   *                     DERIVED_2_TIMES   = 5
1249   *                     OTHERS            = 6.
1250   *          <KF_VALUE> = NEW_CURRENCY_VALUE.
1251   *        ELSE.
1252   *          IF INT_S000-WAERK = OLD_WAERK OR OLD_WAERK IS INITIAL.
1253   *            NUM_KEY_FIGURES-UNIT = INT_S000-WAERK.
1254   *            OLD_WAERK = INT_S000-WAERK.
1255   *          ELSE.
1256   *            NUM_KEY_FIGURES-UNIT = '***'.           "incompatible units
1257   *            OLD_WAERK = '***'.
1258   *          ENDIF.
1259   *        ENDIF.
1260   **       Transfer last currency to correponding data_line field to
1261   **       determine units of dynamic key-figures later.
1262   *        DATA_LINE-XWAERK = NUM_KEY_FIGURES-UNIT.
1263   *      ELSEIF NUM_KEY_FIGURES-REFFIELD = 'BASME'.
1264   *        IF INT_S000-BASME = OLD_BASME OR OLD_BASME IS INITIAL.
1265   *          NUM_KEY_FIGURES-UNIT = INT_S000-BASME.
1266   *          OLD_BASME = INT_S000-BASME.
1267   *        ELSEIF NOT <KF_VALUE> IS INITIAL.         "key-figure filled?
1268   *          NUM_KEY_FIGURES-UNIT = '***'.           "incompatible units
1269   *          OLD_BASME = '***'.
1270   *        ENDIF.
1271   *        DATA_LINE-XBASME = NUM_KEY_FIGURES-UNIT.
1272   *      ELSEIF NUM_KEY_FIGURES-REFFIELD = 'VRKME'.
1273   *        IF INT_S000-VRKME = OLD_VRKME OR OLD_VRKME IS INITIAL.
1274   *          NUM_KEY_FIGURES-UNIT = INT_S000-VRKME.
1275   *          OLD_VRKME = INT_S000-VRKME.
1276   *        ELSEIF NOT <KF_VALUE> IS INITIAL.         "key-figure filled?
1277   *          NUM_KEY_FIGURES-UNIT = '***'.           "incompatible units
1278   *          OLD_VRKME = '***'.
1279   *        ENDIF.
1280   *        DATA_LINE-XVRKME = NUM_KEY_FIGURES-UNIT.
1281   *      ENDIF.
1282   *
1283   **     Add key-figure to array stack.
1284   *      ARRAY_STACK_INDEX = SLICE_OFFSET +
1285   *                          COL_INDEX + ( ROW_INDEX - 1 ) * NO_OF_COLS.
1286   *      READ TABLE ARRAY_STACK INDEX ARRAY_STACK_INDEX.
1287   *      ADD <KF_VALUE> TO ARRAY_STACK-F.
1288   *      MODIFY ARRAY_STACK INDEX ARRAY_STACK_INDEX.
1289   *      MODIFY NUM_KEY_FIGURES INDEX KEY_FIGURE_INDEX.
1290   *    ENDLOOP.   " at num_key_figures
1291   *
1292   *  ENDLOOP.  " at int_s000
1293   *
1294   ** Set units of dynamic key-figures
1295   *  LOOP AT NUM_KEY_FIGURES.
1296   *    CHECK NUM_KEY_FIGURES-TABNAME CS 'Z'.        "dynamic key figure?
1297   *    CASE NUM_KEY_FIGURES-REFFIELD.
1298   *      WHEN 'BASME'. NUM_KEY_FIGURES-UNIT = DATA_LINE-XBASME.
1299   *      WHEN 'VRKME'. NUM_KEY_FIGURES-UNIT = DATA_LINE-XVRKME.
1300   *      WHEN 'WAERK'. NUM_KEY_FIGURES-UNIT = DATA_LINE-XWAERK.
1301   *      WHEN '%UNIT_PERC'. NUM_KEY_FIGURES-UNIT = '%'.
1302   *    ENDCASE.
1303   **  don't allow percent view for dynamic key-figures in LIST_ARRAY_STACK
1304   *    NUM_KEY_FIGURES-PERC_NOT_VALID = TRUE.
1305   *    MODIFY NUM_KEY_FIGURES.
1306   *  ENDLOOP.
