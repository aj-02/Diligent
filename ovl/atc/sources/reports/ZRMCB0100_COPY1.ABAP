541    *---------------------------------------------------------------------*
542    *       FORM SEITENKOPF_SORT_ICON_AUSGEBEN                            *
543    *---------------------------------------------------------------------*
544    *       Ausgabe eines Icons zur Anzeige der Sortierung                *
545    *---------------------------------------------------------------------*
546    *  -->  SA_KENNZAHLEN                                                 *
547    *  -->  SA_SORTKRIT                                                   *
548    *---------------------------------------------------------------------*
549    FORM SEITENKOPF_SORT_ICON_AUSGEBEN
550                               TABLES SA_KENNZAHLEN STRUCTURE AKT_KENNZAHLEN
551                               USING  SA_SORTKRIT LIKE SORT_KRITERIUM.
552
553      LOCAL: FLG_SORT_ABST.
554
555
556      FLG_SORT_ABST = SORT_KENNZAHLEN-FLG_ABST.
557
558      DATA: SS_POS_ICON TYPE I.
559
560      READ TABLE AKT_DRILLDOWN INDEX DRILLDOWN_EINTRAEGE. "evtl. überflüssig
561
562      IF ( AKT_DRILLDOWN-FCODE = CON_FCODE_APER AND
563           SA_SORTKRIT         = CON_FELD_AUSTABOBJEKT ) OR
564    *   Sortierkriterium ist Periode (interne Darstellung wird benutzt)
565           SA_SORTKRIT = CON_FELD_AUSTABTEXT.
566    *   Sortierkriterium ist Merkmal (externe Darstellung wird benutzt)
567        IF FLG_CHECK_BOX = FALSE.
568          SS_POS_ICON = 1.
569        ELSE.
570          SS_POS_ICON = 2.
571        ENDIF.
572      ELSE.
573    *   Sortierkriterium ist Kennzahl => Position berechnen
574        SS_POS_ICON = SPALTEN_ANFANG - 1.
575        LOOP AT SA_KENNZAHLEN.
576          IF SA_KENNZAHLEN-AUSTABFELD = SA_SORTKRIT.
577    *       Sortierkennzahl gefunden
578            EXIT.
579          ENDIF.
580          IF NOT SA_KENNZAHLEN-REFLEN IS INITIAL.
581    *       Kennzahl mit Einheit
582            SS_POS_ICON = SS_POS_ICON + SA_KENNZAHLEN-OUTPUTLEN +
583                          SA_KENNZAHLEN-REFLEN + 2.
584          ELSE.
585    *       Kenzahl ohne Einheit
586            SS_POS_ICON = SS_POS_ICON + SA_KENNZAHLEN-OUTPUTLEN + 1.
587          ENDIF.
588        ENDLOOP.
589    *   Wird die Kennzahl gerade angezeigt?
590        CHECK SA_KENNZAHLEN-AUSTABFELD = SA_SORTKRIT.
591      ENDIF.
592
593    * Icon ausgeben
594      POSITION SS_POS_ICON.
595      WRITE: SY-VLINE NO-GAP.
596      PERFORM SORT_ICON_AUSGEBEN USING FLG_SORT_ABST.
597
598    ENDFORM.                               "SEITENKOPF_SORT_ICON_AUSGEBEN
