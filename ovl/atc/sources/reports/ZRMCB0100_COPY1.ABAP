1600
1601     PERFORM TEXT_ERMITTELN USING    036
1602   *                        'Sortierkriterien'
1603                            CHANGING HLP_TEXT1.
1604     PERFORM TEXT_ERMITTELN USING    037
1605   *                        'Sortierkriterien'
1606                            CHANGING HLP_TEXT2.
1607     PERFORM TEXT_ERMITTELN USING    035
1608   *                        'Sortierkriterium'
1609                            CHANGING HLP_TEXT3.
1610     LS_MINANZ_SORTKRIT = '-1'.
1611     CALL FUNCTION 'MC_POPUP_TO_SELECT_FIELDS'
1612          EXPORTING
1613               I_FIELD_FIRST                 = 1
1614               I_FIELD_NUMBER_MAX            = LS_MAXANZ_SORTKRIT
1615               I_FIELD_NUMBER_MIN            = LS_MINANZ_SORTKRIT
1616               I_FLG_SORT                    = TRUE
1617               I_FLG_SORT_DOWN               = FLG_SORT_ABST
1618               I_FORMNAME                    = MODIFYFORMNAME
1619               I_NO_UNIT_FIELDS              = TRUE
1620               I_OBJECT_NAME_PLURAL          = HLP_TEXT1
1621               I_OBJECT_NAME_PLURAL_TITLEBAR = HLP_TEXT2
1622               I_OBJECT_NAME_SINGULAR        = HLP_TEXT3
1623               I_START_ROW                   = 1
1624               I_PROGNAME                    = LIS_PROGNAME
1625               I_SELECTION_INTTYPE           = SELECTION_INTTYPE_S
1626               I_SELECTION_SOURCE            = '6'  "SELECTION_SOURCE_S
1627               I_SELECTION_TYPE              = SELECTION_TYPE_S
1628               I_TABLE_NAME                  = GSTRU
1629               I_TABLE_NAME_ADDITIONAL       = ZUSATZ_TAB
1630          IMPORTING
1631               E_FIELD_CHANGED               = LS_FLG_CHANGE
1632          TABLES
1633               T_FIELDS                      = KENNZAHLEN_SSTAB_S
1634               T_FIELDS_EXCLUDE              = KENNZAHLEN_TAB.
1635
1636   * Sortierkriterien wurden verändert?
