861             EXPORTING
862                 callback_program       = lis_progname
863                 callback_user_command  = 'HANZ_USER_COMMAND'
864                 callback_text_display  = 'HANZ_TEXT_DISPLAY'
865    *          CALLBACK_COLOR_DISPLAY = ' '
866                 callback_top_of_page   = 'HANZ_TOP_OF_PAGE'
867    *          STATUS                 = 'IMPLICIT'
868    *          CHECK_DUPLICATE_NAME   = '1'
869    *          COLOR_OF_LINK          = '1'
870                 color_of_node          = '1'
871    *          LOWER_CASE_SENSITIVE   = ' '
872    *          MODIFICATION_LOG       = ' '
873                 node_length            = 0
874                 text_length            = 40
875    *          TEXT_LENGTH1           = 0
876    *          TEXT_LENGTH2           = 0
877    *          RETURN_MARKED_SUBTREE  = ' '
878                 screen_start_column    = ha_start_col
879                 screen_start_line      = ha_start_row
880                 screen_end_column      = ha_end_col
881                 screen_end_line        = ha_end_row
882                 suppress_node_output   = ' '
883             IMPORTING
884                 f15                    = ha_dummy.
885      ELSE.
886        CALL FUNCTION 'RS_TREE_LIST_DISPLAY'
887             EXPORTING
888                 callback_program       = lis_progname
889                 callback_user_command  = 'HANZ_USER_COMMAND'
890                 callback_text_display  = 'HANZ_TEXT_DISPLAY_TC'
891    *          CALLBACK_COLOR_DISPLAY = ' '
892                 callback_gui_status    = 'HANZ_GUI_STATUS'
893    *            callback_top_of_page   = 'HANZ_TOP_OF_PAGE'
894    *          STATUS                 = 'IMPLICIT'
895    *          CHECK_DUPLICATE_NAME   = '1'
896    *          COLOR_OF_LINK          = '1'
897                 color_of_node          = '1'
898    *          LOWER_CASE_SENSITIVE   = ' '
899    *          MODIFICATION_LOG       = ' '
900                 node_length            = 0
901                 text_length            = 40
