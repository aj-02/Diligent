68                                              HA_SUBRC.
69         HA_TITLE = DFIES-SCRTEXT_L.
70         CALL FUNCTION 'HELP_OBJECT_SHOW_FOR_FIELD'
71              EXPORTING
72                   CALLED_FOR_TAB   = HA_TABNAME
73                   CALLED_FOR_FIELD = HA_FIELDNAME
74                   DOKTITLE         = HA_TITLE
75              TABLES
76                   LINKS            = HA_LINKS
77              EXCEPTIONS
78                   OBJECT_NOT_FOUND = 1.
79         IF NOT SY-SUBRC IS INITIAL.
80           MESSAGE S720(SH) RAISING NO_VARIABLE_LIST_LINE.
81     *             S720: Keine Dokumentation verfügbar
82         ENDIF.
83
84       ELSEIF FLG_VERGLEICH = FALSE AND FLG_ZEITREIHE = FALSE.
85     *   Doku zum Feld nicht vorhanden => Doku zum Datenelement für Merkmal
86     *   aber nicht im Vergleichspopup und nicht bei Zeitreihe
87         HA_TITLE = AKT_DRILLDOWN-SCRTEXT_L.
88         CALL FUNCTION 'HELP_OBJECT_SHOW'
89              EXPORTING
90                   DOKCLASS         = 'DE'
91                   DOKNAME          = AKT_DRILLDOWN-ROLLNAME
92                   DOKTITLE         = HA_TITLE
93              TABLES
94                   LINKS            = HA_HLP_LINKS
95              EXCEPTIONS
96                   OBJECT_NOT_FOUND = 1
97                   SAPSCRIPT_ERROR  = 2.
98         IF NOT SY-SUBRC IS INITIAL.
99           MESSAGE S720(SH) RAISING NO_VARIABLE_LIST_LINE.
100    *             S720: Keine Dokumentation verfügbar
101        ENDIF.
102      ENDIF.
103
104    ENDFORM.                               "HILFETEXT_ANZEIGEN
